{
  "name": "tarqeem",
  "displayName": "ترقيم - Tarqeem",
  "description": "Arabic programming language support for VS Code - دعم لغة ترقيم البرمجية العربية",
  "version": "0.1.0",
  "publisher": "tarqeem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osama1998H/tarqeem"
  },
  "bugs": {
    "url": "https://github.com/osama1998H/tarqeem/issues"
  },
  "homepage": "https://github.com/osama1998H/tarqeem#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "tarqeem",
    "ترقيم",
    "arabic",
    "عربي",
    "rtl",
    "programming language"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:tarqeem",
    "workspaceContains:**/*.trq",
    "workspaceContains:**/*.ترقيم"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tarqeem",
        "aliases": [
          "Tarqeem",
          "ترقيم",
          "tarqeem"
        ],
        "extensions": [
          ".trq",
          ".ترقيم",
          ".trqh",
          ".ترقيم-ر"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "tarqeem",
        "scopeName": "source.tarqeem",
        "path": "./syntaxes/tarqeem.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tarqeem",
        "path": "./snippets/tarqeem.json"
      }
    ],
    "commands": [
      {
        "command": "tarqeem.run",
        "title": "تشغيل الملف",
        "category": "ترقيم",
        "icon": "$(play)"
      },
      {
        "command": "tarqeem.compile",
        "title": "ترجمة الملف",
        "category": "ترقيم",
        "icon": "$(package)"
      },
      {
        "command": "tarqeem.format",
        "title": "تنسيق الكود",
        "category": "ترقيم",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "tarqeem.newProject",
        "title": "مشروع جديد",
        "category": "ترقيم",
        "icon": "$(new-folder)"
      },
      {
        "command": "tarqeem.openRepl",
        "title": "فتح REPL",
        "category": "ترقيم",
        "icon": "$(terminal)"
      },
      {
        "command": "tarqeem.check",
        "title": "فحص الكود",
        "category": "ترقيم",
        "icon": "$(check)"
      },
      {
        "command": "tarqeem.restartServer",
        "title": "إعادة تشغيل الخادم",
        "category": "ترقيم",
        "icon": "$(refresh)"
      },
      {
        "command": "tarqeem.run.en",
        "title": "Run File",
        "category": "Tarqeem",
        "icon": "$(play)"
      },
      {
        "command": "tarqeem.compile.en",
        "title": "Compile File",
        "category": "Tarqeem",
        "icon": "$(package)"
      },
      {
        "command": "tarqeem.format.en",
        "title": "Format Code",
        "category": "Tarqeem",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "tarqeem.newProject.en",
        "title": "New Project",
        "category": "Tarqeem",
        "icon": "$(new-folder)"
      },
      {
        "command": "tarqeem.openRepl.en",
        "title": "Open REPL",
        "category": "Tarqeem",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tarqeem.run",
          "when": "resourceLangId == tarqeem",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "tarqeem.run",
          "when": "resourceLangId == tarqeem",
          "group": "tarqeem@1"
        },
        {
          "command": "tarqeem.compile",
          "when": "resourceLangId == tarqeem",
          "group": "tarqeem@2"
        },
        {
          "command": "tarqeem.format",
          "when": "resourceLangId == tarqeem",
          "group": "tarqeem@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tarqeem.run",
          "when": "resourceLangId == tarqeem"
        },
        {
          "command": "tarqeem.compile",
          "when": "resourceLangId == tarqeem"
        },
        {
          "command": "tarqeem.format",
          "when": "resourceLangId == tarqeem"
        },
        {
          "command": "tarqeem.check",
          "when": "resourceLangId == tarqeem"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tarqeem.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && resourceLangId == tarqeem"
      },
      {
        "command": "tarqeem.compile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && resourceLangId == tarqeem"
      },
      {
        "command": "tarqeem.format",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && resourceLangId == tarqeem"
      }
    ],
    "configuration": {
      "title": "ترقيم - Tarqeem",
      "properties": {
        "tarqeem.server.path": {
          "type": "string",
          "default": "tarqeem",
          "description": "Path to the Tarqeem compiler executable - مسار ملف ترقيم التنفيذي",
          "scope": "machine-overridable"
        },
        "tarqeem.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments to pass to the Tarqeem LSP server - وسائط خادم LSP",
          "scope": "machine-overridable"
        },
        "tarqeem.language": {
          "type": "string",
          "enum": [
            "ar",
            "en",
            "auto"
          ],
          "default": "auto",
          "enumDescriptions": [
            "العربية",
            "English",
            "Automatic (based on VS Code locale)"
          ],
          "description": "Language for error messages and UI - لغة رسائل الخطأ والواجهة"
        },
        "tarqeem.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication (for debugging) - تتبع اتصالات LSP"
        },
        "tarqeem.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code formatting - تفعيل تنسيق الكود"
        },
        "tarqeem.formatting.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format code on save - تنسيق الكود عند الحفظ"
        },
        "tarqeem.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints for types - إظهار تلميحات الأنماط"
        },
        "tarqeem.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter names in function calls - إظهار أسماء المعاملات"
        },
        "tarqeem.inlayHints.variableTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred types for variables - إظهار الأنماط المستنتجة للمتغيرات"
        },
        "tarqeem.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time diagnostics - تفعيل التشخيصات الفورية"
        },
        "tarqeem.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion - تفعيل الإكمال التلقائي"
        },
        "tarqeem.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information - تفعيل معلومات التحويم"
        },
        "tarqeem.editor.unicodeHighlight": {
          "type": "boolean",
          "default": false,
          "description": "Highlight ambiguous Unicode characters (disable for Arabic) - تمييز الأحرف المشابهة"
        },
        "tarqeem.output.showOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Show output panel when running code - إظهار لوحة الإخراج عند التشغيل"
        },
        "tarqeem.repl.autoStartOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start REPL when opening Tarqeem files - بدء REPL تلقائياً"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "tarqeem",
        "owner": "tarqeem",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^خطأ|error\\s+in\\s+(.+):(\\d+):(\\d+):\\s+(.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "tarqeem",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "compile",
              "check",
              "test"
            ],
            "description": "The Tarqeem command to run"
          },
          "file": {
            "type": "string",
            "description": "The file to operate on"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.55.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
