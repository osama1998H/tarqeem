{
  "دالة - Function": {
    "prefix": ["دالة", "function", "fn", "func"],
    "body": [
      "دالة ${1:اسم_الدالة}(${2:معاملات}) -> ${3:نوع_الإرجاع} {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة جديدة - Define a new function"
  },
  "دالة عام - Public Function": {
    "prefix": ["دالة_عام", "pubfn", "public_function"],
    "body": [
      "عام دالة ${1:اسم_الدالة}(${2:معاملات}) -> ${3:نوع_الإرجاع} {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة عامة - Define a public function"
  },
  "دالة غير متزامنة - Async Function": {
    "prefix": ["غير_متزامن", "async", "asyncfn"],
    "body": [
      "غير_متزامن دالة ${1:اسم_الدالة}(${2:معاملات}) -> ${3:نوع_الإرجاع} {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة غير متزامنة - Define an async function"
  },
  "صنف - Class": {
    "prefix": ["صنف", "class"],
    "body": [
      "صنف ${1:اسم_الصنف} {",
      "\t// الخصائص",
      "\tخاص ${2:خاصية}: ${3:نوع}",
      "",
      "\t// المنشئ",
      "\tمنشئ(${4:معاملات}) {",
      "\t\tهذا.${2:خاصية} = ${5:قيمة}",
      "\t}",
      "",
      "\t// الدوال",
      "\tعام دالة ${6:اسم_الدالة}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "تعريف صنف جديد - Define a new class"
  },
  "صنف يرث - Class Extends": {
    "prefix": ["صنف_يرث", "class_extends", "classex"],
    "body": [
      "صنف ${1:اسم_الصنف} يرث ${2:الصنف_الأب} {",
      "\tمنشئ(${3:معاملات}) {",
      "\t\tأساس(${4:معاملات_الأب})",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "تعريف صنف يرث من صنف آخر - Define a class that extends another"
  },
  "صنف يطبق - Class Implements": {
    "prefix": ["صنف_يطبق", "class_implements", "classim"],
    "body": [
      "صنف ${1:اسم_الصنف} يطبق ${2:الواجهة} {",
      "\t$0",
      "}"
    ],
    "description": "تعريف صنف يطبق واجهة - Define a class that implements an interface"
  },
  "واجهة - Interface": {
    "prefix": ["واجهة", "interface", "iface"],
    "body": [
      "واجهة ${1:اسم_الواجهة} {",
      "\tدالة ${2:اسم_الدالة}(${3:معاملات}) -> ${4:نوع_الإرجاع}",
      "\t$0",
      "}"
    ],
    "description": "تعريف واجهة جديدة - Define a new interface"
  },
  "متغير - Variable": {
    "prefix": ["متغير", "let", "var"],
    "body": "متغير ${1:اسم} = ${2:قيمة}",
    "description": "تعريف متغير - Define a variable"
  },
  "متغير بنوع - Variable with Type": {
    "prefix": ["متغير_نوع", "lettype", "vartype"],
    "body": "متغير ${1:اسم}: ${2:نوع} = ${3:قيمة}",
    "description": "تعريف متغير مع النوع - Define a variable with type"
  },
  "ثابت - Constant": {
    "prefix": ["ثابت", "const"],
    "body": "ثابت ${1:اسم} = ${2:قيمة}",
    "description": "تعريف ثابت - Define a constant"
  },
  "إذا - If": {
    "prefix": ["إذا", "اذا", "if"],
    "body": [
      "إذا (${1:شرط}) {",
      "\t$0",
      "}"
    ],
    "description": "جملة شرطية - If statement"
  },
  "إذا وإلا - If Else": {
    "prefix": ["إذا_وإلا", "اذا_والا", "ifelse"],
    "body": [
      "إذا (${1:شرط}) {",
      "\t$2",
      "} وإلا {",
      "\t$0",
      "}"
    ],
    "description": "جملة شرطية مع وإلا - If else statement"
  },
  "إذا وإلا إذا - If Else If": {
    "prefix": ["إذا_وإلا_إذا", "ifelseif", "elif"],
    "body": [
      "إذا (${1:شرط1}) {",
      "\t$2",
      "} وإلا إذا (${3:شرط2}) {",
      "\t$4",
      "} وإلا {",
      "\t$0",
      "}"
    ],
    "description": "جملة شرطية متعددة - If else if statement"
  },
  "تطابق - Match": {
    "prefix": ["تطابق", "match", "switch"],
    "body": [
      "تطابق (${1:متغير}) {",
      "\tحالة ${2:قيمة1} => {",
      "\t\t$3",
      "\t}",
      "\tحالة ${4:قيمة2} => {",
      "\t\t$5",
      "\t}",
      "\tغير_ذلك => {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "تطابق الأنماط - Pattern matching"
  },
  "طالما - While": {
    "prefix": ["طالما", "while"],
    "body": [
      "طالما (${1:شرط}) {",
      "\t$0",
      "}"
    ],
    "description": "حلقة طالما - While loop"
  },
  "لكل - For": {
    "prefix": ["لكل", "for"],
    "body": [
      "لكل (متغير ${1:ع} = ${2:0}؛ ${1:ع} < ${3:10}؛ ${1:ع}++) {",
      "\t$0",
      "}"
    ],
    "description": "حلقة لكل - For loop"
  },
  "لكل في - For In": {
    "prefix": ["لكل_في", "forin", "foreach"],
    "body": [
      "لكل ${1:عنصر} في ${2:مجموعة} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة لكل في - For-in loop"
  },
  "افعل طالما - Do While": {
    "prefix": ["افعل_طالما", "dowhile"],
    "body": [
      "افعل {",
      "\t$0",
      "} طالما (${1:شرط})"
    ],
    "description": "حلقة افعل-طالما - Do-while loop"
  },
  "حاول - Try Catch": {
    "prefix": ["حاول", "try"],
    "body": [
      "حاول {",
      "\t$1",
      "} التقط (${2:خطأ}) {",
      "\t$0",
      "}"
    ],
    "description": "معالجة الأخطاء - Try-catch block"
  },
  "حاول أخيراً - Try Finally": {
    "prefix": ["حاول_أخيراً", "tryfinally"],
    "body": [
      "حاول {",
      "\t$1",
      "} التقط (${2:خطأ}) {",
      "\t$3",
      "} أخيراً {",
      "\t$0",
      "}"
    ],
    "description": "معالجة الأخطاء مع أخيراً - Try-catch-finally block"
  },
  "ارمِ - Throw": {
    "prefix": ["ارمِ", "ارم", "throw"],
    "body": "ارمِ ${1:خطأ_جديد}(\"${2:رسالة_الخطأ}\")",
    "description": "رمي خطأ - Throw an error"
  },
  "استورد - Import": {
    "prefix": ["استورد", "import"],
    "body": "استورد { ${1:أسماء} } من \"${2:وحدة}\"",
    "description": "استيراد من وحدة - Import from module"
  },
  "استورد كل - Import All": {
    "prefix": ["استورد_كل", "importall"],
    "body": "استورد * كـ ${1:اسم} من \"${2:وحدة}\"",
    "description": "استيراد كل شيء من وحدة - Import all from module"
  },
  "صدّر - Export": {
    "prefix": ["صدّر", "صدر", "export"],
    "body": "صدّر ${0}",
    "description": "تصدير - Export"
  },
  "صدّر دالة - Export Function": {
    "prefix": ["صدّر_دالة", "exportfn"],
    "body": [
      "صدّر دالة ${1:اسم_الدالة}(${2:معاملات}) -> ${3:نوع_الإرجاع} {",
      "\t$0",
      "}"
    ],
    "description": "تصدير دالة - Export function"
  },
  "صدّر صنف - Export Class": {
    "prefix": ["صدّر_صنف", "exportclass"],
    "body": [
      "صدّر صنف ${1:اسم_الصنف} {",
      "\t$0",
      "}"
    ],
    "description": "تصدير صنف - Export class"
  },
  "اطبع - Print": {
    "prefix": ["اطبع", "print", "log"],
    "body": "اطبع(${1:\"رسالة\"})",
    "description": "طباعة نص - Print text"
  },
  "اطبع متغير - Print Variable": {
    "prefix": ["اطبع_متغير", "printvar", "logvar"],
    "body": "اطبع(\"${1:اسم}: \" + ${2:متغير})",
    "description": "طباعة متغير - Print variable"
  },
  "ادخل - Input": {
    "prefix": ["ادخل", "input", "read"],
    "body": "متغير ${1:إدخال} = ادخل(\"${2:رسالة}\")",
    "description": "قراءة مدخل - Read input"
  },
  "مرحبا - Hello World": {
    "prefix": ["مرحبا", "hello", "hw"],
    "body": "اطبع(\"مرحباً بالعالم!\")",
    "description": "برنامج مرحباً بالعالم - Hello World program"
  },
  "دالة سهمية - Arrow Function": {
    "prefix": ["سهم", "arrow", "=>"],
    "body": "(${1:معاملات}) => ${2:تعبير}",
    "description": "دالة سهمية - Arrow function"
  },
  "دالة سهمية كتلة - Arrow Function Block": {
    "prefix": ["سهم_كتلة", "arrowblock"],
    "body": [
      "(${1:معاملات}) => {",
      "\t$0",
      "}"
    ],
    "description": "دالة سهمية مع كتلة - Arrow function with block"
  },
  "مصفوفة - Array": {
    "prefix": ["مصفوفة", "array", "arr"],
    "body": "متغير ${1:اسم}: مصفوفة<${2:نوع}> = [${3:عناصر}]",
    "description": "تعريف مصفوفة - Define an array"
  },
  "قاموس - Map": {
    "prefix": ["قاموس", "map", "dict"],
    "body": "متغير ${1:اسم}: قاموس<${2:مفتاح}، ${3:قيمة}> = {}",
    "description": "تعريف قاموس - Define a map"
  },
  "منشئ - Constructor": {
    "prefix": ["منشئ", "constructor", "ctor"],
    "body": [
      "منشئ(${1:معاملات}) {",
      "\t$0",
      "}"
    ],
    "description": "منشئ الصنف - Class constructor"
  },
  "انتظر - Await": {
    "prefix": ["انتظر", "await"],
    "body": "متغير ${1:نتيجة} = انتظر ${2:دالة_غير_متزامنة}()",
    "description": "انتظار نتيجة غير متزامنة - Await async result"
  },
  "جديد - New Instance": {
    "prefix": ["جديد", "new"],
    "body": "متغير ${1:اسم} = جديد ${2:الصنف}(${3:معاملات})",
    "description": "إنشاء كائن جديد - Create new instance"
  },
  "خاصية خاصة - Private Field": {
    "prefix": ["خاص", "private"],
    "body": "خاص ${1:اسم}: ${2:نوع}",
    "description": "خاصية خاصة - Private field"
  },
  "خاصية عامة - Public Field": {
    "prefix": ["عام", "public"],
    "body": "عام ${1:اسم}: ${2:نوع}",
    "description": "خاصية عامة - Public field"
  },
  "دالة ثابتة - Static Method": {
    "prefix": ["ثابت_صنف", "static"],
    "body": [
      "ثابت_صنف دالة ${1:اسم_الدالة}(${2:معاملات}) -> ${3:نوع_الإرجاع} {",
      "\t$0",
      "}"
    ],
    "description": "دالة ثابتة للصنف - Static method"
  },
  "تعليق توثيقي - Doc Comment": {
    "prefix": ["توثيق", "doc", "///"],
    "body": [
      "/// ${1:وصف الدالة}",
      "///",
      "/// @معامل ${2:اسم} - ${3:وصف المعامل}",
      "/// @ارجاع ${4:وصف القيمة المرجعة}",
      "/// @مثال",
      "/// ```",
      "/// ${5:مثال على الاستخدام}",
      "/// ```"
    ],
    "description": "تعليق توثيقي - Documentation comment"
  },
  "منطقة - Region": {
    "prefix": ["منطقة", "region"],
    "body": [
      "// #region ${1:اسم المنطقة}",
      "$0",
      "// #endregion"
    ],
    "description": "منطقة قابلة للطي - Foldable region"
  }
}
