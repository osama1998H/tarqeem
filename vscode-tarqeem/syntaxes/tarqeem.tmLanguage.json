{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tarqeem",
  "scopeName": "source.tarqeem",
  "fileTypes": ["trq", "ترقيم", "trqh", "ترقيم-ر"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-call" },
    { "include": "#function-declaration" },
    { "include": "#class-declaration" },
    { "include": "#interface-declaration" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tarqeem",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.tarqeem",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "storage.type.class.jsdoc.tarqeem",
              "match": "@(معامل|param|ارجاع|returns|return|مثال|example|راجع|see|تحذير|warning|ملاحظة|note|منذ|since|مهمل|deprecated|خطأ|throws)\\b"
            }
          ]
        },
        {
          "name": "comment.line.documentation.tarqeem",
          "begin": "///",
          "end": "$",
          "patterns": [
            {
              "name": "storage.type.class.jsdoc.tarqeem",
              "match": "@(معامل|param|ارجاع|returns|return|مثال|example|راجع|see|تحذير|warning|ملاحظة|note|منذ|since|مهمل|deprecated|خطأ|throws)\\b"
            }
          ]
        },
        {
          "name": "comment.block.tarqeem",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tarqeem",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#string-interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.tarqeem",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.template.tarqeem",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "name": "meta.embedded.expression.tarqeem",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.tarqeem" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.tarqeem" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.tarqeem",
          "match": "\\\\[\\\\\"'nrtbfv0]"
        },
        {
          "name": "constant.character.escape.unicode.tarqeem",
          "match": "\\\\u[0-9a-fA-F]{4}"
        },
        {
          "name": "constant.character.escape.unicode.tarqeem",
          "match": "\\\\u\\{[0-9a-fA-F]+\\}"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.tarqeem",
          "match": "\\$[a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tarqeem",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.arabic.tarqeem",
          "match": "[٠-٩][٠-٩_]*\\.[٠-٩][٠-٩_]*"
        },
        {
          "name": "constant.numeric.hex.tarqeem",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.tarqeem",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.tarqeem",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tarqeem",
          "match": "\\b[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.arabic.tarqeem",
          "match": "[٠-٩][٠-٩_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Variable declaration keywords - Arabic and English",
          "name": "keyword.declaration.variable.tarqeem",
          "match": "\\b(متغير|let|var|ثابت|const)\\b"
        },
        {
          "comment": "Function keywords - Arabic and English",
          "name": "keyword.declaration.function.tarqeem",
          "match": "\\b(دالة|function|fn|أرجع|ارجع|return|غير_متزامن|async|انتظر|await)\\b"
        },
        {
          "comment": "Control flow keywords - Arabic and English",
          "name": "keyword.control.flow.tarqeem",
          "match": "\\b(إذا|اذا|if|وإلا|والا|else|تطابق|match|switch|حالة|case|غير_ذلك|default)\\b"
        },
        {
          "comment": "Loop keywords - Arabic and English",
          "name": "keyword.control.loop.tarqeem",
          "match": "\\b(طالما|while|لكل|for|في|in|افعل|do|أوقف|اوقف|break|استمر|continue)\\b"
        },
        {
          "comment": "OOP keywords - Arabic and English",
          "name": "keyword.declaration.class.tarqeem",
          "match": "\\b(صنف|class|واجهة|interface|يرث|extends|يطبق|implements)\\b"
        },
        {
          "comment": "Access modifiers - Arabic and English",
          "name": "keyword.modifier.access.tarqeem",
          "match": "\\b(عام|public|خاص|private|محمي|protected|ثابت_صنف|static)\\b"
        },
        {
          "comment": "OOP other keywords - Arabic and English",
          "name": "keyword.other.oop.tarqeem",
          "match": "\\b(منشئ|constructor|هذا|this|أساس|اساس|super|جديد|new)\\b"
        },
        {
          "comment": "Error handling keywords - Arabic and English",
          "name": "keyword.control.exception.tarqeem",
          "match": "\\b(حاول|try|التقط|catch|أخيراً|اخيرا|finally|ارمِ|ارم|throw)\\b"
        },
        {
          "comment": "Module keywords - Arabic and English",
          "name": "keyword.control.import.tarqeem",
          "match": "\\b(استورد|import|صدّر|صدر|export|من|from|كـ|ك|as)\\b"
        },
        {
          "comment": "Logical operator keywords - Arabic",
          "name": "keyword.operator.logical.tarqeem",
          "match": "\\b(و|أو|او|ليس|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Primitive types - Arabic",
          "name": "support.type.primitive.arabic.tarqeem",
          "match": "\\b(عدد|عدد_عشري|نص|منطقي|فراغ|أي|اي)\\b"
        },
        {
          "comment": "Primitive types - English",
          "name": "support.type.primitive.english.tarqeem",
          "match": "\\b(int|float|string|bool|void|any)\\b"
        },
        {
          "comment": "Collection types - Arabic",
          "name": "support.type.collection.arabic.tarqeem",
          "match": "\\b(مصفوفة|قائمة|قاموس|مجموعة)\\b"
        },
        {
          "comment": "Collection types - English",
          "name": "support.type.collection.english.tarqeem",
          "match": "\\b(array|list|map|dict|set)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "comment": "Boolean true - Arabic and English",
          "name": "constant.language.boolean.true.tarqeem",
          "match": "\\b(صحيح|true)\\b"
        },
        {
          "comment": "Boolean false - Arabic and English",
          "name": "constant.language.boolean.false.tarqeem",
          "match": "\\b(خطأ|خطا|false)\\b"
        },
        {
          "comment": "Null - Arabic and English",
          "name": "constant.language.null.tarqeem",
          "match": "\\b(عدم|null|none)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.tarqeem",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.compound.tarqeem",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.assignment.tarqeem",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.tarqeem",
          "match": "(\\+\\+|--|\\*\\*|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.tarqeem",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arrow.tarqeem",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.ternary.tarqeem",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.spread.tarqeem",
          "match": "\\.\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.tarqeem",
          "match": "[,،]"
        },
        {
          "name": "punctuation.terminator.semicolon.tarqeem",
          "match": "[;؛]"
        },
        {
          "name": "punctuation.accessor.tarqeem",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.typeparameters.begin.tarqeem",
          "match": "<(?=[a-zA-Z_\\u0600-\\u06FF])"
        },
        {
          "name": "punctuation.definition.typeparameters.end.tarqeem",
          "match": ">"
        },
        {
          "name": "punctuation.definition.block.tarqeem",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.tarqeem",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.tarqeem",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.colon.tarqeem",
          "match": ":"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "comment": "Function declaration with Arabic keyword",
          "match": "(دالة|function|fn)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.tarqeem" },
            "2": { "name": "entity.name.function.tarqeem" }
          }
        },
        {
          "comment": "Async function declaration",
          "match": "(غير_متزامن|async)\\s+(دالة|function|fn)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.async.tarqeem" },
            "2": { "name": "keyword.declaration.function.tarqeem" },
            "3": { "name": "entity.name.function.tarqeem" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": "Built-in functions - Arabic",
          "match": "\\b(اطبع|ادخل|طول|نوع|حول_لعدد|حول_لنص|حول_لعشري|حول_لمنطقي|جذر|قوة|مطلق|سقف|ارضية|تقريب|عشوائي|جيب|جتا|ظا|جذر_تربيعي)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.builtin.arabic.tarqeem" }
          }
        },
        {
          "comment": "Built-in functions - English",
          "match": "\\b(print|input|len|type|to_int|to_string|to_float|to_bool|sqrt|pow|abs|ceil|floor|round|random|sin|cos|tan)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.builtin.english.tarqeem" }
          }
        },
        {
          "comment": "General function call",
          "match": "([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tarqeem" }
          }
        }
      ]
    },
    "class-declaration": {
      "patterns": [
        {
          "comment": "Class declaration - Arabic",
          "match": "(صنف|class)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*)(?:\\s+(يرث|extends)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*))?(?:\\s+(يطبق|implements)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_,\\s\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.class.tarqeem" },
            "2": { "name": "entity.name.class.tarqeem" },
            "3": { "name": "keyword.declaration.class.extends.tarqeem" },
            "4": { "name": "entity.other.inherited-class.tarqeem" },
            "5": { "name": "keyword.declaration.class.implements.tarqeem" },
            "6": { "name": "entity.other.inherited-class.tarqeem" }
          }
        }
      ]
    },
    "interface-declaration": {
      "patterns": [
        {
          "comment": "Interface declaration",
          "match": "(واجهة|interface)\\s+([a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*)",
          "captures": {
            "1": { "name": "keyword.declaration.interface.tarqeem" },
            "2": { "name": "entity.name.interface.tarqeem" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Identifiers with Arabic letters",
          "name": "variable.other.tarqeem",
          "match": "[a-zA-Z_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF][a-zA-Z0-9_\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF]*"
        }
      ]
    }
  }
}
