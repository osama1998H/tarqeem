/// صنف الزوج لتخزين مفتاح-قيمة
///
/// @مثال
/// متغير ز = جديد زوج<نص، عدد>("عمر"، ٢٥)
/// اطبع(ز.مفتاح)  // "عمر"
/// اطبع(ز.قيمة)   // ٢٥

صدّر صنف زوج<أ، ب> {
    /// المفتاح
    عام مفتاح: أ;
    /// القيمة المرتبطة بالمفتاح
    عام قيمة: ب;

    /// إنشاء زوج جديد
    ///
    /// @معامل م - المفتاح
    /// @معامل ق - القيمة
    منشئ(م: أ، ق: ب) {
        هذا.مفتاح = م
        هذا.قيمة = ق
    }
}

/// صنف الخريطة (قاموس مفتاح-قيمة)
///
/// بنية بيانات تربط مفاتيح بقيم مع دعم البحث والإضافة والحذف
///
/// @ملاحظة نستخدم خريطة بدلاً من قاموس لأن قاموس كلمة محجوزة للنوع
/// @مثال
/// متغير خ = جديد خريطة<نص، عدد>()
/// خ.عيّن("أحمد"، ٣٠)
/// خ.عيّن("محمد"، ٢٥)
/// اطبع(خ.احصل("أحمد"))  // ٣٠

صدّر صنف خريطة<م، ق> {
    خاص _مفاتيح: مصفوفة<م>;
    خاص _قيم: مصفوفة<ق>;
    خاص _طول: عدد;

    /// المنشئ - ينشئ خريطة فارغة جديدة
    منشئ() {
        هذا._مفاتيح = []
        هذا._قيم = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // الإضافة والتعديل
    // ═══════════════════════════════════════════

    /// عيّن قيمة لمفتاح معين
    ///
    /// إذا كان المفتاح موجوداً، يتم تحديث القيمة
    /// وإلا يتم إضافة زوج جديد
    ///
    /// @معامل مفتاح - المفتاح
    /// @معامل قيمة - القيمة المراد تعيينها
    عام دالة عيّن(مفتاح: م، قيمة: ق) {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس >= 0) {
            هذا._قيم[فهرس] = قيمة
        } وإلا {
            هذا._مفاتيح.ألحق(مفتاح)
            هذا._قيم.ألحق(قيمة)
            هذا._طول = هذا._طول + 1
        }
    }

    /// احصل على قيمة بمفتاح معين
    ///
    /// @معامل مفتاح - المفتاح المراد البحث عنه
    /// @أرجع القيمة المرتبطة بالمفتاح
    /// @تحذير يجب التأكد من وجود المفتاح أولاً
    عام دالة احصل(مفتاح: م) -> ق {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        أرجع هذا._قيم[فهرس]
    }

    /// احصل على قيمة أو قيمة افتراضية
    ///
    /// @معامل مفتاح - المفتاح المراد البحث عنه
    /// @معامل افتراضي - القيمة الافتراضية إذا لم يُوجد المفتاح
    /// @أرجع القيمة المرتبطة بالمفتاح أو القيمة الافتراضية
    عام دالة احصل_او(مفتاح: م، افتراضي: ق) -> ق {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس >= 0) {
            أرجع هذا._قيم[فهرس]
        }
        أرجع افتراضي
    }

    // ═══════════════════════════════════════════
    // الحذف
    // ═══════════════════════════════════════════

    /// احذف زوجاً بمفتاح معين
    ///
    /// @معامل مفتاح - المفتاح المراد حذفه
    /// @أرجع صحيح إذا تم الحذف، خطأ إذا لم يُوجد المفتاح
    عام دالة احذف(مفتاح: م) -> منطقي {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس < 0) {
            أرجع خطأ
        }

        متغير ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._مفاتيح[ع] = هذا._مفاتيح[ع + 1]
            هذا._قيم[ع] = هذا._قيم[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع صحيح
    }

    /// امسح جميع الأزواج من الخريطة
    عام دالة امسح() {
        هذا._مفاتيح = []
        هذا._قيم = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // الاستعلام
    // ═══════════════════════════════════════════

    /// تحقق من وجود مفتاح في الخريطة
    ///
    /// @معامل مفتاح - المفتاح المراد البحث عنه
    /// @أرجع صحيح إذا كان المفتاح موجوداً
    عام دالة يحتوي(مفتاح: م) -> منطقي {
        أرجع هذا._ابحث_عن_مفتاح(مفتاح) >= 0
    }

    /// تحقق من وجود قيمة في الخريطة
    ///
    /// @معامل قيمة - القيمة المراد البحث عنها
    /// @أرجع صحيح إذا كانت القيمة موجودة
    عام دالة يحتوي_قيمة(قيمة: ق) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._قيم[ع] == قيمة) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    /// احصل على عدد الأزواج في الخريطة
    ///
    /// @أرجع عدد الأزواج
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    /// تحقق إذا كانت الخريطة فارغة
    ///
    /// @أرجع صحيح إذا كانت فارغة
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ═══════════════════════════════════════════
    // التكرار
    // ═══════════════════════════════════════════

    /// احصل على جميع المفاتيح
    ///
    /// @أرجع قائمة تحتوي جميع المفاتيح
    عام دالة مفاتيح() -> قائمة<م> {
        متغير نتيجة = جديد قائمة<م>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._مفاتيح[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// احصل على جميع القيم
    ///
    /// @أرجع قائمة تحتوي جميع القيم
    عام دالة قيم() -> قائمة<ق> {
        متغير نتيجة = جديد قائمة<ق>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._قيم[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// احصل على جميع الأزواج
    ///
    /// @أرجع قائمة تحتوي جميع أزواج المفتاح-القيمة
    عام دالة عناصر() -> قائمة<زوج<م، ق>> {
        متغير نتيجة = جديد قائمة<زوج<م، ق>>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(جديد زوج<م، ق>(هذا._مفاتيح[ع]، هذا._قيم[ع]))
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // ═══════════════════════════════════════════
    // الدمج والنسخ
    // ═══════════════════════════════════════════

    /// ادمج خريطة أخرى في هذه الخريطة
    ///
    /// @معامل اخر - الخريطة المراد دمجها
    /// @ملاحظة المفاتيح المكررة ستُحدَّث بقيم الخريطة الأخرى
    عام دالة ادمج(اخر: خريطة<م، ق>) {
        متغير ع = 0
        طالما (ع < اخر.طول()) {
            هذا.عيّن(اخر._مفاتيح[ع]، اخر._قيم[ع])
            ع = ع + 1
        }
    }

    /// أنشئ نسخة من الخريطة
    ///
    /// @أرجع خريطة جديدة تحتوي نفس الأزواج
    عام دالة نسخة() -> خريطة<م، ق> {
        متغير نتيجة = جديد خريطة<م، ق>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.عيّن(هذا._مفاتيح[ع]، هذا._قيم[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // ═══════════════════════════════════════════
    // دوال مساعدة خاصة
    // ═══════════════════════════════════════════

    /// ابحث عن فهرس مفتاح معين
    خاص دالة _ابحث_عن_مفتاح(مفتاح: م) -> عدد {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._مفاتيح[ع] == مفتاح) {
                أرجع ع
            }
            ع = ع + 1
        }
        أرجع -1
    }
}

