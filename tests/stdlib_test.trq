// Test file for basic functionality
// ملف اختبار للوظائف الأساسية

// Test math
ثابت نتيجة = 5 + 3
اطبع("5 + 3 = ")
اطبع(نتيجة)
اطبع("\n")

// Test string operations
متغير نص1 = "مرحبا"
متغير نص2 = " بالعالم"
اطبع(نص1 + نص2)
اطبع("\n")

// Test array
متغير ارقام: مصفوفة<عدد> = [1, 2, 3, 4, 5]

// Test loop
لكل رقم في ارقام {
    اطبع(رقم)
    اطبع(" ")
}
اطبع("\n")

اطبع("=== انتهى الاختبار ===\n")
