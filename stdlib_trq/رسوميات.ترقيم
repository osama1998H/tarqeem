/// مكتبة الرسوميات - SDL2
///
/// توفر هذه المكتبة واجهة عربية لإنشاء النوافذ والرسم
/// باستخدام مكتبة SDL2 للرسوميات
///
/// @مثال
/// استورد { هيئ، أنشئ_نافذة، امسح، اعرض } من "رسوميات"
///
/// دالة رئيسية() {
///     هيئ()
///     متغير نافذتي = أنشئ_نافذة("برنامجي"، ٨٠٠، ٦٠٠)
///     // حلقة اللعبة...
///     أغلق_نافذة(نافذتي)
///     أنهِ()
/// }

// ═══════════════════════════════════════════
// التهيئة والإنهاء
// ═══════════════════════════════════════════

/// تهيئة نظام الرسوميات
/// يجب استدعاء هذه الدالة قبل أي دالة رسومية أخرى
///
/// @أرجع صحيح إذا نجحت التهيئة، خطأ عند الفشل
صدّر دالة هيئ() -> منطقي {
    أرجع sdl_init() == 1
}

/// إنهاء نظام الرسوميات وتحرير الموارد
/// يجب استدعاء هذه الدالة عند الانتهاء من البرنامج
صدّر دالة أنهِ() {
    sdl_quit()
}

/// التحقق إذا كان نظام الرسوميات مهيأ
///
/// @أرجع صحيح إذا كان النظام مهيأ
صدّر دالة مهيأ() -> منطقي {
    أرجع sdl_is_init() == 1
}

// ═══════════════════════════════════════════
// إدارة النوافذ
// ═══════════════════════════════════════════

/// إنشاء نافذة جديدة
///
/// @معامل عنوان - عنوان النافذة
/// @معامل عرض - عرض النافذة بالبكسل
/// @معامل ارتفاع - ارتفاع النافذة بالبكسل
/// @أرجع مقبض النافذة (عدد موجب) أو -١ عند الفشل
/// @مثال
/// متغير نافذتي = أنشئ_نافذة("لعبتي"، ٨٠٠، ٦٠٠)
/// إذا (نافذتي > ٠) {
///     اطبع("تم إنشاء النافذة بنجاح!")
/// }
صدّر دالة أنشئ_نافذة(عنوان: نص، عرض: عدد، ارتفاع: عدد) -> عدد {
    أرجع window_create(عنوان، عرض، ارتفاع)
}

/// إغلاق نافذة وتحرير مواردها
///
/// @معامل نافذة - مقبض النافذة
صدّر دالة أغلق_نافذة(نافذة: عدد) {
    window_close(نافذة)
}

/// تعيين عنوان النافذة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل عنوان - العنوان الجديد
صدّر دالة عيّن_عنوان(نافذة: عدد، عنوان: نص) {
    window_set_title(نافذة، عنوان)
}

/// الحصول على عرض النافذة
///
/// @معامل نافذة - مقبض النافذة
/// @أرجع عرض النافذة بالبكسل
صدّر دالة عرض_نافذة(نافذة: عدد) -> عدد {
    أرجع window_width(نافذة)
}

/// الحصول على ارتفاع النافذة
///
/// @معامل نافذة - مقبض النافذة
/// @أرجع ارتفاع النافذة بالبكسل
صدّر دالة ارتفاع_نافذة(نافذة: عدد) -> عدد {
    أرجع window_height(نافذة)
}

/// إظهار النافذة
///
/// @معامل نافذة - مقبض النافذة
صدّر دالة أظهر_نافذة(نافذة: عدد) {
    window_show(نافذة)
}

/// إخفاء النافذة
///
/// @معامل نافذة - مقبض النافذة
صدّر دالة أخفِ_نافذة(نافذة: عدد) {
    window_hide(نافذة)
}

/// تعيين موضع النافذة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س - الموضع الأفقي
/// @معامل ص - الموضع الرأسي
صدّر دالة عيّن_موضع_نافذة(نافذة: عدد، س: عدد، ص: عدد) {
    window_set_position(نافذة، س، ص)
}

/// تعيين حجم النافذة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل عرض - العرض الجديد
/// @معامل ارتفاع - الارتفاع الجديد
صدّر دالة عيّن_حجم_نافذة(نافذة: عدد، عرض: عدد، ارتفاع: عدد) {
    window_set_size(نافذة، عرض، ارتفاع)
}

/// تعيين وضع ملء الشاشة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل وضع - ٠=نافذة، ١=ملء شاشة، ٢=ملء شاشة سطح المكتب
صدّر دالة عيّن_ملء_شاشة(نافذة: عدد، وضع: عدد) {
    window_set_fullscreen(نافذة، وضع)
}

// ═══════════════════════════════════════════
// الرسم والعرض
// ═══════════════════════════════════════════

/// مسح الشاشة باللون الحالي
///
/// @معامل نافذة - مقبض النافذة
صدّر دالة امسح(نافذة: عدد) {
    render_clear(نافذة)
}

/// عرض ما تم رسمه على الشاشة
///
/// @معامل نافذة - مقبض النافذة
صدّر دالة اعرض(نافذة: عدد) {
    render_present(نافذة)
}

/// تعيين لون الرسم (أحمر، أخضر، أزرق، شفافية)
///
/// @معامل نافذة - مقبض النافذة
/// @معامل أحمر - قيمة اللون الأحمر (٠-٢٥٥)
/// @معامل أخضر - قيمة اللون الأخضر (٠-٢٥٥)
/// @معامل أزرق - قيمة اللون الأزرق (٠-٢٥٥)
/// @معامل شفافية - قيمة الشفافية (٠-٢٥٥)، ٢٥٥ = معتم تماماً
صدّر دالة عيّن_لون(نافذة: عدد، أحمر: عدد، أخضر: عدد، أزرق: عدد، شفافية: عدد) {
    render_set_color(نافذة، أحمر، أخضر، أزرق، شفافية)
}

/// تعيين لون الرسم (أحمر، أخضر، أزرق) - شفافية كاملة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل أحمر - قيمة اللون الأحمر (٠-٢٥٥)
/// @معامل أخضر - قيمة اللون الأخضر (٠-٢٥٥)
/// @معامل أزرق - قيمة اللون الأزرق (٠-٢٥٥)
صدّر دالة عيّن_لون_ر_خ_ز(نافذة: عدد، أحمر: عدد، أخضر: عدد، أزرق: عدد) {
    render_set_color(نافذة، أحمر، أخضر، أزرق، 255)
}

/// رسم نقطة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س - الموضع الأفقي
/// @معامل ص - الموضع الرأسي
صدّر دالة ارسم_نقطة(نافذة: عدد، س: عدد، ص: عدد) {
    render_point(نافذة، س، ص)
}

/// رسم خط بين نقطتين
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س١ - الموضع الأفقي للنقطة الأولى
/// @معامل ص١ - الموضع الرأسي للنقطة الأولى
/// @معامل س٢ - الموضع الأفقي للنقطة الثانية
/// @معامل ص٢ - الموضع الرأسي للنقطة الثانية
صدّر دالة ارسم_خط(نافذة: عدد، س١: عدد، ص١: عدد، س٢: عدد، ص٢: عدد) {
    render_line(نافذة، س١، ص١، س٢، ص٢)
}

/// رسم مستطيل فارغ (إطار فقط)
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س - الموضع الأفقي للزاوية العليا اليسرى
/// @معامل ص - الموضع الرأسي للزاوية العليا اليسرى
/// @معامل عرض - عرض المستطيل
/// @معامل ارتفاع - ارتفاع المستطيل
صدّر دالة ارسم_مستطيل(نافذة: عدد، س: عدد، ص: عدد، عرض: عدد، ارتفاع: عدد) {
    render_rect(نافذة، س، ص، عرض، ارتفاع)
}

/// رسم مستطيل ممتلئ
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س - الموضع الأفقي للزاوية العليا اليسرى
/// @معامل ص - الموضع الرأسي للزاوية العليا اليسرى
/// @معامل عرض - عرض المستطيل
/// @معامل ارتفاع - ارتفاع المستطيل
صدّر دالة ارسم_مستطيل_ممتلئ(نافذة: عدد، س: عدد، ص: عدد، عرض: عدد، ارتفاع: عدد) {
    render_fill_rect(نافذة، س، ص، عرض، ارتفاع)
}

/// رسم دائرة فارغة (إطار فقط)
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س_مركز - الموضع الأفقي للمركز
/// @معامل ص_مركز - الموضع الرأسي للمركز
/// @معامل نصف_قطر - نصف قطر الدائرة
صدّر دالة ارسم_دائرة(نافذة: عدد، س_مركز: عدد، ص_مركز: عدد، نصف_قطر: عدد) {
    render_circle(نافذة، س_مركز، ص_مركز، نصف_قطر)
}

/// رسم دائرة ممتلئة
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س_مركز - الموضع الأفقي للمركز
/// @معامل ص_مركز - الموضع الرأسي للمركز
/// @معامل نصف_قطر - نصف قطر الدائرة
صدّر دالة ارسم_دائرة_ممتلئة(نافذة: عدد، س_مركز: عدد، ص_مركز: عدد، نصف_قطر: عدد) {
    render_fill_circle(نافذة، س_مركز، ص_مركز، نصف_قطر)
}

/// رسم قطع ناقص (إهليج)
///
/// @معامل نافذة - مقبض النافذة
/// @معامل س_مركز - الموضع الأفقي للمركز
/// @معامل ص_مركز - الموضع الرأسي للمركز
/// @معامل نصف_محور_س - نصف المحور الأفقي
/// @معامل نصف_محور_ص - نصف المحور الرأسي
صدّر دالة ارسم_قطع_ناقص(نافذة: عدد، س_مركز: عدد، ص_مركز: عدد، نصف_محور_س: عدد، نصف_محور_ص: عدد) {
    render_ellipse(نافذة، س_مركز، ص_مركز، نصف_محور_س، نصف_محور_ص)
}

// ═══════════════════════════════════════════
// معالجة الأحداث
// ═══════════════════════════════════════════

/// استطلاع الأحداث (غير متوقف)
/// تحقق إذا يوجد حدث جديد
///
/// @أرجع صحيح إذا يوجد حدث، خطأ إذا لا توجد أحداث
صدّر دالة استطلع_حدث() -> منطقي {
    أرجع event_poll() == 1
}

/// انتظار حدث (متوقف)
/// ينتظر حتى يحدث حدث جديد
///
/// @أرجع صحيح دائماً (حدث متاح)
صدّر دالة انتظر_حدث() -> منطقي {
    أرجع event_wait() == 1
}

/// الحصول على نوع الحدث الحالي
///
/// @أرجع نوع الحدث كعدد:
///   ٠ = لا شيء
///   ١ = إغلاق (طلب إغلاق النافذة)
///   ٢ = ضغط مفتاح
///   ٣ = رفع مفتاح
///   ٤ = حركة الفأرة
///   ٥ = ضغط زر الفأرة
///   ٦ = رفع زر الفأرة
///   ٧ = تغيير حجم النافذة
///   ٨ = تمرير عجلة الفأرة
صدّر دالة نوع_الحدث() -> عدد {
    أرجع event_type()
}

/// الحصول على رمز المفتاح المضغوط
///
/// @أرجع رمز المفتاح
صدّر دالة مفتاح_الحدث() -> عدد {
    أرجع event_key()
}

/// الحصول على موضع الفأرة الأفقي من الحدث
///
/// @أرجع الموضع الأفقي للفأرة
صدّر دالة فأرة_س() -> عدد {
    أرجع event_mouse_x()
}

/// الحصول على موضع الفأرة الرأسي من الحدث
///
/// @أرجع الموضع الرأسي للفأرة
صدّر دالة فأرة_ص() -> عدد {
    أرجع event_mouse_y()
}

/// الحصول على زر الفأرة من الحدث
///
/// @أرجع رقم الزر: ١=يسار، ٢=وسط، ٣=يمين
صدّر دالة زر_الفأرة() -> عدد {
    أرجع event_mouse_button()
}

/// التحقق إذا كان الحدث الحالي هو طلب إغلاق
///
/// @أرجع صحيح إذا كان حدث إغلاق
صدّر دالة حدث_إغلاق() -> منطقي {
    أرجع نوع_الحدث() == 1
}

/// التحقق إذا كان الحدث الحالي هو ضغط مفتاح
///
/// @أرجع صحيح إذا كان حدث ضغط مفتاح
صدّر دالة حدث_ضغط_مفتاح() -> منطقي {
    أرجع نوع_الحدث() == 2
}

/// التحقق إذا كان الحدث الحالي هو حركة فأرة
///
/// @أرجع صحيح إذا كان حدث حركة فأرة
صدّر دالة حدث_حركة_فأرة() -> منطقي {
    أرجع نوع_الحدث() == 4
}

/// التحقق إذا كان الحدث الحالي هو ضغط زر فأرة
///
/// @أرجع صحيح إذا كان حدث ضغط زر فأرة
صدّر دالة حدث_ضغط_فأرة() -> منطقي {
    أرجع نوع_الحدث() == 5
}

// ═══════════════════════════════════════════
// حالة لوحة المفاتيح والفأرة
// ═══════════════════════════════════════════

/// التحقق إذا كان مفتاح معين مضغوطاً حالياً
///
/// @معامل رمز_المفتاح - رمز المفتاح
/// @أرجع صحيح إذا كان المفتاح مضغوطاً
صدّر دالة مفتاح_مضغوط(رمز_المفتاح: عدد) -> منطقي {
    أرجع key_pressed(رمز_المفتاح) == 1
}

/// الحصول على موضع الفأرة الحالي الأفقي
///
/// @أرجع الموضع الأفقي الحالي للفأرة
صدّر دالة موضع_فأرة_س() -> عدد {
    أرجع mouse_x()
}

/// الحصول على موضع الفأرة الحالي الرأسي
///
/// @أرجع الموضع الرأسي الحالي للفأرة
صدّر دالة موضع_فأرة_ص() -> عدد {
    أرجع mouse_y()
}

/// التحقق إذا كان زر الفأرة مضغوطاً
///
/// @معامل زر - رقم الزر: ١=يسار، ٢=وسط، ٣=يمين
/// @أرجع صحيح إذا كان الزر مضغوطاً
صدّر دالة زر_فأرة_مضغوط(زر: عدد) -> منطقي {
    أرجع mouse_button_pressed(زر) == 1
}

// ═══════════════════════════════════════════
// التوقيت
// ═══════════════════════════════════════════

/// تأخير التنفيذ لفترة محددة
///
/// @معامل مللي_ثانية - مدة التأخير بالمللي ثانية
صدّر دالة تأخير(مللي_ثانية: عدد) {
    delay(مللي_ثانية)
}

/// الحصول على الوقت المنقضي منذ بداية البرنامج
///
/// @أرجع الوقت بالمللي ثانية
صدّر دالة وقت_التشغيل() -> عدد {
    أرجع get_ticks()
}

