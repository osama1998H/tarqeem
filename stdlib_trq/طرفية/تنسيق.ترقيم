/// وحدة تنسيق الإخراج للطرفية
///
/// توفر هذه الوحدة أدوات لتنسيق الإخراج بما في ذلك:
/// - رسم الجداول والصناديق
/// - أشرطة التقدم والمؤشرات
/// - محاذاة النصوص
/// - تنسيق القوائم
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// أحرف رسم المربعات
// ═══════════════════════════════════════════

/// زاوية علوية يسرى
صدّر ثابت زاوية_علوية_يسار: نص = "┌"

/// زاوية علوية يمنى
صدّر ثابت زاوية_علوية_يمين: نص = "┐"

/// زاوية سفلية يسرى
صدّر ثابت زاوية_سفلية_يسار: نص = "└"

/// زاوية سفلية يمنى
صدّر ثابت زاوية_سفلية_يمين: نص = "┘"

/// خط أفقي
صدّر ثابت خط_افقي_حرف: نص = "─"

/// خط عمودي
صدّر ثابت خط_عمودي: نص = "│"

/// تقاطع علوي
صدّر ثابت تقاطع_علوي: نص = "┬"

/// تقاطع سفلي
صدّر ثابت تقاطع_سفلي: نص = "┴"

/// تقاطع يساري
صدّر ثابت تقاطع_يسار: نص = "├"

/// تقاطع يميني
صدّر ثابت تقاطع_يمين: نص = "┤"

/// تقاطع كامل
صدّر ثابت تقاطع_كامل: نص = "┼"

// ═══════════════════════════════════════════
// أحرف المربعات بخط مزدوج
// ═══════════════════════════════════════════

/// زاوية علوية يسرى بخط مزدوج
صدّر ثابت زاوية_علوية_يسار_مزدوج: نص = "╔"

/// زاوية علوية يمنى بخط مزدوج
صدّر ثابت زاوية_علوية_يمين_مزدوج: نص = "╗"

/// زاوية سفلية يسرى بخط مزدوج
صدّر ثابت زاوية_سفلية_يسار_مزدوج: نص = "╚"

/// زاوية سفلية يمنى بخط مزدوج
صدّر ثابت زاوية_سفلية_يمين_مزدوج: نص = "╝"

/// خط أفقي مزدوج
صدّر ثابت خط_افقي_مزدوج: نص = "═"

/// خط عمودي مزدوج
صدّر ثابت خط_عمودي_مزدوج: نص = "║"

// ═══════════════════════════════════════════
// مؤشرات التقدم
// ═══════════════════════════════════════════

/// أنشئ شريط تقدم
///
/// @معامل حالي - القيمة الحالية
/// @معامل اجمالي - القيمة الإجمالية
/// @معامل عرض - عرض الشريط بالأحرف
/// @أرجع نص شريط التقدم
/// @مثال
/// اطبع_سطر(شريط_تقدم(50، 100، 20))
صدّر دالة شريط_تقدم(حالي: عدد، اجمالي: عدد، عرض: عدد) -> نص {
    متغير نسبة = حالي / اجمالي
    متغير مملوء = __تقريب__(نسبة * عرض)
    متغير فارغ = عرض - مملوء

    متغير شريط = "["
    لكل (متغير ع = 0؛ ع < مملوء؛ ع++) {
        شريط = شريط + "█"
    }
    لكل (متغير ع = 0؛ ع < فارغ؛ ع++) {
        شريط = شريط + "░"
    }
    شريط = شريط + "] " + __الى_نص__(__تقريب__(نسبة * 100)) + "%"

    أرجع شريط
}

/// اطبع شريط تقدم مع تحديث في نفس السطر
///
/// @معامل حالي - القيمة الحالية
/// @معامل اجمالي - القيمة الإجمالية
/// @معامل عرض - عرض الشريط بالأحرف
/// @مثال
/// لكل (متغير ع = 0؛ ع <= 100؛ ع++) {
///     اطبع_تقدم(ع، 100، 30)
///     انتظر(50)
/// }
صدّر دالة اطبع_تقدم(حالي: عدد، اجمالي: عدد، عرض: عدد) {
    __اطبع__("\r" + شريط_تقدم(حالي، اجمالي، عرض))
}

/// أحرف الدوران للمؤشر الدوار
صدّر ثابت دوران: مصفوفة<نص> = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

/// احصل على إطار الدوران حسب الفهرس
///
/// @معامل فهرس - رقم الإطار
/// @أرجع حرف الدوران
/// @مثال
/// لكل (متغير ع = 0؛ ع < 30؛ ع++) {
///     اطبع("\r" + اطار_دوران(ع) + " جاري التحميل...")
///     انتظر(100)
/// }
صدّر دالة اطار_دوران(فهرس: عدد) -> نص {
    أرجع دوران[فهرس % 10]
}

// ═══════════════════════════════════════════
// محاذاة النص
// ═══════════════════════════════════════════

/// حاذِ النص لليسار بعرض محدد
///
/// @معامل نص - النص المراد محاذاته
/// @معامل عرض - العرض المطلوب
/// @أرجع النص المحاذى
/// @مثال
/// اطبع_سطر("[" + حاذِ_يسار("اسم"، 20) + "]")
صدّر دالة حاذِ_يسار(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات = ""
    لكل (متغير ع = 0؛ ع < عرض - طول؛ ع++) {
        فراغات = فراغات + " "
    }
    أرجع نص + فراغات
}

/// حاذِ النص لليمين بعرض محدد
///
/// @معامل نص - النص المراد محاذاته
/// @معامل عرض - العرض المطلوب
/// @أرجع النص المحاذى
/// @مثال
/// اطبع_سطر("[" + حاذِ_يمين("123"، 10) + "]")
صدّر دالة حاذِ_يمين(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات = ""
    لكل (متغير ع = 0؛ ع < عرض - طول؛ ع++) {
        فراغات = فراغات + " "
    }
    أرجع فراغات + نص
}

/// وسّط النص بعرض محدد
///
/// @معامل نص - النص المراد توسيطه
/// @معامل عرض - العرض المطلوب
/// @أرجع النص الموسط
/// @مثال
/// اطبع_سطر("[" + وسّط("عنوان"، 30) + "]")
صدّر دالة وسّط(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات_كلي = عرض - طول
    متغير فراغات_يسار = فراغات_كلي / 2
    متغير فراغات_يمين = فراغات_كلي - فراغات_يسار

    متغير يسار = ""
    لكل (متغير ع = 0؛ ع < فراغات_يسار؛ ع++) {
        يسار = يسار + " "
    }

    متغير يمين = ""
    لكل (متغير ع = 0؛ ع < فراغات_يمين؛ ع++) {
        يمين = يمين + " "
    }

    أرجع يسار + نص + يمين
}

// ═══════════════════════════════════════════
// رسم الصناديق
// ═══════════════════════════════════════════

/// ارسم صندوق حول نص
///
/// @معامل نص - النص داخل الصندوق
/// @معامل عرض - عرض الصندوق الكلي
/// @أرجع نص الصندوق متعدد الأسطر
/// @مثال
/// اطبع_سطر(صندوق("مرحباً بالعالم!"، 30))
صدّر دالة صندوق(نص: نص، عرض: عدد) -> نص {
    متغير عرض_داخلي = عرض - 2

    متغير علوي = زاوية_علوية_يسار
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        علوي = علوي + خط_افقي_حرف
    }
    علوي = علوي + زاوية_علوية_يمين + "\n"

    متغير محتوى = خط_عمودي + وسّط(نص، عرض_داخلي) + خط_عمودي + "\n"

    متغير سفلي = زاوية_سفلية_يسار
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        سفلي = سفلي + خط_افقي_حرف
    }
    سفلي = سفلي + زاوية_سفلية_يمين

    أرجع علوي + محتوى + سفلي
}

/// ارسم صندوق بخط مزدوج حول نص
///
/// @معامل نص - النص داخل الصندوق
/// @معامل عرض - عرض الصندوق الكلي
/// @أرجع نص الصندوق متعدد الأسطر
/// @مثال
/// اطبع_سطر(صندوق_مزدوج("عنوان مهم"، 40))
صدّر دالة صندوق_مزدوج(نص: نص، عرض: عدد) -> نص {
    متغير عرض_داخلي = عرض - 2

    متغير علوي = زاوية_علوية_يسار_مزدوج
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        علوي = علوي + خط_افقي_مزدوج
    }
    علوي = علوي + زاوية_علوية_يمين_مزدوج + "\n"

    متغير محتوى = خط_عمودي_مزدوج + وسّط(نص، عرض_داخلي) + خط_عمودي_مزدوج + "\n"

    متغير سفلي = زاوية_سفلية_يسار_مزدوج
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        سفلي = سفلي + خط_افقي_مزدوج
    }
    سفلي = سفلي + زاوية_سفلية_يمين_مزدوج

    أرجع علوي + محتوى + سفلي
}

// ═══════════════════════════════════════════
// تنسيق القوائم
// ═══════════════════════════════════════════

/// نسّق كقائمة منقطة
///
/// @معامل عناصر - مصفوفة العناصر
/// @أرجع نص القائمة المنسقة
/// @مثال
/// اطبع(قائمة_نقاط(["عنصر أول"، "عنصر ثاني"، "عنصر ثالث"]))
صدّر دالة قائمة_نقاط(عناصر: مصفوفة<نص>) -> نص {
    متغير نتيجة = ""
    لكل عنصر في عناصر {
        نتيجة = نتيجة + "• " + عنصر + "\n"
    }
    أرجع نتيجة
}

/// نسّق كقائمة مرقمة
///
/// @معامل عناصر - مصفوفة العناصر
/// @أرجع نص القائمة المنسقة
/// @مثال
/// اطبع(قائمة_ارقام(["الخطوة الأولى"، "الخطوة الثانية"]))
صدّر دالة قائمة_ارقام(عناصر: مصفوفة<نص>) -> نص {
    متغير نتيجة = ""
    متغير رقم = 1
    لكل عنصر في عناصر {
        نتيجة = نتيجة + __الى_نص__(رقم) + ". " + عنصر + "\n"
        رقم = رقم + 1
    }
    أرجع نتيجة
}

/// نسّق كقائمة مرقمة بالأرقام العربية
///
/// @معامل عناصر - مصفوفة العناصر
/// @أرجع نص القائمة المنسقة بأرقام عربية
/// @مثال
/// اطبع(قائمة_ارقام_عربية(["أول"، "ثاني"، "ثالث"]))
صدّر دالة قائمة_ارقام_عربية(عناصر: مصفوفة<نص>) -> نص {
    ثابت ارقام_عربية: مصفوفة<نص> = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"]

    متغير نتيجة = ""
    متغير رقم = 1
    لكل عنصر في عناصر {
        متغير رقم_عربي = ""
        متغير ر = رقم
        إذا (ر == 0) {
            رقم_عربي = "٠"
        } وإلا {
            طالما (ر > 0) {
                رقم_عربي = ارقام_عربية[ر % 10] + رقم_عربي
                ر = ر / 10
            }
        }
        نتيجة = نتيجة + رقم_عربي + ". " + عنصر + "\n"
        رقم = رقم + 1
    }
    أرجع نتيجة
}

