// Simple progress bar function
// دالة شريط تقدم بسيطة
صدّر دالة شريط_تقدم(حالي: عدد، اجمالي: عدد، عرض: عدد) -> نص {
    متغير نسبة = حالي / اجمالي
    متغير مملوء = __تقريب__(نسبة * عرض)
    متغير فارغ = عرض - مملوء

    متغير شريط = "["
    لكل (متغير ع = 0؛ ع < مملوء؛ ع++) {
        شريط = شريط + "█"
    }
    لكل (متغير ع = 0؛ ع < فارغ؛ ع++) {
        شريط = شريط + "░"
    }
    شريط = شريط + "] " + __الى_نص__(__تقريب__(نسبة * 100)) + "%"

    أرجع شريط
}

// Print progress bar with update
// اطبع شريط تقدم مع تحديث
صدّر دالة اطبع_تقدم(حالي: عدد، اجمالي: عدد، عرض: عدد) {
    __اطبع__("\r" + شريط_تقدم(حالي، اجمالي، عرض))
}

// Spinner characters
// أحرف الدوران
صدّر ثابت دوران: مصفوفة<نص> = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

// Get spinner frame
// احصل على إطار الدوران
صدّر دالة اطار_دوران(فهرس: عدد) -> نص {
    أرجع دوران[فهرس % 10]
}

// =============================================================================
// Text Alignment / محاذاة النص
// =============================================================================

// Pad text to width (left-aligned)
// حشو النص للعرض (محاذاة يسار)
صدّر دالة حاذِ_يسار(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات = ""
    لكل (متغير ع = 0؛ ع < عرض - طول؛ ع++) {
        فراغات = فراغات + " "
    }
    أرجع نص + فراغات
}

// Pad text to width (right-aligned)
// حشو النص للعرض (محاذاة يمين)
صدّر دالة حاذِ_يمين(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات = ""
    لكل (متغير ع = 0؛ ع < عرض - طول؛ ع++) {
        فراغات = فراغات + " "
    }
    أرجع فراغات + نص
}

// Pad text to width (center-aligned)
// حشو النص للعرض (محاذاة وسط)
صدّر دالة وسّط(نص: نص، عرض: عدد) -> نص {
    متغير طول = __طول__(نص)
    إذا (طول >= عرض) {
        أرجع نص
    }

    متغير فراغات_كلي = عرض - طول
    متغير فراغات_يسار = فراغات_كلي / 2
    متغير فراغات_يمين = فراغات_كلي - فراغات_يسار

    متغير يسار = ""
    لكل (متغير ع = 0؛ ع < فراغات_يسار؛ ع++) {
        يسار = يسار + " "
    }

    متغير يمين = ""
    لكل (متغير ع = 0؛ ع < فراغات_يمين؛ ع++) {
        يمين = يمين + " "
    }

    أرجع يسار + نص + يمين
}

// =============================================================================
// Box Drawing / رسم الصناديق
// =============================================================================

// Draw a box around text
// ارسم صندوق حول نص
صدّر دالة صندوق(نص: نص، عرض: عدد) -> نص {
    متغير عرض_داخلي = عرض - 2

    // Top border
    متغير علوي = زاوية_علوية_يسار
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        علوي = علوي + خط_افقي_حرف
    }
    علوي = علوي + زاوية_علوية_يمين + "\n"

    // Content
    متغير محتوى = خط_عمودي + وسّط(نص، عرض_داخلي) + خط_عمودي + "\n"

    // Bottom border
    متغير سفلي = زاوية_سفلية_يسار
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        سفلي = سفلي + خط_افقي_حرف
    }
    سفلي = سفلي + زاوية_سفلية_يمين

    أرجع علوي + محتوى + سفلي
}

// Draw a double-line box around text
// ارسم صندوق بخط مزدوج حول نص
صدّر دالة صندوق_مزدوج(نص: نص، عرض: عدد) -> نص {
    متغير عرض_داخلي = عرض - 2

    // Top border
    متغير علوي = زاوية_علوية_يسار_مزدوج
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        علوي = علوي + خط_افقي_مزدوج
    }
    علوي = علوي + زاوية_علوية_يمين_مزدوج + "\n"

    // Content
    متغير محتوى = خط_عمودي_مزدوج + وسّط(نص، عرض_داخلي) + خط_عمودي_مزدوج + "\n"

    // Bottom border
    متغير سفلي = زاوية_سفلية_يسار_مزدوج
    لكل (متغير ع = 0؛ ع < عرض_داخلي؛ ع++) {
        سفلي = سفلي + خط_افقي_مزدوج
    }
    سفلي = سفلي + زاوية_سفلية_يمين_مزدوج

    أرجع علوي + محتوى + سفلي
}

// =============================================================================
// List Formatting / تنسيق القوائم
// =============================================================================

// Format as bulleted list
// نسّق كقائمة منقطة
صدّر دالة قائمة_نقاط(عناصر: مصفوفة<نص>) -> نص {
    متغير نتيجة = ""
    لكل عنصر في عناصر {
        نتيجة = نتيجة + "• " + عنصر + "\n"
    }
    أرجع نتيجة
}

// Format as numbered list
// نسّق كقائمة مرقمة
صدّر دالة قائمة_ارقام(عناصر: مصفوفة<نص>) -> نص {
    متغير نتيجة = ""
    متغير رقم = 1
    لكل عنصر في عناصر {
        نتيجة = نتيجة + __الى_نص__(رقم) + ". " + عنصر + "\n"
        رقم = رقم + 1
    }
    أرجع نتيجة
}

// Format as Arabic numbered list
// نسّق كقائمة مرقمة بالعربية
صدّر دالة قائمة_ارقام_عربية(عناصر: مصفوفة<نص>) -> نص {
    ثابت ارقام_عربية: مصفوفة<نص> = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"]

    متغير نتيجة = ""
    متغير رقم = 1
    لكل عنصر في عناصر {
        // Convert to Arabic numeral
        متغير رقم_عربي = ""
        متغير ر = رقم
        إذا (ر == 0) {
            رقم_عربي = "٠"
        } وإلا {
            طالما (ر > 0) {
                رقم_عربي = ارقام_عربية[ر % 10] + رقم_عربي
                ر = ر / 10
            }
        }
        نتيجة = نتيجة + رقم_عربي + ". " + عنصر + "\n"
        رقم = رقم + 1
    }
    أرجع نتيجة
}

