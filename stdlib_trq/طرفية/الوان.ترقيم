/// وحدة الإخراج الملون للطرفية
///
/// توفر هذه الوحدة ثوابت الألوان ودوال تلوين النصوص
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// ثابت إعادة الضبط
// ═══════════════════════════════════════════

/// إعادة ضبط الألوان والأنماط
صدّر ثابت اعادة: نص = "\x1b[0m"

// ═══════════════════════════════════════════
// الألوان العادية
// ═══════════════════════════════════════════

/// لون أسود
صدّر ثابت اسود: نص = "\x1b[30m"

/// لون أحمر
صدّر ثابت احمر: نص = "\x1b[31m"

/// لون أخضر
صدّر ثابت اخضر: نص = "\x1b[32m"

/// لون أصفر
صدّر ثابت اصفر: نص = "\x1b[33m"

/// لون أزرق
صدّر ثابت ازرق: نص = "\x1b[34m"

/// لون بنفسجي
صدّر ثابت بنفسجي: نص = "\x1b[35m"

/// لون سماوي
صدّر ثابت سماوي: نص = "\x1b[36m"

/// لون أبيض
صدّر ثابت ابيض: نص = "\x1b[37m"

// ═══════════════════════════════════════════
// الألوان الساطعة
// ═══════════════════════════════════════════

/// لون أسود ساطع
صدّر ثابت اسود_ساطع: نص = "\x1b[90m"

/// لون أحمر ساطع
صدّر ثابت احمر_ساطع: نص = "\x1b[91m"

/// لون أخضر ساطع
صدّر ثابت اخضر_ساطع: نص = "\x1b[92m"

/// لون أصفر ساطع
صدّر ثابت اصفر_ساطع: نص = "\x1b[93m"

/// لون أزرق ساطع
صدّر ثابت ازرق_ساطع: نص = "\x1b[94m"

/// لون بنفسجي ساطع
صدّر ثابت بنفسجي_ساطع: نص = "\x1b[95m"

/// لون سماوي ساطع
صدّر ثابت سماوي_ساطع: نص = "\x1b[96m"

/// لون أبيض ساطع
صدّر ثابت ابيض_ساطع: نص = "\x1b[97m"

// ═══════════════════════════════════════════
// ألوان الخلفية
// ═══════════════════════════════════════════

/// خلفية سوداء
صدّر ثابت خلفية_اسود: نص = "\x1b[40m"

/// خلفية حمراء
صدّر ثابت خلفية_احمر: نص = "\x1b[41m"

/// خلفية خضراء
صدّر ثابت خلفية_اخضر: نص = "\x1b[42m"

/// خلفية صفراء
صدّر ثابت خلفية_اصفر: نص = "\x1b[43m"

/// خلفية زرقاء
صدّر ثابت خلفية_ازرق: نص = "\x1b[44m"

/// خلفية بنفسجية
صدّر ثابت خلفية_بنفسجي: نص = "\x1b[45m"

/// خلفية سماوية
صدّر ثابت خلفية_سماوي: نص = "\x1b[46m"

/// خلفية بيضاء
صدّر ثابت خلفية_ابيض: نص = "\x1b[47m"

// ═══════════════════════════════════════════
// أنماط النص
// ═══════════════════════════════════════════

/// نمط عريض
صدّر ثابت عريض: نص = "\x1b[1m"

/// نمط باهت
صدّر ثابت باهت: نص = "\x1b[2m"

/// نمط مائل
صدّر ثابت مائل: نص = "\x1b[3m"

/// نمط تحته خط
صدّر ثابت تحته_خط: نص = "\x1b[4m"

/// نمط وامض
صدّر ثابت وامض: نص = "\x1b[5m"

/// نمط معكوس
صدّر ثابت معكوس: نص = "\x1b[7m"

/// نمط مخفي
صدّر ثابت مخفي: نص = "\x1b[8m"

/// نمط مشطوب
صدّر ثابت مشطوب: نص = "\x1b[9m"

// ═══════════════════════════════════════════
// دوال تطبيق الألوان والأنماط
// ═══════════════════════════════════════════

/// طبّق لون على نص
///
/// @معامل نص - النص المراد تلوينه
/// @معامل لون - رمز اللون
/// @أرجع النص الملون
/// @مثال
/// متغير نص_احمر = لوّن("تحذير!"، احمر)
صدّر دالة لوّن(نص: نص، لون: نص) -> نص {
    أرجع لون + نص + اعادة
}

/// طبّق نمط على نص
///
/// @معامل نص - النص المراد تنميطه
/// @معامل نمط - رمز النمط
/// @أرجع النص المنمط
/// @مثال
/// متغير نص_عريض = نمّط("مهم!"، عريض)
صدّر دالة نمّط(نص: نص، نمط: نص) -> نص {
    أرجع نمط + نص + اعادة
}

/// طبّق لون ونمط على نص
///
/// @معامل نص - النص المراد تنسيقه
/// @معامل لون - رمز اللون
/// @معامل نمط - رمز النمط
/// @أرجع النص المنسق
/// @مثال
/// متغير نص_منسق = لوّن_نمّط("مهم جداً!"، احمر، عريض)
صدّر دالة لوّن_نمّط(نص: نص، لون: نص، نمط: نص) -> نص {
    أرجع لون + نمط + نص + اعادة
}

// ═══════════════════════════════════════════
// دوال مريحة للألوان
// ═══════════════════════════════════════════

/// أرجع نص بلون أحمر
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون أحمر
/// @مثال
/// اطبع_سطر(احمر_نص("خطأ!"))
صدّر دالة احمر_نص(نص: نص) -> نص {
    أرجع لوّن(نص، احمر)
}

/// أرجع نص بلون أخضر
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون أخضر
/// @مثال
/// اطبع_سطر(اخضر_نص("نجاح!"))
صدّر دالة اخضر_نص(نص: نص) -> نص {
    أرجع لوّن(نص، اخضر)
}

/// أرجع نص بلون أصفر
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون أصفر
/// @مثال
/// اطبع_سطر(اصفر_نص("تحذير!"))
صدّر دالة اصفر_نص(نص: نص) -> نص {
    أرجع لوّن(نص، اصفر)
}

/// أرجع نص بلون أزرق
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون أزرق
/// @مثال
/// اطبع_سطر(ازرق_نص("معلومة"))
صدّر دالة ازرق_نص(نص: نص) -> نص {
    أرجع لوّن(نص، ازرق)
}

/// أرجع نص بلون سماوي
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون سماوي
/// @مثال
/// اطبع_سطر(سماوي_نص("رابط"))
صدّر دالة سماوي_نص(نص: نص) -> نص {
    أرجع لوّن(نص، سماوي)
}

/// أرجع نص بلون بنفسجي
///
/// @معامل نص - النص المراد تلوينه
/// @أرجع النص بلون بنفسجي
/// @مثال
/// اطبع_سطر(بنفسجي_نص("مميز"))
صدّر دالة بنفسجي_نص(نص: نص) -> نص {
    أرجع لوّن(نص، بنفسجي)
}

/// أرجع نص عريض
///
/// @معامل نص - النص المراد تعريضه
/// @أرجع النص العريض
/// @مثال
/// اطبع_سطر(عريض_نص("عنوان"))
صدّر دالة عريض_نص(نص: نص) -> نص {
    أرجع نمّط(نص، عريض)
}

/// أرجع نص مائل
///
/// @معامل نص - النص المراد إمالته
/// @أرجع النص المائل
/// @مثال
/// اطبع_سطر(مائل_نص("ملاحظة"))
صدّر دالة مائل_نص(نص: نص) -> نص {
    أرجع نمّط(نص، مائل)
}

/// أرجع نص تحته خط
///
/// @معامل نص - النص المراد تسطيره
/// @أرجع النص المسطر
/// @مثال
/// اطبع_سطر(تحته_خط_نص("رابط"))
صدّر دالة تحته_خط_نص(نص: نص) -> نص {
    أرجع نمّط(نص، تحته_خط)
}

// ═══════════════════════════════════════════
// دوال الطباعة الملونة
// ═══════════════════════════════════════════

/// اطبع رسالة نجاح باللون الأخضر
///
/// @معامل رسالة - رسالة النجاح
/// @مثال
/// نجاح("تم حفظ الملف بنجاح")
صدّر دالة نجاح(رسالة: نص) {
    طباعة_سطر(لوّن("✓ " + رسالة، اخضر))
}

/// اطبع رسالة فشل باللون الأحمر
///
/// @معامل رسالة - رسالة الفشل
/// @مثال
/// فشل("فشل في فتح الملف")
صدّر دالة فشل(رسالة: نص) {
    اطبع_خطأ(لوّن("✗ " + رسالة، احمر) + "\n")
}

/// اطبع رسالة تحذير باللون الأصفر
///
/// @معامل رسالة - رسالة التحذير
/// @مثال
/// تحذير_ملون("الملف قديم")
صدّر دالة تحذير_ملون(رسالة: نص) {
    طباعة_سطر(لوّن("⚠ " + رسالة، اصفر))
}

/// اطبع رسالة معلومات باللون الأزرق
///
/// @معامل رسالة - رسالة المعلومات
/// @مثال
/// معلومة_ملون("جاري التحميل...")
صدّر دالة معلومة_ملون(رسالة: نص) {
    طباعة_سطر(لوّن("ℹ " + رسالة، ازرق))
}

// ═══════════════════════════════════════════
// دعم ٢٥٦ لون
// ═══════════════════════════════════════════

/// احصل على لون المقدمة برقم (٠-٢٥٥)
///
/// @معامل رقم - رقم اللون من ٠ إلى ٢٥٥
/// @أرجع رمز اللون
/// @مثال
/// اطبع_سطر(لون_256(208) + "برتقالي" + اعادة)
صدّر دالة لون_256(رقم: عدد) -> نص {
    أرجع "\x1b[38;5;" + عدد_لنص(رقم) + "m"
}

/// احصل على لون الخلفية برقم (٠-٢٥٥)
///
/// @معامل رقم - رقم اللون من ٠ إلى ٢٥٥
/// @أرجع رمز لون الخلفية
/// @مثال
/// اطبع_سطر(خلفية_256(21) + "خلفية زرقاء" + اعادة)
صدّر دالة خلفية_256(رقم: عدد) -> نص {
    أرجع "\x1b[48;5;" + عدد_لنص(رقم) + "m"
}

// ═══════════════════════════════════════════
// دعم ألوان RGB
// ═══════════════════════════════════════════

/// احصل على لون مقدمة RGB
///
/// @معامل ر - قيمة الأحمر (٠-٢٥٥)
/// @معامل ز - قيمة الأخضر (٠-٢٥٥)
/// @معامل ق - قيمة الأزرق (٠-٢٥٥)
/// @أرجع رمز اللون
/// @مثال
/// اطبع_سطر(لون_RGB(255، 128، 0) + "برتقالي" + اعادة)
صدّر دالة لون_RGB(ر: عدد، ز: عدد، ق: عدد) -> نص {
    أرجع "\x1b[38;2;" + عدد_لنص(ر) + ";" + عدد_لنص(ز) + ";" + عدد_لنص(ق) + "m"
}

/// احصل على لون خلفية RGB
///
/// @معامل ر - قيمة الأحمر (٠-٢٥٥)
/// @معامل ز - قيمة الأخضر (٠-٢٥٥)
/// @معامل ق - قيمة الأزرق (٠-٢٥٥)
/// @أرجع رمز لون الخلفية
/// @مثال
/// اطبع_سطر(خلفية_RGB(0، 100، 200) + "خلفية زرقاء" + اعادة)
صدّر دالة خلفية_RGB(ر: عدد، ز: عدد، ق: عدد) -> نص {
    أرجع "\x1b[48;2;" + عدد_لنص(ر) + ";" + عدد_لنص(ز) + ";" + عدد_لنص(ق) + "m"
}

