// =============================================================================
// Print with Color / طباعة ملونة
// =============================================================================

// Print success message (green)
// اطبع رسالة نجاح (أخضر)
صدّر دالة نجاح(رسالة: نص) {
    __اطبع_سطر__(لوّن("✓ " + رسالة، اخضر))
}

// Print error message (red)
// اطبع رسالة خطأ (أحمر)
صدّر دالة فشل(رسالة: نص) {
    __اطبع_خطأ__(لوّن("✗ " + رسالة، احمر) + "\n")
}

// Print warning message (yellow)
// اطبع رسالة تحذير (أصفر)
صدّر دالة تحذير_ملون(رسالة: نص) {
    __اطبع_سطر__(لوّن("⚠ " + رسالة، اصفر))
}

// Print info message (blue)
// اطبع رسالة معلومات (أزرق)
صدّر دالة معلومة_ملون(رسالة: نص) {
    __اطبع_سطر__(لوّن("ℹ " + رسالة، ازرق))
}

// =============================================================================
// 256 Color Support / دعم 256 لون
// =============================================================================

// Get foreground color by number (0-255)
// احصل على لون المقدمة برقم (0-255)
صدّر دالة لون_256(رقم: عدد) -> نص {
    أرجع "\x1b[38;5;" + __الى_نص__(رقم) + "m"
}

// Get background color by number (0-255)
// احصل على لون الخلفية برقم (0-255)
صدّر دالة خلفية_256(رقم: عدد) -> نص {
    أرجع "\x1b[48;5;" + __الى_نص__(رقم) + "m"
}

// =============================================================================
// RGB Color Support / دعم ألوان RGB
// =============================================================================

// Get foreground RGB color
// احصل على لون مقدمة RGB
صدّر دالة لون_RGB(ر: عدد، ز: عدد، ق: عدد) -> نص {
    أرجع "\x1b[38;2;" + __الى_نص__(ر) + ";" + __الى_نص__(ز) + ";" + __الى_نص__(ق) + "m"
}

// Get background RGB color
// احصل على لون خلفية RGB
صدّر دالة خلفية_RGB(ر: عدد، ز: عدد، ق: عدد) -> نص {
    أرجع "\x1b[48;2;" + __الى_نص__(ر) + ";" + __الى_نص__(ز) + ";" + __الى_نص__(ق) + "m"
}

