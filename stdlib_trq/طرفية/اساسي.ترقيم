/// وحدة الإدخال والإخراج الأساسي
///
/// توفر هذه الوحدة دوال الإدخال والإخراج الأساسية للطرفية
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// دوال الإخراج
// ═══════════════════════════════════════════

/// اطبع نص بدون سطر جديد
///
/// @معامل نص - النص المراد طباعته
/// @مثال
/// اطبع("مرحباً ")
/// اطبع("بالعالم!")
صدّر دالة اطبع(نص: نص) {
    __اطبع__(نص)
}

/// اطبع نص مع سطر جديد
///
/// @معامل نص - النص المراد طباعته
/// @مثال
/// اطبع_سطر("مرحباً بالعالم!")
صدّر دالة اطبع_سطر(نص: نص) {
    __اطبع_سطر__(نص)
}

/// اطبع نص منسق مع محتفظات
///
/// @معامل قالب - قالب النص مع {} للاستبدال
/// @معامل قيمة - القيمة لاستبدالها في القالب
/// @مثال
/// اطبع_منسق("مرحباً {}"، "أحمد")
صدّر دالة اطبع_منسق(قالب: نص، قيمة: نص) {
    __اطبع_منسق__(قالب، قيمة)
}

/// اطبع سطر فارغ
///
/// @مثال
/// اطبع_سطر("سطر أول")
/// سطر_جديد()
/// اطبع_سطر("سطر ثاني")
صدّر دالة سطر_جديد() {
    اطبع_سطر("")
}

/// اطبع عدة سطور
///
/// @معامل سطور - مصفوفة النصوص للطباعة
/// @مثال
/// اطبع_سطور(["السطر الأول"، "السطر الثاني"، "السطر الثالث"])
صدّر دالة اطبع_سطور(سطور: مصفوفة<نص>) {
    لكل سطر في سطور {
        اطبع_سطر(سطر)
    }
}

/// اطبع عناصر مع فاصل
///
/// @معامل عناصر - مصفوفة العناصر للطباعة
/// @معامل فاصل - الفاصل بين العناصر
/// @مثال
/// اطبع_فاصل(["أحمد"، "محمد"، "علي"]، " - ")
صدّر دالة اطبع_فاصل(عناصر: مصفوفة<نص>، فاصل: نص) {
    متغير اول = صحيح
    لكل عنصر في عناصر {
        إذا (!اول) {
            اطبع(فاصل)
        }
        اطبع(عنصر)
        اول = خطأ
    }
    سطر_جديد()
}

// ═══════════════════════════════════════════
// دوال إخراج الأخطاء
// ═══════════════════════════════════════════

/// اطبع رسالة خطأ إلى مجرى الخطأ
///
/// @معامل رسالة - رسالة الخطأ
/// @مثال
/// خطأ("حدث خطأ في العملية")
صدّر دالة خطأ(رسالة: نص) {
    __اطبع_خطأ__(رسالة)
}

/// اطبع رسالة خطأ مع سطر جديد
///
/// @معامل رسالة - رسالة الخطأ
/// @مثال
/// خطأ_سطر("فشلت العملية")
صدّر دالة خطأ_سطر(رسالة: نص) {
    خطأ(رسالة + "\n")
}

/// اطبع رسالة تحذير
///
/// @معامل رسالة - رسالة التحذير
/// @مثال
/// تحذير("الملف غير موجود")
صدّر دالة تحذير(رسالة: نص) {
    خطأ_سطر("تحذير: " + رسالة)
}

/// اطبع رسالة معلومات
///
/// @معامل رسالة - رسالة المعلومات
/// @مثال
/// معلومة("جاري تحميل البيانات...")
صدّر دالة معلومة(رسالة: نص) {
    اطبع_سطر("معلومة: " + رسالة)
}

// ═══════════════════════════════════════════
// دوال الإدخال
// ═══════════════════════════════════════════

/// اقرأ سطر من مجرى الإدخال
///
/// @أرجع النص المُدخل
/// @مثال
/// متغير اسم = ادخل()
صدّر دالة ادخل() -> نص {
    أرجع __ادخل__()
}

/// اقرأ سطر مع رسالة موجهة
///
/// @معامل رسالة - الرسالة للعرض قبل الإدخال
/// @أرجع النص المُدخل
/// @مثال
/// متغير اسم = ادخل_رسالة("أدخل اسمك: ")
صدّر دالة ادخل_رسالة(رسالة: نص) -> نص {
    اطبع(رسالة)
    أرجع ادخل()
}

/// اقرأ عدد صحيح من مجرى الإدخال
///
/// @أرجع العدد المُدخل
/// @مثال
/// متغير عمر = ادخل_عدد()
صدّر دالة ادخل_عدد() -> عدد {
    أرجع __ادخل_عدد__()
}

/// اقرأ عدد صحيح مع رسالة موجهة
///
/// @معامل رسالة - الرسالة للعرض قبل الإدخال
/// @أرجع العدد المُدخل
/// @مثال
/// متغير عمر = ادخل_عدد_رسالة("أدخل عمرك: ")
صدّر دالة ادخل_عدد_رسالة(رسالة: نص) -> عدد {
    اطبع(رسالة)
    أرجع ادخل_عدد()
}

/// اقرأ عدد عشري من مجرى الإدخال
///
/// @أرجع العدد العشري المُدخل
/// @مثال
/// متغير سعر = ادخل_عشري()
صدّر دالة ادخل_عشري() -> عدد_عشري {
    أرجع __ادخل_عشري__()
}

/// اقرأ عدد عشري مع رسالة موجهة
///
/// @معامل رسالة - الرسالة للعرض قبل الإدخال
/// @أرجع العدد العشري المُدخل
/// @مثال
/// متغير سعر = ادخل_عشري_رسالة("أدخل السعر: ")
صدّر دالة ادخل_عشري_رسالة(رسالة: نص) -> عدد_عشري {
    اطبع(رسالة)
    أرجع ادخل_عشري()
}

/// اقرأ استجابة نعم/لا
///
/// @معامل رسالة - السؤال للعرض
/// @أرجع صحيح إذا كانت الاستجابة نعم
/// @مثال
/// إذا (ادخل_موافقة("هل تريد المتابعة؟")) {
///     اطبع_سطر("جاري المتابعة...")
/// }
صدّر دالة ادخل_موافقة(رسالة: نص) -> منطقي {
    اطبع(رسالة + " (نعم/لا): ")
    متغير استجابة = ادخل()
    أرجع استجابة == "نعم" || استجابة == "ن" || استجابة == "y" || استجابة == "yes"
}

// ═══════════════════════════════════════════
// دوال مساعدة
// ═══════════════════════════════════════════

/// امسح الشاشة
///
/// @مثال
/// امسح_شاشة()
/// اطبع_سطر("شاشة نظيفة!")
صدّر دالة امسح_شاشة() {
    اطبع("\x1b[2J\x1b[H")
}

/// انقل المؤشر إلى موضع محدد
///
/// @معامل سطر - رقم السطر (يبدأ من ١)
/// @معامل عمود - رقم العمود (يبدأ من ١)
/// @مثال
/// انقل_مؤشر(5، 10)
/// اطبع("هنا!")
صدّر دالة انقل_مؤشر(سطر: عدد، عمود: عدد) {
    اطبع("\x1b[" + __الى_نص__(سطر) + ";" + __الى_نص__(عمود) + "H")
}

/// أخفِ المؤشر
///
/// @مثال
/// اخفِ_مؤشر()
صدّر دالة اخفِ_مؤشر() {
    اطبع("\x1b[?25l")
}

/// أظهر المؤشر
///
/// @مثال
/// اظهر_مؤشر()
صدّر دالة اظهر_مؤشر() {
    اطبع("\x1b[?25h")
}

/// اطبع خط أفقي
///
/// @معامل عرض - عرض الخط بالأحرف
/// @مثال
/// خط_افقي(40)
صدّر دالة خط_افقي(عرض: عدد) {
    متغير خط = ""
    لكل (متغير ع = 0؛ ع < عرض؛ ع++) {
        خط = خط + "─"
    }
    اطبع_سطر(خط)
}

/// اطبع خط أفقي بحرف محدد
///
/// @معامل عرض - عرض الخط بالأحرف
/// @معامل حرف - الحرف المستخدم للرسم
/// @مثال
/// خط_افقي_حرف(40، "=")
صدّر دالة خط_افقي_حرف(عرض: عدد، حرف: نص) {
    متغير خط = ""
    لكل (متغير ع = 0؛ ع < عرض؛ ع++) {
        خط = خط + حرف
    }
    اطبع_سطر(خط)
}
