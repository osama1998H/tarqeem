// طرفية/اساسي - Basic Console I/O
// طرفية/اساسي - الإدخال والإخراج الأساسي

// =============================================================================
// Output Functions / دوال الإخراج
// =============================================================================

// Print text without newline
// اطبع نص بدون سطر جديد
صدّر دالة اطبع(نص: نص) {
    // Uses runtime: trq_print
    __اطبع__(نص)
}

// Print text with newline
// اطبع نص مع سطر جديد
صدّر دالة اطبع_سطر(نص: نص) {
    // Uses runtime: trq_println
    __اطبع_سطر__(نص)
}

// Print formatted text (with placeholders)
// اطبع نص منسق (مع محتفظات)
صدّر دالة اطبع_منسق(قالب: نص، قيمة: نص) {
    // Uses runtime: trq_printf
    __اطبع_منسق__(قالب، قيمة)
}

// Print empty line
// اطبع سطر فارغ
صدّر دالة سطر_جديد() {
    اطبع_سطر("")
}

// Print multiple lines
// اطبع عدة سطور
صدّر دالة اطبع_سطور(سطور: مصفوفة<نص>) {
    لكل سطر في سطور {
        اطبع_سطر(سطر)
    }
}

// Print with separator
// اطبع مع فاصل
صدّر دالة اطبع_فاصل(عناصر: مصفوفة<نص>، فاصل: نص) {
    متغير اول = صحيح
    لكل عنصر في عناصر {
        إذا (!اول) {
            اطبع(فاصل)
        }
        اطبع(عنصر)
        اول = خطأ
    }
    سطر_جديد()
}

// =============================================================================
// Error Output Functions / دوال إخراج الأخطاء
// =============================================================================

// Print error message to stderr
// اطبع رسالة خطأ إلى مجرى الخطأ
صدّر دالة خطأ(رسالة: نص) {
    // Uses runtime: trq_print_error
    __اطبع_خطأ__(رسالة)
}

// Print error message with newline
// اطبع رسالة خطأ مع سطر جديد
صدّر دالة خطأ_سطر(رسالة: نص) {
    خطأ(رسالة + "\n")
}

// Print warning message
// اطبع رسالة تحذير
صدّر دالة تحذير(رسالة: نص) {
    خطأ_سطر("تحذير: " + رسالة)
}

// Print info message
// اطبع رسالة معلومات
صدّر دالة معلومة(رسالة: نص) {
    اطبع_سطر("معلومة: " + رسالة)
}

// =============================================================================
// Input Functions / دوال الإدخال
// =============================================================================

// Read line from stdin
// اقرأ سطر من مجرى الإدخال
صدّر دالة ادخل() -> نص {
    // Uses runtime: trq_input
    أرجع __ادخل__()
}

// Read line with prompt
// اقرأ سطر مع رسالة
صدّر دالة ادخل_رسالة(رسالة: نص) -> نص {
    اطبع(رسالة)
    أرجع ادخل()
}

// Read integer from stdin
// اقرأ عدد صحيح من مجرى الإدخال
صدّر دالة ادخل_عدد() -> عدد {
    // Uses runtime: trq_input_int
    أرجع __ادخل_عدد__()
}

// Read integer with prompt
// اقرأ عدد صحيح مع رسالة
صدّر دالة ادخل_عدد_رسالة(رسالة: نص) -> عدد {
    اطبع(رسالة)
    أرجع ادخل_عدد()
}

// Read float from stdin
// اقرأ عدد عشري من مجرى الإدخال
صدّر دالة ادخل_عشري() -> عدد_عشري {
    // Uses runtime: trq_input_float
    أرجع __ادخل_عشري__()
}

// Read float with prompt
// اقرأ عدد عشري مع رسالة
صدّر دالة ادخل_عشري_رسالة(رسالة: نص) -> عدد_عشري {
    اطبع(رسالة)
    أرجع ادخل_عشري()
}

// Read yes/no response
// اقرأ استجابة نعم/لا
صدّر دالة ادخل_موافقة(رسالة: نص) -> منطقي {
    اطبع(رسالة + " (نعم/لا): ")
    متغير استجابة = ادخل()
    أرجع استجابة == "نعم" || استجابة == "ن" || استجابة == "y" || استجابة == "yes"
}

// =============================================================================
// Utility Functions / دوال مساعدة
// =============================================================================

// Clear screen (ANSI escape)
// امسح الشاشة
صدّر دالة امسح_شاشة() {
    اطبع("\x1b[2J\x1b[H")
}

// Move cursor to position
// انقل المؤشر إلى موضع
صدّر دالة انقل_مؤشر(سطر: عدد، عمود: عدد) {
    اطبع("\x1b[" + __الى_نص__(سطر) + ";" + __الى_نص__(عمود) + "H")
}

// Hide cursor
// أخفِ المؤشر
صدّر دالة اخفِ_مؤشر() {
    اطبع("\x1b[?25l")
}

// Show cursor
// أظهر المؤشر
صدّر دالة اظهر_مؤشر() {
    اطبع("\x1b[?25h")
}

// Print horizontal line
// اطبع خط أفقي
صدّر دالة خط_افقي(عرض: عدد) {
    متغير خط = ""
    لكل (متغير ع = 0؛ ع < عرض؛ ع++) {
        خط = خط + "─"
    }
    اطبع_سطر(خط)
}

// Print horizontal line with character
// اطبع خط أفقي بحرف
صدّر دالة خط_افقي_حرف(عرض: عدد، حرف: نص) {
    متغير خط = ""
    لكل (متغير ع = 0؛ ع < عرض؛ ع++) {
        خط = خط + حرف
    }
    اطبع_سطر(خط)
}

