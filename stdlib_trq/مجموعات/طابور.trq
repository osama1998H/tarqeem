// طابور - Queue Collection
// طابور - صنف الطابور (FIFO)
//
// First-In-First-Out queue
// طابور أول-داخل-أول-خارج

صدّر صنف طابور<ن> {
    خاص _عناصر: مصفوفة<ن>
    خاص _طول: عدد

    // Constructor - المنشئ
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ======================================
    // Basic operations - العمليات الأساسية
    // ======================================

    // Enqueue - add to back - ادخل عنصر في النهاية
    عام دالة ادخل(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    // Dequeue - remove from front - اخرج عنصر من البداية
    عام دالة اخرج() -> ن {
        إذا (هذا._طول == 0) {
            // Return undefined for empty queue
            // TODO: Handle with Option type when available
            أرجع هذا._عناصر[0]
        }

        متغير عنصر = هذا._عناصر[0]

        // Shift all elements
        متغير ع = 0
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }

        هذا._طول = هذا._طول - 1
        أرجع عنصر
    }

    // Peek - look at front without removing - انظر للأول بدون حذف
    عام دالة انظر() -> ن {
        أرجع هذا._عناصر[0]
    }

    // ======================================
    // Query - الاستعلام
    // ======================================

    // Get length - احصل على الطول
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    // Check if empty - تحقق من الفراغ
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    // Clear all elements - امسح جميع العناصر
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // Check if contains element - تحقق من احتواء عنصر
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // ======================================
    // Conversion - التحويل
    // ======================================

    // Convert to array - حوّل إلى مصفوفة
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    // Convert to list - حوّل إلى قائمة
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }
}
