/// ميثاق المتكرر
///
/// بروتوكول المتكرر لاجتياز المجموعات بشكل تسلسلي

صدّر ميثاق متكرر<ن> {
    /// احصل على العنصر التالي
    ///
    /// @أرجع العنصر التالي في التسلسل
    دالة التالي() -> ن

    /// تحقق من وجود عناصر أخرى
    ///
    /// @أرجع صحيح إذا كان هناك عناصر أخرى للاجتياز
    دالة يوجد_تالي() -> منطقي
}

/// ميثاق قابل للتكرار
///
/// يُلتزم به من الأصناف التي يمكن اجتيازها بمتكرر

صدّر ميثاق قابل_للتكرار<ن> {
    /// احصل على متكرر للاجتياز
    ///
    /// @أرجع متكرر جديد يبدأ من البداية
    دالة متكرر() -> متكرر<ن>
}

/// صنف متكرر المصفوفة
///
/// يتيح اجتياز المصفوفات بشكل تسلسلي
///
/// @مثال
/// متغير م = جديد متكرر_مصفوفة<عدد>([١، ٢، ٣])
/// طالما (م.يوجد_تالي()) {
///     اطبع(م.التالي())
/// }

صدّر صنف متكرر_مصفوفة<ن> يلتزم متكرر<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _فهرس: عدد;
    خاص _طول: عدد;

    /// إنشاء متكرر من مصفوفة
    ///
    /// @معامل عناصر - المصفوفة المراد اجتيازها
    منشئ(عناصر: مصفوفة<ن>) {
        هذا._عناصر = عناصر
        هذا._فهرس = 0
        هذا._طول = عناصر.طول
    }

    /// احصل على العنصر التالي
    ///
    /// @أرجع العنصر التالي وتقدم المؤشر
    عام دالة التالي() -> ن {
        متغير عنصر = هذا._عناصر[هذا._فهرس]
        هذا._فهرس = هذا._فهرس + 1
        أرجع عنصر
    }

    /// تحقق من وجود عناصر أخرى
    ///
    /// @أرجع صحيح إذا لم نصل لنهاية المصفوفة
    عام دالة يوجد_تالي() -> منطقي {
        أرجع هذا._فهرس < هذا._طول
    }
}

/// صنف متكرر النطاق للأعداد
///
/// يولد تسلسلاً من الأعداد من بداية إلى نهاية
///
/// @مثال
/// متغير م = جديد متكرر_نطاق(٠، ٥)
/// طالما (م.يوجد_تالي()) {
///     اطبع(م.التالي())  // ٠، ١، ٢، ٣، ٤
/// }

صدّر صنف متكرر_نطاق يلتزم متكرر<عدد> {
    خاص _حالي: عدد;
    خاص _نهاية: عدد;
    خاص _خطوة: عدد;

    /// إنشاء متكرر نطاق بخطوة ١
    ///
    /// @معامل بداية - قيمة البداية (شاملة)
    /// @معامل نهاية - قيمة النهاية (غير شاملة)
    منشئ(بداية: عدد، نهاية: عدد) {
        هذا._حالي = بداية
        هذا._نهاية = نهاية
        هذا._خطوة = 1
    }

    /// إنشاء متكرر نطاق بخطوة مخصصة
    ///
    /// @معامل بداية - قيمة البداية
    /// @معامل نهاية - قيمة النهاية
    /// @معامل خطوة - مقدار الزيادة في كل تكرار
    /// @أرجع متكرر نطاق جديد
    مشترك دالة بخطوة(بداية: عدد، نهاية: عدد، خطوة: عدد) -> متكرر_نطاق {
        متغير م = جديد متكرر_نطاق(بداية، نهاية)
        م._خطوة = خطوة
        أرجع م
    }

    /// احصل على العدد التالي في النطاق
    ///
    /// @أرجع العدد الحالي وتقدم بالخطوة
    عام دالة التالي() -> عدد {
        متغير قيمة = هذا._حالي
        هذا._حالي = هذا._حالي + هذا._خطوة
        أرجع قيمة
    }

    /// تحقق من وجود أعداد أخرى في النطاق
    ///
    /// @أرجع صحيح إذا لم نصل للنهاية
    عام دالة يوجد_تالي() -> منطقي {
        إذا (هذا._خطوة > 0) {
            أرجع هذا._حالي < هذا._نهاية
        }
        أرجع هذا._حالي > هذا._نهاية
    }
}

/// أنشئ نطاقاً من الأعداد
///
/// @معامل بداية - قيمة البداية (شاملة)
/// @معامل نهاية - قيمة النهاية (غير شاملة)
/// @أرجع متكرر نطاق جديد
/// @مثال
/// لكل ع في نطاق(٠، ١٠) {
///     اطبع(ع)
/// }

صدّر دالة نطاق(بداية: عدد، نهاية: عدد) -> متكرر_نطاق {
    أرجع جديد متكرر_نطاق(بداية، نهاية)
}

/// أنشئ نطاقاً من الأعداد بخطوة مخصصة
///
/// @معامل بداية - قيمة البداية
/// @معامل نهاية - قيمة النهاية
/// @معامل خطوة - مقدار الزيادة في كل تكرار
/// @أرجع متكرر نطاق جديد
/// @مثال
/// لكل ع في نطاق_بخطوة(٠، ١٠، ٢) {
///     اطبع(ع)  // ٠، ٢، ٤، ٦، ٨
/// }

صدّر دالة نطاق_بخطوة(بداية: عدد، نهاية: عدد، خطوة: عدد) -> متكرر_نطاق {
    أرجع متكرر_نطاق.بخطوة(بداية، نهاية، خطوة)
}

