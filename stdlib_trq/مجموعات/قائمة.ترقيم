/// صنف القائمة الديناميكية
///
/// قائمة ديناميكية معممة تدعم الوصول السريع للعناصر
/// والإضافة والحذف من أي موضع
///
/// @مثال
/// متغير ق = جديد قائمة<عدد>()
/// ق.أضف(١)
/// ق.أضف(٢)
/// اطبع(ق.طول())  // ٢

صدّر صنف قائمة<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    /// المنشئ - ينشئ قائمة فارغة جديدة
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // إضافة العناصر
    // ═══════════════════════════════════════════

    /// أضف عنصراً في نهاية القائمة
    ///
    /// @معامل عنصر - العنصر المراد إضافته
    /// @مثال
    /// متغير ق = جديد قائمة<نص>()
    /// ق.أضف("مرحباً")
    عام دالة أضف(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    /// أضف عنصراً في موضع محدد
    ///
    /// @معامل فهرس - موضع الإدراج (من ٠ إلى الطول)
    /// @معامل عنصر - العنصر المراد إضافته
    /// @ملاحظة إذا كان الفهرس خارج الحدود، لا يحدث شيء
    عام دالة أضف_في(فهرس: عدد، عنصر: ن) {
        إذا (فهرس < 0 || فهرس > هذا._طول) {
            أرجع
        }
        متغير ع = هذا._طول
        طالما (ع > فهرس) {
            هذا._عناصر[ع] = هذا._عناصر[ع - 1]
            ع = ع - 1
        }
        هذا._عناصر[فهرس] = عنصر
        هذا._طول = هذا._طول + 1
    }

    /// أضف جميع عناصر قائمة أخرى
    ///
    /// @معامل أخرى - القائمة المراد إضافة عناصرها
    /// @مثال
    /// متغير ق١ = جديد قائمة<عدد>()
    /// متغير ق٢ = جديد قائمة<عدد>()
    /// ق١.أضف(١)
    /// ق٢.أضف(٢)
    /// ق١.أضف_كل(ق٢)  // ق١ تحتوي الآن [١، ٢]
    عام دالة أضف_كل(أخرى: قائمة<ن>) {
        متغير ع = 0
        طالما (ع < أخرى.طول()) {
            هذا.أضف(أخرى.احصل(ع))
            ع = ع + 1
        }
    }

    // ═══════════════════════════════════════════
    // حذف العناصر
    // ═══════════════════════════════════════════

    /// احذف عنصراً من موضع محدد
    ///
    /// @معامل فهرس - موضع العنصر المراد حذفه
    /// @أرجع العنصر المحذوف
    /// @تحذير يجب أن يكون الفهرس ضمن الحدود الصالحة
    عام دالة احذف(فهرس: عدد) -> ن {
        إذا (فهرس < 0 || فهرس >= هذا._طول) {
            أرجع هذا._عناصر[0]
        }
        متغير عنصر = هذا._عناصر[فهرس]
        متغير ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع عنصر
    }

    /// احذف العنصر الأول من القائمة
    ///
    /// @أرجع العنصر الأول المحذوف
    عام دالة احذف_اول() -> ن {
        أرجع هذا.احذف(0)
    }

    /// احذف العنصر الأخير من القائمة
    ///
    /// @أرجع العنصر الأخير المحذوف
    عام دالة احذف_اخير() -> ن {
        أرجع هذا.احذف(هذا._طول - 1)
    }

    /// امسح جميع عناصر القائمة
    ///
    /// @مثال
    /// متغير ق = جديد قائمة<عدد>()
    /// ق.أضف(١)
    /// ق.امسح()
    /// اطبع(ق.فارغة())  // صحيح
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // الوصول للعناصر
    // ═══════════════════════════════════════════

    /// احصل على عنصر من موضع محدد
    ///
    /// @معامل فهرس - موضع العنصر (يبدأ من ٠)
    /// @أرجع العنصر في الموضع المحدد
    عام دالة احصل(فهرس: عدد) -> ن {
        أرجع هذا._عناصر[فهرس]
    }

    /// عيّن قيمة عنصر في موضع محدد
    ///
    /// @معامل فهرس - موضع العنصر
    /// @معامل قيمة - القيمة الجديدة
    عام دالة عيّن(فهرس: عدد، قيمة: ن) {
        هذا._عناصر[فهرس] = قيمة
    }

    /// احصل على العنصر الأول
    ///
    /// @أرجع العنصر الأول في القائمة
    /// @تحذير يجب أن تحتوي القائمة على عنصر واحد على الأقل
    عام دالة اول() -> ن {
        أرجع هذا._عناصر[0]
    }

    /// احصل على العنصر الأخير
    ///
    /// @أرجع العنصر الأخير في القائمة
    /// @تحذير يجب أن تحتوي القائمة على عنصر واحد على الأقل
    عام دالة اخير() -> ن {
        أرجع هذا._عناصر[هذا._طول - 1]
    }

    // ═══════════════════════════════════════════
    // البحث
    // ═══════════════════════════════════════════

    /// تحقق من احتواء القائمة على عنصر
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع صحيح إذا كان العنصر موجوداً، خطأ غير ذلك
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    /// ابحث عن فهرس أول ظهور لعنصر
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع فهرس العنصر أو -١ إذا لم يُوجد
    عام دالة فهرس(عنصر: ن) -> عدد {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع ع
            }
            ع = ع + 1
        }
        أرجع -1
    }

    /// ابحث عن فهرس آخر ظهور لعنصر
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع فهرس آخر ظهور أو -١ إذا لم يُوجد
    عام دالة فهرس_اخير(عنصر: ن) -> عدد {
        متغير ع = هذا._طول - 1
        طالما (ع >= 0) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع ع
            }
            ع = ع - 1
        }
        أرجع -1
    }

    // ═══════════════════════════════════════════
    // الخصائص
    // ═══════════════════════════════════════════

    /// احصل على عدد عناصر القائمة
    ///
    /// @أرجع عدد العناصر في القائمة
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    /// تحقق إذا كانت القائمة فارغة
    ///
    /// @أرجع صحيح إذا كانت فارغة، خطأ غير ذلك
    عام دالة فارغة() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ═══════════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════════

    /// حوّل القائمة إلى مصفوفة
    ///
    /// @أرجع مصفوفة تحتوي نفس العناصر
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    /// أنشئ نسخة من القائمة
    ///
    /// @أرجع قائمة جديدة تحتوي نفس العناصر
    عام دالة نسخة() -> قائمة<ن> {
        متغير جديدة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            جديدة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع جديدة
    }

    // ═══════════════════════════════════════════
    // الترتيب
    // ═══════════════════════════════════════════

    /// اعكس ترتيب عناصر القائمة
    ///
    /// @مثال
    /// متغير ق = جديد قائمة<عدد>()
    /// ق.أضف(١)
    /// ق.أضف(٢)
    /// ق.أضف(٣)
    /// ق.اعكس()  // [٣، ٢، ١]
    عام دالة اعكس() {
        متغير يسار = 0
        متغير يمين = هذا._طول - 1
        طالما (يسار < يمين) {
            متغير مؤقت = هذا._عناصر[يسار]
            هذا._عناصر[يسار] = هذا._عناصر[يمين]
            هذا._عناصر[يمين] = مؤقت
            يسار = يسار + 1
            يمين = يمين - 1
        }
    }
}
