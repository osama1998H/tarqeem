/// وحدة المجموعات
///
/// توفر هذه الوحدة أنواع المجموعات الأساسية للغة ترقيم:
///
/// - قائمة<ن>    : قائمة ديناميكية
/// - مجموعة<ن>   : مجموعة العناصر الفريدة
/// - خريطة<م، ق> : قاموس مفتاح-قيمة
/// - طابور<ن>    : طابور أول-داخل-أول-خارج
/// - مكدس<ن>     : مكدس آخر-داخل-أول-خارج
/// - زوج<أ، ب>   : زوج مفتاح-قيمة
/// - متكرر<ن>    : واجهة المتكرر
///
/// @ملاحظة نستخدم خريطة بدلاً من قاموس لأن قاموس كلمة محجوزة للنوع

استورد { قائمة } من "./قائمة"
استورد { مجموعة } من "./مجموعة"
استورد { خريطة، زوج } من "./قاموس"
استورد { طابور } من "./طابور"
استورد { مكدس } من "./مكدس"
استورد { متكرر، قابل_للتكرار } من "./متكرر"

صدّر { قائمة، مجموعة، خريطة، زوج، طابور، مكدس، متكرر، قابل_للتكرار }
