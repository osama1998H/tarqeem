// مكدس - Stack Collection
// مكدس - صنف المكدس (LIFO)
//
// Last-In-First-Out stack
// مكدس آخر-داخل-أول-خارج

صدّر صنف مكدس<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    // Constructor - المنشئ
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ======================================
    // Basic operations - العمليات الأساسية
    // ======================================

    // Push - add to top - ادفع عنصر للقمة
    عام دالة ادفع(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    // Pop - remove from top - انزع عنصر من القمة
    عام دالة انزع() -> ن {
        إذا (هذا._طول == 0) {
            // Return undefined for empty stack
            // TODO: Handle with Option type when available
            أرجع هذا._عناصر[0]
        }

        هذا._طول = هذا._طول - 1
        متغير عنصر = هذا._عناصر[هذا._طول]
        أرجع عنصر
    }

    // Peek - look at top without removing - انظر للقمة بدون حذف
    عام دالة قمة() -> ن {
        إذا (هذا._طول == 0) {
            أرجع هذا._عناصر[0]
        }
        أرجع هذا._عناصر[هذا._طول - 1]
    }

    // ======================================
    // Query - الاستعلام
    // ======================================

    // Get length - احصل على الطول
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    // Check if empty - تحقق من الفراغ
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    // Clear all elements - امسح جميع العناصر
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // Check if contains element - تحقق من احتواء عنصر
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // ======================================
    // Conversion - التحويل
    // ======================================

    // Convert to array - حوّل إلى مصفوفة
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    // Convert to list - حوّل إلى قائمة
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Reverse the stack - اعكس المكدس
    عام دالة اعكس() {
        متغير يسار = 0
        متغير يمين = هذا._طول - 1
        طالما (يسار < يمين) {
            متغير مؤقت = هذا._عناصر[يسار]
            هذا._عناصر[يسار] = هذا._عناصر[يمين]
            هذا._عناصر[يمين] = مؤقت
            يسار = يسار + 1
            يمين = يمين - 1
        }
    }
}
