/// صنف المكدس (آخر-داخل-أول-خارج)
///
/// بنية بيانات تتبع مبدأ آخر عنصر يدخل هو أول عنصر يخرج
///
/// @مثال
/// متغير م = جديد مكدس<عدد>()
/// م.ادفع(١)
/// م.ادفع(٢)
/// م.ادفع(٣)
/// اطبع(م.انزع())  // ٣
/// اطبع(م.انزع())  // ٢

صدّر صنف مكدس<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    /// المنشئ - ينشئ مكدساً فارغاً جديداً
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // العمليات الأساسية
    // ═══════════════════════════════════════════

    /// ادفع عنصراً إلى قمة المكدس
    ///
    /// @معامل عنصر - العنصر المراد إضافته
    عام دالة ادفع(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    /// انزع عنصراً من قمة المكدس
    ///
    /// @أرجع العنصر في قمة المكدس
    /// @تحذير يجب التأكد من أن المكدس غير فارغ
    عام دالة انزع() -> ن {
        إذا (هذا._طول == 0) {
            أرجع هذا._عناصر[0]
        }

        هذا._طول = هذا._طول - 1
        متغير عنصر = هذا._عناصر[هذا._طول]
        أرجع عنصر
    }

    /// انظر للعنصر في قمة المكدس بدون نزعه
    ///
    /// @أرجع العنصر في قمة المكدس
    /// @تحذير يجب التأكد من أن المكدس غير فارغ
    عام دالة قمة() -> ن {
        إذا (هذا._طول == 0) {
            أرجع هذا._عناصر[0]
        }
        أرجع هذا._عناصر[هذا._طول - 1]
    }

    // ═══════════════════════════════════════════
    // الاستعلام
    // ═══════════════════════════════════════════

    /// احصل على عدد عناصر المكدس
    ///
    /// @أرجع عدد العناصر
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    /// تحقق إذا كان المكدس فارغاً
    ///
    /// @أرجع صحيح إذا كان فارغاً
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    /// امسح جميع عناصر المكدس
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    /// تحقق من وجود عنصر في المكدس
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع صحيح إذا كان موجوداً
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // ═══════════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════════

    /// حوّل المكدس إلى مصفوفة
    ///
    /// @أرجع مصفوفة تحتوي جميع العناصر (من القاعدة للقمة)
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    /// حوّل المكدس إلى قائمة
    ///
    /// @أرجع قائمة تحتوي جميع العناصر (من القاعدة للقمة)
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// اعكس ترتيب عناصر المكدس
    عام دالة اعكس() {
        متغير يسار = 0
        متغير يمين = هذا._طول - 1
        طالما (يسار < يمين) {
            متغير مؤقت = هذا._عناصر[يسار]
            هذا._عناصر[يسار] = هذا._عناصر[يمين]
            هذا._عناصر[يمين] = مؤقت
            يسار = يسار + 1
            يمين = يمين - 1
        }
    }
}

الحمد_لله
