/// صنف المجموعة (العناصر الفريدة)
///
/// مجموعة غير مرتبة من العناصر الفريدة تدعم عمليات
/// المجموعات الرياضية كالاتحاد والتقاطع والفرق
///
/// @مثال
/// متغير م = جديد مجموعة<عدد>()
/// م.أضف(١)
/// م.أضف(٢)
/// م.أضف(١)  // لن يُضاف لأنه موجود
/// اطبع(م.طول())  // ٢

صدّر صنف مجموعة<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    /// المنشئ - ينشئ مجموعة فارغة جديدة
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    /// أنشئ مجموعة من مصفوفة
    ///
    /// @معامل عناصر - المصفوفة المراد تحويلها
    /// @أرجع مجموعة جديدة تحتوي العناصر الفريدة
    مشترك دالة من_مصفوفة(عناصر: مصفوفة<ن>) -> مجموعة<ن> {
        متغير م = جديد مجموعة<ن>()
        لكل عنصر في عناصر {
            م.أضف(عنصر)
        }
        أرجع م
    }

    // ═══════════════════════════════════════════
    // الإضافة والحذف
    // ═══════════════════════════════════════════

    /// أضف عنصراً إلى المجموعة
    ///
    /// @معامل عنصر - العنصر المراد إضافته
    /// @أرجع صحيح إذا أُضيف، خطأ إذا كان موجوداً
    عام دالة أضف(عنصر: ن) -> منطقي {
        إذا (هذا.يحتوي(عنصر)) {
            أرجع خطأ
        }
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
        أرجع صحيح
    }

    /// احذف عنصراً من المجموعة
    ///
    /// @معامل عنصر - العنصر المراد حذفه
    /// @أرجع صحيح إذا حُذف، خطأ إذا لم يكن موجوداً
    عام دالة احذف(عنصر: ن) -> منطقي {
        متغير فهرس = -1
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                فهرس = ع
                ع = هذا._طول
            }
            ع = ع + 1
        }

        إذا (فهرس == -1) {
            أرجع خطأ
        }

        ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع صحيح
    }

    /// امسح جميع عناصر المجموعة
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // الاستعلام
    // ═══════════════════════════════════════════

    /// تحقق من وجود عنصر في المجموعة
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع صحيح إذا كان موجوداً
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    /// احصل على عدد عناصر المجموعة
    ///
    /// @أرجع عدد العناصر
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    /// تحقق إذا كانت المجموعة فارغة
    ///
    /// @أرجع صحيح إذا كانت فارغة
    عام دالة فارغة() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ═══════════════════════════════════════════
    // عمليات المجموعات
    // ═══════════════════════════════════════════

    /// اتحاد مجموعتين
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع مجموعة جديدة تحتوي جميع العناصر من المجموعتين
    /// @مثال
    /// متغير أ = مجموعة.من_مصفوفة([١، ٢])
    /// متغير ب = مجموعة.من_مصفوفة([٢، ٣])
    /// متغير ج = أ.اتحاد(ب)  // {١، ٢، ٣}
    عام دالة اتحاد(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        ع = 0
        طالما (ع < أخرى.طول()) {
            نتيجة.أضف(أخرى._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// تقاطع مجموعتين
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع مجموعة جديدة تحتوي العناصر المشتركة فقط
    /// @مثال
    /// متغير أ = مجموعة.من_مصفوفة([١، ٢، ٣])
    /// متغير ب = مجموعة.من_مصفوفة([٢، ٣، ٤])
    /// متغير ج = أ.تقاطع(ب)  // {٢، ٣}
    عام دالة تقاطع(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// فرق مجموعتين (هذه - الأخرى)
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع مجموعة تحتوي العناصر الموجودة في هذه وليست في الأخرى
    /// @مثال
    /// متغير أ = مجموعة.من_مصفوفة([١، ٢، ٣])
    /// متغير ب = مجموعة.من_مصفوفة([٢، ٣])
    /// متغير ج = أ.فرق(ب)  // {١}
    عام دالة فرق(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// الفرق المتماثل بين مجموعتين
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع مجموعة تحتوي العناصر الموجودة في إحداهما فقط
    عام دالة فرق_متماثل(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        ع = 0
        طالما (ع < أخرى.طول()) {
            إذا (!هذا.يحتوي(أخرى._عناصر[ع])) {
                نتيجة.أضف(أخرى._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// تحقق إذا كانت هذه مجموعة جزئية من الأخرى
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع صحيح إذا كانت جميع عناصر هذه موجودة في الأخرى
    عام دالة مجموعة_جزئية(أخرى: مجموعة<ن>) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                أرجع خطأ
            }
            ع = ع + 1
        }
        أرجع صحيح
    }

    /// تحقق إذا كانت هذه مجموعة شاملة للأخرى
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع صحيح إذا كانت جميع عناصر الأخرى موجودة في هذه
    عام دالة مجموعة_شاملة(أخرى: مجموعة<ن>) -> منطقي {
        أرجع أخرى.مجموعة_جزئية(هذا)
    }

    /// تحقق إذا كانت المجموعتان منفصلتان (لا تقاطع)
    ///
    /// @معامل أخرى - المجموعة الأخرى
    /// @أرجع صحيح إذا لم يكن هناك عناصر مشتركة
    عام دالة منفصلة(أخرى: مجموعة<ن>) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (أخرى.يحتوي(هذا._عناصر[ع])) {
                أرجع خطأ
            }
            ع = ع + 1
        }
        أرجع صحيح
    }

    // ═══════════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════════

    /// حوّل المجموعة إلى مصفوفة
    ///
    /// @أرجع مصفوفة تحتوي جميع العناصر
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    /// حوّل المجموعة إلى قائمة
    ///
    /// @أرجع قائمة تحتوي جميع العناصر
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    /// أنشئ نسخة من المجموعة
    ///
    /// @أرجع مجموعة جديدة تحتوي نفس العناصر
    عام دالة نسخة() -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }
}
