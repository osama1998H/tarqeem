// قائمة - List Collection
// قائمة - صنف القائمة الديناميكية
//
// Generic dynamic list with O(1) access and O(n) insertion/removal
// قائمة ديناميكية معممة مع وصول O(1) وإدراج/حذف O(n)

صدّر صنف قائمة<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    // Constructor - المنشئ
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ======================================
    // Adding elements - إضافة العناصر
    // ======================================

    // Add element to end - أضف عنصر في النهاية
    عام دالة أضف(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    // Add element at specific index - أضف عنصر في موضع محدد
    عام دالة أضف_في(فهرس: عدد، عنصر: ن) {
        إذا (فهرس < 0 || فهرس > هذا._طول) {
            // Index out of bounds - الفهرس خارج الحدود
            أرجع
        }
        // Shift elements to make room
        متغير ع = هذا._طول
        طالما (ع > فهرس) {
            هذا._عناصر[ع] = هذا._عناصر[ع - 1]
            ع = ع - 1
        }
        هذا._عناصر[فهرس] = عنصر
        هذا._طول = هذا._طول + 1
    }

    // Add all elements from another list - أضف جميع العناصر من قائمة أخرى
    عام دالة أضف_كل(أخرى: قائمة<ن>) {
        متغير ع = 0
        طالما (ع < أخرى.طول()) {
            هذا.أضف(أخرى.احصل(ع))
            ع = ع + 1
        }
    }

    // ======================================
    // Removing elements - حذف العناصر
    // ======================================

    // Remove element at index - احذف عنصر من موضع
    عام دالة احذف(فهرس: عدد) -> ن {
        إذا (فهرس < 0 || فهرس >= هذا._طول) {
            // Return default value for out of bounds
            أرجع هذا._عناصر[0]  // TODO: Handle properly
        }
        متغير عنصر = هذا._عناصر[فهرس]
        // Shift elements to fill gap
        متغير ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع عنصر
    }

    // Remove first element - احذف العنصر الأول
    عام دالة احذف_اول() -> ن {
        أرجع هذا.احذف(0)
    }

    // Remove last element - احذف العنصر الأخير
    عام دالة احذف_اخير() -> ن {
        أرجع هذا.احذف(هذا._طول - 1)
    }

    // Clear all elements - امسح جميع العناصر
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ======================================
    // Access elements - الوصول للعناصر
    // ======================================

    // Get element at index - احصل على عنصر من موضع
    عام دالة احصل(فهرس: عدد) -> ن {
        أرجع هذا._عناصر[فهرس]
    }

    // Set element at index - عيّن قيمة عنصر
    عام دالة عيّن(فهرس: عدد، قيمة: ن) {
        هذا._عناصر[فهرس] = قيمة
    }

    // Get first element - احصل على العنصر الأول
    عام دالة اول() -> ن {
        أرجع هذا._عناصر[0]
    }

    // Get last element - احصل على العنصر الأخير
    عام دالة اخير() -> ن {
        أرجع هذا._عناصر[هذا._طول - 1]
    }

    // ======================================
    // Search - البحث
    // ======================================

    // Check if list contains element - تحقق من احتواء القائمة على عنصر
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // Find index of element - ابحث عن فهرس عنصر
    عام دالة فهرس(عنصر: ن) -> عدد {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع ع
            }
            ع = ع + 1
        }
        أرجع -1  // Not found
    }

    // Find last index of element - ابحث عن آخر فهرس لعنصر
    عام دالة فهرس_اخير(عنصر: ن) -> عدد {
        متغير ع = هذا._طول - 1
        طالما (ع >= 0) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع ع
            }
            ع = ع - 1
        }
        أرجع -1  // Not found
    }

    // ======================================
    // Properties - الخصائص
    // ======================================

    // Get length - احصل على الطول
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    // Check if empty - تحقق من الفراغ
    عام دالة فارغة() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ======================================
    // Conversion - التحويل
    // ======================================

    // Convert to array - حوّل إلى مصفوفة
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    // Create a copy - انسخ القائمة
    عام دالة نسخة() -> قائمة<ن> {
        متغير جديدة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            جديدة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع جديدة
    }

    // ======================================
    // Higher-order functions - الدوال العليا
    // TODO: Will be added when function types are fully supported
    // سيتم إضافتها عندما يتم دعم أنماط الدوال بالكامل
    // ======================================

    // ======================================
    // Sorting - الترتيب
    // ======================================

    // Reverse the list in place - اعكس القائمة
    عام دالة اعكس() {
        متغير يسار = 0
        متغير يمين = هذا._طول - 1
        طالما (يسار < يمين) {
            متغير مؤقت = هذا._عناصر[يسار]
            هذا._عناصر[يسار] = هذا._عناصر[يمين]
            هذا._عناصر[يمين] = مؤقت
            يسار = يسار + 1
            يمين = يمين - 1
        }
    }

    // TODO: Sort functions require comparison support
    // عام دالة رتّب() { }
    // عام دالة رتّب_بـ(مقارن: (ن، ن) => عدد) { }
    // عام دالة خلط() { }
}
