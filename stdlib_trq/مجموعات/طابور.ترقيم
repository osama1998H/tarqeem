/// صنف الطابور (أول-داخل-أول-خارج)
///
/// بنية بيانات تتبع مبدأ أول عنصر يدخل هو أول عنصر يخرج
///
/// @مثال
/// متغير ط = جديد طابور<نص>()
/// ط.ادخل("أول")
/// ط.ادخل("ثاني")
/// اطبع(ط.اخرج())  // "أول"
/// اطبع(ط.اخرج())  // "ثاني"

صدّر صنف طابور<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _طول: عدد;

    /// المنشئ - ينشئ طابوراً فارغاً جديداً
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ═══════════════════════════════════════════
    // العمليات الأساسية
    // ═══════════════════════════════════════════

    /// أدخل عنصراً في نهاية الطابور
    ///
    /// @معامل عنصر - العنصر المراد إدخاله
    عام دالة ادخل(عنصر: ن) {
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
    }

    /// أخرج عنصراً من بداية الطابور
    ///
    /// @أرجع العنصر الأول في الطابور
    /// @تحذير يجب التأكد من أن الطابور غير فارغ
    عام دالة اخرج() -> ن {
        إذا (هذا._طول == 0) {
            أرجع هذا._عناصر[0]
        }

        متغير عنصر = هذا._عناصر[0]

        متغير ع = 0
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }

        هذا._طول = هذا._طول - 1
        أرجع عنصر
    }

    /// انظر للعنصر الأول بدون إخراجه
    ///
    /// @أرجع العنصر الأول في الطابور
    /// @تحذير يجب التأكد من أن الطابور غير فارغ
    عام دالة انظر() -> ن {
        أرجع هذا._عناصر[0]
    }

    // ═══════════════════════════════════════════
    // الاستعلام
    // ═══════════════════════════════════════════

    /// احصل على عدد عناصر الطابور
    ///
    /// @أرجع عدد العناصر
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    /// تحقق إذا كان الطابور فارغاً
    ///
    /// @أرجع صحيح إذا كان فارغاً
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    /// امسح جميع عناصر الطابور
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    /// تحقق من وجود عنصر في الطابور
    ///
    /// @معامل عنصر - العنصر المراد البحث عنه
    /// @أرجع صحيح إذا كان موجوداً
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // ═══════════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════════

    /// حوّل الطابور إلى مصفوفة
    ///
    /// @أرجع مصفوفة تحتوي جميع العناصر بنفس الترتيب
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    /// حوّل الطابور إلى قائمة
    ///
    /// @أرجع قائمة تحتوي جميع العناصر بنفس الترتيب
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }
}
