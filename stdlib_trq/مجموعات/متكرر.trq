// متكرر - Iterator Interface
// متكرر - واجهة المتكرر
//
// Iterator protocol for collection traversal
// بروتوكول المتكرر لاجتياز المجموعات

// Iterator interface - واجهة المتكرر
صدّر واجهة متكرر<ن> {
    // Get next element - احصل على العنصر التالي
    دالة التالي() -> ن

    // Check if there are more elements - تحقق من وجود عناصر أخرى
    دالة يوجد_تالي() -> منطقي
}

// Iterable interface - واجهة قابل للتكرار
صدّر واجهة قابل_للتكرار<ن> {
    // Get an iterator - احصل على متكرر
    دالة متكرر() -> متكرر<ن>
}

// Array iterator implementation - تنفيذ متكرر المصفوفة
صدّر صنف متكرر_مصفوفة<ن> يطبق متكرر<ن> {
    خاص _عناصر: مصفوفة<ن>;
    خاص _فهرس: عدد;
    خاص _طول: عدد;

    منشئ(عناصر: مصفوفة<ن>) {
        هذا._عناصر = عناصر
        هذا._فهرس = 0
        هذا._طول = عناصر.طول
    }

    عام دالة التالي() -> ن {
        متغير عنصر = هذا._عناصر[هذا._فهرس]
        هذا._فهرس = هذا._فهرس + 1
        أرجع عنصر
    }

    عام دالة يوجد_تالي() -> منطقي {
        أرجع هذا._فهرس < هذا._طول
    }
}

// Range iterator for numbers - متكرر النطاق للأعداد
صدّر صنف متكرر_نطاق يطبق متكرر<عدد> {
    خاص _حالي: عدد;
    خاص _نهاية: عدد;
    خاص _خطوة: عدد;

    منشئ(بداية: عدد، نهاية: عدد) {
        هذا._حالي = بداية
        هذا._نهاية = نهاية
        هذا._خطوة = 1
    }

    ثابت_صنف دالة بخطوة(بداية: عدد، نهاية: عدد، خطوة: عدد) -> متكرر_نطاق {
        متغير م = جديد متكرر_نطاق(بداية، نهاية)
        م._خطوة = خطوة
        أرجع م
    }

    عام دالة التالي() -> عدد {
        متغير قيمة = هذا._حالي
        هذا._حالي = هذا._حالي + هذا._خطوة
        أرجع قيمة
    }

    عام دالة يوجد_تالي() -> منطقي {
        إذا (هذا._خطوة > 0) {
            أرجع هذا._حالي < هذا._نهاية
        }
        أرجع هذا._حالي > هذا._نهاية
    }
}

// Helper function to create a range - دالة مساعدة لإنشاء نطاق
صدّر دالة نطاق(بداية: عدد، نهاية: عدد) -> متكرر_نطاق {
    أرجع جديد متكرر_نطاق(بداية، نهاية)
}

// Helper function to create a range with step - دالة مساعدة لإنشاء نطاق بخطوة
صدّر دالة نطاق_بخطوة(بداية: عدد، نهاية: عدد، خطوة: عدد) -> متكرر_نطاق {
    أرجع متكرر_نطاق.بخطوة(بداية، نهاية، خطوة)
}
