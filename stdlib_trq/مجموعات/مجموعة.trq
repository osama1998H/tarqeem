// مجموعة - Set Collection
// مجموعة - صنف المجموعة (العناصر الفريدة)
//
// Unordered collection of unique elements
// مجموعة غير مرتبة من العناصر الفريدة

صدّر صنف مجموعة<ن> {
    خاص _عناصر: مصفوفة<ن>
    خاص _طول: عدد

    // Constructor - المنشئ
    منشئ() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // Constructor from array - منشئ من مصفوفة
    ثابت_صنف دالة من_مصفوفة(عناصر: مصفوفة<ن>) -> مجموعة<ن> {
        متغير م = جديد مجموعة<ن>()
        لكل عنصر في عناصر {
            م.أضف(عنصر)
        }
        أرجع م
    }

    // ======================================
    // Adding and removing - الإضافة والحذف
    // ======================================

    // Add element (returns true if added, false if already exists)
    // أضف عنصر (يرجع صحيح إذا أُضيف، خطأ إذا كان موجوداً)
    عام دالة أضف(عنصر: ن) -> منطقي {
        إذا (هذا.يحتوي(عنصر)) {
            أرجع خطأ
        }
        هذا._عناصر.ألحق(عنصر)
        هذا._طول = هذا._طول + 1
        أرجع صحيح
    }

    // Remove element (returns true if removed, false if not found)
    // احذف عنصر (يرجع صحيح إذا حُذف، خطأ إذا غير موجود)
    عام دالة احذف(عنصر: ن) -> منطقي {
        متغير فهرس = -1
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                فهرس = ع
                ع = هذا._طول  // break
            }
            ع = ع + 1
        }

        إذا (فهرس == -1) {
            أرجع خطأ
        }

        // Shift elements to fill gap
        ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._عناصر[ع] = هذا._عناصر[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع صحيح
    }

    // Clear all elements - امسح جميع العناصر
    عام دالة امسح() {
        هذا._عناصر = []
        هذا._طول = 0
    }

    // ======================================
    // Query - الاستعلام
    // ======================================

    // Check if contains element - تحقق من احتواء عنصر
    عام دالة يحتوي(عنصر: ن) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._عناصر[ع] == عنصر) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // Get length - احصل على الطول
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    // Check if empty - تحقق من الفراغ
    عام دالة فارغة() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ======================================
    // Set operations - عمليات المجموعات
    // ======================================

    // Union of two sets - اتحاد مجموعتين
    عام دالة اتحاد(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        // Add all from this set
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        // Add all from other set (duplicates will be ignored)
        ع = 0
        طالما (ع < أخرى.طول()) {
            نتيجة.أضف(أخرى._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Intersection of two sets - تقاطع مجموعتين
    عام دالة تقاطع(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Difference of two sets (this - other) - فرق مجموعتين
    عام دالة فرق(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Symmetric difference - الفرق المتماثل
    عام دالة فرق_متماثل(أخرى: مجموعة<ن>) -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        // Add elements in this but not in other
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                نتيجة.أضف(هذا._عناصر[ع])
            }
            ع = ع + 1
        }
        // Add elements in other but not in this
        ع = 0
        طالما (ع < أخرى.طول()) {
            إذا (!هذا.يحتوي(أخرى._عناصر[ع])) {
                نتيجة.أضف(أخرى._عناصر[ع])
            }
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Check if this is a subset of other - تحقق من المجموعة الجزئية
    عام دالة مجموعة_جزئية(أخرى: مجموعة<ن>) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (!أخرى.يحتوي(هذا._عناصر[ع])) {
                أرجع خطأ
            }
            ع = ع + 1
        }
        أرجع صحيح
    }

    // Check if this is a superset of other - تحقق من المجموعة الشاملة
    عام دالة مجموعة_شاملة(أخرى: مجموعة<ن>) -> منطقي {
        أرجع أخرى.مجموعة_جزئية(هذا)
    }

    // Check if sets are disjoint - تحقق من عدم التقاطع
    عام دالة منفصلة(أخرى: مجموعة<ن>) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (أخرى.يحتوي(هذا._عناصر[ع])) {
                أرجع خطأ
            }
            ع = ع + 1
        }
        أرجع صحيح
    }

    // ======================================
    // Conversion - التحويل
    // ======================================

    // Convert to array - حوّل إلى مصفوفة
    عام دالة الى_مصفوفة() -> مصفوفة<ن> {
        أرجع هذا._عناصر
    }

    // Convert to list - حوّل إلى قائمة
    عام دالة الى_قائمة() -> قائمة<ن> {
        متغير نتيجة = جديد قائمة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Create a copy - انسخ المجموعة
    عام دالة نسخة() -> مجموعة<ن> {
        متغير نتيجة = جديد مجموعة<ن>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._عناصر[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // ======================================
    // Iteration - التكرار
    // ======================================

    // For each element - لكل عنصر
    عام دالة لكل(دالة: (ن) => فراغ) {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            دالة(هذا._عناصر[ع])
            ع = ع + 1
        }
    }
}
