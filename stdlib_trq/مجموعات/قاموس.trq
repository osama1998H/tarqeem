// قاموس - Dictionary/Map Collection
// قاموس - صنف القاموس (قاموس مفتاح-قيمة)
//
// Key-value dictionary with O(n) lookup (simple implementation)
// قاموس مفتاح-قيمة مع بحث O(n) (تنفيذ بسيط)

// Pair type for key-value storage - نوع الزوج للتخزين
صدّر صنف زوج<أ، ب> {
    عام مفتاح: أ
    عام قيمة: ب

    منشئ(م: أ، ق: ب) {
        هذا.مفتاح = م
        هذا.قيمة = ق
    }
}

صدّر صنف قاموس<م، ق> {
    خاص _مفاتيح: مصفوفة<م>
    خاص _قيم: مصفوفة<ق>
    خاص _طول: عدد

    // Constructor - المنشئ
    منشئ() {
        هذا._مفاتيح = []
        هذا._قيم = []
        هذا._طول = 0
    }

    // ======================================
    // Adding and modifying - الإضافة والتعديل
    // ======================================

    // Set key-value pair - عيّن زوج مفتاح-قيمة
    عام دالة عيّن(مفتاح: م، قيمة: ق) {
        // Check if key already exists
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس >= 0) {
            // Update existing value
            هذا._قيم[فهرس] = قيمة
        } وإلا {
            // Add new key-value pair
            هذا._مفاتيح.ألحق(مفتاح)
            هذا._قيم.ألحق(قيمة)
            هذا._طول = هذا._طول + 1
        }
    }

    // Get value by key - احصل على قيمة بالمفتاح
    عام دالة احصل(مفتاح: م) -> ق {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        // Returns value at index (undefined behavior if not found)
        // TODO: Handle with Option type when available
        أرجع هذا._قيم[فهرس]
    }

    // Get value or default - احصل على قيمة أو افتراضي
    عام دالة احصل_او(مفتاح: م، افتراضي: ق) -> ق {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس >= 0) {
            أرجع هذا._قيم[فهرس]
        }
        أرجع افتراضي
    }

    // ======================================
    // Removing - الحذف
    // ======================================

    // Remove by key - احذف بالمفتاح
    عام دالة احذف(مفتاح: م) -> منطقي {
        متغير فهرس = هذا._ابحث_عن_مفتاح(مفتاح)
        إذا (فهرس < 0) {
            أرجع خطأ
        }

        // Shift elements to fill gap
        متغير ع = فهرس
        طالما (ع < هذا._طول - 1) {
            هذا._مفاتيح[ع] = هذا._مفاتيح[ع + 1]
            هذا._قيم[ع] = هذا._قيم[ع + 1]
            ع = ع + 1
        }
        هذا._طول = هذا._طول - 1
        أرجع صحيح
    }

    // Clear all entries - امسح جميع الإدخالات
    عام دالة امسح() {
        هذا._مفاتيح = []
        هذا._قيم = []
        هذا._طول = 0
    }

    // ======================================
    // Query - الاستعلام
    // ======================================

    // Check if contains key - تحقق من احتواء مفتاح
    عام دالة يحتوي(مفتاح: م) -> منطقي {
        أرجع هذا._ابحث_عن_مفتاح(مفتاح) >= 0
    }

    // Check if contains value - تحقق من احتواء قيمة
    عام دالة يحتوي_قيمة(قيمة: ق) -> منطقي {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._قيم[ع] == قيمة) {
                أرجع صحيح
            }
            ع = ع + 1
        }
        أرجع خطأ
    }

    // Get length - احصل على الطول
    عام دالة طول() -> عدد {
        أرجع هذا._طول
    }

    // Check if empty - تحقق من الفراغ
    عام دالة فارغ() -> منطقي {
        أرجع هذا._طول == 0
    }

    // ======================================
    // Iteration - التكرار
    // ======================================

    // Get all keys - احصل على جميع المفاتيح
    عام دالة مفاتيح() -> قائمة<م> {
        متغير نتيجة = جديد قائمة<م>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._مفاتيح[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Get all values - احصل على جميع القيم
    عام دالة قيم() -> قائمة<ق> {
        متغير نتيجة = جديد قائمة<ق>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(هذا._قيم[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // Get all key-value pairs - احصل على جميع الأزواج
    عام دالة عناصر() -> قائمة<زوج<م، ق>> {
        متغير نتيجة = جديد قائمة<زوج<م، ق>>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.أضف(جديد زوج<م، ق>(هذا._مفاتيح[ع]، هذا._قيم[ع]))
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // For each entry - لكل إدخال
    عام دالة لكل(دالة: (م، ق) => فراغ) {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            دالة(هذا._مفاتيح[ع]، هذا._قيم[ع])
            ع = ع + 1
        }
    }

    // ======================================
    // Merging - الدمج
    // ======================================

    // Merge another dictionary into this one - ادمج قاموس آخر
    عام دالة ادمج(اخر: قاموس<م، ق>) {
        متغير ع = 0
        طالما (ع < اخر.طول()) {
            هذا.عيّن(اخر._مفاتيح[ع]، اخر._قيم[ع])
            ع = ع + 1
        }
    }

    // Create a copy - انسخ القاموس
    عام دالة نسخة() -> قاموس<م، ق> {
        متغير نتيجة = جديد قاموس<م، ق>()
        متغير ع = 0
        طالما (ع < هذا._طول) {
            نتيجة.عيّن(هذا._مفاتيح[ع]، هذا._قيم[ع])
            ع = ع + 1
        }
        أرجع نتيجة
    }

    // ======================================
    // Private helpers - دوال مساعدة خاصة
    // ======================================

    // Find key index - ابحث عن فهرس المفتاح
    خاص دالة _ابحث_عن_مفتاح(مفتاح: م) -> عدد {
        متغير ع = 0
        طالما (ع < هذا._طول) {
            إذا (هذا._مفاتيح[ع] == مفتاح) {
                أرجع ع
            }
            ع = ع + 1
        }
        أرجع -1
    }
}
