// أخطاء - Error Handling Module
// أخطاء - وحدة معالجة الأخطاء
//
// Provides error types, Result, and Option types
// يوفر أنواع الأخطاء ونتيجة واختياري

// =============================================================================
// خطأ - Base Error Class
// =============================================================================

صدّر صنف خطأ {
    عام رسالة: نص
    عام رسالة_عربية: نص
    خاص _نوع: نص

    // Constructor with message
    // المنشئ مع الرسالة
    منشئ(رسالة: نص) {
        هذا.رسالة = رسالة
        هذا.رسالة_عربية = رسالة
        هذا._نوع = "خطأ"
    }

    // Constructor with bilingual messages
    // المنشئ مع رسائل ثنائية اللغة
    منشئ_ثنائي(رسالة: نص، رسالة_عربية: نص) {
        هذا.رسالة = رسالة
        هذا.رسالة_عربية = رسالة_عربية
        هذا._نوع = "خطأ"
    }

    // Get error type
    // احصل على نوع الخطأ
    عام دالة نوع() -> نص {
        أرجع هذا._نوع
    }

    // Convert to string (uses Arabic message)
    // حوّل إلى نص (يستخدم الرسالة العربية)
    عام دالة إلى_نص() -> نص {
        أرجع هذا._نوع + ": " + هذا.رسالة_عربية
    }

    // Convert to English string
    // حوّل إلى نص إنجليزي
    عام دالة إلى_نص_انجليزي() -> نص {
        أرجع هذا._نوع + ": " + هذا.رسالة
    }
}

// =============================================================================
// Specific Error Types / أنواع أخطاء محددة
// =============================================================================

// خطأ_قيمة - Value Error (invalid value)
// خطأ القيمة - قيمة غير صالحة
صدّر صنف خطأ_قيمة يرث خطأ {
    عام قيمة: نص

    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_قيمة"
        هذا.قيمة = ""
    }

    منشئ_قيمة(رسالة: نص، قيمة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_قيمة"
        هذا.قيمة = قيمة
    }
}

// خطأ_نوع - Type Error (type mismatch)
// خطأ النوع - عدم تطابق الأنماط
صدّر صنف خطأ_نوع يرث خطأ {
    عام نوع_متوقع: نص
    عام نوع_فعلي: نص

    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_نوع"
        هذا.نوع_متوقع = ""
        هذا.نوع_فعلي = ""
    }

    منشئ_أنواع(متوقع: نص، فعلي: نص) {
        متغير رسالة = "توقعت " + متوقع + " لكن حصلت على " + فعلي
        أساس.منشئ_ثنائي(
            "Expected " + متوقع + " but got " + فعلي،
            رسالة
        )
        هذا._نوع = "خطأ_نوع"
        هذا.نوع_متوقع = متوقع
        هذا.نوع_فعلي = فعلي
    }
}

// خطأ_فهرس - Index Error (out of bounds)
// خطأ الفهرس - خارج الحدود
صدّر صنف خطأ_فهرس يرث خطأ {
    عام فهرس: عدد
    عام طول: عدد

    منشئ(فهرس: عدد، طول: عدد) {
        متغير رسالة_ع = "الفهرس " + __إلى_نص__(فهرس) + " خارج الحدود (الطول: " + __إلى_نص__(طول) + ")"
        متغير رسالة_ا = "Index " + __إلى_نص__(فهرس) + " out of bounds (length: " + __إلى_نص__(طول) + ")"
        أساس.منشئ_ثنائي(رسالة_ا، رسالة_ع)
        هذا._نوع = "خطأ_فهرس"
        هذا.فهرس = فهرس
        هذا.طول = طول
    }
}

// خطأ_ملف - File Error
// خطأ الملف
صدّر صنف خطأ_ملف يرث خطأ {
    عام مسار: نص
    عام عملية: نص

    منشئ(مسار: نص، رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_ملف"
        هذا.مسار = مسار
        هذا.عملية = ""
    }

    منشئ_عملية(مسار: نص، عملية: نص، رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_ملف"
        هذا.مسار = مسار
        هذا.عملية = عملية
    }
}

// خطأ_شبكة - Network Error
// خطأ الشبكة
صدّر صنف خطأ_شبكة يرث خطأ {
    عام عنوان: نص
    عام منفذ: عدد
    عام كود: عدد

    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = ""
        هذا.منفذ = 0
        هذا.كود = 0
    }

    منشئ_اتصال(عنوان: نص، منفذ: عدد، رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = عنوان
        هذا.منفذ = منفذ
        هذا.كود = 0
    }

    منشئ_كود(كود: عدد، رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = ""
        هذا.منفذ = 0
        هذا.كود = كود
    }
}

// خطأ_صياغة - Parse/Syntax Error
// خطأ الصياغة
صدّر صنف خطأ_صياغة يرث خطأ {
    عام نص_مدخل: نص
    عام موضع: عدد

    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_صياغة"
        هذا.نص_مدخل = ""
        هذا.موضع = -1
    }

    منشئ_موضع(نص_مدخل: نص، موضع: عدد، رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_صياغة"
        هذا.نص_مدخل = نص_مدخل
        هذا.موضع = موضع
    }
}

// خطأ_قسمة - Division Error (divide by zero)
// خطأ القسمة
صدّر صنف خطأ_قسمة يرث خطأ {
    منشئ() {
        أساس.منشئ_ثنائي(
            "Division by zero",
            "القسمة على صفر"
        )
        هذا._نوع = "خطأ_قسمة"
    }
}

// خطأ_تجاوز - Overflow Error
// خطأ التجاوز
صدّر صنف خطأ_تجاوز يرث خطأ {
    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_تجاوز"
    }
}

// خطأ_ذاكرة - Memory Error
// خطأ الذاكرة
صدّر صنف خطأ_ذاكرة يرث خطأ {
    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_ذاكرة"
    }
}

// خطأ_مهلة - Timeout Error
// خطأ المهلة
صدّر صنف خطأ_مهلة يرث خطأ {
    عام مدة_ميلي: عدد

    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_مهلة"
        هذا.مدة_ميلي = 0
    }

    منشئ_مدة(مدة_ميلي: عدد) {
        متغير رسالة = "انتهت المهلة بعد " + __إلى_نص__(مدة_ميلي) + " ميلي ثانية"
        أساس.منشئ_ثنائي(
            "Timeout after " + __إلى_نص__(مدة_ميلي) + " milliseconds",
            رسالة
        )
        هذا._نوع = "خطأ_مهلة"
        هذا.مدة_ميلي = مدة_ميلي
    }
}

// خطأ_تأكيد - Assertion Error
// خطأ التأكيد
صدّر صنف خطأ_تأكيد يرث خطأ {
    منشئ(رسالة: نص) {
        أساس.منشئ(رسالة)
        هذا._نوع = "خطأ_تأكيد"
    }
}

// خطأ_غير_مطبق - Not Implemented Error
// خطأ غير مطبق
صدّر صنف خطأ_غير_مطبق يرث خطأ {
    منشئ(رسالة: نص) {
        أساس.منشئ_ثنائي(
            "Not implemented: " + رسالة،
            "غير مطبق: " + رسالة
        )
        هذا._نوع = "خطأ_غير_مطبق"
    }
}

// =============================================================================
// نتيجة<ن، خ> - Result Type (Success or Error)
// =============================================================================

صدّر صنف نتيجة<ن، خ> {
    خاص _قيمة: ن
    خاص _خطأ: خ
    خاص _ناجحة: منطقي

    // Private constructor
    // منشئ خاص
    منشئ(قيمة: ن، خطأ: خ، ناجحة: منطقي) {
        هذا._قيمة = قيمة
        هذا._خطأ = خطأ
        هذا._ناجحة = ناجحة
    }

    // Factory: Create success result
    // مصنع: أنشئ نتيجة ناجحة
    ثابت_صنف دالة نجاح(قيمة: ن) -> نتيجة<ن، خ> {
        متغير خطأ_فارغ: خ
        أرجع جديد نتيجة<ن، خ>(قيمة، خطأ_فارغ، صحيح)
    }

    // Factory: Create failure result
    // مصنع: أنشئ نتيجة فاشلة
    ثابت_صنف دالة فشل(خطأ: خ) -> نتيجة<ن، خ> {
        متغير قيمة_فارغة: ن
        أرجع جديد نتيجة<ن، خ>(قيمة_فارغة، خطأ، خطأ)
    }

    // Check if successful
    // تحقق إذا ناجحة
    عام دالة ناجحة() -> منطقي {
        أرجع هذا._ناجحة
    }

    // Check if failed
    // تحقق إذا فاشلة
    عام دالة فاشلة() -> منطقي {
        أرجع !هذا._ناجحة
    }

    // Get value (only call if successful)
    // احصل على القيمة (فقط إذا ناجحة)
    عام دالة قيمة() -> ن {
        أرجع هذا._قيمة
    }

    // Get error (only call if failed)
    // احصل على الخطأ (فقط إذا فاشلة)
    عام دالة خطأ() -> خ {
        أرجع هذا._خطأ
    }

    // Get value or default
    // احصل على القيمة أو الافتراضية
    عام دالة قيمة_أو(افتراضي: ن) -> ن {
        إذا (هذا._ناجحة) {
            أرجع هذا._قيمة
        }
        أرجع افتراضي
    }

    // Get value or execute function for default
    // احصل على القيمة أو نفذ دالة للافتراضية
    // TODO: Add when function types are supported
    // عام دالة قيمة_أو_نفذ(دالة: () => ن) -> ن { }

    // Unwrap value (panics if failed)
    // فك القيمة (يتوقف إذا فاشلة)
    عام دالة فك() -> ن {
        إذا (هذا._ناجحة) {
            أرجع هذا._قيمة
        }
        // In a real implementation, this would panic
        // في تطبيق حقيقي، هذا سيتوقف
        أرجع هذا._قيمة
    }

    // Unwrap error (panics if successful)
    // فك الخطأ (يتوقف إذا ناجحة)
    عام دالة فك_خطأ() -> خ {
        إذا (!هذا._ناجحة) {
            أرجع هذا._خطأ
        }
        أرجع هذا._خطأ
    }
}

// =============================================================================
// اختياري<ن> - Option Type (Some or None)
// =============================================================================

صدّر صنف اختياري<ن> {
    خاص _قيمة: ن
    خاص _موجود: منطقي

    // Private constructor
    // منشئ خاص
    منشئ(قيمة: ن، موجود: منطقي) {
        هذا._قيمة = قيمة
        هذا._موجود = موجود
    }

    // Factory: Create Some value
    // مصنع: أنشئ قيمة موجودة
    ثابت_صنف دالة بعض(قيمة: ن) -> اختياري<ن> {
        أرجع جديد اختياري<ن>(قيمة، صحيح)
    }

    // Factory: Create None value
    // مصنع: أنشئ قيمة فارغة
    ثابت_صنف دالة لا_شيء() -> اختياري<ن> {
        متغير فارغ: ن
        أرجع جديد اختياري<ن>(فارغ، خطأ)
    }

    // Check if value exists
    // تحقق إذا القيمة موجودة
    عام دالة موجود() -> منطقي {
        أرجع هذا._موجود
    }

    // Check if value is absent
    // تحقق إذا القيمة غائبة
    عام دالة فارغ() -> منطقي {
        أرجع !هذا._موجود
    }

    // Get value (only call if exists)
    // احصل على القيمة (فقط إذا موجودة)
    عام دالة قيمة() -> ن {
        أرجع هذا._قيمة
    }

    // Get value or default
    // احصل على القيمة أو الافتراضية
    عام دالة قيمة_أو(افتراضي: ن) -> ن {
        إذا (هذا._موجود) {
            أرجع هذا._قيمة
        }
        أرجع افتراضي
    }

    // Unwrap value (panics if none)
    // فك القيمة (يتوقف إذا فارغة)
    عام دالة فك() -> ن {
        أرجع هذا._قيمة
    }

    // Take value, leaving None
    // خذ القيمة، واترك لا_شيء
    عام دالة خذ() -> اختياري<ن> {
        إذا (هذا._موجود) {
            متغير قيمة = هذا._قيمة
            هذا._موجود = خطأ
            أرجع اختياري<ن>.بعض(قيمة)
        }
        أرجع اختياري<ن>.لا_شيء()
    }

    // Replace value
    // استبدل القيمة
    عام دالة استبدل(قيمة_جديدة: ن) -> اختياري<ن> {
        متغير قديم = اختياري<ن>.لا_شيء()
        إذا (هذا._موجود) {
            قديم = اختياري<ن>.بعض(هذا._قيمة)
        }
        هذا._قيمة = قيمة_جديدة
        هذا._موجود = صحيح
        أرجع قديم
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Create success result
// أنشئ نتيجة ناجحة
صدّر دالة نجاح<ن، خ>(قيمة: ن) -> نتيجة<ن، خ> {
    أرجع نتيجة<ن، خ>.نجاح(قيمة)
}

// Create failure result
// أنشئ نتيجة فاشلة
صدّر دالة فشل<ن، خ>(خطأ: خ) -> نتيجة<ن، خ> {
    أرجع نتيجة<ن، خ>.فشل(خطأ)
}

// Create Some optional
// أنشئ اختياري موجود
صدّر دالة بعض<ن>(قيمة: ن) -> اختياري<ن> {
    أرجع اختياري<ن>.بعض(قيمة)
}

// Create None optional
// أنشئ اختياري فارغ
صدّر دالة لا_شيء<ن>() -> اختياري<ن> {
    أرجع اختياري<ن>.لا_شيء()
}

// Assert condition (throws if false)
// تأكيد شرط (يرمي إذا خطأ)
صدّر دالة تأكيد(شرط: منطقي، رسالة: نص) {
    إذا (!شرط) {
        ارمِ جديد خطأ_تأكيد(رسالة)
    }
}

// Panic with message
// توقف مع رسالة
صدّر دالة توقف(رسالة: نص) {
    // Uses runtime: trq_panic
    __توقف__(رسالة)
}

// Unreachable code marker
// علامة كود غير قابل للوصول
صدّر دالة غير_قابل_للوصول() {
    توقف("وصل الكود إلى نقطة غير قابلة للوصول")
}

// Create new error
// أنشئ خطأ جديد
صدّر دالة خطأ_جديد(رسالة: نص) -> خطأ {
    أرجع جديد خطأ(رسالة)
}

// Create bilingual error
// أنشئ خطأ ثنائي اللغة
صدّر دالة خطأ_ثنائي(رسالة_انجليزية: نص، رسالة_عربية: نص) -> خطأ {
    أرجع جديد خطأ.منشئ_ثنائي(رسالة_انجليزية، رسالة_عربية)
}
