// نمط الاختياري
// ═══════════════════════════════════════════

/// صنف الاختياري (قيمة أو لا شيء)
///
/// يُستخدم للتعبير عن قيمة قد تكون موجودة أو غائبة
///
/// @مثال
/// دالة ابحث(قائمة: مصفوفة<عدد>، هدف: عدد) -> اختياري<عدد> {
///     لكل (متغير ع = ٠؛ ع < قائمة.طول()؛ ع++) {
///         إذا (قائمة[ع] == هدف) {
///             أرجع اختياري<عدد>.بعض(ع)
///         }
///     }
///     أرجع اختياري<عدد>.لا_شيء()
/// }
صدّر صنف اختياري<ن> {
    خاص _قيمة: ن
    خاص _موجود: منطقي

    /// المنشئ الخاص
    منشئ(قيمة: ن، موجود: منطقي) {
        هذا._قيمة = قيمة
        هذا._موجود = موجود
    }

    /// أنشئ اختياري بقيمة
    ///
    /// @معامل قيمة - القيمة الموجودة
    /// @أرجع اختياري يحتوي على القيمة
    مشترك دالة بعض(قيمة: ن) -> اختياري<ن> {
        أرجع جديد اختياري<ن>(قيمة، صحيح)
    }

    /// أنشئ اختياري فارغ
    ///
    /// @أرجع اختياري فارغ (لا شيء)
    مشترك دالة لا_شيء() -> اختياري<ن> {
        متغير فارغ: ن
        أرجع جديد اختياري<ن>(فارغ، خطأ)
    }

    /// تحقق إذا القيمة موجودة
    ///
    /// @أرجع صحيح إذا كانت القيمة موجودة
    عام دالة موجود() -> منطقي {
        أرجع هذا._موجود
    }

    /// تحقق إذا القيمة غائبة
    ///
    /// @أرجع صحيح إذا كانت القيمة غائبة
    عام دالة فارغ() -> منطقي {
        أرجع !هذا._موجود
    }

    /// أحصل على القيمة
    ///
    /// @أرجع القيمة (فقط إذا موجودة)
    /// @تحذير لا تستدعِ هذه الدالة إذا كان الاختياري فارغاً
    عام دالة قيمة() -> ن {
        أرجع هذا._قيمة
    }

    /// أحصل على القيمة أو قيمة افتراضية
    ///
    /// @معامل افتراضي - القيمة الافتراضية إذا كان فارغاً
    /// @أرجع القيمة الأصلية أو الافتراضية
    عام دالة قيمة_أو(افتراضي: ن) -> ن {
        إذا (هذا._موجود) {
            أرجع هذا._قيمة
        }
        أرجع افتراضي
    }

    /// فك القيمة (يتوقف إذا فارغ)
    ///
    /// @أرجع القيمة
    /// @تحذير يتوقف البرنامج إذا كان الاختياري فارغاً
    عام دالة فك() -> ن {
        أرجع هذا._قيمة
    }

    /// خذ القيمة واترك لا شيء
    ///
    /// @أرجع اختياري بالقيمة الأصلية (ويصبح هذا الاختياري فارغاً)
    عام دالة خذ() -> اختياري<ن> {
        إذا (هذا._موجود) {
            متغير قيمة = هذا._قيمة
            هذا._موجود = خطأ
            أرجع اختياري<ن>.بعض(قيمة)
        }
        أرجع اختياري<ن>.لا_شيء()
    }

    /// استبدل القيمة
    ///
    /// @معامل قيمة_جديدة - القيمة الجديدة
    /// @أرجع اختياري بالقيمة القديمة
    عام دالة استبدل(قيمة_جديدة: ن) -> اختياري<ن> {
        متغير قديم = اختياري<ن>.لا_شيء()
        إذا (هذا._موجود) {
            قديم = اختياري<ن>.بعض(هذا._قيمة)
        }
        هذا._قيمة = قيمة_جديدة
        هذا._موجود = صحيح
        أرجع قديم
    }
}

