// دوال مساعدة
// ═══════════════════════════════════════════

/// أنشئ نتيجة ناجحة
///
/// @معامل قيمة - القيمة الناجحة
/// @أرجع نتيجة تحتوي على القيمة
صدّر دالة نجاح<ن، خ>(قيمة: ن) -> نتيجة<ن، خ> {
    أرجع نتيجة<ن، خ>.نجاح(قيمة)
}

/// أنشئ نتيجة فاشلة
///
/// @معامل خطأ - الخطأ الذي حدث
/// @أرجع نتيجة تحتوي على الخطأ
صدّر دالة فشل<ن، خ>(خطأ: خ) -> نتيجة<ن، خ> {
    أرجع نتيجة<ن، خ>.فشل(خطأ)
}

/// أنشئ اختياري بقيمة
///
/// @معامل قيمة - القيمة الموجودة
/// @أرجع اختياري يحتوي على القيمة
صدّر دالة بعض<ن>(قيمة: ن) -> اختياري<ن> {
    أرجع اختياري<ن>.بعض(قيمة)
}

/// أنشئ اختياري فارغ
///
/// @أرجع اختياري فارغ (لا شيء)
صدّر دالة لا_شيء<ن>() -> اختياري<ن> {
    أرجع اختياري<ن>.لا_شيء()
}

/// تأكيد شرط
///
/// يرمي خطأ_تأكيد إذا كان الشرط خاطئاً
///
/// @معامل شرط - الشرط المطلوب تحققه
/// @معامل رسالة - رسالة الخطأ إذا فشل الشرط
/// @مثال
/// تأكيد(عدد > ٠، "يجب أن يكون العدد موجباً")
صدّر دالة تأكيد(شرط: منطقي، رسالة: نص) {
    إذا (!شرط) {
        ارمِ جديد خطأ_تأكيد(رسالة)
    }
}

// Note: توقف، عدد_لنص are builtin functions

/// علامة كود غير قابل للوصول
///
/// تُستخدم لتعليم أجزاء من الكود يجب ألا تُنفَّذ أبداً
صدّر دالة غير_قابل_للوصول() {
    توقف("وصل الكود إلى نقطة غير قابلة للوصول")
}

/// أنشئ خطأ جديد
///
/// @معامل رسالة - رسالة الخطأ
/// @أرجع كائن خطأ جديد
صدّر دالة خطأ_جديد(رسالة: نص) -> خطأ {
    أرجع جديد خطأ(رسالة)
}

/// أنشئ خطأ ثنائي اللغة
///
/// @معامل رسالة_انجليزية - الرسالة بالإنجليزية
/// @معامل رسالة_عربية - الرسالة بالعربية
/// @أرجع كائن خطأ جديد
صدّر دالة خطأ_ثنائي(رسالة_انجليزية: نص، رسالة_عربية: نص) -> خطأ {
    أرجع جديد خطأ.منشئ_ثنائي(رسالة_انجليزية، رسالة_عربية)
}
