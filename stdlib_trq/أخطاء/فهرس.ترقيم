// نمط النتيجة
// ═══════════════════════════════════════════

/// صنف النتيجة (نجاح أو فشل)
///
/// يُستخدم للتعامل مع العمليات التي قد تفشل بدون استثناءات
///
/// @مثال
/// دالة قسمة_آمنة(أ: عدد، ب: عدد) -> نتيجة<عدد، خطأ> {
///     إذا (ب == ٠) {
///         أرجع نتيجة<عدد، خطأ>.فشل(جديد خطأ_قسمة())
///     }
///     أرجع نتيجة<عدد، خطأ>.نجاح(أ / ب)
/// }
صدّر صنف نتيجة<ن، خ> {
    خاص _قيمة: ن
    خاص _خطأ: خ
    خاص _ناجحة: منطقي

    /// المنشئ الخاص
    منشئ(قيمة: ن، خطأ: خ، ناجحة: منطقي) {
        هذا._قيمة = قيمة
        هذا._خطأ = خطأ
        هذا._ناجحة = ناجحة
    }

    /// أنشئ نتيجة ناجحة
    ///
    /// @معامل قيمة - القيمة الناجحة
    /// @أرجع نتيجة تحتوي على القيمة
    مشترك دالة نجاح(قيمة: ن) -> نتيجة<ن، خ> {
        متغير خطأ_فارغ: خ
        أرجع جديد نتيجة<ن، خ>(قيمة، خطأ_فارغ، صحيح)
    }

    /// أنشئ نتيجة فاشلة
    ///
    /// @معامل خطأ - الخطأ الذي حدث
    /// @أرجع نتيجة تحتوي على الخطأ
    مشترك دالة فشل(خطأ: خ) -> نتيجة<ن، خ> {
        متغير قيمة_فارغة: ن
        أرجع جديد نتيجة<ن، خ>(قيمة_فارغة، خطأ، خطأ)
    }

    /// تحقق إذا النتيجة ناجحة
    ///
    /// @أرجع صحيح إذا كانت النتيجة ناجحة
    عام دالة ناجحة() -> منطقي {
        أرجع هذا._ناجحة
    }

    /// تحقق إذا النتيجة فاشلة
    ///
    /// @أرجع صحيح إذا كانت النتيجة فاشلة
    عام دالة فاشلة() -> منطقي {
        أرجع !هذا._ناجحة
    }

    /// أحصل على القيمة
    ///
    /// @أرجع القيمة (فقط إذا كانت النتيجة ناجحة)
    /// @تحذير لا تستدعِ هذه الدالة إذا كانت النتيجة فاشلة
    عام دالة قيمة() -> ن {
        أرجع هذا._قيمة
    }

    /// أحصل على الخطأ
    ///
    /// @أرجع الخطأ (فقط إذا كانت النتيجة فاشلة)
    /// @تحذير لا تستدعِ هذه الدالة إذا كانت النتيجة ناجحة
    عام دالة خطأ() -> خ {
        أرجع هذا._خطأ
    }

    /// أحصل على القيمة أو قيمة افتراضية
    ///
    /// @معامل افتراضي - القيمة الافتراضية إذا فشلت النتيجة
    /// @أرجع القيمة الأصلية أو الافتراضية
    عام دالة قيمة_أو(افتراضي: ن) -> ن {
        إذا (هذا._ناجحة) {
            أرجع هذا._قيمة
        }
        أرجع افتراضي
    }

    /// فك القيمة (يتوقف إذا فاشلة)
    ///
    /// @أرجع القيمة
    /// @تحذير يتوقف البرنامج إذا كانت النتيجة فاشلة
    عام دالة فك() -> ن {
        إذا (هذا._ناجحة) {
            أرجع هذا._قيمة
        }
        أرجع هذا._قيمة
    }

    /// فك الخطأ (يتوقف إذا ناجحة)
    ///
    /// @أرجع الخطأ
    /// @تحذير يتوقف البرنامج إذا كانت النتيجة ناجحة
    عام دالة فك_خطأ() -> خ {
        إذا (!هذا._ناجحة) {
            أرجع هذا._خطأ
        }
        أرجع هذا._خطأ
    }
}

