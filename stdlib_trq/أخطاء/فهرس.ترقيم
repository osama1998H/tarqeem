/// وحدة معالجة الأخطاء
///
/// توفر هذه الوحدة أنواع الأخطاء الأساسية والمتخصصة
/// بالإضافة إلى أنماط نتيجة واختياري للتعامل الآمن مع الأخطاء
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// صنف الخطأ الأساسي
// ═══════════════════════════════════════════

/// صنف الخطأ الأساسي
///
/// الصنف الأب لجميع أنواع الأخطاء في المكتبة القياسية
///
/// @مثال
/// متغير خ = جديد خطأ("حدث خطأ ما")
/// اطبع(خ.إلى_نص())
صدّر صنف خطأ {
    /// رسالة الخطأ
    عام رسالة: نص

    /// رسالة الخطأ بالعربية
    عام رسالة_عربية: نص

    /// نوع الخطأ الداخلي
    خاص _نوع: نص

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    منشئ(رسالة: نص) {
        هذا.رسالة = رسالة
        هذا.رسالة_عربية = رسالة
        هذا._نوع = "خطأ"
    }

    /// منشئ برسالتين (ثنائي اللغة)
    ///
    /// @معامل رسالة - الرسالة الأساسية
    /// @معامل رسالة_عربية - الرسالة بالعربية
    منشئ_ثنائي(رسالة: نص، رسالة_عربية: نص) {
        هذا.رسالة = رسالة
        هذا.رسالة_عربية = رسالة_عربية
        هذا._نوع = "خطأ"
    }

    /// أحصل على نوع الخطأ
    ///
    /// @أرجع نص يمثل نوع الخطأ
    عام دالة نوع() -> نص {
        أرجع هذا._نوع
    }

    /// حوّل الخطأ إلى نص
    ///
    /// @أرجع تمثيل نصي للخطأ بالعربية
    عام دالة إلى_نص() -> نص {
        أرجع هذا._نوع + ": " + هذا.رسالة_عربية
    }

    /// حوّل الخطأ إلى نص (النسخة الأساسية)
    ///
    /// @أرجع تمثيل نصي للخطأ
    عام دالة إلى_نص_انجليزي() -> نص {
        أرجع هذا._نوع + ": " + هذا.رسالة
    }
}

// ═══════════════════════════════════════════
// أنواع الأخطاء المتخصصة
// ═══════════════════════════════════════════

/// خطأ القيمة
///
/// يُستخدم عندما تكون القيمة المُدخلة غير صالحة
///
/// @مثال
/// إذا (عمر < 0) {
///     ارمِ جديد خطأ_قيمة("العمر لا يمكن أن يكون سالباً")
/// }
صدّر صنف خطأ_قيمة يرث خطأ {
    /// القيمة التي سببت الخطأ
    عام قيمة: نص

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    منشئ(رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_قيمة"
        هذا.قيمة = ""
    }

    /// منشئ مع القيمة
    ///
    /// @معامل رسالة - رسالة الخطأ
    /// @معامل قيمة - القيمة غير الصالحة
    منشئ_قيمة(رسالة: نص، قيمة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_قيمة"
        هذا.قيمة = قيمة
    }
}

/// خطأ النوع
///
/// يُستخدم عند عدم تطابق الأنماط المتوقعة والفعلية
///
/// @مثال
/// ارمِ جديد خطأ_نوع.منشئ_أنواع("عدد"، "نص")
صدّر صنف خطأ_نوع يرث خطأ {
    /// النوع المتوقع
    عام نوع_متوقع: نص

    /// النوع الفعلي
    عام نوع_فعلي: نص

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    منشئ(رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_نوع"
        هذا.نوع_متوقع = ""
        هذا.نوع_فعلي = ""
    }

    /// منشئ مع الأنواع
    ///
    /// @معامل متوقع - النوع المتوقع
    /// @معامل فعلي - النوع الفعلي
    منشئ_أنواع(متوقع: نص، فعلي: نص) {
        متغير رسالة = "توقعت " + متوقع + " لكن حصلت على " + فعلي
        الأصل.منشئ_ثنائي(
            "Expected " + متوقع + " but got " + فعلي،
            رسالة
        )
        هذا._نوع = "خطأ_نوع"
        هذا.نوع_متوقع = متوقع
        هذا.نوع_فعلي = فعلي
    }
}

/// خطأ الفهرس
///
/// يُستخدم عند الوصول لفهرس خارج حدود المصفوفة
///
/// @مثال
/// ارمِ جديد خطأ_فهرس(١٠، ٥)
صدّر صنف خطأ_فهرس يرث خطأ {
    /// الفهرس المطلوب
    عام فهرس: عدد

    /// طول المصفوفة
    عام طول: عدد

    /// المنشئ
    ///
    /// @معامل فهرس - الفهرس المطلوب
    /// @معامل طول - طول المصفوفة
    منشئ(فهرس: عدد، طول: عدد) {
        متغير رسالة_ع = "الفهرس " + عدد_لنص(فهرس) + " خارج الحدود (الطول: " + عدد_لنص(طول) + ")"
        متغير رسالة_ا = "Index " + عدد_لنص(فهرس) + " out of bounds (length: " + عدد_لنص(طول) + ")"
        الأصل.منشئ_ثنائي(رسالة_ا، رسالة_ع)
        هذا._نوع = "خطأ_فهرس"
        هذا.فهرس = فهرس
        هذا.طول = طول
    }
}

/// خطأ الملف
///
/// يُستخدم عند حدوث مشكلة في عمليات الملفات
///
/// @مثال
/// ارمِ جديد خطأ_ملف("/مسار/ملف.txt"، "الملف غير موجود")
صدّر صنف خطأ_ملف يرث خطأ {
    /// مسار الملف
    عام مسار: نص

    /// نوع العملية
    عام عملية: نص

    /// المنشئ الأساسي
    ///
    /// @معامل مسار - مسار الملف
    /// @معامل رسالة - رسالة الخطأ
    منشئ(مسار: نص، رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_ملف"
        هذا.مسار = مسار
        هذا.عملية = ""
    }

    /// منشئ مع العملية
    ///
    /// @معامل مسار - مسار الملف
    /// @معامل عملية - نوع العملية (قراءة، كتابة، حذف)
    /// @معامل رسالة - رسالة الخطأ
    منشئ_عملية(مسار: نص، عملية: نص، رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_ملف"
        هذا.مسار = مسار
        هذا.عملية = عملية
    }
}

/// خطأ الشبكة
///
/// يُستخدم عند حدوث مشكلة في عمليات الشبكة
///
/// @مثال
/// ارمِ جديد خطأ_شبكة.منشئ_اتصال("192.168.1.1"، ٨٠٨٠، "رفض الاتصال")
صدّر صنف خطأ_شبكة يرث خطأ {
    /// عنوان الخادم
    عام عنوان: نص

    /// رقم المنفذ
    عام منفذ: عدد

    /// كود الخطأ
    عام كود: عدد

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    منشئ(رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = ""
        هذا.منفذ = 0
        هذا.كود = 0
    }

    /// منشئ مع بيانات الاتصال
    ///
    /// @معامل عنوان - عنوان الخادم
    /// @معامل منفذ - رقم المنفذ
    /// @معامل رسالة - رسالة الخطأ
    منشئ_اتصال(عنوان: نص، منفذ: عدد، رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = عنوان
        هذا.منفذ = منفذ
        هذا.كود = 0
    }

    /// منشئ مع كود الخطأ
    ///
    /// @معامل كود - كود الخطأ
    /// @معامل رسالة - رسالة الخطأ
    منشئ_كود(كود: عدد، رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_شبكة"
        هذا.عنوان = ""
        هذا.منفذ = 0
        هذا.كود = كود
    }
}

/// خطأ الصياغة
///
/// يُستخدم عند فشل تحليل نص أو صياغة
///
/// @مثال
/// ارمِ جديد خطأ_صياغة.منشئ_موضع("٢٣abc"، ٢، "حرف غير متوقع")
صدّر صنف خطأ_صياغة يرث خطأ {
    /// النص المُدخل
    عام نص_مدخل: نص

    /// موضع الخطأ
    عام موضع: عدد

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    منشئ(رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_صياغة"
        هذا.نص_مدخل = ""
        هذا.موضع = -1
    }

    /// منشئ مع موضع الخطأ
    ///
    /// @معامل نص_مدخل - النص الذي فشل تحليله
    /// @معامل موضع - موضع الخطأ في النص
    /// @معامل رسالة - رسالة الخطأ
    منشئ_موضع(نص_مدخل: نص، موضع: عدد، رسالة: نص) {
        الأصل.منشئ(رسالة)
        هذا._نوع = "خطأ_صياغة"
        هذا.نص_مدخل = نص_مدخل
        هذا.موضع = موضع
    }
}

