/// وحدة معالجة النصوص
///
/// توفر هذه الوحدة دوال أساسية للتعامل مع النصوص
///
/// @ملاحظة بعض الدوال تتطلب دعم وقت التشغيل
/// @منذ ١.٠.٠

/// تحقق إذا كان النص فارغاً
///
/// @معامل س - النص المراد فحصه
/// @أرجع صحيح إذا كان النص فارغاً
/// @مثال
/// إذا (فارغ(اسم)) {
///     اطبع_سطر("الاسم مطلوب")
/// }
صدّر دالة فارغ(س: نص) -> منطقي {
    أرجع س.طول == 0
}

/// تحقق إذا كان النص يحتوي على جزء معين
///
/// @معامل نص - النص المراد البحث فيه
/// @معامل جزء - الجزء المراد البحث عنه
/// @أرجع صحيح إذا وُجد الجزء
/// @ملاحظة تتطلب تنفيذ وقت التشغيل
صدّر دالة يحتوي(نص: نص، جزء: نص) -> منطقي {
    أرجع خطأ
}

/// تحقق إذا كان النص يبدأ ببادئة معينة
///
/// @معامل نص - النص المراد فحصه
/// @معامل بادئة - البادئة المراد التحقق منها
/// @أرجع صحيح إذا كان النص يبدأ بالبادئة
/// @ملاحظة تتطلب تنفيذ وقت التشغيل
صدّر دالة يبدأ_بـ(نص: نص، بادئة: نص) -> منطقي {
    أرجع خطأ
}

/// تحقق إذا كان النص ينتهي بلاحقة معينة
///
/// @معامل نص - النص المراد فحصه
/// @معامل لاحقة - اللاحقة المراد التحقق منها
/// @أرجع صحيح إذا كان النص ينتهي باللاحقة
/// @ملاحظة تتطلب تنفيذ وقت التشغيل
صدّر دالة ينتهي_بـ(نص: نص، لاحقة: نص) -> منطقي {
    أرجع خطأ
}

/// كرر النص عدداً من المرات
///
/// @معامل نص - النص المراد تكراره
/// @معامل عدد - عدد مرات التكرار
/// @أرجع النص المكرر
/// @ملاحظة تتطلب تنفيذ وقت التشغيل
صدّر دالة كرر(نص: نص، عدد: عدد) -> نص {
    أرجع نص
}

/// قص المسافات من طرفي النص
///
/// @معامل نص - النص المراد قصه
/// @أرجع النص بعد إزالة المسافات
/// @ملاحظة تتطلب تنفيذ وقت التشغيل
صدّر دالة قص(نص: نص) -> نص {
    أرجع نص
}
