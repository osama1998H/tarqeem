/// وحدة الرياضيات
///
/// توفر هذه الوحدة الثوابت والدوال الرياضية الأساسية
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// الثوابت الرياضية
// ═══════════════════════════════════════════

/// النسبة التقريبية (باي)
صدّر ثابت باي = 3.141592653589793

/// عدد أويلر (هـ)
صدّر ثابت هـ = 2.718281828459045

// ═══════════════════════════════════════════
// دوال القيمة المطلقة
// ═══════════════════════════════════════════

/// احسب القيمة المطلقة لعدد صحيح
///
/// @معامل س - العدد المراد حساب قيمته المطلقة
/// @أرجع القيمة المطلقة
/// @مثال
/// متغير ن = مطلق(-5)  // ٥
صدّر دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

/// احسب القيمة المطلقة لعدد عشري
///
/// @معامل س - العدد المراد حساب قيمته المطلقة
/// @أرجع القيمة المطلقة
/// @مثال
/// متغير ن = مطلق_عشري(-3.14)  // ٣.١٤
صدّر دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع -س
    }
    أرجع س
}

// ═══════════════════════════════════════════
// دوال المقارنة
// ═══════════════════════════════════════════

/// أرجع الأقصى بين عددين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع العدد الأكبر
/// @مثال
/// متغير ن = أقصى(5، 3)  // ٥
صدّر دالة أقصى(أ: عدد، ب: عدد) -> عدد {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// أرجع الأدنى بين عددين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع العدد الأصغر
/// @مثال
/// متغير ن = أدنى(5، 3)  // ٣
صدّر دالة أدنى(أ: عدد، ب: عدد) -> عدد {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

// ═══════════════════════════════════════════
// دوال الفحص
// ═══════════════════════════════════════════

/// تحقق إذا كان العدد زوجياً
///
/// @معامل س - العدد المراد فحصه
/// @أرجع صحيح إذا كان زوجياً
/// @مثال
/// إذا (زوجي(4)) {
///     اطبع_سطر("زوجي")
/// }
صدّر دالة زوجي(س: عدد) -> منطقي {
    أرجع س % 2 == 0
}

/// تحقق إذا كان العدد فردياً
///
/// @معامل س - العدد المراد فحصه
/// @أرجع صحيح إذا كان فردياً
/// @مثال
/// إذا (فردي(3)) {
///     اطبع_سطر("فردي")
/// }
صدّر دالة فردي(س: عدد) -> منطقي {
    أرجع س % 2 != 0
}

// ═══════════════════════════════════════════
// دوال الأسس
// ═══════════════════════════════════════════

/// احسب القوة (الأس الصحيح)
///
/// @معامل أساس - العدد الأساسي
/// @معامل أس - الأس
/// @أرجع الناتج
/// @مثال
/// متغير ن = قوة(2، 3)  // ٨
صدّر دالة قوة(أساس: عدد، أس: عدد) -> عدد {
    إذا (أس == 0) {
        أرجع 1
    }
    متغير نتيجة = 1
    متغير ع = 0
    طالما (ع < أس) {
        نتيجة = نتيجة * أساس
        ع = ع + 1
    }
    أرجع نتيجة
}
