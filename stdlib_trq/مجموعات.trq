// مجموعات - Collections Module
// مجموعات - وحدة المجموعات

// قائمة - List class wrapper around arrays
صدّر صنف قائمة<ن> {
    خاص عناصر: مصفوفة<ن>

    منشئ() {
        هذا.عناصر = []
    }

    عام دالة أضف(عنصر: ن) {
        هذا.عناصر.ألحق(عنصر)
    }

    عام دالة طول() -> عدد {
        أرجع هذا.عناصر.طول
    }

    عام دالة احصل(فهرس: عدد) -> ن {
        أرجع هذا.عناصر[فهرس]
    }

    عام دالة حدّد(فهرس: عدد، قيمة: ن) {
        هذا.عناصر[فهرس] = قيمة
    }

    عام دالة فارغ() -> منطقي {
        أرجع هذا.عناصر.طول == 0
    }
}

