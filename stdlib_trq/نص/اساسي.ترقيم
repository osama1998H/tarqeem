صدّر دالة يساوي(أ: نص، ب: نص) -> منطقي {
    أرجع قارن(أ، ب) == 0
}

/// تحقق إذا نصين متساويين (بدون اعتبار الحالة)
///
/// @معامل أ - النص الأول
/// @معامل ب - النص الثاني
