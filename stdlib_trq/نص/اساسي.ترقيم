/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// عمليات القطع
// ═══════════════════════════════════════════

/// قص جزء من النص
///
/// @معامل سلسلة - النص الأصلي
/// @معامل بداية - موضع البداية
/// @معامل عدد_احرف - عدد الأحرف المطلوب قصها
/// @أرجع الجزء المقطوع من النص
/// @مثال
/// متغير جزء = قص("مرحباً بالعالم"، ٠، ٦)  // "مرحباً"
صدّر دالة قص(سلسلة: نص، بداية: عدد، عدد_احرف: عدد) -> نص {
    أرجع __قص_نص__(سلسلة، بداية، عدد_احرف)
}

/// قص النص من موضع معين حتى النهاية
///
/// @معامل سلسلة - النص الأصلي
/// @معامل بداية - موضع البداية
/// @أرجع الجزء من البداية حتى نهاية النص
/// @مثال
/// متغير باقي = قص_من("مرحباً بالعالم"، ٧)  // "بالعالم"
صدّر دالة قص_من(سلسلة: نص، بداية: عدد) -> نص {
    أرجع قص(سلسلة، بداية، طول(سلسلة) - بداية)
}

/// أحصل على أول ن حرف من النص
///
/// @معامل سلسلة - النص الأصلي
/// @معامل ن - عدد الأحرف المطلوبة
/// @أرجع أول ن حرف
/// @ملاحظة يدعم الحروف متعددة البايت (يونيكود)
/// @مثال
/// متغير اول = اول_حروف("مرحباً"، ٣)  // "مرح"
صدّر دالة اول_حروف(سلسلة: نص، ن: عدد) -> نص {
    أرجع __قص_حروف__(سلسلة، 0، ن)
}

/// أحصل على آخر ن حرف من النص
///
/// @معامل سلسلة - النص الأصلي
/// @معامل ن - عدد الأحرف المطلوبة
/// @أرجع آخر ن حرف
/// @ملاحظة يدعم الحروف متعددة البايت (يونيكود)
/// @مثال
/// متغير اخر = اخر_حروف("مرحباً"، ٣)  // "باً"
صدّر دالة اخر_حروف(سلسلة: نص، ن: عدد) -> نص {
    متغير عدد_حروف = طول_حروف(سلسلة)
    إذا (ن >= عدد_حروف) {
        أرجع سلسلة
    }
    أرجع __قص_حروف__(سلسلة، عدد_حروف - ن، ن)
}

/// أحصل على حرف في موضع معين
///
/// @معامل سلسلة - النص الأصلي
/// @معامل فهرس - موضع الحرف (يبدأ من ٠)
/// @أرجع الحرف في الموضع المحدد
/// @ملاحظة يدعم الحروف متعددة البايت (يونيكود)
/// @مثال
/// متغير حرف = حرف_في("مرحباً"، ٠)  // "م"
صدّر دالة حرف_في(سلسلة: نص، فهرس: عدد) -> نص {
    أرجع __حرف_في__(سلسلة، فهرس)
}

