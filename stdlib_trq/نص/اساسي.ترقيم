// الفحص والتحقق
// ═══════════════════════════════════════════

/// تحقق إذا النص فارغ
///
/// @معامل سلسلة - النص المراد فحصه
/// @أرجع صحيح إذا كان النص فارغاً
/// @مثال
/// فارغ("")  // صحيح
/// فارغ("أ")  // خطأ
صدّر دالة فارغ(سلسلة: نص) -> منطقي {
    أرجع طول(سلسلة) == 0
}

/// أحصل على طول النص بالبايت
///
/// @معامل سلسلة - النص المراد قياسه
/// @أرجع طول النص بالبايت
/// @ملاحظة الحروف العربية تأخذ أكثر من بايت واحد
/// @مثال
/// طول("hello")  // ٥
صدّر دالة طول(سلسلة: نص) -> عدد {
    أرجع طول_نص(سلسلة)
}

// Note: طول_حروف, رقمي, حروف_فقط, عربي are now builtin functions

// ═══════════════════════════════════════════
// المقارنة
// ═══════════════════════════════════════════

/// قارن نصين
///
/// @معامل أ - النص الأول
/// @معامل ب - النص الثاني
/// @أرجع ٠ إذا متساويين، سالب إذا أ < ب، موجب إذا أ > ب
/// @مثال
/// قارن("أحمد"، "علي")  // سالب (أحمد قبل علي أبجدياً)
صدّر دالة قارن(أ: نص، ب: نص) -> عدد {
    أرجع قارن_نص(أ، ب)
}

/// تحقق إذا نصين متساويين
///
/// @معامل أ - النص الأول
/// @معامل ب - النص الثاني
/// @أرجع صحيح إذا كانا متساويين
/// @مثال
/// يساوي("مرحباً"، "مرحباً")  // صحيح
صدّر دالة يساوي(أ: نص، ب: نص) -> منطقي {
    أرجع قارن(أ، ب) == 0
}

/// تحقق إذا نصين متساويين (بدون اعتبار الحالة)
///
/// @معامل أ - النص الأول
/// @معامل ب - النص الثاني
/// @أرجع صحيح إذا كانا متساويين بغض النظر عن حالة الأحرف
/// @ملاحظة مفيد للأحرف اللاتينية فقط
/// @مثال
/// يساوي_بدون_حالة("Hello"، "hello")  // صحيح
صدّر دالة يساوي_بدون_حالة(أ: نص، ب: نص) -> منطقي {
    أرجع يساوي(صغير(أ)، صغير(ب))
}

// ═══════════════════════════════════════════
// التحويل
// ═══════════════════════════════════════════

/// حوّل عدداً صحيحاً إلى نص
///
/// @معامل قيمة - العدد المراد تحويله
/// @أرجع التمثيل النصي للعدد
/// @مثال
/// من_عدد(١٢٣)  // "123"
صدّر دالة من_عدد(قيمة: عدد) -> نص {
    أرجع عدد_لنص(قيمة)
}

/// حوّل عدداً عشرياً إلى نص
///
/// @معامل قيمة - العدد العشري المراد تحويله
/// @أرجع التمثيل النصي للعدد العشري
/// @مثال
/// من_عشري(٣.١٤)  // "3.14"
صدّر دالة من_عشري(قيمة: عدد_عشري) -> نص {
    أرجع عشري_لنص(قيمة)
}

/// حوّل قيمة منطقية إلى نص
///
/// @معامل قيمة - القيمة المنطقية
/// @أرجع "صحيح" أو "خطأ"
/// @مثال
/// من_منطقي(صحيح)  // "صحيح"
صدّر دالة من_منطقي(قيمة: منطقي) -> نص {
    أرجع منطقي_لنص(قيمة)
}

/// حوّل نصاً إلى عدد صحيح
///
/// @معامل سلسلة - النص المراد تحويله
/// @أرجع العدد الصحيح
/// @تحذير قد يفشل إذا كان النص ليس رقماً صالحاً
/// @مثال
/// الى_عدد("123")  // ١٢٣
صدّر دالة الى_عدد(سلسلة: نص) -> عدد {
    أرجع نص_لعدد(سلسلة)
}

/// حوّل نصاً إلى عدد عشري
///
/// @معامل سلسلة - النص المراد تحويله
/// @أرجع العدد العشري
/// @تحذير قد يفشل إذا كان النص ليس رقماً صالحاً
/// @مثال
/// الى_عشري("3.14")  // ٣.١٤
صدّر دالة الى_عشري(سلسلة: نص) -> عدد_عشري {
    أرجع نص_لعشري(سلسلة)
}

