/// @مثال
/// قارن("أحمد"، "علي")  // سالب (أحمد قبل علي أبجدياً)
صدّر دالة قارن(أ: نص، ب: نص) -> عدد {
    أرجع __قارن_نص__(أ، ب)
}

/// تحقق إذا نصين متساويين
