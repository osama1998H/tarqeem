/// كرر النص عدة مرات
///
/// @معامل سلسلة - النص المراد تكراره
/// @معامل مرات - عدد مرات التكرار
/// @أرجع النص المكرر
/// @مثال
/// كرر("أ"، ٥)  // "أأأأأ"
صدّر دالة كرر(سلسلة: نص، مرات: عدد) -> نص {
    أرجع كرر_نص(سلسلة، مرات)
}

