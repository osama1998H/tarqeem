/// اعكس النص
///
/// @معامل سلسلة - النص الأصلي
/// @أرجع النص معكوساً
/// @ملاحظة يدعم الحروف متعددة البايت (يونيكود)
/// @مثال
/// اعكس("مرحباً")  // "ًابحرم"
صدّر دالة اعكس(سلسلة: نص) -> نص {
    أرجع اعكس_نص(سلسلة)
}

