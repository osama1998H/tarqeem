/// قسّم النص إلى سطور
///
/// @معامل سلسلة - النص الأصلي
/// @أرجع مصفوفة من السطور
/// @مثال
/// متغير س = سطور("سطر١\nسطر٢")  // ["سطر١"، "سطر٢"]
صدّر دالة سطور(سلسلة: نص) -> مصفوفة<نص> {
    أرجع قسّم(سلسلة، "\n")
}

