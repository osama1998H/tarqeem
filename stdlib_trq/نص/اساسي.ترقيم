/// استبدل أول حدوث (اسم مستعار)
///
/// @معامل سلسلة - النص الأصلي
/// @معامل قديم - النص المراد استبداله
/// @معامل بديل - النص البديل
/// @أرجع النص بعد الاستبدال
صدّر دالة استبدل_اول(سلسلة: نص، قديم: نص، بديل: نص) -> نص {
    أرجع استبدل(سلسلة، قديم، بديل)
}

