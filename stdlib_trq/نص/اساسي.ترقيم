///
/// @معامل قيمة - العدد العشري المراد تحويله
/// @أرجع التمثيل النصي للعدد العشري
/// @مثال
/// من_عشري(٣.١٤)  // "3.14"
صدّر دالة من_عشري(قيمة: عدد_عشري) -> نص {
    أرجع __عشري_لنص__(قيمة)
}

/// حوّل قيمة منطقية إلى نص
///
/// @معامل قيمة - القيمة المنطقية
/// @أرجع "صحيح" أو "خطأ"
/// @مثال
/// من_منطقي(صحيح)  // "صحيح"
صدّر دالة من_منطقي(قيمة: منطقي) -> نص {
    أرجع __منطقي_لنص__(قيمة)
}

/// حوّل نصاً إلى عدد صحيح
///
/// @معامل سلسلة - النص المراد تحويله
/// @أرجع العدد الصحيح
/// @تحذير قد يفشل إذا كان النص ليس رقماً صالحاً
/// @مثال
/// الى_عدد("123")  // ١٢٣
صدّر دالة الى_عدد(سلسلة: نص) -> عدد {
    أرجع __نص_لعدد__(سلسلة)
}

/// حوّل نصاً إلى عدد عشري
///
/// @معامل سلسلة - النص المراد تحويله
/// @أرجع العدد العشري
/// @تحذير قد يفشل إذا كان النص ليس رقماً صالحاً
/// @مثال
/// الى_عشري("3.14")  // ٣.١٤
صدّر دالة الى_عشري(سلسلة: نص) -> عدد_عشري {
    أرجع __نص_لعشري__(سلسلة)
}
