/// @أرجع النص المدموج
/// @مثال
/// متغير نص = ادمج(["أحمد"، "محمد"، "علي"]، " و ")
/// // "أحمد و محمد و علي"
صدّر دالة ادمج(اجزاء: مصفوفة<نص>، فاصل: نص) -> نص {
    أرجع __ادمج__(اجزاء، فاصل)
}

/// قسّم النص إلى سطور
