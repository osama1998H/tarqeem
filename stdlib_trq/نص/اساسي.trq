// نص/اساسي - Basic String Functions
// نص/اساسي - دوال النص الأساسية

// =============================================================================
// Substring operations / عمليات القطع
// =============================================================================

// Get substring by byte indices
// قص النص بفهارس البايت
// Note: Runtime function handles this
صدّر دالة قص(سلسلة: نص، بداية: عدد، عدد_احرف: عدد) -> نص {
    // Uses runtime: trq_string_substr
    أرجع __قص_نص__(سلسلة، بداية، عدد_احرف)
}

// Get substring from start to end
// قص النص من البداية للنهاية
صدّر دالة قص_من(سلسلة: نص، بداية: عدد) -> نص {
    أرجع قص(سلسلة، بداية، طول(سلسلة) - بداية)
}

// Get first n characters (UTF-8 aware)
// أول ن حروف (يدعم يونيكود)
صدّر دالة اول_حروف(سلسلة: نص، ن: عدد) -> نص {
    // Uses runtime: trq_string_substr_chars
    أرجع __قص_حروف__(سلسلة، 0، ن)
}

// Get last n characters (UTF-8 aware)
// آخر ن حروف (يدعم يونيكود)
صدّر دالة اخر_حروف(سلسلة: نص، ن: عدد) -> نص {
    متغير عدد_حروف = طول_حروف(سلسلة)
    إذا (ن >= عدد_حروف) {
        أرجع سلسلة
    }
    أرجع __قص_حروف__(سلسلة، عدد_حروف - ن، ن)
}

// Get character at index (UTF-8 aware)
// احصل على الحرف في الفهرس (يدعم يونيكود)
صدّر دالة حرف_في(سلسلة: نص، فهرس: عدد) -> نص {
    // Uses runtime: trq_string_char_at
    أرجع __حرف_في__(سلسلة، فهرس)
}

// =============================================================================
// Search operations / عمليات البحث
// =============================================================================

// Check if string contains substring
// تحقق إذا النص يحتوي على جزء
صدّر دالة يحتوي(سلسلة: نص، جزء: نص) -> منطقي {
    // Uses runtime: trq_string_contains
    أرجع __يحتوي__(سلسلة، جزء)
}

// Check if string starts with prefix
// تحقق إذا النص يبدأ ببادئة
صدّر دالة يبدأ_بـ(سلسلة: نص، بادئة: نص) -> منطقي {
    // Uses runtime: trq_string_starts_with
    أرجع __يبدأ_بـ__(سلسلة، بادئة)
}

// Check if string ends with suffix
// تحقق إذا النص ينتهي بلاحقة
صدّر دالة ينتهي_بـ(سلسلة: نص، لاحقة: نص) -> منطقي {
    // Uses runtime: trq_string_ends_with
    أرجع __ينتهي_بـ__(سلسلة، لاحقة)
}

// Find index of first occurrence
// ابحث عن أول حدوث
صدّر دالة موضع(سلسلة: نص، جزء: نص) -> عدد {
    // Uses runtime: trq_string_index_of
    أرجع __موضع__(سلسلة، جزء)
}

// Find index of last occurrence
// ابحث عن آخر حدوث
صدّر دالة موضع_اخير(سلسلة: نص، جزء: نص) -> عدد {
    // Uses runtime: trq_string_last_index_of
    أرجع __موضع_اخير__(سلسلة، جزء)
}

// Count occurrences of substring
// عد مرات ظهور الجزء
صدّر دالة عدد_مرات(سلسلة: نص، جزء: نص) -> عدد {
    // Uses runtime: trq_string_count
    أرجع __عدد_مرات__(سلسلة، جزء)
}

// =============================================================================
// Case conversion / تحويل الحالة
// =============================================================================

// Convert to uppercase (ASCII)
// تحويل للأحرف الكبيرة (ASCII)
صدّر دالة كبير(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_to_upper
    أرجع __كبير__(سلسلة)
}

// Convert to lowercase (ASCII)
// تحويل للأحرف الصغيرة (ASCII)
صدّر دالة صغير(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_to_lower
    أرجع __صغير__(سلسلة)
}

// Convert to title case
// تحويل لحالة العنوان
صدّر دالة عنوان(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_to_title
    أرجع __عنوان__(سلسلة)
}

// Reverse string (UTF-8 aware)
// عكس النص (يدعم يونيكود)
صدّر دالة اعكس(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_reverse
    أرجع __اعكس_نص__(سلسلة)
}

// =============================================================================
// Trimming / التنظيف
// =============================================================================

// Trim whitespace from both ends
// إزالة الفراغات من الطرفين
صدّر دالة ازل_فراغات(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_trim
    أرجع __ازل_فراغات__(سلسلة)
}

// Trim whitespace from left
// إزالة الفراغات من اليسار
صدّر دالة ازل_فراغات_يسار(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_trim_left
    أرجع __ازل_فراغات_يسار__(سلسلة)
}

// Trim whitespace from right
// إزالة الفراغات من اليمين
صدّر دالة ازل_فراغات_يمين(سلسلة: نص) -> نص {
    // Uses runtime: trq_string_trim_right
    أرجع __ازل_فراغات_يمين__(سلسلة)
}

// =============================================================================
// Split and Join / التقسيم والدمج
// =============================================================================

// Split string by delimiter
// قسم النص بفاصل
صدّر دالة قسّم(سلسلة: نص، فاصل: نص) -> مصفوفة<نص> {
    // Uses runtime: trq_string_split
    أرجع __قسّم__(سلسلة، فاصل)
}

// Join array of strings with delimiter
// ادمج مصفوفة نصوص بفاصل
صدّر دالة ادمج(اجزاء: مصفوفة<نص>، فاصل: نص) -> نص {
    // Uses runtime: trq_string_join
    أرجع __ادمج__(اجزاء، فاصل)
}

// Split string into lines
// قسم النص لسطور
صدّر دالة سطور(سلسلة: نص) -> مصفوفة<نص> {
    أرجع قسّم(سلسلة، "\n")
}

// =============================================================================
// Replace / الاستبدال
// =============================================================================

// Replace first occurrence
// استبدل أول حدوث
صدّر دالة استبدل(سلسلة: نص، قديم: نص، بديل: نص) -> نص {
    // Uses runtime: trq_string_replace
    أرجع __استبدل__(سلسلة، قديم، بديل)
}

// Replace all occurrences
// استبدل جميع الحدوث
صدّر دالة استبدل_كل(سلسلة: نص، قديم: نص، بديل: نص) -> نص {
    // Uses runtime: trq_string_replace_all
    أرجع __استبدل_كل__(سلسلة، قديم، بديل)
}

// Replace first occurrence (alias)
// استبدل أول حدوث (اسم مستعار)
صدّر دالة استبدل_اول(سلسلة: نص، قديم: نص، بديل: نص) -> نص {
    أرجع استبدل(سلسلة، قديم، بديل)
}

// =============================================================================
// Repeat and Pad / التكرار والحشو
// =============================================================================

// Repeat string n times
// كرر النص ن مرات
صدّر دالة كرر(سلسلة: نص، مرات: عدد) -> نص {
    // Uses runtime: trq_string_repeat
    أرجع __كرر__(سلسلة، مرات)
}

// Pad string on the left
// احشو النص من اليسار
صدّر دالة احشو_يسار(سلسلة: نص، هدف: عدد، حرف: نص) -> نص {
    // Uses runtime: trq_string_pad_left
    أرجع __احشو_يسار__(سلسلة، هدف، حرف)
}

// Pad string on the right
// احشو النص من اليمين
صدّر دالة احشو_يمين(سلسلة: نص، هدف: عدد، حرف: نص) -> نص {
    // Uses runtime: trq_string_pad_right
    أرجع __احشو_يمين__(سلسلة، هدف، حرف)
}

// =============================================================================
// Inspection / الفحص
// =============================================================================

// Check if string is empty
// تحقق إذا النص فارغ
صدّر دالة فارغ(سلسلة: نص) -> منطقي {
    أرجع طول(سلسلة) == 0
}

// Get string length in bytes
// أحصل على طول النص بالبايت
صدّر دالة طول(سلسلة: نص) -> عدد {
    // Uses runtime: trq_string_len
    أرجع __طول_نص__(سلسلة)
}

// Get string length in characters (UTF-8)
// أحصل على طول النص بالحروف (يونيكود)
صدّر دالة طول_حروف(سلسلة: نص) -> عدد {
    // Uses runtime: trq_string_len_chars
    أرجع __طول_حروف__(سلسلة)
}

// Check if string is numeric (digits only)
// تحقق إذا النص رقمي (أرقام فقط)
صدّر دالة رقمي(سلسلة: نص) -> منطقي {
    // Uses runtime: trq_string_is_numeric
    أرجع __رقمي__(سلسلة)
}

// Check if string contains only letters
// تحقق إذا النص حروف فقط
صدّر دالة حروف_فقط(سلسلة: نص) -> منطقي {
    // Uses runtime: trq_string_is_alpha
    أرجع __حروف_فقط__(سلسلة)
}

// Check if string contains only Arabic characters
// تحقق إذا النص عربي فقط
صدّر دالة عربي(سلسلة: نص) -> منطقي {
    // Uses runtime: trq_string_is_arabic
    أرجع __عربي__(سلسلة)
}

// =============================================================================
// Comparison / المقارنة
// =============================================================================

// Compare two strings
// قارن نصين
صدّر دالة قارن(أ: نص، ب: نص) -> عدد {
    // Uses runtime: trq_string_compare
    أرجع __قارن_نص__(أ، ب)
}

// Check if two strings are equal
// تحقق إذا نصين متساويين
صدّر دالة يساوي(أ: نص، ب: نص) -> منطقي {
    أرجع قارن(أ، ب) == 0
}

// Check if strings are equal (case insensitive)
// تحقق إذا نصين متساويين (بدون اعتبار الحالة)
صدّر دالة يساوي_بدون_حالة(أ: نص، ب: نص) -> منطقي {
    أرجع يساوي(صغير(أ)، صغير(ب))
}

// =============================================================================
// Conversion / التحويل
// =============================================================================

// Convert integer to string
// حول عدد لنص
صدّر دالة من_عدد(قيمة: عدد) -> نص {
    // Uses runtime: trq_int_to_string
    أرجع __عدد_لنص__(قيمة)
}

// Convert float to string
// حول عدد عشري لنص
صدّر دالة من_عشري(قيمة: عدد_عشري) -> نص {
    // Uses runtime: trq_float_to_string
    أرجع __عشري_لنص__(قيمة)
}

// Convert boolean to string
// حول منطقي لنص
صدّر دالة من_منطقي(قيمة: منطقي) -> نص {
    // Uses runtime: trq_bool_to_string
    أرجع __منطقي_لنص__(قيمة)
}

// Parse string to integer
// حلل نص لعدد
صدّر دالة الى_عدد(سلسلة: نص) -> عدد {
    // Uses runtime: trq_string_to_int
    أرجع __نص_لعدد__(سلسلة)
}

// Parse string to float
// حلل نص لعدد عشري
صدّر دالة الى_عشري(سلسلة: نص) -> عدد_عشري {
    // Uses runtime: trq_string_to_float
    أرجع __نص_لعشري__(سلسلة)
}

