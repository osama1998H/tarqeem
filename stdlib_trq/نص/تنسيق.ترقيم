// String formatting utilities
// أدوات تنسيق النصوص

// =============================================================================
// Basic Formatting / التنسيق الأساسي
// =============================================================================

// Format string with single value
// نسّق نص بقيمة واحدة
// Example: نسّق("مرحباً {}!"، "أحمد") -> "مرحباً أحمد!"
صدّر دالة نسّق(قالب: نص، قيمة: نص) -> نص {
    أرجع __استبدل__(قالب، "{}"، قيمة)
}

// Format string with two values
// نسّق نص بقيمتين
صدّر دالة نسّق2(قالب: نص، قيمة1: نص، قيمة2: نص) -> نص {
    متغير نتيجة = __استبدل__(قالب، "{}"، قيمة1)
    أرجع __استبدل__(نتيجة، "{}"، قيمة2)
}

// Format string with three values
// نسّق نص بثلاث قيم
صدّر دالة نسّق3(قالب: نص، قيمة1: نص، قيمة2: نص، قيمة3: نص) -> نص {
    متغير نتيجة = __استبدل__(قالب، "{}"، قيمة1)
    نتيجة = __استبدل__(نتيجة، "{}"، قيمة2)
    أرجع __استبدل__(نتيجة، "{}"، قيمة3)
}

// Format string with integer
// نسّق نص بعدد
صدّر دالة نسّق_عدد(قالب: نص، قيمة: عدد) -> نص {
    أرجع نسّق(قالب، __عدد_لنص__(قيمة))
}

// Format string with float
// نسّق نص بعدد عشري
صدّر دالة نسّق_عشري(قالب: نص، قيمة: عدد_عشري) -> نص {
    أرجع نسّق(قالب، __عشري_لنص__(قيمة))
}

// Format string with boolean
// نسّق نص بمنطقي
صدّر دالة نسّق_منطقي(قالب: نص، قيمة: منطقي) -> نص {
    أرجع نسّق(قالب، __منطقي_لنص__(قيمة))
}

// =============================================================================
// Number Formatting / تنسيق الأرقام
// =============================================================================

// Format integer with leading zeros
// نسّق عدد بأصفار بادئة
صدّر دالة بأصفار(قيمة: عدد، عرض: عدد) -> نص {
    متغير نص = __عدد_لنص__(قيمة)
    أرجع __احشو_يسار__(نص، عرض، "0")
}

// Format integer with thousand separators (comma)
// نسّق عدد بفواصل الآلاف
صدّر دالة بفواصل(قيمة: عدد) -> نص {
    متغير نص = __عدد_لنص__(قيمة)
    متغير طول = __طول_نص__(نص)

    إذا (طول <= 3) {
        أرجع نص
    }

    // Build result with commas
    // ابنِ النتيجة بالفواصل
    متغير نتيجة = ""
    متغير عداد = 0
    متغير ع = طول - 1

    طالما (ع >= 0) {
        إذا (عداد > 0 && عداد % 3 == 0) {
            نتيجة = "،" + نتيجة
        }
        نتيجة = __حرف_في__(نص، ع) + نتيجة
        عداد = عداد + 1
        ع = ع - 1
    }

    أرجع نتيجة
}

// Format float with fixed decimal places
// نسّق عدد عشري بخانات عشرية ثابتة
صدّر دالة بخانات(قيمة: عدد_عشري، خانات: عدد) -> نص {
    // Simple implementation: multiply, round, format
    // تنفيذ بسيط: اضرب، قرّب، نسّق
    متغير مضاعف = 1.0
    متغير ع = 0
    طالما (ع < خانات) {
        مضاعف = مضاعف * 10.0
        ع = ع + 1
    }

    متغير مقرّب = __قرّب__(قيمة * مضاعف)
    متغير جزء_صحيح = __اقطع__(مقرّب / مضاعف)
    متغير جزء_عشري = __مطلق_عشري__(مقرّب - جزء_صحيح * مضاعف)

    متغير نص_صحيح = __عدد_لنص__(__اقطع_لعدد__(جزء_صحيح))
    متغير نص_عشري = __عدد_لنص__(__اقطع_لعدد__(جزء_عشري))
    نص_عشري = __احشو_يسار__(نص_عشري، خانات، "0")

    أرجع نص_صحيح + "." + نص_عشري
}

// =============================================================================
// String Alignment / محاذاة النص
// =============================================================================

// Align string to the left with padding
// حاذِ النص لليسار مع حشو
صدّر دالة حاذِ_يسار(نص: نص، عرض: عدد) -> نص {
    أرجع __احشو_يمين__(نص، عرض، " ")
}

// Align string to the right with padding
// حاذِ النص لليمين مع حشو
صدّر دالة حاذِ_يمين(نص: نص، عرض: عدد) -> نص {
    أرجع __احشو_يسار__(نص، عرض، " ")
}

// Center string with padding
// وسّط النص مع حشو
صدّر دالة وسّط(نص: نص، عرض: عدد) -> نص {
    متغير طول_نص = __طول_حروف__(نص)
    إذا (طول_نص >= عرض) {
        أرجع نص
    }

    متغير حشو = عرض - طول_نص
    متغير يسار = حشو / 2
    متغير يمين = حشو - يسار

    أرجع __كرر__(" "، يسار) + نص + __كرر__(" "، يمين)
}

// =============================================================================
// Special Formats / تنسيقات خاصة
// =============================================================================

// Format as percentage
// نسّق كنسبة مئوية
صدّر دالة نسبة(قيمة: عدد_عشري) -> نص {
    متغير نسبة = قيمة * 100.0
    أرجع بخانات(نسبة، 2) + "%"
}

// Format as currency (basic)
// نسّق كعملة (أساسي)
صدّر دالة عملة(قيمة: عدد_عشري، رمز: نص) -> نص {
    أرجع رمز + " " + بخانات(قيمة، 2)
}

// Format as currency - Saudi Riyal
// نسّق كعملة - ريال سعودي
صدّر دالة ريال(قيمة: عدد_عشري) -> نص {
    أرجع بخانات(قيمة، 2) + " ر.س"
}

// Format boolean as Arabic yes/no
// نسّق منطقي كنعم/لا عربي
صدّر دالة نعم_لا(قيمة: منطقي) -> نص {
    إذا (قيمة) {
        أرجع "نعم"
    }
    أرجع "لا"
}

// Format boolean as Arabic true/false
// نسّق منطقي كصحيح/خطأ عربي
صدّر دالة صحيح_خطأ(قيمة: منطقي) -> نص {
    إذا (قيمة) {
        أرجع "صحيح"
    }
    أرجع "خطأ"
}
