/// دوال التنسيق
///
/// أدوات لتنسيق النصوص والأرقام بأشكال مختلفة
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// التنسيق الأساسي
// ═══════════════════════════════════════════

/// نسّق نصاً باستبدال {} بقيمة
///
/// @معامل قالب - قالب النص مع {}
/// @معامل قيمة - القيمة لاستبدال أول {}
/// @أرجع النص المنسق
/// @مثال
/// نسّق("مرحباً {}!"، "أحمد")  // "مرحباً أحمد!"
صدّر دالة نسّق(قالب: نص، قيمة: نص) -> نص {
    أرجع استبدل(قالب، "{}"، قيمة)
}

/// نسّق نصاً بقيمتين
///
/// @معامل قالب - قالب النص مع {} مرتين
/// @معامل قيمة1 - القيمة الأولى
/// @معامل قيمة2 - القيمة الثانية
/// @أرجع النص المنسق
/// @مثال
/// نسّق2("الاسم: {}، العمر: {}"، "أحمد"، "٢٥")
صدّر دالة نسّق2(قالب: نص، قيمة1: نص، قيمة2: نص) -> نص {
    متغير نتيجة = استبدل(قالب، "{}"، قيمة1)
    أرجع استبدل(نتيجة، "{}"، قيمة2)
}

/// نسّق نصاً بثلاث قيم
///
/// @معامل قالب - قالب النص مع {} ثلاث مرات
/// @معامل قيمة1 - القيمة الأولى
/// @معامل قيمة2 - القيمة الثانية
/// @معامل قيمة3 - القيمة الثالثة
/// @أرجع النص المنسق
/// @مثال
/// نسّق3("{} + {} = {}"، "٢"، "٣"، "٥")
صدّر دالة نسّق3(قالب: نص، قيمة1: نص، قيمة2: نص، قيمة3: نص) -> نص {
    متغير نتيجة = استبدل(قالب، "{}"، قيمة1)
    نتيجة = استبدل(نتيجة، "{}"، قيمة2)
    أرجع استبدل(نتيجة، "{}"، قيمة3)
}

/// نسّق نصاً بعدد صحيح
///
/// @معامل قالب - قالب النص مع {}
/// @معامل قيمة - العدد الصحيح
/// @أرجع النص المنسق
/// @مثال
/// نسّق_عدد("العمر: {} سنة"، ٢٥)
صدّر دالة نسّق_عدد(قالب: نص، قيمة: عدد) -> نص {
    أرجع نسّق(قالب، عدد_لنص(قيمة))
}

/// نسّق نصاً بعدد عشري
///
/// @معامل قالب - قالب النص مع {}
/// @معامل قيمة - العدد العشري
/// @أرجع النص المنسق
/// @مثال
/// نسّق_عشري("السعر: {} ريال"، ٩٩.٩٩)
صدّر دالة نسّق_عشري(قالب: نص، قيمة: عدد_عشري) -> نص {
    أرجع نسّق(قالب، عشري_لنص(قيمة))
}

/// نسّق نصاً بقيمة منطقية
///
/// @معامل قالب - قالب النص مع {}
/// @معامل قيمة - القيمة المنطقية
/// @أرجع النص المنسق
/// @مثال
/// نسّق_منطقي("نشط: {}"، صحيح)
صدّر دالة نسّق_منطقي(قالب: نص، قيمة: منطقي) -> نص {
    أرجع نسّق(قالب، منطقي_لنص(قيمة))
}

// ═══════════════════════════════════════════
// تنسيق الأرقام
// ═══════════════════════════════════════════

/// نسّق عدداً بأصفار بادئة
///
/// @معامل قيمة - العدد المراد تنسيقه
/// @معامل عرض - العرض الإجمالي المطلوب
/// @أرجع العدد بأصفار بادئة
/// @مثال
/// بأصفار(٥، ٣)  // "005"
/// بأصفار(٤٢، ٥)  // "00042"
صدّر دالة بأصفار(قيمة: عدد، عرض: عدد) -> نص {
    متغير نص = عدد_لنص(قيمة)
    أرجع احشو_يسار(نص، عرض، "0")
}

/// نسّق عدداً بفواصل الآلاف
///
/// @معامل قيمة - العدد المراد تنسيقه
/// @أرجع العدد بفواصل الآلاف
/// @مثال
/// بفواصل(١٠٠٠٠٠٠)  // "1،000،000"
صدّر دالة بفواصل(قيمة: عدد) -> نص {
    متغير نص = عدد_لنص(قيمة)
    متغير طول = طول_نص(نص)

    إذا (طول <= 3) {
        أرجع نص
    }

    متغير نتيجة = ""
    متغير عداد = 0
    متغير ع = طول - 1

    طالما (ع >= 0) {
        إذا (عداد > 0 && عداد % 3 == 0) {
            نتيجة = "،" + نتيجة
        }
        نتيجة = حرف_في(نص، ع) + نتيجة
        عداد = عداد + 1
        ع = ع - 1
    }

    أرجع نتيجة
}

/// نسّق عدداً عشرياً بخانات عشرية ثابتة
///
/// @معامل قيمة - العدد العشري
/// @معامل خانات - عدد الخانات العشرية
/// @أرجع العدد بالخانات المحددة
/// @مثال
/// بخانات(٣.١٤١٥٩، ٢)  // "3.14"
صدّر دالة بخانات(قيمة: عدد_عشري، خانات: عدد) -> نص {
    متغير مضاعف = 1.0
    متغير ع = 0
    طالما (ع < خانات) {
        مضاعف = مضاعف * 10.0
        ع = ع + 1
    }

    متغير مقرّب = قرّب(قيمة * مضاعف)
    متغير جزء_صحيح = اقطع(مقرّب / مضاعف)
    متغير جزء_عشري = مطلق_عشري(مقرّب - جزء_صحيح * مضاعف)

    متغير نص_صحيح = عدد_لنص(اقطع_لعدد(جزء_صحيح))
    متغير نص_عشري = عدد_لنص(اقطع_لعدد(جزء_عشري))
    نص_عشري = احشو_يسار(نص_عشري، خانات، "0")

    أرجع نص_صحيح + "." + نص_عشري
}

// ═══════════════════════════════════════════
// محاذاة النص
// ═══════════════════════════════════════════

/// حاذِ النص لليسار مع حشو
///
/// @معامل نص - النص المراد محاذاته
/// @معامل عرض - العرض الإجمالي
/// @أرجع النص محاذى لليسار
/// @مثال
/// حاذِ_يسار("أحمد"، ١٠)  // "أحمد      "
صدّر دالة حاذِ_يسار(نص: نص، عرض: عدد) -> نص {
    أرجع احشو_يمين(نص، عرض، " ")
}

/// حاذِ النص لليمين مع حشو
///
/// @معامل نص - النص المراد محاذاته
/// @معامل عرض - العرض الإجمالي
/// @أرجع النص محاذى لليمين
/// @مثال
/// حاذِ_يمين("أحمد"، ١٠)  // "      أحمد"
صدّر دالة حاذِ_يمين(نص: نص، عرض: عدد) -> نص {
    أرجع احشو_يسار(نص، عرض، " ")
}

/// وسّط النص مع حشو
///
/// @معامل نص - النص المراد توسيطه
/// @معامل عرض - العرض الإجمالي
/// @أرجع النص موسطاً
/// @مثال
/// وسّط("عنوان"، ٢٠)  // "       عنوان        "
صدّر دالة وسّط(نص: نص، عرض: عدد) -> نص {
    متغير طول_نص = طول_حروف(نص)
    إذا (طول_نص >= عرض) {
        أرجع نص
    }

    متغير حشو = عرض - طول_نص
    متغير يسار = حشو / 2
    متغير يمين = حشو - يسار

    أرجع كرر_نص(" "، يسار) + نص + كرر_نص(" "، يمين)
}

// ═══════════════════════════════════════════
// تنسيقات خاصة
// ═══════════════════════════════════════════

/// نسّق كنسبة مئوية
///
/// @معامل قيمة - القيمة (٠.٠ إلى ١.٠)
/// @أرجع النسبة المئوية
/// @مثال
/// نسبة(٠.٧٥)  // "75.00%"
صدّر دالة نسبة(قيمة: عدد_عشري) -> نص {
    متغير نسبة = قيمة * 100.0
    أرجع بخانات(نسبة، 2) + "%"
}

/// نسّق كعملة
///
/// @معامل قيمة - المبلغ
/// @معامل رمز - رمز العملة
/// @أرجع المبلغ منسقاً بالعملة
/// @مثال
/// عملة(٩٩.٩٩، "$")  // "$ 99.99"
صدّر دالة عملة(قيمة: عدد_عشري، رمز: نص) -> نص {
    أرجع رمز + " " + بخانات(قيمة، 2)
}

/// نسّق كريال سعودي
///
/// @معامل قيمة - المبلغ بالريال
/// @أرجع المبلغ بصيغة الريال السعودي
/// @مثال
/// ريال(٥٠٠.٠٠)  // "500.00 ر.س"
صدّر دالة ريال(قيمة: عدد_عشري) -> نص {
    أرجع بخانات(قيمة، 2) + " ر.س"
}

/// نسّق قيمة منطقية كنعم/لا
///
/// @معامل قيمة - القيمة المنطقية
/// @أرجع "نعم" أو "لا"
/// @مثال
/// نعم_لا(صحيح)  // "نعم"
صدّر دالة نعم_لا(قيمة: منطقي) -> نص {
    إذا (قيمة) {
        أرجع "نعم"
    }
    أرجع "لا"
}

/// نسّق قيمة منطقية كصحيح/خطأ
///
/// @معامل قيمة - القيمة المنطقية
/// @أرجع "صحيح" أو "خطأ"
/// @مثال
/// صحيح_خطأ(خطأ)  // "خطأ"
صدّر دالة صحيح_خطأ(قيمة: منطقي) -> نص {
    إذا (قيمة) {
        أرجع "صحيح"
    }
    أرجع "خطأ"
}

