/// صنف باني النص
///
/// يُستخدم لبناء النصوص بكفاءة عالية عند دمج عدة أجزاء
/// بدلاً من استخدام عامل الجمع (+) المتكرر
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// صنف باني النص
// ═══════════════════════════════════════════

/// صنف باني النص
///
/// يوفر طريقة فعالة لبناء النصوص الطويلة
/// من خلال تجميع الأجزاء ثم دمجها مرة واحدة
///
/// @مثال
/// متغير ب = جديد باني_نص()
/// ب.اضف("مرحباً")
/// ب.مسافة()
/// ب.اضف("بالعالم")
/// اطبع(ب.بناء())  // "مرحباً بالعالم"
صدّر صنف باني_نص {
    /// مصفوفة الأجزاء الداخلية
    خاص _اجزاء: مصفوفة<نص>

    /// عدد الأجزاء المُضافة
    خاص _عدد: عدد

    /// المنشئ - ينشئ باني نص فارغ
    منشئ() {
        هذا._اجزاء = []
        هذا._عدد = 0
    }

    /// أضف نصاً للباني
    ///
    /// @معامل جزء - النص المراد إضافته
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف("مرحباً").اضف(" ").اضف("بالعالم")
    عام دالة اضف(جزء: نص) -> باني_نص {
        الحق(هذا._اجزاء، جزء)
        هذا._عدد = هذا._عدد + 1
        أرجع هذا
    }

    /// أضف نصاً متبوعاً بسطر جديد
    ///
    /// @معامل جزء - النص المراد إضافته
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف_سطر("السطر الأول")
    /// ب.اضف_سطر("السطر الثاني")
    عام دالة اضف_سطر(جزء: نص) -> باني_نص {
        هذا.اضف(جزء)
        هذا.اضف("\n")
        أرجع هذا
    }

    /// أضف سطراً جديداً فقط
    ///
    /// @أرجع الباني نفسه (للتسلسل)
    عام دالة سطر_جديد() -> باني_نص {
        هذا.اضف("\n")
        أرجع هذا
    }

    /// أضف نصاً منسقاً باستبدال {} بالقيمة
    ///
    /// @معامل قالب - قالب النص مع {}
    /// @معامل قيمة - القيمة لاستبدال {}
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف_منسق("مرحباً {}"، "أحمد")  // "مرحباً أحمد"
    عام دالة اضف_منسق(قالب: نص، قيمة: نص) -> باني_نص {
        متغير نتيجة = استبدل(قالب، "{}"، قيمة)
        هذا.اضف(نتيجة)
        أرجع هذا
    }

    /// أضف عدداً صحيحاً
    ///
    /// @معامل قيمة - العدد المراد إضافته
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف("العمر: ").اضف_عدد(٢٥)
    عام دالة اضف_عدد(قيمة: عدد) -> باني_نص {
        هذا.اضف(عدد_لنص(قيمة))
        أرجع هذا
    }

    /// أضف عدداً عشرياً
    ///
    /// @معامل قيمة - العدد العشري المراد إضافته
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف("السعر: ").اضف_عشري(٩٩.٩٩)
    عام دالة اضف_عشري(قيمة: عدد_عشري) -> باني_نص {
        هذا.اضف(عشري_لنص(قيمة))
        أرجع هذا
    }

    /// أضف قيمة منطقية
    ///
    /// @معامل قيمة - القيمة المنطقية المراد إضافتها
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف("نشط: ").اضف_منطقي(صحيح)
    عام دالة اضف_منطقي(قيمة: منطقي) -> باني_نص {
        هذا.اضف(منطقي_لنص(قيمة))
        أرجع هذا
    }

    /// أضف مسافة واحدة
    ///
    /// @أرجع الباني نفسه (للتسلسل)
    عام دالة مسافة() -> باني_نص {
        هذا.اضف(" ")
        أرجع هذا
    }

    /// أضف مسافة جدولة (تاب)
    ///
    /// @أرجع الباني نفسه (للتسلسل)
    عام دالة مسافة_جدول() -> باني_نص {
        هذا.اضف("\t")
        أرجع هذا
    }

    /// أضف نصاً مكرراً عدة مرات
    ///
    /// @معامل جزء - النص المراد تكراره
    /// @معامل مرات - عدد مرات التكرار
    /// @أرجع الباني نفسه (للتسلسل)
    /// @مثال
    /// ب.اضف_مكرر("="، ٢٠)  // "===================="
    عام دالة اضف_مكرر(جزء: نص، مرات: عدد) -> باني_نص {
        متغير ع = 0
        طالما (ع < مرات) {
            هذا.اضف(جزء)
            ع = ع + 1
        }
        أرجع هذا
    }

    /// امسح جميع المحتويات
    ///
    /// @أرجع الباني نفسه (للتسلسل)
    عام دالة امسح() -> باني_نص {
        هذا._اجزاء = []
        هذا._عدد = 0
        أرجع هذا
    }

    /// أحصل على عدد الأجزاء المُضافة
    ///
    /// @أرجع عدد الأجزاء
    عام دالة عدد_اجزاء() -> عدد {
        أرجع هذا._عدد
    }

    /// تحقق إذا الباني فارغ
    ///
    /// @أرجع صحيح إذا لم تُضف أي أجزاء
    عام دالة فارغ() -> منطقي {
        أرجع هذا._عدد == 0
    }

    /// أحصل على الطول الإجمالي للنص المبني
    ///
    /// @أرجع الطول بالبايت
    عام دالة طول() -> عدد {
        متغير المجموع = 0
        متغير ع = 0
        طالما (ع < هذا._عدد) {
            المجموع = المجموع + طول_نص(هذا._اجزاء[ع])
            ع = ع + 1
        }
        أرجع المجموع
    }

    /// ابنِ النص النهائي
    ///
    /// @أرجع النص المجمّع من كل الأجزاء
    /// @مثال
    /// متغير نص = ب.بناء()
    عام دالة بناء() -> نص {
        أرجع ادمج(هذا._اجزاء، "")
    }

    /// حوّل الباني إلى نص (مثل بناء)
    ///
    /// @أرجع النص المجمّع من كل الأجزاء
    عام دالة الى_نص() -> نص {
        أرجع هذا.بناء()
    }
}

// ═══════════════════════════════════════════
// دوال مساعدة
// ═══════════════════════════════════════════

/// أنشئ باني نص جديد فارغ
///
/// @أرجع باني نص جديد
/// @مثال
/// متغير ب = باني_جديد()
صدّر دالة باني_جديد() -> باني_نص {
    أرجع جديد باني_نص()
}

/// أنشئ باني نص بمحتوى ابتدائي
///
/// @معامل نص - النص الابتدائي
/// @أرجع باني نص يحتوي على النص المُعطى
/// @مثال
/// متغير ب = باني_من("مرحباً")
صدّر دالة باني_من(نص: نص) -> باني_نص {
    متغير ب = جديد باني_نص()
    ب.اضف(نص)
    أرجع ب
}

