// نص/بناء - StringBuilder Class
// نص/بناء - صنف باني النص

// StringBuilder for efficient string concatenation
// باني النص للدمج الفعال

// استورد { قائمة } من "../مجموعات"

// =============================================================================
// باني_نص - StringBuilder class
// =============================================================================

صدّر صنف باني_نص {
    خاص _اجزاء: مصفوفة<نص>
    خاص _عدد: عدد

    // Constructor - empty
    // المنشئ - فارغ
    منشئ() {
        هذا._اجزاء = []
        هذا._عدد = 0
    }

    // Constructor - with initial string
    // المنشئ - مع نص ابتدائي
    // Note: Overloaded constructors need compiler support
    // منشئ_نص(نص_اولي: نص) {
    //     هذا._اجزاء = [نص_اولي]
    //     هذا._عدد = 1
    // }

    // Add text
    // أضف نص
    عام دالة اضف(جزء: نص) -> باني_نص {
        // Note: Array operations use __الحق__ intrinsic
        __الحق__(هذا._اجزاء، جزء)
        هذا._عدد = هذا._عدد + 1
        أرجع هذا
    }

    // Add text with newline
    // أضف نص مع سطر جديد
    عام دالة اضف_سطر(جزء: نص) -> باني_نص {
        هذا.اضف(جزء)
        هذا.اضف("\n")
        أرجع هذا
    }

    // Add newline
    // أضف سطر جديد
    عام دالة سطر_جديد() -> باني_نص {
        هذا.اضف("\n")
        أرجع هذا
    }

    // Add formatted text
    // أضف نص منسق
    عام دالة اضف_منسق(قالب: نص، قيمة: نص) -> باني_نص {
        // Simple replacement of {} with value
        // استبدال بسيط لـ {} بالقيمة
        متغير نتيجة = __استبدل__(قالب، "{}"، قيمة)
        هذا.اضف(نتيجة)
        أرجع هذا
    }

    // Add integer
    // أضف عدد
    عام دالة اضف_عدد(قيمة: عدد) -> باني_نص {
        هذا.اضف(__عدد_لنص__(قيمة))
        أرجع هذا
    }

    // Add float
    // أضف عدد عشري
    عام دالة اضف_عشري(قيمة: عدد_عشري) -> باني_نص {
        هذا.اضف(__عشري_لنص__(قيمة))
        أرجع هذا
    }

    // Add boolean
    // أضف منطقي
    عام دالة اضف_منطقي(قيمة: منطقي) -> باني_نص {
        هذا.اضف(__منطقي_لنص__(قيمة))
        أرجع هذا
    }

    // Add space
    // أضف مسافة
    عام دالة مسافة() -> باني_نص {
        هذا.اضف(" ")
        أرجع هذا
    }

    // Add tab
    // أضف مسافة جدولة
    عام دالة مسافة_جدول() -> باني_نص {
        هذا.اضف("\t")
        أرجع هذا
    }

    // Add repeated text
    // أضف نص مكرر
    عام دالة اضف_مكرر(جزء: نص، مرات: عدد) -> باني_نص {
        متغير ع = 0
        طالما (ع < مرات) {
            هذا.اضف(جزء)
            ع = ع + 1
        }
        أرجع هذا
    }

    // Clear contents
    // امسح المحتويات
    عام دالة امسح() -> باني_نص {
        هذا._اجزاء = []
        هذا._عدد = 0
        أرجع هذا
    }

    // Get number of parts
    // أحصل على عدد الأجزاء
    عام دالة عدد_اجزاء() -> عدد {
        أرجع هذا._عدد
    }

    // Check if empty
    // تحقق إذا فارغ
    عام دالة فارغ() -> منطقي {
        أرجع هذا._عدد == 0
    }

    // Get current length (in bytes)
    // أحصل على الطول الحالي (بالبايت)
    عام دالة طول() -> عدد {
        متغير المجموع = 0
        متغير ع = 0
        طالما (ع < هذا._عدد) {
            المجموع = المجموع + __طول_نص__(هذا._اجزاء[ع])
            ع = ع + 1
        }
        أرجع المجموع
    }

    // Build final string
    // ابنِ النص النهائي
    عام دالة بناء() -> نص {
        أرجع __ادمج__(هذا._اجزاء، "")
    }

    // Alias for بناء
    // اسم مستعار لـ بناء
    عام دالة الى_نص() -> نص {
        أرجع هذا.بناء()
    }
}

// =============================================================================
// Helper functions / دوال مساعدة
// =============================================================================

// Create a new StringBuilder
// أنشئ باني نص جديد
صدّر دالة باني_جديد() -> باني_نص {
    أرجع جديد باني_نص()
}

// Create a StringBuilder with initial content
// أنشئ باني نص بمحتوى ابتدائي
صدّر دالة باني_من(نص: نص) -> باني_نص {
    متغير ب = جديد باني_نص()
    ب.اضف(نص)
    أرجع ب
}
