/// عمليات المجلدات
///
/// تحتوي هذه الوحدة على صنف المجلد ودوال التعامل مع المجلدات
///
/// @منذ ١.٠.٠

استورد { مسار } من "./مسار"

// ═══════════════════════════════════════════
// صنف المجلد
// ═══════════════════════════════════════════

/// صنف المجلد
///
/// يمثل مجلداً في نظام الملفات ويوفر عمليات
/// الإدراج والإنشاء والحذف
///
/// @مثال
/// متغير م = جديد مجلد("/home/user/مستندات")
/// لكل ملف في م.ملفات() {
///     اطبع(ملف)
/// }
صدّر صنف مجلد {
    /// مسار المجلد
    خاص _مسار: نص

    /// المنشئ
    ///
    /// @معامل مسار - مسار المجلد
    منشئ(مسار: نص) {
        هذا._مسار = مسار
    }

    /// أحصل على مسار المجلد
    ///
    /// @أرجع مسار المجلد كنص
    عام دالة مسار() -> نص {
        أرجع هذا._مسار
    }

    /// أحصل على المسار ككائن مسار
    ///
    /// @أرجع كائن مسار
    عام دالة كمسار() -> مسار {
        أرجع جديد مسار(هذا._مسار)
    }

    /// تحقق إذا المجلد موجود
    ///
    /// @أرجع صحيح إذا كان المجلد موجوداً
    عام دالة موجود() -> منطقي {
        أرجع __هل_مجلد__(هذا._مسار)
    }

    /// أنشئ المجلد
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @ملاحظة يفشل إذا كان المجلد الأب غير موجود
    عام دالة انشئ() -> منطقي {
        أرجع __انشئ_مجلد__(هذا._مسار)
    }

    /// أنشئ المجلد وكل المجلدات الأب
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @مثال
    /// متغير م = جديد مجلد("/a/b/c/d")
    /// م.انشئ_كل()  // ينشئ a، b، c، d
    عام دالة انشئ_كل() -> منطقي {
        أرجع __انشئ_مجلدات__(هذا._مسار)
    }

    /// احذف المجلد
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @تحذير يجب أن يكون المجلد فارغاً
    عام دالة احذف() -> منطقي {
        أرجع __احذف_مجلد__(هذا._مسار)
    }

    /// أدرج محتويات المجلد
    ///
    /// @أرجع مصفوفة بأسماء الملفات والمجلدات
    عام دالة محتويات() -> مصفوفة<نص> {
        أرجع __ادرج_مجلد__(هذا._مسار)
    }

    /// أدرج الملفات فقط
    ///
    /// @أرجع مصفوفة بأسماء الملفات
    عام دالة ملفات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = __ادمج_مسار__(هذا._مسار، عنصر)
            إذا (__هل_ملف__(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    /// أدرج المجلدات الفرعية فقط
    ///
    /// @أرجع مصفوفة بأسماء المجلدات الفرعية
    عام دالة مجلدات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = __ادمج_مسار__(هذا._مسار، عنصر)
            إذا (__هل_مجلد__(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    /// أحصل على المجلد الأب
    ///
    /// @أرجع كائن مجلد للأب
    عام دالة اب() -> مجلد {
        متغير مسار_اب = __مسار_اب__(هذا._مسار)
        أرجع جديد مجلد(مسار_اب)
    }

    /// أحصل على مسار ملف داخل المجلد
    ///
    /// @معامل اسم - اسم الملف
    /// @أرجع المسار الكامل للملف
    عام دالة ملف(اسم: نص) -> نص {
        أرجع __ادمج_مسار__(هذا._مسار، اسم)
    }

    /// أحصل على مجلد فرعي
    ///
    /// @معامل اسم - اسم المجلد الفرعي
    /// @أرجع كائن مجلد للمجلد الفرعي
    عام دالة مجلد_فرعي(اسم: نص) -> مجلد {
        متغير مسار_فرعي = __ادمج_مسار__(هذا._مسار، اسم)
        أرجع جديد مجلد(مسار_فرعي)
    }

    /// تحقق إذا المجلد فارغ
    ///
    /// @أرجع صحيح إذا كان المجلد لا يحتوي على عناصر
    عام دالة فارغ() -> منطقي {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول() == 0
    }

    /// عدّ العناصر في المجلد
    ///
    /// @أرجع عدد الملفات والمجلدات
    عام دالة عدد_عناصر() -> عدد {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول()
    }

    /// أحصل على اسم المجلد
    ///
    /// @أرجع اسم المجلد فقط (بدون المسار)
    عام دالة اسم() -> نص {
        أرجع __اسم_ملف__(هذا._مسار)
    }
}

// ═══════════════════════════════════════════
// دوال المجلدات
// ═══════════════════════════════════════════

/// أنشئ مجلداً
///
/// @معامل مسار - مسار المجلد
/// @أرجع صحيح إذا نجحت العملية
صدّر دالة انشئ_مجلد(مسار: نص) -> منطقي {
    أرجع __انشئ_مجلد__(مسار)
}

/// أنشئ مجلداً مع كل المجلدات الأب
///
/// @معامل مسار - مسار المجلد
/// @أرجع صحيح إذا نجحت العملية
صدّر دالة انشئ_مجلدات(مسار: نص) -> منطقي {
    أرجع __انشئ_مجلدات__(مسار)
}

/// احذف مجلداً
///
/// @معامل مسار - مسار المجلد
/// @أرجع صحيح إذا نجحت العملية
/// @تحذير يجب أن يكون المجلد فارغاً
صدّر دالة احذف_مجلد(مسار: نص) -> منطقي {
    أرجع __احذف_مجلد__(مسار)
}

/// أدرج محتويات مجلد
///
/// @معامل مسار - مسار المجلد
/// @أرجع مصفوفة بأسماء المحتويات
صدّر دالة ادرج_مجلد(مسار: نص) -> مصفوفة<نص> {
    أرجع __ادرج_مجلد__(مسار)
}

/// تحقق إذا المسار يشير لمجلد
///
/// @معامل مسار - المسار المراد فحصه
/// @أرجع صحيح إذا كان المسار يشير لمجلد
صدّر دالة هل_مجلد(مسار: نص) -> منطقي {
    أرجع __هل_مجلد__(مسار)
}

/// أحصل على مجلد العمل الحالي كنص
///
/// @أرجع مسار مجلد العمل الحالي
صدّر دالة المجلد_الحالي() -> نص {
    أرجع __مجلد_حالي__()
}

/// أحصل على مجلد المستخدم كنص
///
/// @أرجع مسار مجلد المستخدم
صدّر دالة مجلد_المستخدم() -> نص {
    أرجع __مجلد_مستخدم__()
}

/// أحصل على مجلد الملفات المؤقتة كنص
///
/// @أرجع مسار مجلد المؤقت
صدّر دالة مجلد_المؤقت() -> نص {
    أرجع __مجلد_مؤقت__()
}

// ═══════════════════════════════════════════
// دوال إنشاء سريعة
// ═══════════════════════════════════════════

/// افتح مجلداً موجوداً
///
/// @معامل مسار - مسار المجلد
/// @أرجع كائن مجلد
صدّر دالة افتح_مجلد(مسار: نص) -> مجلد {
    أرجع جديد مجلد(مسار)
}

/// أحصل على المجلد الحالي ككائن
///
/// @أرجع كائن مجلد للمجلد الحالي
/// @مثال
/// متغير م = هنا()
/// لكل ملف في م.ملفات() {
///     اطبع(ملف)
/// }
صدّر دالة هنا() -> مجلد {
    أرجع جديد مجلد(__مجلد_حالي__())
}

/// أحصل على مجلد المستخدم ككائن
///
/// @أرجع كائن مجلد لمجلد المستخدم
صدّر دالة بيت() -> مجلد {
    أرجع جديد مجلد(__مجلد_مستخدم__())
}

/// أحصل على مجلد المؤقت ككائن
///
/// @أرجع كائن مجلد لمجلد المؤقت
صدّر دالة مؤقت() -> مجلد {
    أرجع جديد مجلد(__مجلد_مؤقت__())
}
