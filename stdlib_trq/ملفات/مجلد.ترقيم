/// عمليات المجلدات
///
/// تحتوي هذه الوحدة على صنف المجلد ودوال التعامل مع المجلدات
///
/// @منذ ١.٠.٠

استورد { مسار } من "./مسار"

// ═══════════════════════════════════════════
// صنف المجلد
// ═══════════════════════════════════════════

/// صنف المجلد
///
/// يمثل مجلداً في نظام الملفات ويوفر عمليات
/// الإدراج والإنشاء والحذف
///
/// @مثال
/// متغير م = جديد مجلد("/home/user/مستندات")
/// لكل ملف في م.ملفات() {
///     اطبع(ملف)
/// }
صدّر صنف مجلد {
    /// مسار المجلد
    خاص _مسار: نص

    /// المنشئ
    ///
    /// @معامل مسار - مسار المجلد
    منشئ(مسار: نص) {
        هذا._مسار = مسار
    }

    /// أحصل على مسار المجلد
    ///
    /// @أرجع مسار المجلد كنص
    عام دالة مسار() -> نص {
        أرجع هذا._مسار
    }

    /// أحصل على المسار ككائن مسار
    ///
    /// @أرجع كائن مسار
    عام دالة كمسار() -> مسار {
        أرجع جديد مسار(هذا._مسار)
    }

    /// تحقق إذا المجلد موجود
    ///
    /// @أرجع صحيح إذا كان المجلد موجوداً
    عام دالة موجود() -> منطقي {
        أرجع هل_مجلد(هذا._مسار)
    }

    /// أنشئ المجلد
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @ملاحظة يفشل إذا كان المجلد الأب غير موجود
    عام دالة انشئ() -> منطقي {
        أرجع انشئ_مجلد(هذا._مسار)
    }

    /// احذف المجلد
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @تحذير يجب أن يكون المجلد فارغاً
    عام دالة احذف() -> منطقي {
        أرجع احذف_مجلد(هذا._مسار)
    }

    /// أدرج محتويات المجلد
    ///
    /// @أرجع مصفوفة بأسماء الملفات والمجلدات
    عام دالة محتويات() -> مصفوفة<نص> {
        أرجع قائمة_مجلد(هذا._مسار)
    }

    /// أدرج الملفات فقط
    ///
    /// @أرجع مصفوفة بأسماء الملفات
    عام دالة ملفات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = ادمج_مسار(هذا._مسار، عنصر)
            إذا (هل_ملف(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    /// أدرج المجلدات الفرعية فقط
    ///
    /// @أرجع مصفوفة بأسماء المجلدات الفرعية
    عام دالة مجلدات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = ادمج_مسار(هذا._مسار، عنصر)
            إذا (هل_مجلد(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    /// أحصل على المجلد الأب
    ///
    /// @أرجع كائن مجلد للأب
    عام دالة اب() -> مجلد {
        متغير مسار_الاب = مسار_اب(هذا._مسار)
        أرجع جديد مجلد(مسار_الاب)
    }

    /// أحصل على مسار ملف داخل المجلد
    ///
    /// @معامل اسم - اسم الملف
    /// @أرجع المسار الكامل للملف
    عام دالة ملف(اسم: نص) -> نص {
        أرجع ادمج_مسار(هذا._مسار، اسم)
    }

    /// أحصل على مجلد فرعي
    ///
    /// @معامل اسم - اسم المجلد الفرعي
    /// @أرجع كائن مجلد للمجلد الفرعي
    عام دالة مجلد_فرعي(اسم: نص) -> مجلد {
        متغير مسار_فرعي = ادمج_مسار(هذا._مسار، اسم)
        أرجع جديد مجلد(مسار_فرعي)
    }

    /// تحقق إذا المجلد فارغ
    ///
    /// @أرجع صحيح إذا كان المجلد لا يحتوي على عناصر
    عام دالة فارغ() -> منطقي {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول() == 0
    }

    /// عدّ العناصر في المجلد
    ///
    /// @أرجع عدد الملفات والمجلدات
    عام دالة عدد_عناصر() -> عدد {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول()
    }

    /// أحصل على اسم المجلد
    ///
    /// @أرجع اسم المجلد فقط (بدون المسار)
    عام دالة اسم() -> نص {
        أرجع اسم_ملف(هذا._مسار)
    }
}

// ═══════════════════════════════════════════
// دوال إنشاء سريعة
// ═══════════════════════════════════════════

/// افتح مجلداً موجوداً
///
/// @معامل مسار - مسار المجلد
/// @أرجع كائن مجلد
صدّر دالة افتح_مجلد(مسار: نص) -> مجلد {
    أرجع جديد مجلد(مسار)
}

/// أحصل على المجلد الحالي ككائن
///
/// @أرجع كائن مجلد للمجلد الحالي
/// @مثال
/// متغير م = هنا()
/// لكل ملف في م.ملفات() {
///     اطبع(ملف)
/// }
صدّر دالة هنا() -> مجلد {
    أرجع جديد مجلد(مجلد_حالي())
}

/// أحصل على مجلد المستخدم ككائن
///
/// @أرجع كائن مجلد لمجلد المستخدم
صدّر دالة بيت() -> مجلد {
    أرجع جديد مجلد(مجلد_مستخدم())
}

/// أحصل على مجلد المؤقت ككائن
///
/// @أرجع كائن مجلد لمجلد المؤقت
صدّر دالة مؤقت() -> مجلد {
    أرجع جديد مجلد(مجلد_مؤقت())
}

// Note: انشئ_مجلد، احذف_مجلد، قائمة_مجلد، هل_مجلد، مجلد_حالي، مجلد_مستخدم، مجلد_مؤقت
// are now builtin functions - users can call them directly without importing this module
