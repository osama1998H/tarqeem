// ملفات/مجلد - Directory Operations
// ملفات/مجلد - عمليات المجلدات

استورد { مسار } من "./مسار"

// =============================================================================
// مجلد - Directory Class
// =============================================================================

صدّر صنف مجلد {
    خاص _مسار: نص

    // Constructor with path
    // المنشئ مع المسار
    منشئ(مسار: نص) {
        هذا._مسار = مسار
    }

    // Get directory path
    // احصل على مسار المجلد
    عام دالة مسار() -> نص {
        أرجع هذا._مسار
    }

    // Get as Path object
    // احصل ككائن مسار
    عام دالة كمسار() -> مسار {
        أرجع جديد مسار(هذا._مسار)
    }

    // Check if directory exists
    // تحقق إذا المجلد موجود
    عام دالة موجود() -> منطقي {
        // Uses runtime: trq_file_is_dir
        أرجع __هل_مجلد__(هذا._مسار)
    }

    // Create the directory
    // أنشئ المجلد
    عام دالة انشئ() -> منطقي {
        // Uses runtime: trq_dir_create
        أرجع __انشئ_مجلد__(هذا._مسار)
    }

    // Create directory and all parents
    // أنشئ المجلد وكل الآباء
    عام دالة انشئ_كل() -> منطقي {
        // Uses runtime: trq_dir_create_all
        أرجع __انشئ_مجلدات__(هذا._مسار)
    }

    // Delete the directory (must be empty)
    // احذف المجلد (يجب أن يكون فارغاً)
    عام دالة احذف() -> منطقي {
        // Uses runtime: trq_dir_delete
        أرجع __احذف_مجلد__(هذا._مسار)
    }

    // List directory contents as strings
    // أدرج محتويات المجلد كنصوص
    عام دالة محتويات() -> مصفوفة<نص> {
        // Uses runtime: trq_dir_list
        أرجع __ادرج_مجلد__(هذا._مسار)
    }

    // List files only
    // أدرج الملفات فقط
    عام دالة ملفات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = __ادمج_مسار__(هذا._مسار، عنصر)
            إذا (__هل_ملف__(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    // List subdirectories only
    // أدرج المجلدات الفرعية فقط
    عام دالة مجلدات() -> مصفوفة<نص> {
        متغير كل = هذا.محتويات()
        متغير نتيجة: مصفوفة<نص> = []

        لكل عنصر في كل {
            متغير مسار_كامل = __ادمج_مسار__(هذا._مسار، عنصر)
            إذا (__هل_مجلد__(مسار_كامل)) {
                نتيجة.ألحق(عنصر)
            }
        }

        أرجع نتيجة
    }

    // Get parent directory
    // احصل على المجلد الأب
    عام دالة اب() -> مجلد {
        متغير مسار_اب = __مسار_اب__(هذا._مسار)
        أرجع جديد مجلد(مسار_اب)
    }

    // Get child file
    // احصل على ملف فرعي
    عام دالة ملف(اسم: نص) -> نص {
        أرجع __ادمج_مسار__(هذا._مسار، اسم)
    }

    // Get subdirectory
    // احصل على مجلد فرعي
    عام دالة مجلد_فرعي(اسم: نص) -> مجلد {
        متغير مسار_فرعي = __ادمج_مسار__(هذا._مسار، اسم)
        أرجع جديد مجلد(مسار_فرعي)
    }

    // Check if directory is empty
    // تحقق إذا المجلد فارغ
    عام دالة فارغ() -> منطقي {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول() == 0
    }

    // Count items in directory
    // عدّ العناصر في المجلد
    عام دالة عدد_عناصر() -> عدد {
        متغير محتويات = هذا.محتويات()
        أرجع محتويات.طول()
    }

    // Get directory name
    // احصل على اسم المجلد
    عام دالة اسم() -> نص {
        أرجع __اسم_ملف__(هذا._مسار)
    }
}

// =============================================================================
// Static Directory Functions / دوال مجلد ثابتة
// =============================================================================

// Create a directory
// أنشئ مجلد
صدّر دالة انشئ_مجلد(مسار: نص) -> منطقي {
    // Uses runtime: trq_dir_create
    أرجع __انشئ_مجلد__(مسار)
}

// Create directory and all parents
// أنشئ مجلد وكل الآباء
صدّر دالة انشئ_مجلدات(مسار: نص) -> منطقي {
    // Uses runtime: trq_dir_create_all
    أرجع __انشئ_مجلدات__(مسار)
}

// Delete a directory
// احذف مجلد
صدّر دالة احذف_مجلد(مسار: نص) -> منطقي {
    // Uses runtime: trq_dir_delete
    أرجع __احذف_مجلد__(مسار)
}

// List directory contents
// أدرج محتويات مجلد
صدّر دالة ادرج_مجلد(مسار: نص) -> مصفوفة<نص> {
    // Uses runtime: trq_dir_list
    أرجع __ادرج_مجلد__(مسار)
}

// Check if path is a directory
// تحقق إذا المسار مجلد
صدّر دالة هل_مجلد(مسار: نص) -> منطقي {
    // Uses runtime: trq_file_is_dir
    أرجع __هل_مجلد__(مسار)
}

// Get current working directory
// احصل على مجلد العمل الحالي
صدّر دالة المجلد_الحالي() -> نص {
    // Uses runtime: trq_dir_current
    أرجع __مجلد_حالي__()
}

// Get home directory
// احصل على مجلد المستخدم
صدّر دالة مجلد_المستخدم() -> نص {
    // Uses runtime: trq_dir_home
    أرجع __مجلد_مستخدم__()
}

// Get temp directory
// احصل على مجلد المؤقت
صدّر دالة مجلد_المؤقت() -> نص {
    // Uses runtime: trq_dir_temp
    أرجع __مجلد_مؤقت__()
}

// =============================================================================
// Convenience Constructors / منشئات مريحة
// =============================================================================

// Open directory (returns new Directory instance)
// افتح مجلد (يُرجع نسخة مجلد جديدة)
صدّر دالة افتح_مجلد(مسار: نص) -> مجلد {
    أرجع جديد مجلد(مسار)
}

// Get current directory as Directory object
// احصل على المجلد الحالي ككائن مجلد
صدّر دالة هنا() -> مجلد {
    أرجع جديد مجلد(__مجلد_حالي__())
}

// Get home directory as Directory object
// احصل على مجلد المستخدم ككائن مجلد
صدّر دالة بيت() -> مجلد {
    أرجع جديد مجلد(__مجلد_مستخدم__())
}

// Get temp directory as Directory object
// احصل على المجلد المؤقت ككائن مجلد
صدّر دالة مؤقت() -> مجلد {
    أرجع جديد مجلد(__مجلد_مؤقت__())
}

