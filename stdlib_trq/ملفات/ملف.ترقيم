/// عمليات الملفات
///
/// تحتوي هذه الوحدة على صنف الملف ودوال التعامل مع الملفات
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// ثوابت وضع الملف
// ═══════════════════════════════════════════

/// وضع القراءة فقط
صدّر ثابت وضع_قراءة: عدد = 0

/// وضع الكتابة (يستبدل المحتوى)
صدّر ثابت وضع_كتابة: عدد = 1

/// وضع الإضافة (يُلحق بالنهاية)
صدّر ثابت وضع_اضافة: عدد = 2

/// وضع القراءة والكتابة
صدّر ثابت وضع_قراءة_كتابة: عدد = 3

// ═══════════════════════════════════════════
// صنف الملف
// ═══════════════════════════════════════════

/// صنف الملف
///
/// يمثل ملفاً في نظام الملفات ويوفر عمليات
/// القراءة والكتابة والتعديل
///
/// @مثال
/// متغير م = جديد ملف("بيانات.txt")
/// إذا (م.موجود()) {
///     اطبع(م.اقرأ_كل())
/// }
صدّر صنف ملف {
    /// مسار الملف
    خاص _مسار: نص

    /// حالة الفتح
    خاص _مفتوح: منطقي

    /// وضع الفتح
    خاص _وضع: عدد

    /// المنشئ
    ///
    /// @معامل مسار - مسار الملف
    منشئ(مسار: نص) {
        هذا._مسار = مسار
        هذا._مفتوح = خطأ
        هذا._وضع = وضع_قراءة
    }

    /// أحصل على مسار الملف
    ///
    /// @أرجع مسار الملف كنص
    عام دالة مسار() -> نص {
        أرجع هذا._مسار
    }

    /// تحقق إذا الملف مفتوح
    ///
    /// @أرجع صحيح إذا كان الملف مفتوحاً
    عام دالة مفتوح() -> منطقي {
        أرجع هذا._مفتوح
    }

    /// تحقق إذا الملف موجود
    ///
    /// @أرجع صحيح إذا كان الملف موجوداً
    عام دالة موجود() -> منطقي {
        أرجع __ملف_موجود__(هذا._مسار)
    }

    /// أحصل على حجم الملف
    ///
    /// @أرجع حجم الملف بالبايت
    عام دالة حجم() -> عدد {
        أرجع __حجم_ملف__(هذا._مسار)
    }

    /// اقرأ محتويات الملف كاملة
    ///
    /// @أرجع محتوى الملف كنص
    /// @مثال
    /// متغير محتوى = م.اقرأ_كل()
    عام دالة اقرأ_كل() -> نص {
        أرجع __اقرأ_ملف__(هذا._مسار)
    }

    /// اقرأ الملف كمصفوفة سطور
    ///
    /// @أرجع مصفوفة من السطور
    /// @مثال
    /// متغير سطور = م.اقرأ_سطور()
    /// لكل سطر في سطور {
    ///     اطبع(سطر)
    /// }
    عام دالة اقرأ_سطور() -> مصفوفة<نص> {
        متغير محتوى = هذا.اقرأ_كل()
        أرجع __قسّم__(محتوى، "\n")
    }

    /// اكتب محتوى للملف
    ///
    /// يستبدل المحتوى الحالي بالكامل
    ///
    /// @معامل محتوى - المحتوى الجديد
    /// @أرجع صحيح إذا نجحت العملية
    /// @مثال
    /// م.اكتب("مرحباً بالعالم")
    عام دالة اكتب(محتوى: نص) -> منطقي {
        أرجع __اكتب_ملف__(هذا._مسار، محتوى)
    }

    /// اكتب سطراً للملف
    ///
    /// يستبدل المحتوى بسطر واحد
    ///
    /// @معامل سطر - السطر المراد كتابته
    /// @أرجع صحيح إذا نجحت العملية
    عام دالة اكتب_سطر(سطر: نص) -> منطقي {
        أرجع هذا.اكتب(سطر + "\n")
    }

    /// اكتب مصفوفة سطور للملف
    ///
    /// @معامل سطور - مصفوفة السطور
    /// @أرجع صحيح إذا نجحت العملية
    عام دالة اكتب_سطور(سطور: مصفوفة<نص>) -> منطقي {
        متغير محتوى = __ادمج__(سطور، "\n")
        أرجع هذا.اكتب(محتوى)
    }

    /// ألحق محتوى بنهاية الملف
    ///
    /// @معامل محتوى - المحتوى المراد إلحاقه
    /// @أرجع صحيح إذا نجحت العملية
    /// @مثال
    /// م.الحق("سطر جديد")
    عام دالة الحق(محتوى: نص) -> منطقي {
        أرجع __الحق_ملف__(هذا._مسار، محتوى)
    }

    /// ألحق سطراً بنهاية الملف
    ///
    /// @معامل سطر - السطر المراد إلحاقه
    /// @أرجع صحيح إذا نجحت العملية
    عام دالة الحق_سطر(سطر: نص) -> منطقي {
        أرجع هذا.الحق(سطر + "\n")
    }

    /// احذف الملف
    ///
    /// @أرجع صحيح إذا نجحت العملية
    /// @تحذير لا يمكن التراجع عن هذه العملية
    عام دالة احذف() -> منطقي {
        أرجع __احذف_ملف__(هذا._مسار)
    }

    /// انسخ الملف إلى موقع جديد
    ///
    /// @معامل وجهة - مسار الوجهة
    /// @أرجع صحيح إذا نجحت العملية
    /// @مثال
    /// م.انسخ_الى("نسخة_احتياطية.txt")
    عام دالة انسخ_الى(وجهة: نص) -> منطقي {
        أرجع __انسخ_ملف__(هذا._مسار، وجهة)
    }

    /// انقل أو أعد تسمية الملف
    ///
    /// @معامل وجهة - المسار الجديد
    /// @أرجع صحيح إذا نجحت العملية
    /// @ملاحظة يُحدّث مسار الكائن تلقائياً عند النجاح
    عام دالة انقل_الى(وجهة: نص) -> منطقي {
        متغير نجاح = __انقل_ملف__(هذا._مسار، وجهة)
        إذا (نجاح) {
            هذا._مسار = وجهة
        }
        أرجع نجاح
    }

    /// امسح محتويات الملف
    ///
    /// @أرجع صحيح إذا نجحت العملية
    عام دالة امسح() -> منطقي {
        أرجع هذا.اكتب("")
    }
}

// ═══════════════════════════════════════════
// دوال إنشاء الملفات
// ═══════════════════════════════════════════

/// افتح ملفاً موجوداً
///
/// @معامل مسار - مسار الملف
/// @أرجع كائن ملف
/// @مثال
/// متغير م = افتح("بيانات.txt")
صدّر دالة افتح(مسار: نص) -> ملف {
    أرجع جديد ملف(مسار)
}

/// أنشئ ملفاً جديداً فارغاً
///
/// @معامل مسار - مسار الملف الجديد
/// @أرجع كائن ملف
/// @مثال
/// متغير م = انشئ("جديد.txt")
صدّر دالة انشئ(مسار: نص) -> ملف {
    متغير م = جديد ملف(مسار)
    م.اكتب("")
    أرجع م
}

// ═══════════════════════════════════════════
// دوال اختصار
// ═══════════════════════════════════════════

/// اقرأ محتوى ملف بالكامل
///
/// @معامل مسار - مسار الملف
/// @أرجع محتوى الملف
/// @مثال
/// متغير نص = اقرأ_ملف("ملف.txt")
صدّر دالة اقرأ_ملف(مسار: نص) -> نص {
    أرجع __اقرأ_ملف__(مسار)
}

/// اكتب محتوى لملف
///
/// @معامل مسار - مسار الملف
/// @معامل محتوى - المحتوى المراد كتابته
/// @أرجع صحيح إذا نجحت العملية
/// @مثال
/// اكتب_ملف("ملف.txt"، "مرحباً")
صدّر دالة اكتب_ملف(مسار: نص، محتوى: نص) -> منطقي {
    أرجع __اكتب_ملف__(مسار، محتوى)
}

/// ألحق محتوى بنهاية ملف
///
/// @معامل مسار - مسار الملف
/// @معامل محتوى - المحتوى المراد إلحاقه
/// @أرجع صحيح إذا نجحت العملية
صدّر دالة الحق_ملف(مسار: نص، محتوى: نص) -> منطقي {
    أرجع __الحق_ملف__(مسار، محتوى)
}

/// تحقق إذا الملف موجود
///
/// @معامل مسار - مسار الملف
/// @أرجع صحيح إذا كان الملف موجوداً
/// @مثال
/// إذا (ملف_موجود("config.txt")) {
///     اطبع("الملف موجود")
/// }
صدّر دالة ملف_موجود(مسار: نص) -> منطقي {
    أرجع __ملف_موجود__(مسار)
}

/// احذف ملفاً
///
/// @معامل مسار - مسار الملف
/// @أرجع صحيح إذا نجحت العملية
/// @تحذير لا يمكن التراجع عن هذه العملية
صدّر دالة احذف_ملف(مسار: نص) -> منطقي {
    أرجع __احذف_ملف__(مسار)
}

/// انسخ ملفاً
///
/// @معامل من - مسار الملف المصدر
/// @معامل الى - مسار الوجهة
/// @أرجع صحيح إذا نجحت العملية
صدّر دالة انسخ_ملف(من: نص، الى: نص) -> منطقي {
    أرجع __انسخ_ملف__(من، الى)
}

/// انقل أو أعد تسمية ملف
///
/// @معامل من - المسار الحالي
/// @معامل الى - المسار الجديد
/// @أرجع صحيح إذا نجحت العملية
صدّر دالة انقل_ملف(من: نص، الى: نص) -> منطقي {
    أرجع __انقل_ملف__(من، الى)
}

/// أحصل على حجم ملف
///
/// @معامل مسار - مسار الملف
/// @أرجع حجم الملف بالبايت
صدّر دالة حجم_ملف(مسار: نص) -> عدد {
    أرجع __حجم_ملف__(مسار)
}

/// تحقق إذا المسار يشير لملف
///
/// @معامل مسار - المسار المراد فحصه
/// @أرجع صحيح إذا كان المسار يشير لملف
صدّر دالة هل_ملف(مسار: نص) -> منطقي {
    أرجع __هل_ملف__(مسار)
}
