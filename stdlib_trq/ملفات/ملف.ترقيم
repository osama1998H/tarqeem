// =============================================================================
// File Mode Enum / تعداد وضع الملف
// =============================================================================

// Note: Enums require compiler support
// تعداد وضع_ملف {
//     قراءة،
//     كتابة،
//     اضافة،
//     قراءة_كتابة
// }

// File mode constants
// ثوابت وضع الملف
صدّر ثابت وضع_قراءة: عدد = 0
صدّر ثابت وضع_كتابة: عدد = 1
صدّر ثابت وضع_اضافة: عدد = 2
صدّر ثابت وضع_قراءة_كتابة: عدد = 3

// =============================================================================
// ملف - File Class
// =============================================================================

صدّر صنف ملف {
    خاص _مسار: نص
    خاص _مفتوح: منطقي
    خاص _وضع: عدد

    // Constructor with path
    // المنشئ مع المسار
    منشئ(مسار: نص) {
        هذا._مسار = مسار
        هذا._مفتوح = خطأ
        هذا._وضع = وضع_قراءة
    }

    // Get file path
    // أحصل على مسار الملف
    عام دالة مسار() -> نص {
        أرجع هذا._مسار
    }

    // Check if file is open
    // تحقق إذا الملف مفتوح
    عام دالة مفتوح() -> منطقي {
        أرجع هذا._مفتوح
    }

    // Check if file exists
    // تحقق إذا الملف موجود
    عام دالة موجود() -> منطقي {
        // Uses runtime: trq_file_exists
        أرجع __ملف_موجود__(هذا._مسار)
    }

    // Get file size in bytes
    // أحصل على حجم الملف بالبايت
    عام دالة حجم() -> عدد {
        // Uses runtime: trq_file_size
        أرجع __حجم_ملف__(هذا._مسار)
    }

    // Read entire file contents
    // اقرأ محتويات الملف كاملة
    عام دالة اقرأ_كل() -> نص {
        // Uses runtime: trq_file_read
        أرجع __اقرأ_ملف__(هذا._مسار)
    }

    // Read file lines
    // اقرأ سطور الملف
    عام دالة اقرأ_سطور() -> مصفوفة<نص> {
        متغير محتوى = هذا.اقرأ_كل()
        أرجع __قسّم__(محتوى، "\n")
    }

    // Write content to file (overwrites)
    // اكتب محتوى للملف (يستبدل)
    عام دالة اكتب(محتوى: نص) -> منطقي {
        // Uses runtime: trq_file_write
        أرجع __اكتب_ملف__(هذا._مسار، محتوى)
    }

    // Write line to file (overwrites)
    // اكتب سطر للملف (يستبدل)
    عام دالة اكتب_سطر(سطر: نص) -> منطقي {
        أرجع هذا.اكتب(سطر + "\n")
    }

    // Write lines to file (overwrites)
    // اكتب سطور للملف (يستبدل)
    عام دالة اكتب_سطور(سطور: مصفوفة<نص>) -> منطقي {
        متغير محتوى = __ادمج__(سطور، "\n")
        أرجع هذا.اكتب(محتوى)
    }

    // Append content to file
    // ألحق محتوى بالملف
    عام دالة الحق(محتوى: نص) -> منطقي {
        // Uses runtime: trq_file_append
        أرجع __الحق_ملف__(هذا._مسار، محتوى)
    }

    // Append line to file
    // ألحق سطر بالملف
    عام دالة الحق_سطر(سطر: نص) -> منطقي {
        أرجع هذا.الحق(سطر + "\n")
    }

    // Delete the file
    // احذف الملف
    عام دالة احذف() -> منطقي {
        // Uses runtime: trq_file_delete
        أرجع __احذف_ملف__(هذا._مسار)
    }

    // Copy file to destination
    // انسخ الملف للوجهة
    عام دالة انسخ_الى(وجهة: نص) -> منطقي {
        // Uses runtime: trq_file_copy
        أرجع __انسخ_ملف__(هذا._مسار، وجهة)
    }

    // Move/rename file
    // انقل/أعد تسمية الملف
    عام دالة انقل_الى(وجهة: نص) -> منطقي {
        // Uses runtime: trq_file_move
        متغير نجاح = __انقل_ملف__(هذا._مسار، وجهة)
        إذا (نجاح) {
            هذا._مسار = وجهة
        }
        أرجع نجاح
    }

    // Clear file contents
    // امسح محتويات الملف
    عام دالة امسح() -> منطقي {
        أرجع هذا.اكتب("")
    }
}

// =============================================================================
// Static File Functions / دوال ملف ثابتة
// =============================================================================

// Open file for reading (returns new File instance)
// افتح ملف للقراءة (يُرجع نسخة ملف جديدة)
صدّر دالة افتح(مسار: نص) -> ملف {
    أرجع جديد ملف(مسار)
}

// Create a new file
// أنشئ ملف جديد
صدّر دالة انشئ(مسار: نص) -> ملف {
    متغير م = جديد ملف(مسار)
    م.اكتب("")
    أرجع م
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Read entire file contents
// اقرأ محتويات الملف كاملة
صدّر دالة اقرأ_ملف(مسار: نص) -> نص {
    // Uses runtime: trq_file_read
    أرجع __اقرأ_ملف__(مسار)
}

// Write content to file
// اكتب محتوى للملف
صدّر دالة اكتب_ملف(مسار: نص، محتوى: نص) -> منطقي {
    // Uses runtime: trq_file_write
    أرجع __اكتب_ملف__(مسار، محتوى)
}

// Append content to file
// ألحق محتوى بالملف
صدّر دالة الحق_ملف(مسار: نص، محتوى: نص) -> منطقي {
    // Uses runtime: trq_file_append
    أرجع __الحق_ملف__(مسار، محتوى)
}

// Check if file exists
// تحقق إذا الملف موجود
صدّر دالة ملف_موجود(مسار: نص) -> منطقي {
    // Uses runtime: trq_file_exists
    أرجع __ملف_موجود__(مسار)
}

// Delete file
// احذف ملف
صدّر دالة احذف_ملف(مسار: نص) -> منطقي {
    // Uses runtime: trq_file_delete
    أرجع __احذف_ملف__(مسار)
}

// Copy file
// انسخ ملف
صدّر دالة انسخ_ملف(من: نص، الى: نص) -> منطقي {
    // Uses runtime: trq_file_copy
    أرجع __انسخ_ملف__(من، الى)
}

// Move/rename file
// انقل/أعد تسمية ملف
صدّر دالة انقل_ملف(من: نص، الى: نص) -> منطقي {
    // Uses runtime: trq_file_move
    أرجع __انقل_ملف__(من، الى)
}

// Get file size
// أحصل على حجم الملف
صدّر دالة حجم_ملف(مسار: نص) -> عدد {
    // Uses runtime: trq_file_size
    أرجع __حجم_ملف__(مسار)
}

// Check if path is a file
// تحقق إذا المسار ملف
صدّر دالة هل_ملف(مسار: نص) -> منطقي {
    // Uses runtime: trq_file_is_file
    أرجع __هل_ملف__(مسار)
}
