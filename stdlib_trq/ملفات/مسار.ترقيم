/// عمليات المسارات
///
/// تحتوي هذه الوحدة على صنف المسار ودوال معالجة المسارات
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// صنف المسار
// ═══════════════════════════════════════════

/// صنف المسار
///
/// يمثل مساراً في نظام الملفات ويوفر عمليات
/// لمعالجة وتحليل المسارات
///
/// @مثال
/// متغير م = جديد مسار("/home/user/ملفات")
/// اطبع(م.اسم())  // "ملفات"
صدّر صنف مسار {
    /// قيمة المسار
    خاص _قيمة: نص

    /// المنشئ
    ///
    /// @معامل مسار - نص المسار
    منشئ(مسار: نص) {
        هذا._قيمة = مسار
    }

    /// حوّل المسار إلى نص
    ///
    /// @أرجع نص المسار
    عام دالة الى_نص() -> نص {
        أرجع هذا._قيمة
    }

    /// ادمج المسار مع مكون آخر
    ///
    /// @معامل اخر - المكون المراد دمجه
    /// @أرجع مسار جديد مدموج
    /// @مثال
    /// متغير جديد = م.ادمج("ملف.txt")
    عام دالة ادمج(اخر: نص) -> مسار {
        متغير نتيجة = __ادمج_مسار__(هذا._قيمة، اخر)
        أرجع جديد مسار(نتيجة)
    }

    /// أحصل على المجلد الأب
    ///
    /// @أرجع مسار المجلد الأب
    /// @مثال
    /// متغير اب = م.اب()  // "/home/user"
    عام دالة اب() -> مسار {
        متغير نتيجة = __مسار_اب__(هذا._قيمة)
        أرجع جديد مسار(نتيجة)
    }

    /// أحصل على اسم الملف أو المجلد
    ///
    /// @أرجع المكون الأخير من المسار
    /// @مثال
    /// متغير اسم = م.اسم()  // "ملف.txt"
    عام دالة اسم() -> نص {
        أرجع __اسم_ملف__(هذا._قيمة)
    }

    /// أحصل على امتداد الملف
    ///
    /// @أرجع الامتداد بدون النقطة
    /// @مثال
    /// متغير امت = م.امتداد()  // "txt"
    عام دالة امتداد() -> نص {
        أرجع __امتداد_ملف__(هذا._قيمة)
    }

    /// أحصل على جذع الملف
    ///
    /// الاسم بدون الامتداد
    ///
    /// @أرجع اسم الملف بدون الامتداد
    /// @مثال
    /// متغير جذع = م.جذع()  // "ملف"
    عام دالة جذع() -> نص {
        أرجع __جذع_ملف__(هذا._قيمة)
    }

    /// أحصل على المسار المطلق
    ///
    /// @أرجع المسار الكامل من الجذر
    عام دالة مطلق() -> مسار {
        متغير نتيجة = __مسار_مطلق__(هذا._قيمة)
        أرجع جديد مسار(نتيجة)
    }

    /// تحقق إذا المسار مطلق
    ///
    /// @أرجع صحيح إذا كان المسار يبدأ من الجذر
    عام دالة هل_مطلق() -> منطقي {
        أرجع __مسار_هل_مطلق__(هذا._قيمة)
    }

    /// تحقق إذا المسار موجود
    ///
    /// @أرجع صحيح إذا كان الملف أو المجلد موجوداً
    عام دالة موجود() -> منطقي {
        أرجع __ملف_موجود__(هذا._قيمة)
    }

    /// تحقق إذا المسار يشير لملف
    ///
    /// @أرجع صحيح إذا كان المسار يشير لملف
    عام دالة هل_ملف() -> منطقي {
        أرجع __هل_ملف__(هذا._قيمة)
    }

    /// تحقق إذا المسار يشير لمجلد
    ///
    /// @أرجع صحيح إذا كان المسار يشير لمجلد
    عام دالة هل_مجلد() -> منطقي {
        أرجع __هل_مجلد__(هذا._قيمة)
    }

    /// أحصل على مكونات المسار
    ///
    /// @أرجع مصفوفة بأجزاء المسار
    /// @مثال
    /// متغير اجزاء = م.مكونات()  // ["home"، "user"، "ملفات"]
    عام دالة مكونات() -> مصفوفة<نص> {
        متغير فاصل = فاصل_مسار()
        أرجع __قسّم__(هذا._قيمة، فاصل)
    }

    /// أنشئ مساراً بامتداد جديد
    ///
    /// @معامل امتداد_جديد - الامتداد الجديد
    /// @أرجع مسار جديد بالامتداد المحدد
    /// @مثال
    /// متغير جديد = م.مع_امتداد("pdf")  // "/home/ملف.pdf"
    عام دالة مع_امتداد(امتداد_جديد: نص) -> مسار {
        متغير جذع = هذا.جذع()
        متغير اب = هذا.اب()
        متغير اسم_جديد = جذع + "." + امتداد_جديد
        أرجع اب.ادمج(اسم_جديد)
    }

    /// نظّف المسار
    ///
    /// يحوّل المسار لمسار مطلق نظيف
    ///
    /// @أرجع المسار المنظف
    عام دالة نظّف() -> مسار {
        أرجع هذا.مطلق()
    }
}

// ═══════════════════════════════════════════
// دوال المسارات
// ═══════════════════════════════════════════

/// أحصل على فاصل المسار للنظام الحالي
///
/// @أرجع "/" في لينكس/ماك أو "\" في ويندوز
صدّر دالة فاصل_مسار() -> نص {
    أرجع __فاصل_مسار__()
}

/// ادمج مكوني مسار
///
/// @معامل اول - المكون الأول
/// @معامل ثاني - المكون الثاني
/// @أرجع المسار المدموج
/// @مثال
/// ادمج_مسار("/home"، "user")  // "/home/user"
صدّر دالة ادمج_مسار(اول: نص، ثاني: نص) -> نص {
    أرجع __ادمج_مسار__(اول، ثاني)
}

/// أحصل على المجلد الأب لمسار
///
/// @معامل مسار - المسار
/// @أرجع مسار المجلد الأب
صدّر دالة مسار_اب(مسار: نص) -> نص {
    أرجع __مسار_اب__(مسار)
}

/// أحصل على اسم الملف من مسار
///
/// @معامل مسار - المسار الكامل
/// @أرجع اسم الملف فقط
/// @مثال
/// اسم_ملف("/home/user/ملف.txt")  // "ملف.txt"
صدّر دالة اسم_ملف(مسار: نص) -> نص {
    أرجع __اسم_ملف__(مسار)
}

/// أحصل على امتداد الملف
///
/// @معامل مسار - مسار الملف
/// @أرجع الامتداد بدون النقطة
/// @مثال
/// امتداد_ملف("ملف.txt")  // "txt"
صدّر دالة امتداد_ملف(مسار: نص) -> نص {
    أرجع __امتداد_ملف__(مسار)
}

/// أحصل على جذع الملف
///
/// @معامل مسار - مسار الملف
/// @أرجع الاسم بدون الامتداد
/// @مثال
/// جذع_ملف("ملف.txt")  // "ملف"
صدّر دالة جذع_ملف(مسار: نص) -> نص {
    أرجع __جذع_ملف__(مسار)
}

/// أحصل على المسار المطلق
///
/// @معامل مسار - المسار النسبي أو المطلق
/// @أرجع المسار المطلق الكامل
صدّر دالة مسار_مطلق(مسار: نص) -> نص {
    أرجع __مسار_مطلق__(مسار)
}

/// تحقق إذا المسار مطلق
///
/// @معامل مسار - المسار المراد فحصه
/// @أرجع صحيح إذا كان المسار مطلقاً
صدّر دالة هل_مسار_مطلق(مسار: نص) -> منطقي {
    أرجع __مسار_هل_مطلق__(مسار)
}

// ═══════════════════════════════════════════
// مسارات النظام
// ═══════════════════════════════════════════

/// أحصل على مجلد العمل الحالي
///
/// @أرجع كائن مسار لمجلد العمل
صدّر دالة مجلد_حالي() -> مسار {
    متغير مسار_نص = __مجلد_حالي__()
    أرجع جديد مسار(مسار_نص)
}

/// أحصل على مجلد المستخدم
///
/// @أرجع كائن مسار لمجلد المستخدم الرئيسي
صدّر دالة مجلد_مستخدم() -> مسار {
    متغير مسار_نص = __مجلد_مستخدم__()
    أرجع جديد مسار(مسار_نص)
}

/// أحصل على مجلد الملفات المؤقتة
///
/// @أرجع كائن مسار لمجلد المؤقت
صدّر دالة مجلد_مؤقت() -> مسار {
    متغير مسار_نص = __مجلد_مؤقت__()
    أرجع جديد مسار(مسار_نص)
}
