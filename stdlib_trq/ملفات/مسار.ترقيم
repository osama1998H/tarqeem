// =============================================================================
// مسار - Path Class
// =============================================================================

صدّر صنف مسار {
    خاص _قيمة: نص

    // Constructor with path string
    // المنشئ مع نص المسار
    منشئ(مسار: نص) {
        هذا._قيمة = مسار
    }

    // Get path as string
    // احصل على المسار كنص
    عام دالة الى_نص() -> نص {
        أرجع هذا._قيمة
    }

    // Join path with another component
    // ادمج المسار مع مكون آخر
    عام دالة ادمج(اخر: نص) -> مسار {
        // Uses runtime: trq_path_join
        متغير نتيجة = __ادمج_مسار__(هذا._قيمة، اخر)
        أرجع جديد مسار(نتيجة)
    }

    // Get parent directory
    // احصل على المجلد الأب
    عام دالة اب() -> مسار {
        // Uses runtime: trq_path_parent
        متغير نتيجة = __مسار_اب__(هذا._قيمة)
        أرجع جديد مسار(نتيجة)
    }

    // Get file name (last component)
    // احصل على اسم الملف (المكون الأخير)
    عام دالة اسم() -> نص {
        // Uses runtime: trq_path_filename
        أرجع __اسم_ملف__(هذا._قيمة)
    }

    // Get file extension (without dot)
    // احصل على امتداد الملف (بدون نقطة)
    عام دالة امتداد() -> نص {
        // Uses runtime: trq_path_extension
        أرجع __امتداد_ملف__(هذا._قيمة)
    }

    // Get file stem (name without extension)
    // احصل على جذع الملف (الاسم بدون الامتداد)
    عام دالة جذع() -> نص {
        // Uses runtime: trq_path_stem
        أرجع __جذع_ملف__(هذا._قيمة)
    }

    // Get absolute path
    // احصل على المسار المطلق
    عام دالة مطلق() -> مسار {
        // Uses runtime: trq_path_absolute
        متغير نتيجة = __مسار_مطلق__(هذا._قيمة)
        أرجع جديد مسار(نتيجة)
    }

    // Check if path is absolute
    // تحقق إذا المسار مطلق
    عام دالة هل_مطلق() -> منطقي {
        // Uses runtime: trq_path_is_absolute
        أرجع __مسار_هل_مطلق__(هذا._قيمة)
    }

    // Check if path exists
    // تحقق إذا المسار موجود
    عام دالة موجود() -> منطقي {
        // Uses runtime: trq_file_exists
        أرجع __ملف_موجود__(هذا._قيمة)
    }

    // Check if path is a file
    // تحقق إذا المسار ملف
    عام دالة هل_ملف() -> منطقي {
        // Uses runtime: trq_file_is_file
        أرجع __هل_ملف__(هذا._قيمة)
    }

    // Check if path is a directory
    // تحقق إذا المسار مجلد
    عام دالة هل_مجلد() -> منطقي {
        // Uses runtime: trq_file_is_dir
        أرجع __هل_مجلد__(هذا._قيمة)
    }

    // Get components as array
    // احصل على المكونات كمصفوفة
    عام دالة مكونات() -> مصفوفة<نص> {
        متغير فاصل = فاصل_مسار()
        أرجع __قسّم__(هذا._قيمة، فاصل)
    }

    // Change extension
    // غيّر الامتداد
    عام دالة مع_امتداد(امتداد_جديد: نص) -> مسار {
        متغير جذع = هذا.جذع()
        متغير اب = هذا.اب()
        متغير اسم_جديد = جذع + "." + امتداد_جديد
        أرجع اب.ادمج(اسم_جديد)
    }

    // Normalize path (remove . and ..)
    // نظّف المسار (أزل . و ..)
    عام دالة نظّف() -> مسار {
        // Simple normalization - get absolute then back to relative if needed
        أرجع هذا.مطلق()
    }
}

// =============================================================================
// Static Path Functions / دوال مسار ثابتة
// =============================================================================

// Get path separator for current platform
// احصل على فاصل المسار للنظام الحالي
صدّر دالة فاصل_مسار() -> نص {
    // Uses runtime: trq_path_separator
    أرجع __فاصل_مسار__()
}

// Join multiple path components
// ادمج عدة مكونات مسار
صدّر دالة ادمج_مسار(اول: نص، ثاني: نص) -> نص {
    // Uses runtime: trq_path_join
    أرجع __ادمج_مسار__(اول، ثاني)
}

// Get parent directory of a path
// احصل على المجلد الأب لمسار
صدّر دالة مسار_اب(مسار: نص) -> نص {
    // Uses runtime: trq_path_parent
    أرجع __مسار_اب__(مسار)
}

// Get filename from path
// احصل على اسم الملف من المسار
صدّر دالة اسم_ملف(مسار: نص) -> نص {
    // Uses runtime: trq_path_filename
    أرجع __اسم_ملف__(مسار)
}

// Get extension from path
// احصل على الامتداد من المسار
صدّر دالة امتداد_ملف(مسار: نص) -> نص {
    // Uses runtime: trq_path_extension
    أرجع __امتداد_ملف__(مسار)
}

// Get stem (name without extension) from path
// احصل على الجذع (الاسم بدون الامتداد) من المسار
صدّر دالة جذع_ملف(مسار: نص) -> نص {
    // Uses runtime: trq_path_stem
    أرجع __جذع_ملف__(مسار)
}

// Get absolute path
// احصل على المسار المطلق
صدّر دالة مسار_مطلق(مسار: نص) -> نص {
    // Uses runtime: trq_path_absolute
    أرجع __مسار_مطلق__(مسار)
}

// Check if path is absolute
// تحقق إذا المسار مطلق
صدّر دالة هل_مسار_مطلق(مسار: نص) -> منطقي {
    // Uses runtime: trq_path_is_absolute
    أرجع __مسار_هل_مطلق__(مسار)
}

// =============================================================================
// Common Paths / مسارات شائعة
// =============================================================================

// Get current working directory
// احصل على مجلد العمل الحالي
صدّر دالة مجلد_حالي() -> مسار {
    // Uses runtime: trq_dir_current
    متغير مسار_نص = __مجلد_حالي__()
    أرجع جديد مسار(مسار_نص)
}

