    متغير مسار_نص = __مجلد_مستخدم__()
    أرجع جديد مسار(مسار_نص)
}

// Get temp directory
// احصل على مجلد المؤقت
صدّر دالة مجلد_مؤقت() -> مسار {
    // Uses runtime: trq_dir_temp
    متغير مسار_نص = __مجلد_مؤقت__()
    أرجع جديد مسار(مسار_نص)
}

