/// عميل HTTP
///
/// يوفر وظائف عميل HTTP لإرسال الطلبات
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// ثوابت طرق HTTP
// ═══════════════════════════════════════════

/// طريقة GET
صدّر ثابت طريقة_احضر: نص = "GET"

/// طريقة POST
صدّر ثابت طريقة_أرسل: نص = "POST"

/// طريقة PUT
صدّر ثابت طريقة_ضع: نص = "PUT"

/// طريقة DELETE
صدّر ثابت طريقة_احذف: نص = "DELETE"

/// طريقة PATCH
صدّر ثابت طريقة_رقّع: نص = "PATCH"

/// طريقة HEAD
صدّر ثابت طريقة_ترويسة: نص = "HEAD"

/// طريقة OPTIONS
صدّر ثابت طريقة_خيارات: نص = "OPTIONS"

// ═══════════════════════════════════════════
// صنف استجابة HTTP
// ═══════════════════════════════════════════

/// صنف استجابة HTTP
///
/// يمثل استجابة من خادم HTTP
///
/// @مثال
/// متغير رد = احصل("https://api.example.com/data")
/// إذا (رد.ناجحة()) {
///     اطبع(رد.جسم)
/// }
صدّر صنف استجابة_ويب {
    /// رمز حالة HTTP (مثل ٢٠٠، ٤٠٤)
    عام حالة: عدد

    /// نص الحالة (مثل "OK"، "Not Found")
    عام نص_حالة: نص

    /// جسم الاستجابة
    عام جسم: نص

    /// رؤوس الاستجابة
    خاص _رؤوس: مصفوفة<نص>

    /// عدد الرؤوس
    خاص _عدد_رؤوس: عدد

    /// المنشئ الافتراضي
    منشئ() {
        هذا.حالة = 0
        هذا.نص_حالة = ""
        هذا.جسم = ""
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
    }

    /// المنشئ الكامل
    ///
    /// @معامل حالة - رمز الحالة
    /// @معامل نص_حالة - نص الحالة
    /// @معامل جسم - جسم الاستجابة
    مشترك دالة كاملة(حالة: عدد، نص_حالة: نص، جسم: نص) -> استجابة_ويب {
        متغير استجابة = جديد استجابة_ويب()
        استجابة.حالة = حالة
        استجابة.نص_حالة = نص_حالة
        استجابة.جسم = جسم
        أرجع استجابة
    }

    /// تحقق إذا الاستجابة ناجحة (2xx)
    ///
    /// @أرجع صحيح إذا كان رمز الحالة بين ٢٠٠ و٢٩٩
    عام دالة ناجحة() -> منطقي {
        أرجع هذا.حالة >= 200 && هذا.حالة < 300
    }

    /// تحقق إذا تحويل (3xx)
    ///
    /// @أرجع صحيح إذا كان رمز الحالة بين ٣٠٠ و٣٩٩
    عام دالة تحويل() -> منطقي {
        أرجع هذا.حالة >= 300 && هذا.حالة < 400
    }

    /// تحقق إذا خطأ عميل (4xx)
    ///
    /// @أرجع صحيح إذا كان رمز الحالة بين ٤٠٠ و٤٩٩
    عام دالة خطأ_عميل() -> منطقي {
        أرجع هذا.حالة >= 400 && هذا.حالة < 500
    }

    /// تحقق إذا خطأ خادم (5xx)
    ///
    /// @أرجع صحيح إذا كان رمز الحالة بين ٥٠٠ و٥٩٩
    عام دالة خطأ_خادم() -> منطقي {
        أرجع هذا.حالة >= 500 && هذا.حالة < 600
    }

    /// احصل على قيمة رأس
    ///
    /// @معامل اسم - اسم الرأس
    /// @أرجع قيمة الرأس أو نص فارغ
    عام دالة رأس(اسم: نص) -> نص {
        متغير ع = 0
        طالما (ع < هذا._عدد_رؤوس) {
            متغير رأس = هذا._رؤوس[ع]
            إذا (يبدأ_بـ(رأس، اسم + ": ")) {
                أرجع قص_من(رأس، طول(اسم) + 2)
            }
            ع = ع + 1
        }
        أرجع ""
    }

    /// أضف رأس (للاستخدام الداخلي)
    ///
    /// @معامل رأس - الرأس بصيغة "اسم: قيمة"
    عام دالة _أضف_رأس(رأس: نص) {
        هذا._رؤوس[هذا._عدد_رؤوس] = رأس
        هذا._عدد_رؤوس = هذا._عدد_رؤوس + 1
    }

    /// احصل على طول الجسم
    ///
    /// @أرجع طول الجسم بالأحرف
    عام دالة طول_جسم() -> عدد {
        أرجع طول(هذا.جسم)
    }

    /// احصل على نوع المحتوى
    ///
    /// @أرجع قيمة رأس Content-Type
    عام دالة نوع_محتوى() -> نص {
        أرجع هذا.رأس("Content-Type")
    }

    /// تحقق إذا استجابة JSON
    ///
    /// @أرجع صحيح إذا كان نوع المحتوى JSON
    عام دالة هل_ترميز_كائني() -> منطقي {
        متغير نوع = هذا.نوع_محتوى()
        أرجع يحتوي(نوع، "application/json")
    }
}

