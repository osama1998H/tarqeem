// صنف طلب HTTP
// ═══════════════════════════════════════════

/// صنف طلب HTTP
///
/// يوفر باني طلبات HTTP بأسلوب التسلسل
///
/// @مثال
/// متغير رد = طلب_جديد()
///     .رابط("https://api.example.com/users")
///     .طريقة("POST")
///     .جسم_ترميز_كائني('{"name": "أحمد"}')
///     .رأس("X-Custom"، "value")
///     .ارسل()
صدّر صنف طلب {
    /// رابط الطلب
    خاص _رابط: نص

    /// طريقة HTTP
    خاص _طريقة: نص

    /// رؤوس الطلب
    خاص _رؤوس: مصفوفة<نص>

    /// عدد الرؤوس
    خاص _عدد_رؤوس: عدد

    /// جسم الطلب
    خاص _جسم: نص

    /// مهلة الطلب
    خاص _مهلة: عدد

    /// متابعة التحويلات
    خاص _متابعة_تحويلات: منطقي

    /// المنشئ الافتراضي
    منشئ() {
        هذا._رابط = ""
        هذا._طريقة = "GET"
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
        هذا._جسم = ""
        هذا._مهلة = 30000
        هذا._متابعة_تحويلات = صحيح
    }

    /// المنشئ مع الرابط
    ///
    /// @معامل رابط - رابط الطلب
    مشترك دالة برابط(رابط: نص) -> طلب {
        متغير طلب = جديد طلب()
        طلب._رابط = رابط
        أرجع طلب
    }

    /// عيّن الرابط
    ///
    /// @معامل رابط - رابط الطلب
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة رابط(رابط: نص) -> طلب {
        هذا._رابط = رابط
        أرجع هذا
    }

    /// عيّن الطريقة
    ///
    /// @معامل طريقة - طريقة HTTP (GET، POST، PUT، DELETE، إلخ)
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة طريقة(طريقة: نص) -> طلب {
        هذا._طريقة = طريقة
        أرجع هذا
    }

    /// أضف رأس
    ///
    /// @معامل اسم - اسم الرأس
    /// @معامل قيمة - قيمة الرأس
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة رأس(اسم: نص، قيمة: نص) -> طلب {
        هذا._رؤوس[هذا._عدد_رؤوس] = اسم + ": " + قيمة
        هذا._عدد_رؤوس = هذا._عدد_رؤوس + 1
        أرجع هذا
    }

    /// عيّن الجسم
    ///
    /// @معامل محتوى - محتوى الجسم
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة جسم(محتوى: نص) -> طلب {
        هذا._جسم = محتوى
        أرجع هذا
    }

    /// عيّن جسم JSON
    ///
    /// يضيف تلقائياً رأس Content-Type المناسب
    ///
    /// @معامل محتوى - محتوى JSON
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة جسم_ترميز_كائني(محتوى: نص) -> طلب {
        هذا._جسم = محتوى
        هذا.رأس("Content-Type", "application/json")
        أرجع هذا
    }

    /// عيّن المهلة
    ///
    /// @معامل ميلي_ثانية - المهلة بالميلي ثانية
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة مهلة(ميلي_ثانية: عدد) -> طلب {
        هذا._مهلة = ميلي_ثانية
        أرجع هذا
    }

    /// عيّن متابعة التحويلات
    ///
    /// @معامل متابعة - صحيح لمتابعة التحويلات تلقائياً
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة متابعة_تحويلات(متابعة: منطقي) -> طلب {
        هذا._متابعة_تحويلات = متابعة
        أرجع هذا
    }

    /// عيّن المصادقة الأساسية
    ///
    /// @معامل مستخدم - اسم المستخدم
    /// @معامل كلمة_مرور - كلمة المرور
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة مصادقة_اساسية(مستخدم: نص، كلمة_مرور: نص) -> طلب {
        متغير مشفر = ترميز_أساس64(مستخدم + ":" + كلمة_مرور)
        هذا.رأس("Authorization", "Basic " + مشفر)
        أرجع هذا
    }

    /// عيّن رمز Bearer
    ///
    /// @معامل رمز - رمز المصادقة
    /// @أرجع الطلب نفسه (للتسلسل)
    عام دالة رمز_حامل(رمز: نص) -> طلب {
        هذا.رأس("Authorization", "Bearer " + رمز)
        أرجع هذا
    }

    /// نفّذ الطلب
    ///
    /// @أرجع كائن استجابة HTTP
    عام دالة ارسل() -> استجابة_ويب {
        أرجع طلب_ويب(
            هذا._طريقة،
            هذا._رابط،
            هذا._رؤوس،
            هذا._جسم،
            هذا._مهلة،
            هذا._متابعة_تحويلات
        )
    }
}

// ═══════════════════════════════════════════
// دوال اختصار
// ═══════════════════════════════════════════

/// نفّذ طلب GET
///
/// @معامل رابط - رابط الطلب
/// @أرجع كائن استجابة HTTP
/// @مثال
/// متغير رد = احصل("https://api.example.com/data")
صدّر دالة احصل(رابط: نص) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("GET")
    أرجع طلب.ارسل()
}

/// نفّذ طلب GET مع رؤوس
///
/// @معامل رابط - رابط الطلب
/// @معامل رؤوس - مصفوفة الرؤوس بصيغة ["اسم: قيمة"]
/// @أرجع كائن استجابة HTTP
صدّر دالة احصل_مع_رؤوس(رابط: نص، رؤوس: مصفوفة<نص>) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("GET")
    متغير ع = 0
    طالما (ع < طول_مصفوفة(رؤوس)) {
        متغير رأس = رؤوس[ع]
        متغير موضع = موضع_في(رأس، ": ")
        إذا (موضع > 0) {
            متغير اسم = قص(رأس، 0، موضع)
            متغير قيمة = قص_من(رأس، موضع + 2)
            طلب.رأس(اسم، قيمة)
        }
        ع = ع + 1
    }
    أرجع طلب.ارسل()
}

/// نفّذ طلب POST
///
/// @معامل رابط - رابط الطلب
/// @معامل جسم - جسم الطلب
/// @أرجع كائن استجابة HTTP
/// @مثال
/// متغير رد = ارسل("https://api.example.com/users"، "name=أحمد")
صدّر دالة ارسل(رابط: نص، جسم: نص) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("POST")
    طلب.جسم(جسم)
    أرجع طلب.ارسل()
}

/// نفّذ طلب POST مع JSON
///
/// @معامل رابط - رابط الطلب
/// @معامل جسم - جسم JSON
/// @أرجع كائن استجابة HTTP
/// @مثال
/// متغير رد = ارسل_ترميز_كائني("https://api.example.com/users"، '{"name": "أحمد"}')
صدّر دالة ارسل_ترميز_كائني(رابط: نص، جسم: نص) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("POST")
    طلب.جسم_ترميز_كائني(جسم)
    أرجع طلب.ارسل()
}

/// نفّذ طلب PUT
///
/// @معامل رابط - رابط الطلب
/// @معامل جسم - جسم الطلب
/// @أرجع كائن استجابة HTTP
صدّر دالة حدّث(رابط: نص، جسم: نص) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("PUT")
    طلب.جسم(جسم)
    أرجع طلب.ارسل()
}

/// نفّذ طلب DELETE
///
/// @معامل رابط - رابط الطلب
/// @أرجع كائن استجابة HTTP
صدّر دالة احذف(رابط: نص) -> استجابة_ويب {
    متغير طلب = جديد طلب()
    طلب.رابط(رابط)
    طلب.طريقة("DELETE")
    أرجع طلب.ارسل()
}

/// أنشئ باني طلب جديد
///
/// @أرجع كائن طلب HTTP
/// @مثال
/// متغير رد = طلب_جديد()
///     .رابط("https://api.example.com")
///     .ارسل()
صدّر دالة طلب_جديد() -> طلب {
    أرجع جديد طلب()
}

/// أنشئ باني طلب مع رابط
///
/// @معامل رابط - رابط الطلب
/// @أرجع كائن طلب HTTP
/// @مثال
/// متغير رد = طلب("https://api.example.com").ارسل()
صدّر دالة انشئ_طلب(رابط: نص) -> طلب {
    أرجع جديد طلب().رابط(رابط)
}

/// حمّل ملف من رابط
///
/// @معامل رابط - رابط الملف
/// @معامل مسار - مسار الحفظ
/// @أرجع صحيح إذا نجح التحميل
/// @مثال
/// حمّل_ملف("https://example.com/file.zip"، "/tmp/file.zip")
صدّر دالة حمّل_ملف(رابط: نص، مسار: نص) -> منطقي {
    أرجع حمّل_ويب(رابط، مسار)
}

