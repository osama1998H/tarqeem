// شبكة/خادم - TCP Server
// شبكة/خادم - خادم TCP
//
// Provides TCP server functionality for accepting connections
// يوفر وظائف خادم TCP لقبول الاتصالات

// =============================================================================
// خادم_tcp - TCP Server Class
// =============================================================================

صدّر صنف خادم_tcp {
    خاص _منفذ: عدد
    خاص _مقبض: عدد
    خاص _يستمع: منطقي
    خاص _حد_اتصالات: عدد
    خاص _عنوان_ربط: نص

    // Constructor with port
    // المنشئ مع المنفذ
    منشئ(منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._يستمع = خطأ
        هذا._حد_اتصالات = 128
        هذا._عنوان_ربط = "0.0.0.0"
    }

    // Constructor with address and port
    // المنشئ مع العنوان والمنفذ
    منشئ_عنوان(عنوان: نص، منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._يستمع = خطأ
        هذا._حد_اتصالات = 128
        هذا._عنوان_ربط = عنوان
    }

    // Get port number
    // احصل على رقم المنفذ
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    // Check if server is listening
    // تحقق إذا الخادم يستمع
    عام دالة يستمع() -> منطقي {
        أرجع هذا._يستمع
    }

    // Set connection backlog limit
    // عيّن حد الاتصالات المعلقة
    عام دالة عيّن_حد_اتصالات(حد: عدد) {
        هذا._حد_اتصالات = حد
    }

    // Start listening for connections
    // ابدأ الاستماع للاتصالات
    عام دالة استمع() -> منطقي {
        إذا (هذا._يستمع) {
            أرجع صحيح
        }
        // Uses runtime: trq_tcp_listen
        هذا._مقبض = __tcp_استمع__(هذا._عنوان_ربط، هذا._منفذ، هذا._حد_اتصالات)
        إذا (هذا._مقبض >= 0) {
            هذا._يستمع = صحيح
            أرجع صحيح
        }
        أرجع خطأ
    }

    // Accept a connection (blocking)
    // اقبل اتصال (حجب)
    عام دالة اقبل() -> اتصال_tcp {
        إذا (!هذا._يستمع) {
            أرجع جديد اتصال_tcp("", 0)
        }
        // Uses runtime: trq_tcp_accept
        متغير بيانات = __tcp_اقبل__(هذا._مقبض)
        متغير عنوان = بيانات.عنوان
        متغير منفذ = بيانات.منفذ
        متغير مقبض = بيانات.مقبض

        متغير اتصال = جديد اتصال_tcp(عنوان، منفذ)
        // Set the socket handle directly
        // عيّن مقبض المقبس مباشرة
        اتصال._مقبض = مقبض
        اتصال._حالة = حالة_متصل
        أرجع اتصال
    }

    // Accept with timeout (milliseconds)
    // اقبل مع مهلة (بالميلي ثانية)
    عام دالة اقبل_مع_مهلة(مهلة: عدد) -> اتصال_tcp {
        إذا (!هذا._يستمع) {
            أرجع جديد اتصال_tcp("", 0)
        }
        // Uses runtime: trq_tcp_accept_timeout
        متغير بيانات = __tcp_اقبل_مع_مهلة__(هذا._مقبض، مهلة)
        إذا (بيانات.مقبض < 0) {
            أرجع جديد اتصال_tcp("", 0)
        }

        متغير اتصال = جديد اتصال_tcp(بيانات.عنوان، بيانات.منفذ)
        اتصال._مقبض = بيانات.مقبض
        اتصال._حالة = حالة_متصل
        أرجع اتصال
    }

    // Stop listening and close server
    // أوقف الاستماع وأغلق الخادم
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            // Uses runtime: trq_tcp_close
            __tcp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._يستمع = خطأ
    }

    // Get bound address
    // احصل على العنوان المربوط
    عام دالة عنوان() -> نص {
        أرجع هذا._عنوان_ربط
    }
}

// =============================================================================
// خادم_udp - UDP Server Class
// =============================================================================

صدّر صنف خادم_udp {
    خاص _منفذ: عدد
    خاص _مقبض: عدد
    خاص _مربوط: منطقي
    خاص _مهلة: عدد

    // Constructor with port
    // المنشئ مع المنفذ
    منشئ(منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._مربوط = خطأ
        هذا._مهلة = 5000
    }

    // Get port
    // احصل على المنفذ
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    // Check if bound
    // تحقق إذا مربوط
    عام دالة مربوط() -> منطقي {
        أرجع هذا._مربوط
    }

    // Set receive timeout
    // عيّن مهلة الاستقبال
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    // Bind to port and start listening
    // اربط بالمنفذ وابدأ الاستماع
    عام دالة اربط() -> منطقي {
        إذا (هذا._مربوط) {
            أرجع صحيح
        }
        // Uses runtime: trq_udp_bind
        هذا._مقبض = __udp_اربط__(هذا._منفذ)
        إذا (هذا._مقبض >= 0) {
            هذا._مربوط = صحيح
            أرجع صحيح
        }
        أرجع خطأ
    }

    // Receive datagram with sender info
    // استقبل مخطط بيانات مع معلومات المرسل
    عام دالة استقبل() -> نص {
        إذا (!هذا._مربوط) {
            أرجع ""
        }
        // Uses runtime: trq_udp_receive
        أرجع __udp_استقبل__(هذا._مقبض، هذا._مهلة)
    }

    // Receive bytes
    // استقبل بايتات
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (!هذا._مربوط) {
            أرجع []
        }
        // Uses runtime: trq_udp_receive_bytes
        أرجع __udp_استقبل_بايتات__(هذا._مقبض، حجم، هذا._مهلة)
    }

    // Send response to last sender
    // أرسل رد إلى آخر مرسل
    عام دالة ارسل_رد(بيانات: نص) -> منطقي {
        إذا (!هذا._مربوط) {
            أرجع خطأ
        }
        // Uses runtime: trq_udp_reply
        أرجع __udp_ارسل_رد__(هذا._مقبض، بيانات)
    }

    // Send to specific address
    // أرسل إلى عنوان محدد
    عام دالة ارسل_الى(عنوان: نص، منفذ: عدد، بيانات: نص) -> منطقي {
        إذا (!هذا._مربوط) {
            أرجع خطأ
        }
        // Uses runtime: trq_udp_send_to
        أرجع __udp_ارسل_الى__(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    // Close server
    // أغلق الخادم
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            // Uses runtime: trq_udp_close
            __udp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._مربوط = خطأ
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Create TCP server on port
// أنشئ خادم TCP على منفذ
صدّر دالة خادم_جديد(منفذ: عدد) -> خادم_tcp {
    أرجع جديد خادم_tcp(منفذ)
}

// Create and start TCP server
// أنشئ وابدأ خادم TCP
صدّر دالة ابدأ_خادم(منفذ: عدد) -> خادم_tcp {
    متغير خادم = جديد خادم_tcp(منفذ)
    خادم.استمع()
    أرجع خادم
}

// Create UDP server on port
// أنشئ خادم UDP على منفذ
صدّر دالة خادم_udp_جديد(منفذ: عدد) -> خادم_udp {
    أرجع جديد خادم_udp(منفذ)
}
