/// خوادم TCP و UDP
///
/// توفر هذه الوحدة أصناف الخوادم لقبول الاتصالات
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// صنف خادم TCP
// ═══════════════════════════════════════════

/// صنف خادم TCP
///
/// يوفر خادم TCP لقبول اتصالات العملاء
///
/// @مثال
/// متغير خ = جديد خادم_tcp(8080)
/// إذا (خ.استمع()) {
///     طالما (صحيح) {
///         متغير عميل = خ.اقبل()
///         إذا (عميل.متصل()) {
///             متغير رسالة = عميل.استقبل()
///             عميل.ارسل("مرحباً!")
///             عميل.اغلق()
///         }
///     }
/// }
صدّر صنف خادم_tcp {
    /// رقم المنفذ
    خاص _منفذ: عدد

    /// مقبض المقبس
    خاص _مقبض: عدد

    /// حالة الاستماع
    خاص _يستمع: منطقي

    /// حد الاتصالات المعلقة
    خاص _حد_اتصالات: عدد

    /// عنوان الربط
    خاص _عنوان_ربط: نص

    /// المنشئ مع المنفذ
    ///
    /// @معامل منفذ - رقم المنفذ للاستماع عليه
    منشئ(منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._يستمع = خطأ
        هذا._حد_اتصالات = 128
        هذا._عنوان_ربط = "0.0.0.0"
    }

    /// المنشئ مع العنوان والمنفذ
    ///
    /// @معامل عنوان - عنوان الربط (مثل "127.0.0.1")
    /// @معامل منفذ - رقم المنفذ
    منشئ_عنوان(عنوان: نص، منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._يستمع = خطأ
        هذا._حد_اتصالات = 128
        هذا._عنوان_ربط = عنوان
    }

    /// احصل على رقم المنفذ
    ///
    /// @أرجع رقم المنفذ
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    /// تحقق إذا الخادم يستمع
    ///
    /// @أرجع صحيح إذا كان يستمع للاتصالات
    عام دالة يستمع() -> منطقي {
        أرجع هذا._يستمع
    }

    /// عيّن حد الاتصالات المعلقة
    ///
    /// @معامل حد - العدد الأقصى للاتصالات المعلقة
    عام دالة عيّن_حد_اتصالات(حد: عدد) {
        هذا._حد_اتصالات = حد
    }

    /// ابدأ الاستماع للاتصالات
    ///
    /// @أرجع صحيح إذا بدأ الاستماع بنجاح
    /// @مثال
    /// إذا (خ.استمع()) {
    ///     اطبع("الخادم يستمع على المنفذ " + خ.منفذ())
    /// }
    عام دالة استمع() -> منطقي {
        إذا (هذا._يستمع) {
            أرجع صحيح
        }
        هذا._مقبض = __tcp_استمع__(هذا._عنوان_ربط، هذا._منفذ، هذا._حد_اتصالات)
        إذا (هذا._مقبض >= 0) {
            هذا._يستمع = صحيح
            أرجع صحيح
        }
        أرجع خطأ
    }

    /// اقبل اتصالاً (حاجب)
    ///
    /// ينتظر حتى يتصل عميل ثم يعيد كائن الاتصال
    ///
    /// @أرجع كائن اتصال TCP للعميل
    /// @ملاحظة هذه الدالة حاجبة وتنتظر حتى يتصل عميل
    عام دالة اقبل() -> اتصال_tcp {
        إذا (!هذا._يستمع) {
            أرجع جديد اتصال_tcp("", 0)
        }
        متغير بيانات = __tcp_اقبل__(هذا._مقبض)
        متغير عنوان = بيانات.عنوان
        متغير منفذ = بيانات.منفذ
        متغير مقبض = بيانات.مقبض

        متغير اتصال = جديد اتصال_tcp(عنوان، منفذ)
        اتصال._مقبض = مقبض
        اتصال._حالة = حالة_متصل
        أرجع اتصال
    }

    /// اقبل اتصالاً مع مهلة
    ///
    /// @معامل مهلة - المهلة بالميلي ثانية
    /// @أرجع كائن اتصال TCP أو اتصال فارغ عند انتهاء المهلة
    عام دالة اقبل_مع_مهلة(مهلة: عدد) -> اتصال_tcp {
        إذا (!هذا._يستمع) {
            أرجع جديد اتصال_tcp("", 0)
        }
        متغير بيانات = __tcp_اقبل_مع_مهلة__(هذا._مقبض، مهلة)
        إذا (بيانات.مقبض < 0) {
            أرجع جديد اتصال_tcp("", 0)
        }

        متغير اتصال = جديد اتصال_tcp(بيانات.عنوان، بيانات.منفذ)
        اتصال._مقبض = بيانات.مقبض
        اتصال._حالة = حالة_متصل
        أرجع اتصال
    }

    /// أوقف الاستماع وأغلق الخادم
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            __tcp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._يستمع = خطأ
    }

    /// احصل على العنوان المربوط
    ///
    /// @أرجع عنوان الربط
    عام دالة عنوان() -> نص {
        أرجع هذا._عنوان_ربط
    }
}

// ═══════════════════════════════════════════
// صنف خادم UDP
// ═══════════════════════════════════════════

/// صنف خادم UDP
///
/// يوفر خادم UDP لاستقبال مخططات البيانات
///
/// @مثال
/// متغير خ = جديد خادم_udp(9000)
/// إذا (خ.اربط()) {
///     متغير رسالة = خ.استقبل()
///     اطبع("استقبلت: " + رسالة)
///     خ.ارسل_رد("تم الاستلام")
/// }
صدّر صنف خادم_udp {
    /// رقم المنفذ
    خاص _منفذ: عدد

    /// مقبض المقبس
    خاص _مقبض: عدد

    /// حالة الربط
    خاص _مربوط: منطقي

    /// مهلة الاستقبال
    خاص _مهلة: عدد

    /// المنشئ
    ///
    /// @معامل منفذ - رقم المنفذ للربط
    منشئ(منفذ: عدد) {
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._مربوط = خطأ
        هذا._مهلة = 5000
    }

    /// احصل على رقم المنفذ
    ///
    /// @أرجع رقم المنفذ
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    /// تحقق إذا مربوط
    ///
    /// @أرجع صحيح إذا كان مربوطاً بالمنفذ
    عام دالة مربوط() -> منطقي {
        أرجع هذا._مربوط
    }

    /// عيّن مهلة الاستقبال
    ///
    /// @معامل ميلي_ثانية - المهلة بالميلي ثانية
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    /// اربط بالمنفذ وابدأ الاستماع
    ///
    /// @أرجع صحيح إذا نجح الربط
    عام دالة اربط() -> منطقي {
        إذا (هذا._مربوط) {
            أرجع صحيح
        }
        هذا._مقبض = __udp_اربط__(هذا._منفذ)
        إذا (هذا._مقبض >= 0) {
            هذا._مربوط = صحيح
            أرجع صحيح
        }
        أرجع خطأ
    }

    /// استقبل مخطط بيانات
    ///
    /// @أرجع النص المستقبل
    عام دالة استقبل() -> نص {
        إذا (!هذا._مربوط) {
            أرجع ""
        }
        أرجع __udp_استقبل__(هذا._مقبض، هذا._مهلة)
    }

    /// استقبل بايتات
    ///
    /// @معامل حجم - الحجم الأقصى للاستقبال
    /// @أرجع مصفوفة البايتات المستقبلة
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (!هذا._مربوط) {
            أرجع []
        }
        أرجع __udp_استقبل_بايتات__(هذا._مقبض، حجم، هذا._مهلة)
    }

    /// أرسل رداً إلى آخر مرسل
    ///
    /// @معامل بيانات - النص المراد إرساله
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_رد(بيانات: نص) -> منطقي {
        إذا (!هذا._مربوط) {
            أرجع خطأ
        }
        أرجع __udp_ارسل_رد__(هذا._مقبض، بيانات)
    }

    /// أرسل إلى عنوان محدد
    ///
    /// @معامل عنوان - عنوان الوجهة
    /// @معامل منفذ - منفذ الوجهة
    /// @معامل بيانات - النص المراد إرساله
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_الى(عنوان: نص، منفذ: عدد، بيانات: نص) -> منطقي {
        إذا (!هذا._مربوط) {
            أرجع خطأ
        }
        أرجع __udp_ارسل_الى__(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    /// أغلق الخادم
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            __udp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._مربوط = خطأ
    }
}

// ═══════════════════════════════════════════
// دوال اختصار
// ═══════════════════════════════════════════

/// أنشئ خادم TCP جديد
///
/// @معامل منفذ - رقم المنفذ
/// @أرجع كائن خادم TCP
/// @مثال
/// متغير خ = خادم_جديد(8080)
صدّر دالة خادم_جديد(منفذ: عدد) -> خادم_tcp {
    أرجع جديد خادم_tcp(منفذ)
}

/// أنشئ وابدأ خادم TCP
///
/// @معامل منفذ - رقم المنفذ
/// @أرجع كائن خادم TCP يستمع
/// @مثال
/// متغير خ = ابدأ_خادم(8080)
صدّر دالة ابدأ_خادم(منفذ: عدد) -> خادم_tcp {
    متغير خادم = جديد خادم_tcp(منفذ)
    خادم.استمع()
    أرجع خادم
}

/// أنشئ خادم UDP جديد
///
/// @معامل منفذ - رقم المنفذ
/// @أرجع كائن خادم UDP
/// @مثال
/// متغير خ = خادم_udp_جديد(9000)
صدّر دالة خادم_udp_جديد(منفذ: عدد) -> خادم_udp {
    أرجع جديد خادم_udp(منفذ)
}
