// شبكة/http - HTTP Client
// شبكة/http - عميل HTTP
//
// Provides simple HTTP client functionality
// يوفر وظائف عميل HTTP بسيطة

// =============================================================================
// HTTP Method Constants / ثوابت طريقة HTTP
// =============================================================================

صدّر ثابت طريقة_GET: نص = "GET"
صدّر ثابت طريقة_POST: نص = "POST"
صدّر ثابت طريقة_PUT: نص = "PUT"
صدّر ثابت طريقة_DELETE: نص = "DELETE"
صدّر ثابت طريقة_PATCH: نص = "PATCH"
صدّر ثابت طريقة_HEAD: نص = "HEAD"
صدّر ثابت طريقة_OPTIONS: نص = "OPTIONS"

// =============================================================================
// استجابة_http - HTTP Response Class
// =============================================================================

صدّر صنف استجابة_http {
    عام حالة: عدد
    عام نص_حالة: نص
    عام جسم: نص
    خاص _رؤوس: مصفوفة<نص>
    خاص _عدد_رؤوس: عدد

    // Constructor
    // المنشئ
    منشئ() {
        هذا.حالة = 0
        هذا.نص_حالة = ""
        هذا.جسم = ""
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
    }

    // Constructor with values
    // المنشئ مع القيم
    منشئ_كامل(حالة: عدد، نص_حالة: نص، جسم: نص) {
        هذا.حالة = حالة
        هذا.نص_حالة = نص_حالة
        هذا.جسم = جسم
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
    }

    // Check if response is successful (2xx)
    // تحقق إذا الاستجابة ناجحة (2xx)
    عام دالة ناجحة() -> منطقي {
        أرجع هذا.حالة >= 200 && هذا.حالة < 300
    }

    // Check if redirect (3xx)
    // تحقق إذا تحويل (3xx)
    عام دالة تحويل() -> منطقي {
        أرجع هذا.حالة >= 300 && هذا.حالة < 400
    }

    // Check if client error (4xx)
    // تحقق إذا خطأ عميل (4xx)
    عام دالة خطأ_عميل() -> منطقي {
        أرجع هذا.حالة >= 400 && هذا.حالة < 500
    }

    // Check if server error (5xx)
    // تحقق إذا خطأ خادم (5xx)
    عام دالة خطأ_خادم() -> منطقي {
        أرجع هذا.حالة >= 500 && هذا.حالة < 600
    }

    // Get header value
    // احصل على قيمة رأس
    عام دالة رأس(اسم: نص) -> نص {
        متغير ع = 0
        طالما (ع < هذا._عدد_رؤوس) {
            متغير رأس = هذا._رؤوس[ع]
            // Headers stored as "name: value"
            إذا (__يبدأ_بـ__(رأس، اسم + ": ")) {
                أرجع __قص_من__(رأس، __طول__(اسم) + 2)
            }
            ع = ع + 1
        }
        أرجع ""
    }

    // Add header (internal use)
    // أضف رأس (استخدام داخلي)
    عام دالة _أضف_رأس(رأس: نص) {
        هذا._رؤوس[هذا._عدد_رؤوس] = رأس
        هذا._عدد_رؤوس = هذا._عدد_رؤوس + 1
    }

    // Get body length
    // احصل على طول الجسم
    عام دالة طول_جسم() -> عدد {
        أرجع __طول__(هذا.جسم)
    }

    // Get content type
    // احصل على نوع المحتوى
    عام دالة نوع_محتوى() -> نص {
        أرجع هذا.رأس("Content-Type")
    }

    // Check if JSON response
    // تحقق إذا استجابة JSON
    عام دالة هل_json() -> منطقي {
        متغير نوع = هذا.نوع_محتوى()
        أرجع __يحتوي__(نوع، "application/json")
    }
}

// =============================================================================
// طلب_http - HTTP Request Class
// =============================================================================

صدّر صنف طلب_http {
    خاص _رابط: نص
    خاص _طريقة: نص
    خاص _رؤوس: مصفوفة<نص>
    خاص _عدد_رؤوس: عدد
    خاص _جسم: نص
    خاص _مهلة: عدد
    خاص _متابعة_تحويلات: منطقي

    // Constructor
    // المنشئ
    منشئ() {
        هذا._رابط = ""
        هذا._طريقة = "GET"
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
        هذا._جسم = ""
        هذا._مهلة = 30000
        هذا._متابعة_تحويلات = صحيح
    }

    // Constructor with URL
    // المنشئ مع الرابط
    منشئ_رابط(رابط: نص) {
        هذا._رابط = رابط
        هذا._طريقة = "GET"
        هذا._رؤوس = []
        هذا._عدد_رؤوس = 0
        هذا._جسم = ""
        هذا._مهلة = 30000
        هذا._متابعة_تحويلات = صحيح
    }

    // Set URL
    // عيّن الرابط
    عام دالة رابط(رابط: نص) -> طلب_http {
        هذا._رابط = رابط
        أرجع هذا
    }

    // Set method
    // عيّن الطريقة
    عام دالة طريقة(طريقة: نص) -> طلب_http {
        هذا._طريقة = طريقة
        أرجع هذا
    }

    // Add header
    // أضف رأس
    عام دالة رأس(اسم: نص، قيمة: نص) -> طلب_http {
        هذا._رؤوس[هذا._عدد_رؤوس] = اسم + ": " + قيمة
        هذا._عدد_رؤوس = هذا._عدد_رؤوس + 1
        أرجع هذا
    }

    // Set body
    // عيّن الجسم
    عام دالة جسم(محتوى: نص) -> طلب_http {
        هذا._جسم = محتوى
        أرجع هذا
    }

    // Set JSON body
    // عيّن جسم JSON
    عام دالة جسم_json(محتوى: نص) -> طلب_http {
        هذا._جسم = محتوى
        هذا.رأس("Content-Type", "application/json")
        أرجع هذا
    }

    // Set timeout
    // عيّن المهلة
    عام دالة مهلة(ميلي_ثانية: عدد) -> طلب_http {
        هذا._مهلة = ميلي_ثانية
        أرجع هذا
    }

    // Set follow redirects
    // عيّن متابعة التحويلات
    عام دالة متابعة_تحويلات(متابعة: منطقي) -> طلب_http {
        هذا._متابعة_تحويلات = متابعة
        أرجع هذا
    }

    // Set basic authentication
    // عيّن المصادقة الأساسية
    عام دالة مصادقة_اساسية(مستخدم: نص، كلمة_مرور: نص) -> طلب_http {
        متغير مشفر = __base64_ترميز__(مستخدم + ":" + كلمة_مرور)
        هذا.رأس("Authorization", "Basic " + مشفر)
        أرجع هذا
    }

    // Set bearer token
    // عيّن رمز Bearer
    عام دالة رمز_bearer(رمز: نص) -> طلب_http {
        هذا.رأس("Authorization", "Bearer " + رمز)
        أرجع هذا
    }

    // Execute request
    // نفّذ الطلب
    عام دالة ارسل() -> استجابة_http {
        // Uses runtime: trq_http_request
        أرجع __http_طلب__(
            هذا._طريقة،
            هذا._رابط،
            هذا._رؤوس،
            هذا._جسم،
            هذا._مهلة،
            هذا._متابعة_تحويلات
        )
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Perform GET request
// نفّذ طلب GET
صدّر دالة احصل(رابط: نص) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("GET")
    أرجع طلب.ارسل()
}

// Perform GET request with headers
// نفّذ طلب GET مع رؤوس
صدّر دالة احصل_مع_رؤوس(رابط: نص، رؤوس: مصفوفة<نص>) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("GET")
    متغير ع = 0
    طالما (ع < __طول_مصفوفة__(رؤوس)) {
        متغير رأس = رؤوس[ع]
        متغير موضع = __موضع__(رأس، ": ")
        إذا (موضع > 0) {
            متغير اسم = __قص__(رأس، 0، موضع)
            متغير قيمة = __قص_من__(رأس، موضع + 2)
            طلب.رأس(اسم، قيمة)
        }
        ع = ع + 1
    }
    أرجع طلب.ارسل()
}

// Perform POST request
// نفّذ طلب POST
صدّر دالة ارسل(رابط: نص، جسم: نص) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("POST")
    طلب.جسم(جسم)
    أرجع طلب.ارسل()
}

// Perform POST request with JSON
// نفّذ طلب POST مع JSON
صدّر دالة ارسل_json(رابط: نص، جسم: نص) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("POST")
    طلب.جسم_json(جسم)
    أرجع طلب.ارسل()
}

// Perform PUT request
// نفّذ طلب PUT
صدّر دالة حدّث(رابط: نص، جسم: نص) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("PUT")
    طلب.جسم(جسم)
    أرجع طلب.ارسل()
}

// Perform DELETE request
// نفّذ طلب DELETE
صدّر دالة احذف(رابط: نص) -> استجابة_http {
    متغير طلب = جديد طلب_http()
    طلب.رابط(رابط)
    طلب.طريقة("DELETE")
    أرجع طلب.ارسل()
}

// Create new request builder
// أنشئ باني طلب جديد
صدّر دالة طلب_جديد() -> طلب_http {
    أرجع جديد طلب_http()
}

// Create request builder with URL
// أنشئ باني طلب مع رابط
صدّر دالة طلب(رابط: نص) -> طلب_http {
    أرجع جديد طلب_http()
        .رابط(رابط)
}

// Download file from URL
// حمّل ملف من رابط
صدّر دالة حمّل_ملف(رابط: نص، مسار: نص) -> منطقي {
    // Uses runtime: trq_http_download
    أرجع __http_حمّل__(رابط، مسار)
}

// URL encode string
// رمّز النص للرابط
صدّر دالة رمّز_رابط(نص: نص) -> نص {
    // Uses runtime: trq_url_encode
    أرجع __رمّز_رابط__(نص)
}

// URL decode string
// فك رمز الرابط
صدّر دالة فك_رمز_رابط(نص: نص) -> نص {
    // Uses runtime: trq_url_decode
    أرجع __فك_رمز_رابط__(نص)
}
