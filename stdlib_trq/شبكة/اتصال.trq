// شبكة/اتصال - TCP/UDP Connection
// شبكة/اتصال - اتصال TCP/UDP
//
// Provides TCP and UDP socket connections
// يوفر اتصالات مقابس TCP و UDP

// =============================================================================
// Connection Status Enum / تعداد حالة الاتصال
// =============================================================================

// Connection status constants
// ثوابت حالة الاتصال
صدّر ثابت حالة_غير_متصل: عدد = 0
صدّر ثابت حالة_يتصل: عدد = 1
صدّر ثابت حالة_متصل: عدد = 2
صدّر ثابت حالة_مغلق: عدد = 3
صدّر ثابت حالة_خطأ: عدد = 4

// =============================================================================
// اتصال_tcp - TCP Connection Class
// =============================================================================

صدّر صنف اتصال_tcp {
    خاص _عنوان: نص
    خاص _منفذ: عدد
    خاص _مقبض: عدد
    خاص _حالة: عدد
    خاص _مهلة: عدد

    // Constructor with address and port
    // المنشئ مع العنوان والمنفذ
    منشئ(عنوان: نص، منفذ: عدد) {
        هذا._عنوان = عنوان
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._حالة = حالة_غير_متصل
        هذا._مهلة = 30000  // Default 30 seconds
    }

    // Get server address
    // احصل على عنوان الخادم
    عام دالة عنوان() -> نص {
        أرجع هذا._عنوان
    }

    // Get server port
    // احصل على منفذ الخادم
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    // Get connection status
    // احصل على حالة الاتصال
    عام دالة حالة() -> عدد {
        أرجع هذا._حالة
    }

    // Check if connected
    // تحقق إذا متصل
    عام دالة متصل() -> منطقي {
        أرجع هذا._حالة == حالة_متصل
    }

    // Set connection timeout (milliseconds)
    // عيّن مهلة الاتصال (بالميلي ثانية)
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    // Connect to server
    // اتصل بالخادم
    عام دالة اتصل() -> منطقي {
        إذا (هذا._حالة == حالة_متصل) {
            أرجع صحيح
        }
        هذا._حالة = حالة_يتصل
        // Uses runtime: trq_tcp_connect
        هذا._مقبض = __tcp_اتصل__(هذا._عنوان، هذا._منفذ، هذا._مهلة)
        إذا (هذا._مقبض >= 0) {
            هذا._حالة = حالة_متصل
            أرجع صحيح
        }
        هذا._حالة = حالة_خطأ
        أرجع خطأ
    }

    // Disconnect from server
    // اقطع الاتصال بالخادم
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            // Uses runtime: trq_tcp_close
            __tcp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._حالة = حالة_مغلق
    }

    // Send data (string)
    // أرسل بيانات (نص)
    عام دالة ارسل(بيانات: نص) -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        // Uses runtime: trq_tcp_send
        أرجع __tcp_ارسل__(هذا._مقبض، بيانات)
    }

    // Send data with newline
    // أرسل بيانات مع سطر جديد
    عام دالة ارسل_سطر(بيانات: نص) -> منطقي {
        أرجع هذا.ارسل(بيانات + "\n")
    }

    // Send raw bytes
    // أرسل بايتات خام
    عام دالة ارسل_بايتات(بيانات: مصفوفة<عدد>) -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        // Uses runtime: trq_tcp_send_bytes
        أرجع __tcp_ارسل_بايتات__(هذا._مقبض، بيانات)
    }

    // Receive data (string)
    // استقبل بيانات (نص)
    عام دالة استقبل() -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        // Uses runtime: trq_tcp_receive
        أرجع __tcp_استقبل__(هذا._مقبض، هذا._مهلة)
    }

    // Receive specific number of bytes
    // استقبل عدد محدد من البايتات
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع []
        }
        // Uses runtime: trq_tcp_receive_bytes
        أرجع __tcp_استقبل_بايتات__(هذا._مقبض، حجم، هذا._مهلة)
    }

    // Receive until delimiter
    // استقبل حتى الفاصل
    عام دالة استقبل_حتى(فاصل: نص) -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        // Uses runtime: trq_tcp_receive_until
        أرجع __tcp_استقبل_حتى__(هذا._مقبض، فاصل، هذا._مهلة)
    }

    // Receive line (until newline)
    // استقبل سطر (حتى سطر جديد)
    عام دالة استقبل_سطر() -> نص {
        أرجع هذا.استقبل_حتى("\n")
    }

    // Check if data is available
    // تحقق إذا توجد بيانات متاحة
    عام دالة بيانات_متاحة() -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        // Uses runtime: trq_tcp_available
        أرجع __tcp_بيانات_متاحة__(هذا._مقبض)
    }

    // Get local address
    // احصل على العنوان المحلي
    عام دالة عنوان_محلي() -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        // Uses runtime: trq_tcp_local_address
        أرجع __tcp_عنوان_محلي__(هذا._مقبض)
    }

    // Get local port
    // احصل على المنفذ المحلي
    عام دالة منفذ_محلي() -> عدد {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع -1
        }
        // Uses runtime: trq_tcp_local_port
        أرجع __tcp_منفذ_محلي__(هذا._مقبض)
    }
}

// =============================================================================
// اتصال_udp - UDP Connection Class
// =============================================================================

صدّر صنف اتصال_udp {
    خاص _مقبض: عدد
    خاص _منفذ_محلي: عدد
    خاص _مهلة: عدد

    // Constructor
    // المنشئ
    منشئ() {
        هذا._مقبض = -1
        هذا._منفذ_محلي = 0
        هذا._مهلة = 5000  // Default 5 seconds
    }

    // Constructor with local port
    // المنشئ مع المنفذ المحلي
    منشئ_منفذ(منفذ: عدد) {
        هذا._مقبض = -1
        هذا._منفذ_محلي = منفذ
        هذا._مهلة = 5000
    }

    // Bind to local port
    // اربط بالمنفذ المحلي
    عام دالة اربط(منفذ: عدد) -> منطقي {
        // Uses runtime: trq_udp_bind
        هذا._مقبض = __udp_اربط__(منفذ)
        إذا (هذا._مقبض >= 0) {
            هذا._منفذ_محلي = منفذ
            أرجع صحيح
        }
        أرجع خطأ
    }

    // Close socket
    // أغلق المقبس
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            // Uses runtime: trq_udp_close
            __udp_اغلق__(هذا._مقبض)
            هذا._مقبض = -1
        }
    }

    // Set timeout
    // عيّن المهلة
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    // Send datagram to address
    // أرسل مخطط بيانات إلى عنوان
    عام دالة ارسل_الى(عنوان: نص، منفذ: عدد، بيانات: نص) -> منطقي {
        إذا (هذا._مقبض < 0) {
            // Auto-bind to random port
            هذا.اربط(0)
        }
        // Uses runtime: trq_udp_send_to
        أرجع __udp_ارسل_الى__(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    // Send bytes to address
    // أرسل بايتات إلى عنوان
    عام دالة ارسل_بايتات_الى(عنوان: نص، منفذ: عدد، بيانات: مصفوفة<عدد>) -> منطقي {
        إذا (هذا._مقبض < 0) {
            هذا.اربط(0)
        }
        // Uses runtime: trq_udp_send_bytes_to
        أرجع __udp_ارسل_بايتات_الى__(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    // Receive datagram
    // استقبل مخطط بيانات
    عام دالة استقبل() -> نص {
        إذا (هذا._مقبض < 0) {
            أرجع ""
        }
        // Uses runtime: trq_udp_receive
        أرجع __udp_استقبل__(هذا._مقبض، هذا._مهلة)
    }

    // Receive bytes
    // استقبل بايتات
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (هذا._مقبض < 0) {
            أرجع []
        }
        // Uses runtime: trq_udp_receive_bytes
        أرجع __udp_استقبل_بايتات__(هذا._مقبض، حجم، هذا._مهلة)
    }

    // Check if bound
    // تحقق إذا مربوط
    عام دالة مربوط() -> منطقي {
        أرجع هذا._مقبض >= 0
    }

    // Get local port
    // احصل على المنفذ المحلي
    عام دالة منفذ_محلي() -> عدد {
        أرجع هذا._منفذ_محلي
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Create TCP connection
// أنشئ اتصال TCP
صدّر دالة اتصال_جديد(عنوان: نص، منفذ: عدد) -> اتصال_tcp {
    أرجع جديد اتصال_tcp(عنوان، منفذ)
}

// Connect and return connection (convenience)
// اتصل وأرجع الاتصال (للراحة)
صدّر دالة اتصل_بـ(عنوان: نص، منفذ: عدد) -> اتصال_tcp {
    متغير اتصال = جديد اتصال_tcp(عنوان، منفذ)
    اتصال.اتصل()
    أرجع اتصال
}

// Resolve hostname to IP
// حل اسم المضيف إلى IP
صدّر دالة حل_عنوان(اسم_مضيف: نص) -> نص {
    // Uses runtime: trq_resolve_hostname
    أرجع __حل_عنوان__(اسم_مضيف)
}

// Get local IP address
// احصل على عنوان IP المحلي
صدّر دالة عنوان_محلي() -> نص {
    // Uses runtime: trq_get_local_ip
    أرجع __احصل_ip_محلي__()
}
