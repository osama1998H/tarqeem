/// اتصالات TCP و UDP
///
/// توفر هذه الوحدة أصناف الاتصال بالمقابس
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// ثوابت حالة الاتصال
// ═══════════════════════════════════════════

/// حالة غير متصل
صدّر ثابت حالة_غير_متصل: عدد = 0

/// حالة جاري الاتصال
صدّر ثابت حالة_يتصل: عدد = 1

/// حالة متصل
صدّر ثابت حالة_متصل: عدد = 2

/// حالة مغلق
صدّر ثابت حالة_مغلق: عدد = 3

/// حالة خطأ
صدّر ثابت حالة_خطأ: عدد = 4

// ═══════════════════════════════════════════
// صنف اتصال TCP
// ═══════════════════════════════════════════

/// صنف اتصال TCP
///
/// يوفر اتصال TCP بخادم بعيد مع إمكانية
/// الإرسال والاستقبال
///
/// @مثال
/// متغير ات = جديد اتصال_نقل("127.0.0.1"، 8080)
/// إذا (ات.اتصل()) {
///     ات.ارسل("مرحباً")
///     متغير رد = ات.استقبل()
///     ات.اغلق()
/// }
صدّر صنف اتصال_نقل {
    /// عنوان الخادم
    خاص _عنوان: نص

    /// منفذ الخادم
    خاص _منفذ: عدد

    /// مقبض المقبس
    خاص _مقبض: عدد

    /// حالة الاتصال
    خاص _حالة: عدد

    /// مهلة الاتصال بالميلي ثانية
    خاص _مهلة: عدد

    /// المنشئ
    ///
    /// @معامل عنوان - عنوان الخادم (IP أو اسم مضيف)
    /// @معامل منفذ - رقم المنفذ
    منشئ(عنوان: نص، منفذ: عدد) {
        هذا._عنوان = عنوان
        هذا._منفذ = منفذ
        هذا._مقبض = -1
        هذا._حالة = حالة_غير_متصل
        هذا._مهلة = 30000
    }

    /// احصل على عنوان الخادم
    ///
    /// @أرجع عنوان الخادم
    عام دالة عنوان() -> نص {
        أرجع هذا._عنوان
    }

    /// احصل على منفذ الخادم
    ///
    /// @أرجع رقم المنفذ
    عام دالة منفذ() -> عدد {
        أرجع هذا._منفذ
    }

    /// احصل على حالة الاتصال
    ///
    /// @أرجع رقم الحالة (استخدم ثوابت حالة_*)
    عام دالة حالة() -> عدد {
        أرجع هذا._حالة
    }

    /// تحقق إذا متصل
    ///
    /// @أرجع صحيح إذا كان الاتصال نشطاً
    عام دالة متصل() -> منطقي {
        أرجع هذا._حالة == حالة_متصل
    }

    /// عيّن مهلة الاتصال
    ///
    /// @معامل ميلي_ثانية - المهلة بالميلي ثانية
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    /// اتصل بالخادم
    ///
    /// @أرجع صحيح إذا نجح الاتصال
    /// @مثال
    /// إذا (ات.اتصل()) {
    ///     اطبع("تم الاتصال!")
    /// }
    عام دالة اتصل() -> منطقي {
        إذا (هذا._حالة == حالة_متصل) {
            أرجع صحيح
        }
        هذا._حالة = حالة_يتصل
        هذا._مقبض = نقل_اتصل(هذا._عنوان، هذا._منفذ، هذا._مهلة)
        إذا (هذا._مقبض >= 0) {
            هذا._حالة = حالة_متصل
            أرجع صحيح
        }
        هذا._حالة = حالة_خطأ
        أرجع خطأ
    }

    /// أغلق الاتصال
    ///
    /// @ملاحظة يمكن استدعاؤها بأمان حتى لو لم يكن متصلاً
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            نقل_اغلق(هذا._مقبض)
            هذا._مقبض = -1
        }
        هذا._حالة = حالة_مغلق
    }

    /// أرسل بيانات نصية
    ///
    /// @معامل بيانات - النص المراد إرساله
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل(بيانات: نص) -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        أرجع نقل_ارسل(هذا._مقبض، بيانات)
    }

    /// أرسل سطراً مع حرف السطر الجديد
    ///
    /// @معامل بيانات - النص المراد إرساله
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_سطر(بيانات: نص) -> منطقي {
        أرجع هذا.ارسل(بيانات + "\n")
    }

    /// أرسل بايتات خام
    ///
    /// @معامل بيانات - مصفوفة البايتات
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_بايتات(بيانات: مصفوفة<عدد>) -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        أرجع نقل_ارسل_بايتات(هذا._مقبض، بيانات)
    }

    /// استقبل بيانات نصية
    ///
    /// @أرجع النص المستقبل أو نص فارغ عند الفشل
    عام دالة استقبل() -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        أرجع نقل_استقبل(هذا._مقبض، هذا._مهلة)
    }

    /// استقبل عدد محدد من البايتات
    ///
    /// @معامل حجم - عدد البايتات المطلوبة
    /// @أرجع مصفوفة البايتات المستقبلة
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع []
        }
        أرجع نقل_استقبل_بايتات(هذا._مقبض، حجم، هذا._مهلة)
    }

    /// استقبل حتى الوصول لفاصل معين
    ///
    /// @معامل فاصل - الفاصل المراد التوقف عنده
    /// @أرجع النص المستقبل حتى الفاصل
    عام دالة استقبل_حتى(فاصل: نص) -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        أرجع نقل_استقبل_حتى(هذا._مقبض، فاصل، هذا._مهلة)
    }

    /// استقبل سطراً واحداً
    ///
    /// @أرجع السطر المستقبل بدون حرف السطر الجديد
    عام دالة استقبل_سطر() -> نص {
        أرجع هذا.استقبل_حتى("\n")
    }

    /// تحقق إذا توجد بيانات متاحة للقراءة
    ///
    /// @أرجع صحيح إذا توجد بيانات
    عام دالة بيانات_متاحة() -> منطقي {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع خطأ
        }
        أرجع نقل_بيانات_متاحة(هذا._مقبض)
    }

    /// احصل على العنوان المحلي
    ///
    /// @أرجع عنوان IP المحلي
    عام دالة عنوان_محلي() -> نص {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع ""
        }
        أرجع نقل_عنوان_محلي(هذا._مقبض)
    }

    /// احصل على المنفذ المحلي
    ///
    /// @أرجع رقم المنفذ المحلي
    عام دالة منفذ_محلي() -> عدد {
        إذا (هذا._حالة != حالة_متصل) {
            أرجع -1
        }
        أرجع نقل_منفذ_محلي(هذا._مقبض)
    }
}

// ═══════════════════════════════════════════
// صنف اتصال UDP
// ═══════════════════════════════════════════

/// صنف اتصال UDP
///
/// يوفر إرسال واستقبال مخططات بيانات UDP
///
/// @مثال
/// متغير udp = جديد اتصال_حزم()
/// udp.ارسل_الى("127.0.0.1"، 9000، "مرحباً")
/// متغير رد = udp.استقبل()
/// udp.اغلق()
صدّر صنف اتصال_حزم {
    /// مقبض المقبس
    خاص _مقبض: عدد

    /// المنفذ المحلي
    خاص _منفذ_محلي: عدد

    /// مهلة الاستقبال
    خاص _مهلة: عدد

    /// المنشئ الافتراضي
    منشئ() {
        هذا._مقبض = -1
        هذا._منفذ_محلي = 0
        هذا._مهلة = 5000
    }

    /// المنشئ مع المنفذ المحلي
    ///
    /// @معامل منفذ - المنفذ المحلي للربط
    منشئ_منفذ(منفذ: عدد) {
        هذا._مقبض = -1
        هذا._منفذ_محلي = منفذ
        هذا._مهلة = 5000
    }

    /// اربط بمنفذ محلي
    ///
    /// @معامل منفذ - رقم المنفذ (٠ لاختيار تلقائي)
    /// @أرجع صحيح إذا نجح الربط
    عام دالة اربط(منفذ: عدد) -> منطقي {
        هذا._مقبض = حزم_اربط(منفذ)
        إذا (هذا._مقبض >= 0) {
            هذا._منفذ_محلي = منفذ
            أرجع صحيح
        }
        أرجع خطأ
    }

    /// أغلق المقبس
    عام دالة اغلق() {
        إذا (هذا._مقبض >= 0) {
            حزم_اغلق(هذا._مقبض)
            هذا._مقبض = -1
        }
    }

    /// عيّن مهلة الاستقبال
    ///
    /// @معامل ميلي_ثانية - المهلة بالميلي ثانية
    عام دالة عيّن_مهلة(ميلي_ثانية: عدد) {
        هذا._مهلة = ميلي_ثانية
    }

    /// أرسل مخطط بيانات إلى عنوان
    ///
    /// @معامل عنوان - عنوان الوجهة
    /// @معامل منفذ - منفذ الوجهة
    /// @معامل بيانات - النص المراد إرساله
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_الى(عنوان: نص، منفذ: عدد، بيانات: نص) -> منطقي {
        إذا (هذا._مقبض < 0) {
            هذا.اربط(0)
        }
        أرجع حزم_ارسل_الى(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    /// أرسل بايتات إلى عنوان
    ///
    /// @معامل عنوان - عنوان الوجهة
    /// @معامل منفذ - منفذ الوجهة
    /// @معامل بيانات - مصفوفة البايتات
    /// @أرجع صحيح إذا نجح الإرسال
    عام دالة ارسل_بايتات_الى(عنوان: نص، منفذ: عدد، بيانات: مصفوفة<عدد>) -> منطقي {
        إذا (هذا._مقبض < 0) {
            هذا.اربط(0)
        }
        أرجع حزم_ارسل_بايتات_الى(هذا._مقبض، عنوان، منفذ، بيانات)
    }

    /// استقبل مخطط بيانات
    ///
    /// @أرجع النص المستقبل
    عام دالة استقبل() -> نص {
        إذا (هذا._مقبض < 0) {
            أرجع ""
        }
        أرجع حزم_استقبل(هذا._مقبض، هذا._مهلة)
    }

    /// استقبل بايتات
    ///
    /// @معامل حجم - الحجم الأقصى للاستقبال
    /// @أرجع مصفوفة البايتات المستقبلة
    عام دالة استقبل_بايتات(حجم: عدد) -> مصفوفة<عدد> {
        إذا (هذا._مقبض < 0) {
            أرجع []
        }
        أرجع حزم_استقبل_بايتات(هذا._مقبض، حجم، هذا._مهلة)
    }

    /// تحقق إذا مربوط بمنفذ
    ///
    /// @أرجع صحيح إذا كان مربوطاً
    عام دالة مربوط() -> منطقي {
        أرجع هذا._مقبض >= 0
    }

    /// احصل على المنفذ المحلي
    ///
    /// @أرجع رقم المنفذ المحلي
    عام دالة منفذ_محلي() -> عدد {
        أرجع هذا._منفذ_محلي
    }
}

// ═══════════════════════════════════════════
// دوال اختصار
// ═══════════════════════════════════════════

/// أنشئ اتصال TCP جديد
///
/// @معامل عنوان - عنوان الخادم
/// @معامل منفذ - رقم المنفذ
/// @أرجع كائن اتصال TCP
/// @مثال
/// متغير ات = اتصال_جديد("127.0.0.1"، 8080)
صدّر دالة اتصال_جديد(عنوان: نص، منفذ: عدد) -> اتصال_نقل {
    أرجع جديد اتصال_نقل(عنوان، منفذ)
}

/// أنشئ اتصال واتصل مباشرة
///
/// @معامل عنوان - عنوان الخادم
/// @معامل منفذ - رقم المنفذ
/// @أرجع كائن اتصال TCP متصل
/// @مثال
/// متغير ات = اتصل_بـ("google.com"، 80)
صدّر دالة اتصل_بـ(عنوان: نص، منفذ: عدد) -> اتصال_نقل {
    متغير اتصال = جديد اتصال_نقل(عنوان، منفذ)
    اتصال.اتصل()
    أرجع اتصال
}

/// حل اسم المضيف إلى عنوان IP
///
/// @معامل اسم_مضيف - اسم المضيف (مثل google.com)
/// @أرجع عنوان IP
/// @مثال
/// متغير ip = حل_عنوان("google.com")
صدّر دالة حل_عنوان(اسم_مضيف: نص) -> نص {
    أرجع __حل_عنوان__(اسم_مضيف)
}

/// احصل على عنوان IP المحلي
///
/// @أرجع عنوان IP المحلي
صدّر دالة عنوان_محلي() -> نص {
    أرجع احصل_عنوان_محلي()
}
