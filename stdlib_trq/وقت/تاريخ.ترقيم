// =============================================================================
// تاريخ - Date Class
// =============================================================================

صدّر صنف تاريخ {
    عام سنة: عدد
    عام شهر: عدد
    عام يوم: عدد

    // Constructor with year, month, day
    // المنشئ مع السنة والشهر واليوم
    منشئ(سنة: عدد، شهر: عدد، يوم: عدد) {
        هذا.سنة = سنة
        هذا.شهر = شهر
        هذا.يوم = يوم
    }

    // ======================================
    // Static Factory Methods
    // دوال مصنع ثابتة
    // ======================================

    // Get today's date
    // احصل على تاريخ اليوم
    ثابت_صنف دالة اليوم() -> تاريخ {
        // Uses runtime: trq_date_today
        متغير بيانات = __تاريخ_اليوم__()
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // Parse date from string (YYYY-MM-DD format)
    // حلل التاريخ من نص (صيغة YYYY-MM-DD)
    ثابت_صنف دالة من_نص(نص: نص) -> تاريخ {
        // Uses runtime: trq_date_parse
        متغير بيانات = __حلل_تاريخ__(نص)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // Create from Unix timestamp (seconds since 1970-01-01)
    // أنشئ من طابع Unix (ثواني منذ 1970-01-01)
    ثابت_صنف دالة من_طابع(طابع: عدد) -> تاريخ {
        // Uses runtime: trq_date_from_timestamp
        متغير بيانات = __تاريخ_من_طابع__(طابع)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // ======================================
    // Date Arithmetic
    // الحساب مع التواريخ
    // ======================================

    // Add days
    // أضف أيام
    عام دالة أضف_أيام(أيام: عدد) -> تاريخ {
        // Uses runtime: trq_date_add_days
        متغير بيانات = __أضف_أيام__(هذا.سنة، هذا.شهر، هذا.يوم، أيام)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // Add months
    // أضف أشهر
    عام دالة أضف_أشهر(أشهر: عدد) -> تاريخ {
        // Uses runtime: trq_date_add_months
        متغير بيانات = __أضف_أشهر__(هذا.سنة، هذا.شهر، هذا.يوم، أشهر)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // Add years
    // أضف سنوات
    عام دالة أضف_سنوات(سنوات: عدد) -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة + سنوات، هذا.شهر، هذا.يوم)
    }

    // Subtract days
    // اطرح أيام
    عام دالة اطرح_أيام(أيام: عدد) -> تاريخ {
        أرجع هذا.أضف_أيام(-أيام)
    }

    // Difference in days between two dates
    // الفرق بالأيام بين تاريخين
    عام دالة فرق_أيام(آخر: تاريخ) -> عدد {
        // Uses runtime: trq_date_diff_days
        أرجع __فرق_أيام__(
            هذا.سنة، هذا.شهر، هذا.يوم،
            آخر.سنة، آخر.شهر، آخر.يوم
        )
    }

    // ======================================
    // Day Information
    // معلومات اليوم
    // ======================================

    // Get day of week (0 = Sunday, 6 = Saturday)
    // احصل على يوم الأسبوع (0 = الأحد، 6 = السبت)
    عام دالة يوم_الأسبوع() -> عدد {
        // Uses runtime: trq_day_of_week
        أرجع __يوم_الأسبوع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    // Get day of year (1-366)
    // احصل على يوم السنة (1-366)
    عام دالة يوم_السنة() -> عدد {
        // Uses runtime: trq_day_of_year
        أرجع __يوم_السنة__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    // Get week number (ISO 8601)
    // احصل على رقم الأسبوع (ISO 8601)
    عام دالة رقم_الأسبوع() -> عدد {
        // Uses runtime: trq_week_number
        أرجع __رقم_الأسبوع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    // Get Arabic day name
    // احصل على اسم اليوم العربي
    عام دالة اسم_اليوم() -> نص {
        أرجع أيام_عربي[هذا.يوم_الأسبوع()]
    }

    // Get Arabic day name (short)
    // احصل على اسم اليوم العربي (مختصر)
    عام دالة اسم_اليوم_مختصر() -> نص {
        أرجع أيام_عربي_مختصر[هذا.يوم_الأسبوع()]
    }

    // Get English day name
    // احصل على اسم اليوم الإنجليزي
    عام دالة اسم_اليوم_انجليزي() -> نص {
        أرجع أيام_انجليزي[هذا.يوم_الأسبوع()]
    }

    // ======================================
    // Month Information
    // معلومات الشهر
    // ======================================

    // Get Arabic month name
    // احصل على اسم الشهر العربي
    عام دالة اسم_الشهر() -> نص {
        أرجع أشهر_عربي[هذا.شهر]
    }

    // Get Levantine month name
    // احصل على اسم الشهر الشامي
    عام دالة اسم_الشهر_شامي() -> نص {
        أرجع أشهر_شامية[هذا.شهر]
    }

    // Get English month name
    // احصل على اسم الشهر الإنجليزي
    عام دالة اسم_الشهر_انجليزي() -> نص {
        أرجع أشهر_انجليزي[هذا.شهر]
    }

    // Get days in month
    // احصل على أيام الشهر
    عام دالة أيام_الشهر() -> عدد {
        // Uses runtime: trq_days_in_month
        أرجع __أيام_الشهر__(هذا.سنة، هذا.شهر)
    }

    // ======================================
    // Year Information
    // معلومات السنة
    // ======================================

    // Check if leap year
    // تحقق إذا سنة كبيسة
    عام دالة سنة_كبيسة() -> منطقي {
        إذا (هذا.سنة % 400 == 0) {
            أرجع صحيح
        }
        إذا (هذا.سنة % 100 == 0) {
            أرجع خطأ
        }
        أرجع هذا.سنة % 4 == 0
    }

    // Get days in year
    // احصل على أيام السنة
    عام دالة أيام_السنة() -> عدد {
        إذا (هذا.سنة_كبيسة()) {
            أرجع 366
        }
        أرجع 365
    }

    // ======================================
    // Comparison
    // المقارنة
    // ======================================

    // Check if before another date
    // تحقق إذا قبل تاريخ آخر
    عام دالة قبل(آخر: تاريخ) -> منطقي {
        إذا (هذا.سنة < آخر.سنة) { أرجع صحيح }
        إذا (هذا.سنة > آخر.سنة) { أرجع خطأ }
        إذا (هذا.شهر < آخر.شهر) { أرجع صحيح }
        إذا (هذا.شهر > آخر.شهر) { أرجع خطأ }
        أرجع هذا.يوم < آخر.يوم
    }

    // Check if after another date
    // تحقق إذا بعد تاريخ آخر
    عام دالة بعد(آخر: تاريخ) -> منطقي {
        أرجع آخر.قبل(هذا)
    }

    // Check if equal to another date
    // تحقق إذا يساوي تاريخ آخر
    عام دالة يساوي(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة &&
               هذا.شهر == آخر.شهر &&
               هذا.يوم == آخر.يوم
    }

    // Check if same month
    // تحقق إذا نفس الشهر
    عام دالة نفس_الشهر(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة && هذا.شهر == آخر.شهر
    }

    // Check if same year
    // تحقق إذا نفس السنة
    عام دالة نفس_السنة(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة
    }

    // ======================================
    // Special Dates
    // تواريخ خاصة
    // ======================================

    // Check if today
    // تحقق إذا اليوم
    عام دالة هل_اليوم() -> منطقي {
        متغير الآن = تاريخ.اليوم()
        أرجع هذا.يساوي(الآن)
    }

    // Check if weekend (Friday/Saturday for Arabic, Saturday/Sunday for Western)
    // تحقق إذا عطلة نهاية الأسبوع
    عام دالة عطلة_عربية() -> منطقي {
        متغير يوم = هذا.يوم_الأسبوع()
        أرجع يوم == 5 || يوم == 6  // Friday or Saturday
    }

    // Check if weekend (Western: Saturday/Sunday)
    // تحقق إذا عطلة نهاية الأسبوع (غربي)
    عام دالة عطلة_غربية() -> منطقي {
        متغير يوم = هذا.يوم_الأسبوع()
        أرجع يوم == 0 || يوم == 6  // Sunday or Saturday
    }

    // Get first day of month
    // احصل على أول يوم في الشهر
    عام دالة أول_الشهر() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، هذا.شهر، 1)
    }

    // Get last day of month
    // احصل على آخر يوم في الشهر
    عام دالة آخر_الشهر() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، هذا.شهر، هذا.أيام_الشهر())
    }

    // Get first day of year
    // احصل على أول يوم في السنة
    عام دالة أول_السنة() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، 1، 1)
    }

    // Get last day of year
    // احصل على آخر يوم في السنة
    عام دالة آخر_السنة() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، 12، 31)
    }

    // ======================================
    // Formatting
    // التنسيق
    // ======================================

    // Format date using pattern
    // نسّق التاريخ باستخدام نمط
    // Patterns: YYYY (year), MM (month), DD (day), DDD (day name), MMM (month name)
    عام دالة نسّق(نمط: نص) -> نص {
        // Uses runtime: trq_date_format
        أرجع __نسّق_تاريخ__(هذا.سنة، هذا.شهر، هذا.يوم، نمط)
    }

    // Convert to ISO format (YYYY-MM-DD)
    // حوّل إلى صيغة ISO (YYYY-MM-DD)
    عام دالة إلى_iso() -> نص {
        متغير شهر_نص = ""
        متغير يوم_نص = ""
        إذا (هذا.شهر < 10) {
            شهر_نص = "0" + __إلى_نص__(هذا.شهر)
        } وإلا {
            شهر_نص = __إلى_نص__(هذا.شهر)
        }
        إذا (هذا.يوم < 10) {
            يوم_نص = "0" + __إلى_نص__(هذا.يوم)
        } وإلا {
            يوم_نص = __إلى_نص__(هذا.يوم)
        }
        أرجع __إلى_نص__(هذا.سنة) + "-" + شهر_نص + "-" + يوم_نص
    }

    // Convert to string (Arabic format)
    // حوّل إلى نص (صيغة عربية)
    عام دالة إلى_نص() -> نص {
        أرجع __إلى_نص__(هذا.يوم) + " " + هذا.اسم_الشهر() + " " + __إلى_نص__(هذا.سنة)
    }

    // Convert to string (English format)
    // حوّل إلى نص (صيغة إنجليزية)
    عام دالة إلى_نص_انجليزي() -> نص {
        أرجع هذا.اسم_الشهر_انجليزي() + " " + __إلى_نص__(هذا.يوم) + ", " + __إلى_نص__(هذا.سنة)
    }

    // Convert to Unix timestamp
    // حوّل إلى طابع Unix
    عام دالة إلى_طابع() -> عدد {
        // Uses runtime: trq_date_to_timestamp
        أرجع __تاريخ_إلى_طابع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Get today's date
// احصل على تاريخ اليوم
صدّر دالة اليوم() -> تاريخ {
    أرجع تاريخ.اليوم()
}

// Get yesterday's date
// احصل على تاريخ الأمس
صدّر دالة الأمس() -> تاريخ {
    أرجع تاريخ.اليوم().اطرح_أيام(1)
}

// Get tomorrow's date
// احصل على تاريخ الغد
صدّر دالة الغد() -> تاريخ {
    أرجع تاريخ.اليوم().أضف_أيام(1)
}

// Create date from components
// أنشئ تاريخ من المكونات
صدّر دالة تاريخ_جديد(سنة: عدد، شهر: عدد، يوم: عدد) -> تاريخ {
    أرجع جديد تاريخ(سنة، شهر، يوم)
}

// Parse date from ISO string
// حلل التاريخ من نص ISO
صدّر دالة حلل_تاريخ(نص: نص) -> تاريخ {
    أرجع تاريخ.من_نص(نص)
}

// Check if year is leap year
// تحقق إذا السنة كبيسة
صدّر دالة سنة_كبيسة(سنة: عدد) -> منطقي {
    متغير ت = جديد تاريخ(سنة، 1، 1)
    أرجع ت.سنة_كبيسة()
}

// Get days in month
// احصل على أيام الشهر
صدّر دالة أيام_الشهر(سنة: عدد، شهر: عدد) -> عدد {
    أرجع __أيام_الشهر__(سنة، شهر)
}
