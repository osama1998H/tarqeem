/// احصل على تاريخ اليوم
///
/// @أرجع تاريخ اليوم الحالي
/// @مثال
/// متغير ت = اليوم()
صدّر دالة اليوم() -> تاريخ {
    أرجع تاريخ.اليوم()
}

/// احصل على تاريخ الأمس
///
/// @أرجع تاريخ أمس
/// @مثال
/// متغير ت = الأمس()
صدّر دالة الأمس() -> تاريخ {
    أرجع تاريخ.اليوم().اطرح_أيام(1)
}

/// احصل على تاريخ الغد
///
/// @أرجع تاريخ غد
/// @مثال
/// متغير ت = الغد()
صدّر دالة الغد() -> تاريخ {
    أرجع تاريخ.اليوم().أضف_أيام(1)
}

/// أنشئ تاريخ جديد من المكونات
///
/// @معامل سنة - السنة
/// @معامل شهر - الشهر (١-١٢)
/// @معامل يوم - اليوم (١-٣١)
/// @أرجع كائن تاريخ جديد
/// @مثال
/// متغير ت = تاريخ_جديد(2024، 1، 15)
صدّر دالة تاريخ_جديد(سنة: عدد، شهر: عدد، يوم: عدد) -> تاريخ {
    أرجع جديد تاريخ(سنة، شهر، يوم)
}

/// حلل تاريخ من نص ISO
///
/// @معامل نص - نص التاريخ بصيغة YYYY-MM-DD
/// @أرجع كائن تاريخ
/// @مثال
/// متغير ت = حلل_تاريخ("2024-01-15")
صدّر دالة حلل_تاريخ(نص: نص) -> تاريخ {
    أرجع تاريخ.من_نص(نص)
}

/// تحقق إذا السنة كبيسة
///
/// @معامل سنة - السنة المراد فحصها
/// @أرجع صحيح إذا كانت السنة كبيسة
/// @مثال
/// إذا (سنة_كبيسة(2024)) {
///     اطبع("سنة كبيسة")
/// }
صدّر دالة سنة_كبيسة(سنة: عدد) -> منطقي {
    متغير ت = جديد تاريخ(سنة، 1، 1)
    أرجع ت.سنة_كبيسة()
}

/// احصل على عدد أيام الشهر
///
/// @معامل سنة - السنة
/// @معامل شهر - الشهر (١-١٢)
/// @أرجع عدد الأيام في الشهر
/// @مثال
/// متغير أيام = أيام_الشهر(2024، 2)  // 29 (سنة كبيسة)
صدّر دالة أيام_الشهر(سنة: عدد، شهر: عدد) -> عدد {
    أرجع __أيام_الشهر__(سنة، شهر)
}
