// ═══════════════════════════════════════════
// صنف التاريخ
// ═══════════════════════════════════════════

/// صنف التاريخ
///
/// يمثل تاريخاً في التقويم الميلادي ويوفر عمليات
/// التحويل والمقارنة والحساب
///
/// @مثال
/// متغير ت = جديد تاريخ(2024، 1، 15)
/// اطبع(ت.اسم_اليوم())
/// اطبع(ت.إلى_نص())
صدّر صنف تاريخ {
    /// السنة
    عام سنة: عدد

    /// الشهر (١-١٢)
    عام شهر: عدد

    /// اليوم (١-٣١)
    عام يوم: عدد

    /// المنشئ
    ///
    /// @معامل سنة - السنة الميلادية
    /// @معامل شهر - رقم الشهر (١-١٢)
    /// @معامل يوم - رقم اليوم (١-٣١)
    منشئ(سنة: عدد، شهر: عدد، يوم: عدد) {
        هذا.سنة = سنة
        هذا.شهر = شهر
        هذا.يوم = يوم
    }

    // ═══════════════════════════════════════
    // دوال المصنع الثابتة
    // ═══════════════════════════════════════

    /// احصل على تاريخ اليوم
    ///
    /// @أرجع تاريخ اليوم الحالي
    /// @مثال
    /// متغير اليوم = تاريخ.اليوم()
    ثابت_صنف دالة اليوم() -> تاريخ {
        متغير بيانات = __تاريخ_اليوم__()
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    /// حلل التاريخ من نص
    ///
    /// @معامل نص - نص التاريخ بصيغة YYYY-MM-DD
    /// @أرجع كائن تاريخ
    /// @مثال
    /// متغير ت = تاريخ.من_نص("2024-01-15")
    ثابت_صنف دالة من_نص(نص: نص) -> تاريخ {
        متغير بيانات = __حلل_تاريخ__(نص)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    /// أنشئ تاريخ من طابع يونكس
    ///
    /// @معامل طابع - عدد الثواني منذ ١٩٧٠-٠١-٠١
    /// @أرجع كائن تاريخ
    /// @مثال
    /// متغير ت = تاريخ.من_طابع(1705276800)
    ثابت_صنف دالة من_طابع(طابع: عدد) -> تاريخ {
        متغير بيانات = __تاريخ_من_طابع__(طابع)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    // ═══════════════════════════════════════
    // الحساب مع التواريخ
    // ═══════════════════════════════════════

    /// أضف أياماً للتاريخ
    ///
    /// @معامل أيام - عدد الأيام المراد إضافتها
    /// @أرجع تاريخ جديد بعد إضافة الأيام
    /// @مثال
    /// متغير بعد_أسبوع = ت.أضف_أيام(7)
    عام دالة أضف_أيام(أيام: عدد) -> تاريخ {
        متغير بيانات = __أضف_أيام__(هذا.سنة، هذا.شهر، هذا.يوم، أيام)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    /// أضف أشهراً للتاريخ
    ///
    /// @معامل أشهر - عدد الأشهر المراد إضافتها
    /// @أرجع تاريخ جديد بعد إضافة الأشهر
    /// @مثال
    /// متغير بعد_شهر = ت.أضف_أشهر(1)
    عام دالة أضف_أشهر(أشهر: عدد) -> تاريخ {
        متغير بيانات = __أضف_أشهر__(هذا.سنة، هذا.شهر، هذا.يوم، أشهر)
        أرجع جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
    }

    /// أضف سنوات للتاريخ
    ///
    /// @معامل سنوات - عدد السنوات المراد إضافتها
    /// @أرجع تاريخ جديد بعد إضافة السنوات
    عام دالة أضف_سنوات(سنوات: عدد) -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة + سنوات، هذا.شهر، هذا.يوم)
    }

    /// اطرح أياماً من التاريخ
    ///
    /// @معامل أيام - عدد الأيام المراد طرحها
    /// @أرجع تاريخ جديد بعد طرح الأيام
    عام دالة اطرح_أيام(أيام: عدد) -> تاريخ {
        أرجع هذا.أضف_أيام(-أيام)
    }

    /// احسب الفرق بالأيام بين تاريخين
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع عدد الأيام بين التاريخين
    /// @مثال
    /// متغير فرق = ت1.فرق_أيام(ت2)
    عام دالة فرق_أيام(آخر: تاريخ) -> عدد {
        أرجع __فرق_أيام__(
            هذا.سنة، هذا.شهر، هذا.يوم،
            آخر.سنة، آخر.شهر، آخر.يوم
        )
    }

    // ═══════════════════════════════════════
    // معلومات اليوم
    // ═══════════════════════════════════════

    /// احصل على يوم الأسبوع
    ///
    /// @أرجع رقم اليوم (٠ = الأحد، ٦ = السبت)
    /// @مثال
    /// متغير يوم = ت.يوم_الأسبوع()
    عام دالة يوم_الأسبوع() -> عدد {
        أرجع __يوم_الأسبوع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    /// احصل على يوم السنة
    ///
    /// @أرجع رقم اليوم في السنة (١-٣٦٦)
    عام دالة يوم_السنة() -> عدد {
        أرجع __يوم_السنة__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    /// احصل على رقم الأسبوع
    ///
    /// @أرجع رقم الأسبوع حسب معيار ISO 8601
    عام دالة رقم_الأسبوع() -> عدد {
        أرجع __رقم_الأسبوع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }

    /// احصل على اسم اليوم العربي
    ///
    /// @أرجع اسم اليوم بالعربية
    /// @مثال
    /// اطبع(ت.اسم_اليوم())  // "الجمعة"
    عام دالة اسم_اليوم() -> نص {
        أرجع أيام_عربي[هذا.يوم_الأسبوع()]
    }

    /// احصل على اسم اليوم العربي المختصر
    ///
    /// @أرجع اسم اليوم المختصر بالعربية
    عام دالة اسم_اليوم_مختصر() -> نص {
        أرجع أيام_عربي_مختصر[هذا.يوم_الأسبوع()]
    }

    /// احصل على اسم اليوم الإنجليزي
    ///
    /// @أرجع اسم اليوم بالإنجليزية
    عام دالة اسم_اليوم_انجليزي() -> نص {
        أرجع أيام_انجليزي[هذا.يوم_الأسبوع()]
    }

    // ═══════════════════════════════════════
    // معلومات الشهر
    // ═══════════════════════════════════════

    /// احصل على اسم الشهر العربي
    ///
    /// @أرجع اسم الشهر بالعربية
    /// @مثال
    /// اطبع(ت.اسم_الشهر())  // "يناير"
    عام دالة اسم_الشهر() -> نص {
        أرجع أشهر_عربي[هذا.شهر]
    }

    /// احصل على اسم الشهر الشامي
    ///
    /// @أرجع اسم الشهر بالتسمية الشامية
    /// @مثال
    /// اطبع(ت.اسم_الشهر_شامي())  // "كانون الثاني"
    عام دالة اسم_الشهر_شامي() -> نص {
        أرجع أشهر_شامية[هذا.شهر]
    }

    /// احصل على اسم الشهر الإنجليزي
    ///
    /// @أرجع اسم الشهر بالإنجليزية
    عام دالة اسم_الشهر_انجليزي() -> نص {
        أرجع أشهر_انجليزي[هذا.شهر]
    }

    /// احصل على عدد أيام الشهر
    ///
    /// @أرجع عدد الأيام في الشهر الحالي
    عام دالة أيام_الشهر() -> عدد {
        أرجع __أيام_الشهر__(هذا.سنة، هذا.شهر)
    }

    // ═══════════════════════════════════════
    // معلومات السنة
    // ═══════════════════════════════════════

    /// تحقق إذا السنة كبيسة
    ///
    /// @أرجع صحيح إذا كانت السنة كبيسة
    /// @مثال
    /// إذا (ت.سنة_كبيسة()) {
    ///     اطبع("سنة كبيسة!")
    /// }
    عام دالة سنة_كبيسة() -> منطقي {
        إذا (هذا.سنة % 400 == 0) {
            أرجع صحيح
        }
        إذا (هذا.سنة % 100 == 0) {
            أرجع خطأ
        }
        أرجع هذا.سنة % 4 == 0
    }

    /// احصل على عدد أيام السنة
    ///
    /// @أرجع ٣٦٦ للسنة الكبيسة، ٣٦٥ لغيرها
    عام دالة أيام_السنة() -> عدد {
        إذا (هذا.سنة_كبيسة()) {
            أرجع 366
        }
        أرجع 365
    }

    // ═══════════════════════════════════════
    // المقارنة
    // ═══════════════════════════════════════

    /// تحقق إذا التاريخ قبل تاريخ آخر
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا التاريخ قبل الآخر
    عام دالة قبل(آخر: تاريخ) -> منطقي {
        إذا (هذا.سنة < آخر.سنة) { أرجع صحيح }
        إذا (هذا.سنة > آخر.سنة) { أرجع خطأ }
        إذا (هذا.شهر < آخر.شهر) { أرجع صحيح }
        إذا (هذا.شهر > آخر.شهر) { أرجع خطأ }
        أرجع هذا.يوم < آخر.يوم
    }

    /// تحقق إذا التاريخ بعد تاريخ آخر
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا التاريخ بعد الآخر
    عام دالة بعد(آخر: تاريخ) -> منطقي {
        أرجع آخر.قبل(هذا)
    }

    /// تحقق إذا التاريخ يساوي تاريخ آخر
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع صحيح إذا كان التاريخان متساويين
    عام دالة يساوي(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة &&
               هذا.شهر == آخر.شهر &&
               هذا.يوم == آخر.يوم
    }

    /// تحقق إذا في نفس الشهر
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع صحيح إذا كانا في نفس الشهر والسنة
    عام دالة نفس_الشهر(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة && هذا.شهر == آخر.شهر
    }

    /// تحقق إذا في نفس السنة
    ///
    /// @معامل آخر - التاريخ الآخر للمقارنة
    /// @أرجع صحيح إذا كانا في نفس السنة
    عام دالة نفس_السنة(آخر: تاريخ) -> منطقي {
        أرجع هذا.سنة == آخر.سنة
    }

    // ═══════════════════════════════════════
    // تواريخ خاصة
    // ═══════════════════════════════════════

    /// تحقق إذا التاريخ هو اليوم
    ///
    /// @أرجع صحيح إذا كان التاريخ هو تاريخ اليوم
    عام دالة هل_اليوم() -> منطقي {
        متغير الآن = تاريخ.اليوم()
        أرجع هذا.يساوي(الآن)
    }

    /// تحقق إذا عطلة نهاية الأسبوع (عربي: الجمعة والسبت)
    ///
    /// @أرجع صحيح إذا كان اليوم جمعة أو سبت
    عام دالة عطلة_عربية() -> منطقي {
        متغير يوم = هذا.يوم_الأسبوع()
        أرجع يوم == 5 || يوم == 6
    }

    /// تحقق إذا عطلة نهاية الأسبوع (غربي: السبت والأحد)
    ///
    /// @أرجع صحيح إذا كان اليوم سبت أو أحد
    عام دالة عطلة_غربية() -> منطقي {
        متغير يوم = هذا.يوم_الأسبوع()
        أرجع يوم == 0 || يوم == 6
    }

    /// احصل على أول يوم في الشهر
    ///
    /// @أرجع تاريخ أول يوم في الشهر
    عام دالة أول_الشهر() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، هذا.شهر، 1)
    }

    /// احصل على آخر يوم في الشهر
    ///
    /// @أرجع تاريخ آخر يوم في الشهر
    عام دالة آخر_الشهر() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، هذا.شهر، هذا.أيام_الشهر())
    }

    /// احصل على أول يوم في السنة
    ///
    /// @أرجع تاريخ ١ يناير من نفس السنة
    عام دالة أول_السنة() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، 1، 1)
    }

    /// احصل على آخر يوم في السنة
    ///
    /// @أرجع تاريخ ٣١ ديسمبر من نفس السنة
    عام دالة آخر_السنة() -> تاريخ {
        أرجع جديد تاريخ(هذا.سنة، 12، 31)
    }

    // ═══════════════════════════════════════
    // التنسيق
    // ═══════════════════════════════════════

    /// نسّق التاريخ باستخدام نمط
    ///
    /// الأنماط المدعومة:
    /// - YYYY: السنة بأربعة أرقام
    /// - MM: الشهر برقمين
    /// - DD: اليوم برقمين
    /// - DDD: اسم اليوم
    /// - MMM: اسم الشهر
    ///
    /// @معامل نمط - نمط التنسيق
    /// @أرجع التاريخ المنسق
    /// @مثال
    /// ت.نسّق("YYYY/MM/DD")  // "2024/01/15"
    عام دالة نسّق(نمط: نص) -> نص {
        أرجع __نسّق_تاريخ__(هذا.سنة، هذا.شهر، هذا.يوم، نمط)
    }

    /// حوّل إلى صيغة ISO (YYYY-MM-DD)
    ///
    /// @أرجع التاريخ بصيغة ISO القياسية
    /// @مثال
    /// ت.إلى_iso()  // "2024-01-15"
    عام دالة إلى_iso() -> نص {
        متغير شهر_نص = ""
        متغير يوم_نص = ""
        إذا (هذا.شهر < 10) {
            شهر_نص = "0" + __إلى_نص__(هذا.شهر)
        } وإلا {
            شهر_نص = __إلى_نص__(هذا.شهر)
        }
        إذا (هذا.يوم < 10) {
            يوم_نص = "0" + __إلى_نص__(هذا.يوم)
        } وإلا {
            يوم_نص = __إلى_نص__(هذا.يوم)
        }
        أرجع __إلى_نص__(هذا.سنة) + "-" + شهر_نص + "-" + يوم_نص
    }

    /// حوّل إلى نص عربي
    ///
    /// @أرجع التاريخ بصيغة عربية
    /// @مثال
    /// ت.إلى_نص()  // "15 يناير 2024"
    عام دالة إلى_نص() -> نص {
        أرجع __إلى_نص__(هذا.يوم) + " " + هذا.اسم_الشهر() + " " + __إلى_نص__(هذا.سنة)
    }

    /// حوّل إلى نص إنجليزي
    ///
    /// @أرجع التاريخ بصيغة إنجليزية
    /// @مثال
    /// ت.إلى_نص_انجليزي()  // "January 15, 2024"
    عام دالة إلى_نص_انجليزي() -> نص {
        أرجع هذا.اسم_الشهر_انجليزي() + " " + __إلى_نص__(هذا.يوم) + ", " + __إلى_نص__(هذا.سنة)
    }

    /// حوّل إلى طابع يونكس
    ///
    /// @أرجع عدد الثواني منذ ١٩٧٠-٠١-٠١
    عام دالة إلى_طابع() -> عدد {
        أرجع __تاريخ_إلى_طابع__(هذا.سنة، هذا.شهر، هذا.يوم)
    }
}

