/// عمليات الوقت
///
/// توفر هذه الوحدة معالجة الوقت والتاريخ_ووقت والمدة
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// صنف الوقت
// ═══════════════════════════════════════════

/// صنف الوقت
///
/// يمثل وقتاً في اليوم (ساعة، دقيقة، ثانية، ميلي ثانية)
///
/// @مثال
/// متغير و = جديد وقت(14، 30، 0)
/// اطبع(و.إلى_نص())  // "14:30:00"
صدّر صنف وقت {
    /// الساعة (٠-٢٣)
    عام ساعة: عدد

    /// الدقيقة (٠-٥٩)
    عام دقيقة: عدد

    /// الثانية (٠-٥٩)
    عام ثانية: عدد

    /// الميلي ثانية (٠-٩٩٩)
    عام ميلي: عدد

    /// المنشئ الأساسي
    ///
    /// @معامل ساعة - الساعة (٠-٢٣)
    /// @معامل دقيقة - الدقيقة (٠-٥٩)
    /// @معامل ثانية - الثانية (٠-٥٩)
    منشئ(ساعة: عدد، دقيقة: عدد، ثانية: عدد) {
        هذا.ساعة = ساعة
        هذا.دقيقة = دقيقة
        هذا.ثانية = ثانية
        هذا.ميلي = 0
    }

    /// المنشئ الكامل مع الميلي ثانية
    ///
    /// @معامل ساعة - الساعة (٠-٢٣)
    /// @معامل دقيقة - الدقيقة (٠-٥٩)
    /// @معامل ثانية - الثانية (٠-٥٩)
    /// @معامل ميلي - الميلي ثانية (٠-٩٩٩)
    منشئ_كامل(ساعة: عدد، دقيقة: عدد، ثانية: عدد، ميلي: عدد) {
        هذا.ساعة = ساعة
        هذا.دقيقة = دقيقة
        هذا.ثانية = ثانية
        هذا.ميلي = ميلي
    }

    // ═══════════════════════════════════════
    // دوال المصنع الثابتة
    // ═══════════════════════════════════════

    /// احصل على الوقت الحالي
    ///
    /// @أرجع الوقت الحالي
    /// @مثال
    /// متغير الآن = وقت.الآن()
    مشترك دالة الآن() -> وقت {
        متغير بيانات = وقت_الآن()
        أرجع جديد وقت.منشئ_كامل(
            بيانات.ساعة،
            بيانات.دقيقة،
            بيانات.ثانية،
            بيانات.ميلي
        )
    }

    /// حلل الوقت من نص
    ///
    /// @معامل نص - نص الوقت بصيغة HH:MM:SS
    /// @أرجع كائن وقت
    /// @مثال
    /// متغير و = وقت.من_نص("14:30:00")
    مشترك دالة من_نص(نص: نص) -> وقت {
        متغير بيانات = حلل_وقت(نص)
        أرجع جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
    }

    /// أنشئ وقت من إجمالي الثواني
    ///
    /// @معامل ثواني - إجمالي الثواني
    /// @أرجع كائن وقت
    /// @مثال
    /// متغير و = وقت.من_ثواني(3661)  // 01:01:01
    مشترك دالة من_ثواني(ثواني: عدد) -> وقت {
        متغير س = ثواني / 3600
        متغير باقي = ثواني % 3600
        متغير د = باقي / 60
        متغير ث = باقي % 60
        أرجع جديد وقت(س، د، ث)
    }

    /// أنشئ وقت من إجمالي الميلي ثانية
    ///
    /// @معامل ميلي - إجمالي الميلي ثانية
    /// @أرجع كائن وقت
    مشترك دالة من_ميلي(ميلي: عدد) -> وقت {
        متغير إجمالي_ثواني = ميلي / 1000
        متغير م = ميلي % 1000
        متغير وقت_جديد = وقت.من_ثواني(إجمالي_ثواني)
        وقت_جديد.ميلي = م
        أرجع وقت_جديد
    }

    /// منتصف الليل (٠٠:٠٠:٠٠)
    ///
    /// @أرجع وقت منتصف الليل
    مشترك دالة منتصف_الليل() -> وقت {
        أرجع جديد وقت(0، 0، 0)
    }

    /// الظهر (١٢:٠٠:٠٠)
    ///
    /// @أرجع وقت الظهر
    مشترك دالة الظهر() -> وقت {
        أرجع جديد وقت(12، 0، 0)
    }

    // ═══════════════════════════════════════
    // الحساب مع الوقت
    // ═══════════════════════════════════════

    /// أضف ثواني للوقت
    ///
    /// @معامل ثواني - عدد الثواني المراد إضافتها
    /// @أرجع وقت جديد بعد إضافة الثواني
    /// @ملاحظة يلتف الوقت عند تجاوز ٢٤ ساعة
    عام دالة أضف_ثواني(ثواني: عدد) -> وقت {
        متغير إجمالي = هذا.إلى_ثواني() + ثواني
        إجمالي = إجمالي % 86400
        إذا (إجمالي < 0) {
            إجمالي = إجمالي + 86400
        }
        متغير نتيجة = وقت.من_ثواني(إجمالي)
        نتيجة.ميلي = هذا.ميلي
        أرجع نتيجة
    }

    /// أضف دقائق للوقت
    ///
    /// @معامل دقائق - عدد الدقائق المراد إضافتها
    /// @أرجع وقت جديد بعد إضافة الدقائق
    عام دالة أضف_دقائق(دقائق: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(دقائق * 60)
    }

    /// أضف ساعات للوقت
    ///
    /// @معامل ساعات - عدد الساعات المراد إضافتها
    /// @أرجع وقت جديد بعد إضافة الساعات
    عام دالة أضف_ساعات(ساعات: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(ساعات * 3600)
    }

    /// اطرح ثواني من الوقت
    ///
    /// @معامل ثواني - عدد الثواني المراد طرحها
    /// @أرجع وقت جديد بعد طرح الثواني
    عام دالة اطرح_ثواني(ثواني: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(-ثواني)
    }

    /// احسب الفرق بالثواني بين وقتين
    ///
    /// @معامل آخر - الوقت الآخر للمقارنة
    /// @أرجع الفرق بالثواني
    عام دالة فرق_ثواني(آخر: وقت) -> عدد {
        أرجع هذا.إلى_ثواني() - آخر.إلى_ثواني()
    }

    // ═══════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════

    /// حوّل إلى إجمالي الثواني
    ///
    /// @أرجع إجمالي الثواني من منتصف الليل
    عام دالة إلى_ثواني() -> عدد {
        أرجع هذا.ساعة * 3600 + هذا.دقيقة * 60 + هذا.ثانية
    }

    /// حوّل إلى إجمالي الميلي ثانية
    ///
    /// @أرجع إجمالي الميلي ثانية من منتصف الليل
    عام دالة إلى_ميلي() -> عدد {
        أرجع هذا.إلى_ثواني() * 1000 + هذا.ميلي
    }

    /// حوّل إلى إجمالي الدقائق
    ///
    /// @أرجع إجمالي الدقائق من منتصف الليل
    عام دالة إلى_دقائق() -> عدد {
        أرجع هذا.ساعة * 60 + هذا.دقيقة
    }

    // ═══════════════════════════════════════
    // المقارنة
    // ═══════════════════════════════════════

    /// تحقق إذا الوقت قبل وقت آخر
    ///
    /// @معامل آخر - الوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا الوقت قبل الآخر
    عام دالة قبل(آخر: وقت) -> منطقي {
        أرجع هذا.إلى_ميلي() < آخر.إلى_ميلي()
    }

    /// تحقق إذا الوقت بعد وقت آخر
    ///
    /// @معامل آخر - الوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا الوقت بعد الآخر
    عام دالة بعد(آخر: وقت) -> منطقي {
        أرجع هذا.إلى_ميلي() > آخر.إلى_ميلي()
    }

    /// تحقق إذا الوقت يساوي وقت آخر
    ///
    /// @معامل آخر - الوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كان الوقتان متساويين
    عام دالة يساوي(آخر: وقت) -> منطقي {
        أرجع هذا.ساعة == آخر.ساعة &&
               هذا.دقيقة == آخر.دقيقة &&
               هذا.ثانية == آخر.ثانية &&
               هذا.ميلي == آخر.ميلي
    }

    /// تحقق إذا الوقت بين وقتين
    ///
    /// @معامل بداية - وقت البداية
    /// @معامل نهاية - وقت النهاية
    /// @أرجع صحيح إذا كان الوقت بين البداية والنهاية
    عام دالة بين(بداية: وقت، نهاية: وقت) -> منطقي {
        أرجع !هذا.قبل(بداية) && !هذا.بعد(نهاية)
    }

    // ═══════════════════════════════════════
    // فترة الوقت
    // ═══════════════════════════════════════

    /// تحقق إذا الوقت صباحاً (٦:٠٠ - ١١:٥٩)
    ///
    /// @أرجع صحيح إذا كان الوقت صباحاً
    عام دالة صباح() -> منطقي {
        أرجع هذا.ساعة >= 6 && هذا.ساعة < 12
    }

    /// تحقق إذا الوقت ظهيرة (١٢:٠٠ - ١٧:٥٩)
    ///
    /// @أرجع صحيح إذا كان الوقت ظهيرة
    عام دالة ظهيرة() -> منطقي {
        أرجع هذا.ساعة >= 12 && هذا.ساعة < 18
    }

    /// تحقق إذا الوقت مساءً (١٨:٠٠ - ٢٠:٥٩)
    ///
    /// @أرجع صحيح إذا كان الوقت مساءً
    عام دالة مساء() -> منطقي {
        أرجع هذا.ساعة >= 18 && هذا.ساعة < 21
    }

    /// تحقق إذا الوقت ليلاً (٢١:٠٠ - ٥:٥٩)
    ///
    /// @أرجع صحيح إذا كان الوقت ليلاً
    عام دالة ليل() -> منطقي {
        أرجع هذا.ساعة >= 21 || هذا.ساعة < 6
    }

    /// احصل على اسم الفترة العربي
    ///
    /// @أرجع اسم الفترة (صباحاً، ظهراً، مساءً، ليلاً)
    عام دالة فترة() -> نص {
        إذا (هذا.صباح()) { أرجع "صباحاً" }
        إذا (هذا.ظهيرة()) { أرجع "ظهراً" }
        إذا (هذا.مساء()) { أرجع "مساءً" }
        أرجع "ليلاً"
    }

    // ═══════════════════════════════════════
    // التنسيق
    // ═══════════════════════════════════════

    /// نسّق إلى نص ٢٤ ساعة (HH:MM:SS)
    ///
    /// @أرجع الوقت بصيغة ٢٤ ساعة
    /// @مثال
    /// و.إلى_نص()  // "14:30:00"
    عام دالة إلى_نص() -> نص {
        متغير س = ""
        متغير د = ""
        متغير ث = ""
        إذا (هذا.ساعة < 10) { س = "0" } وإلا { س = "" }
        س = س + عدد_لنص(هذا.ساعة)
        إذا (هذا.دقيقة < 10) { د = "0" } وإلا { د = "" }
        د = د + عدد_لنص(هذا.دقيقة)
        إذا (هذا.ثانية < 10) { ث = "0" } وإلا { ث = "" }
        ث = ث + عدد_لنص(هذا.ثانية)
        أرجع س + ":" + د + ":" + ث
    }

    /// نسّق إلى نص ١٢ ساعة مع ص/م
    ///
    /// @أرجع الوقت بصيغة ١٢ ساعة
    /// @مثال
    /// و.إلى_نص_12()  // "2:30 م"
    عام دالة إلى_نص_12() -> نص {
        متغير س = هذا.ساعة
        متغير فترة = "ص"
        إذا (س >= 12) {
            فترة = "م"
            إذا (س > 12) {
                س = س - 12
            }
        }
        إذا (س == 0) {
            س = 12
        }
        متغير س_نص = عدد_لنص(س)
        متغير د_نص = ""
        إذا (هذا.دقيقة < 10) { د_نص = "0" }
        د_نص = د_نص + عدد_لنص(هذا.دقيقة)
        أرجع س_نص + ":" + د_نص + " " + فترة
    }

    /// نسّق إلى نص عربي مع الفترة
    ///
    /// @أرجع الوقت بصيغة عربية كاملة
    /// @مثال
    /// و.إلى_نص_عربي()  // "2:30 م ظهراً"
    عام دالة إلى_نص_عربي() -> نص {
        أرجع هذا.إلى_نص_12() + " " + هذا.فترة()
    }

    /// نسّق باستخدام نمط
    ///
    /// @معامل نمط - نمط التنسيق
    /// @أرجع الوقت المنسق
    عام دالة نسّق(نمط: نص) -> نص {
        أرجع نسّق_وقت(هذا.ساعة، هذا.دقيقة، هذا.ثانية، هذا.ميلي، نمط)
    }
}

// ═══════════════════════════════════════════
// صنف التاريخ والوقت
// ═══════════════════════════════════════════

/// صنف التاريخ والوقت
///
/// يجمع بين التاريخ والوقت في كائن واحد
///
/// @مثال
/// متغير الآن = تاريخ_ووقت.الآن()
/// اطبع(الآن.إلى_نص())
صدّر صنف تاريخ_ووقت {
    /// مكون التاريخ
    عام تاريخ: تاريخ

    /// مكون الوقت
    عام وقت: وقت

    /// المنشئ مع التاريخ والوقت
    ///
    /// @معامل تاريخ - كائن التاريخ
    /// @معامل وقت - كائن الوقت
    منشئ(تاريخ: تاريخ، وقت: وقت) {
        هذا.تاريخ = تاريخ
        هذا.وقت = وقت
    }

    /// المنشئ الكامل مع المكونات
    ///
    /// @معامل سنة - السنة
    /// @معامل شهر - الشهر
    /// @معامل يوم - اليوم
    /// @معامل ساعة - الساعة
    /// @معامل دقيقة - الدقيقة
    /// @معامل ثانية - الثانية
    منشئ_كامل(سنة: عدد، شهر: عدد، يوم: عدد، ساعة: عدد، دقيقة: عدد، ثانية: عدد) {
        هذا.تاريخ = جديد تاريخ(سنة، شهر، يوم)
        هذا.وقت = جديد وقت(ساعة، دقيقة، ثانية)
    }

    // ═══════════════════════════════════════
    // دوال المصنع الثابتة
    // ═══════════════════════════════════════

    /// احصل على التاريخ والوقت الحالي
    ///
    /// @أرجع التاريخ والوقت الحالي
    /// @مثال
    /// متغير الآن = تاريخ_ووقت.الآن()
    مشترك دالة الآن() -> تاريخ_ووقت {
        أرجع جديد تاريخ_ووقت(تاريخ.اليوم()، وقت.الآن())
    }

    /// أنشئ من طابع يونكس
    ///
    /// @معامل طابع - عدد الثواني منذ ١٩٧٠-٠١-٠١
    /// @أرجع كائن تاريخ_ووقت
    مشترك دالة من_طابع(طابع: عدد) -> تاريخ_ووقت {
        متغير بيانات = تاريخ_ووقت_من_طابع(طابع)
        متغير ت = جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
        متغير و = جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
        أرجع جديد تاريخ_ووقت(ت، و)
    }

    /// حلل من نص ISO
    ///
    /// @معامل نص - نص بصيغة ISO (YYYY-MM-DDTHH:MM:SS)
    /// @أرجع كائن تاريخ_ووقت
    /// @مثال
    /// متغير تو = تاريخ_ووقت.من_نص("2024-01-15T14:30:00")
    مشترك دالة من_نص(نص: نص) -> تاريخ_ووقت {
        متغير بيانات = حلل_تاريخ_ووقت(نص)
        متغير ت = جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
        متغير و = جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
        أرجع جديد تاريخ_ووقت(ت، و)
    }

    // ═══════════════════════════════════════
    // الوصول للمكونات (اختصارات)
    // ═══════════════════════════════════════

    /// احصل على السنة
    عام دالة سنة() -> عدد { أرجع هذا.تاريخ.سنة }

    /// احصل على الشهر
    عام دالة شهر() -> عدد { أرجع هذا.تاريخ.شهر }

    /// احصل على اليوم
    عام دالة يوم() -> عدد { أرجع هذا.تاريخ.يوم }

    /// احصل على الساعة
    عام دالة ساعة() -> عدد { أرجع هذا.وقت.ساعة }

    /// احصل على الدقيقة
    عام دالة دقيقة() -> عدد { أرجع هذا.وقت.دقيقة }

    /// احصل على الثانية
    عام دالة ثانية() -> عدد { أرجع هذا.وقت.ثانية }

    // ═══════════════════════════════════════
    // الحساب
    // ═══════════════════════════════════════

    /// أضف أياماً
    ///
    /// @معامل أيام - عدد الأيام المراد إضافتها
    /// @أرجع تاريخ_ووقت جديد
    عام دالة أضف_أيام(أيام: عدد) -> تاريخ_ووقت {
        أرجع جديد تاريخ_ووقت(هذا.تاريخ.أضف_أيام(أيام)، هذا.وقت)
    }

    /// أضف ساعات
    ///
    /// @معامل ساعات - عدد الساعات المراد إضافتها
    /// @أرجع تاريخ_ووقت جديد
    /// @ملاحظة يُحدث التاريخ تلقائياً عند تجاوز اليوم
    عام دالة أضف_ساعات(ساعات: عدد) -> تاريخ_ووقت {
        متغير إجمالي_ثواني = هذا.وقت.إلى_ثواني() + ساعات * 3600
        متغير أيام_إضافية = إجمالي_ثواني / 86400
        متغير باقي_ثواني = إجمالي_ثواني % 86400
        إذا (باقي_ثواني < 0) {
            أيام_إضافية = أيام_إضافية - 1
            باقي_ثواني = باقي_ثواني + 86400
        }
        متغير وقت_جديد = وقت.من_ثواني(باقي_ثواني)
        متغير تاريخ_جديد = هذا.تاريخ.أضف_أيام(أيام_إضافية)
        أرجع جديد تاريخ_ووقت(تاريخ_جديد، وقت_جديد)
    }

    /// أضف دقائق
    ///
    /// @معامل دقائق - عدد الدقائق المراد إضافتها
    /// @أرجع تاريخ_ووقت جديد
    عام دالة أضف_دقائق(دقائق: عدد) -> تاريخ_ووقت {
        أرجع هذا.أضف_ساعات(0).أضف_ثواني(دقائق * 60)
    }

    /// أضف ثواني
    ///
    /// @معامل ثواني - عدد الثواني المراد إضافتها
    /// @أرجع تاريخ_ووقت جديد
    عام دالة أضف_ثواني(ثواني: عدد) -> تاريخ_ووقت {
        متغير إجمالي = هذا.وقت.إلى_ثواني() + ثواني
        متغير أيام = إجمالي / 86400
        متغير باقي = إجمالي % 86400
        إذا (باقي < 0) {
            أيام = أيام - 1
            باقي = باقي + 86400
        }
        أرجع جديد تاريخ_ووقت(
            هذا.تاريخ.أضف_أيام(أيام)،
            وقت.من_ثواني(باقي)
        )
    }

    // ═══════════════════════════════════════
    // المقارنة
    // ═══════════════════════════════════════

    /// تحقق إذا قبل تاريخ_ووقت آخر
    ///
    /// @معامل آخر - التاريخ والوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا قبل الآخر
    عام دالة قبل(آخر: تاريخ_ووقت) -> منطقي {
        إذا (هذا.تاريخ.قبل(آخر.تاريخ)) { أرجع صحيح }
        إذا (هذا.تاريخ.بعد(آخر.تاريخ)) { أرجع خطأ }
        أرجع هذا.وقت.قبل(آخر.وقت)
    }

    /// تحقق إذا بعد تاريخ_ووقت آخر
    ///
    /// @معامل آخر - التاريخ والوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كان هذا بعد الآخر
    عام دالة بعد(آخر: تاريخ_ووقت) -> منطقي {
        أرجع آخر.قبل(هذا)
    }

    /// تحقق إذا يساوي تاريخ_ووقت آخر
    ///
    /// @معامل آخر - التاريخ والوقت الآخر للمقارنة
    /// @أرجع صحيح إذا كانا متساويين
    عام دالة يساوي(آخر: تاريخ_ووقت) -> منطقي {
        أرجع هذا.تاريخ.يساوي(آخر.تاريخ) && هذا.وقت.يساوي(آخر.وقت)
    }

    // ═══════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════

    /// حوّل إلى طابع يونكس
    ///
    /// @أرجع عدد الثواني منذ ١٩٧٠-٠١-٠١
    عام دالة إلى_طابع() -> عدد {
        أرجع هذا.تاريخ.إلى_طابع() + هذا.وقت.إلى_ثواني()
    }

    /// حوّل إلى صيغة ISO
    ///
    /// @أرجع النص بصيغة YYYY-MM-DDTHH:MM:SS
    /// @مثال
    /// تو.إلى_iso()  // "2024-01-15T14:30:00"
    عام دالة إلى_iso() -> نص {
        أرجع هذا.تاريخ.إلى_iso() + "T" + هذا.وقت.إلى_نص()
    }

    /// حوّل إلى نص عربي
    ///
    /// @أرجع التاريخ والوقت بصيغة عربية
    /// @مثال
    /// تو.إلى_نص()  // "15 يناير 2024 2:30 م ظهراً"
    عام دالة إلى_نص() -> نص {
        أرجع هذا.تاريخ.إلى_نص() + " " + هذا.وقت.إلى_نص_عربي()
    }

    /// نسّق باستخدام نمط
    ///
    /// @معامل نمط - نمط التنسيق
    /// @أرجع التاريخ والوقت المنسق
    عام دالة نسّق(نمط: نص) -> نص {
        أرجع نسّق_تاريخ_ووقت(
            هذا.تاريخ.سنة، هذا.تاريخ.شهر، هذا.تاريخ.يوم،
            هذا.وقت.ساعة، هذا.وقت.دقيقة، هذا.وقت.ثانية،
            نمط
        )
    }
}

// ═══════════════════════════════════════════
// دوال اختصار
// ═══════════════════════════════════════════

/// احصل على التاريخ والوقت الحالي
///
/// @أرجع التاريخ والوقت الحالي
/// @مثال
/// متغير الآن = الآن()
صدّر دالة الآن() -> تاريخ_ووقت {
    أرجع تاريخ_ووقت.الآن()
}

/// احصل على طابع يونكس الحالي
///
/// @أرجع عدد الثواني منذ ١٩٧٠-٠١-٠١
/// @مثال
/// متغير طابع = طابع_الآن()
صدّر دالة طابع_الآن() -> عدد {
    أرجع تاريخ_ووقت.الآن().إلى_طابع()
}

/// احصل على الوقت الحالي فقط
///
/// @أرجع الوقت الحالي
/// @مثال
/// متغير و = الوقت_الآن()
صدّر دالة الوقت_الآن() -> وقت {
    أرجع وقت.الآن()
}

// Note: نم is a builtin function, available directly

/// نم لمدة ثواني
///
/// @معامل ثواني - المدة بالثواني
/// @مثال
/// نم_ثواني(5)  // نم 5 ثواني
صدّر دالة نم_ثواني(ثواني: عدد) {
    نم(ثواني * 1000)
}

/// قس وقت التنفيذ
///
/// @أرجع الوقت الحالي بدقة عالية بالميلي ثانية
/// @مثال
/// متغير بداية = قس_وقت()
/// // كود للقياس
/// متغير نهاية = قس_وقت()
/// اطبع("المدة: " + (نهاية - بداية) + " ميلي ثانية")
صدّر دالة قس_وقت() -> عدد {
    أرجع وقت_أداء()
}

// ═══════════════════════════════════════════
// صنف المدة
// ═══════════════════════════════════════════

/// صنف المدة الزمنية
///
/// يمثل فترة زمنية (أيام، ساعات، دقائق، ثواني)
///
/// @مثال
/// متغير م = مدة.ساعات(2)
/// اطبع(م.إلى_نص())  // "2 ساعة"
صدّر صنف مدة {
    /// المدة بالميلي ثانية
    خاص _ميلي: عدد

    /// المنشئ من الميلي ثانية
    ///
    /// @معامل ميلي_ثانية - المدة بالميلي ثانية
    منشئ(ميلي_ثانية: عدد) {
        هذا._ميلي = ميلي_ثانية
    }

    // ═══════════════════════════════════════
    // دوال المصنع
    // ═══════════════════════════════════════

    /// أنشئ مدة من الثواني
    ///
    /// @معامل ث - عدد الثواني
    /// @أرجع كائن مدة
    مشترك دالة ثواني(ث: عدد) -> مدة { أرجع جديد مدة(ث * 1000) }

    /// أنشئ مدة من الدقائق
    ///
    /// @معامل د - عدد الدقائق
    /// @أرجع كائن مدة
    مشترك دالة دقائق(د: عدد) -> مدة { أرجع جديد مدة(د * 60000) }

    /// أنشئ مدة من الساعات
    ///
    /// @معامل س - عدد الساعات
    /// @أرجع كائن مدة
    مشترك دالة ساعات(س: عدد) -> مدة { أرجع جديد مدة(س * 3600000) }

    /// أنشئ مدة من الأيام
    ///
    /// @معامل أ - عدد الأيام
    /// @أرجع كائن مدة
    مشترك دالة أيام(أ: عدد) -> مدة { أرجع جديد مدة(أ * 86400000) }

    // ═══════════════════════════════════════
    // التحويل
    // ═══════════════════════════════════════

    /// حوّل إلى ميلي ثانية
    ///
    /// @أرجع المدة بالميلي ثانية
    عام دالة إلى_ميلي() -> عدد { أرجع هذا._ميلي }

    /// حوّل إلى ثواني
    ///
    /// @أرجع المدة بالثواني
    عام دالة إلى_ثواني() -> عدد { أرجع هذا._ميلي / 1000 }

    /// حوّل إلى دقائق
    ///
    /// @أرجع المدة بالدقائق
    عام دالة إلى_دقائق() -> عدد { أرجع هذا._ميلي / 60000 }

    /// حوّل إلى ساعات
    ///
    /// @أرجع المدة بالساعات
    عام دالة إلى_ساعات() -> عدد { أرجع هذا._ميلي / 3600000 }

    /// حوّل إلى أيام
    ///
    /// @أرجع المدة بالأيام
    عام دالة إلى_أيام() -> عدد { أرجع هذا._ميلي / 86400000 }

    // ═══════════════════════════════════════
    // الحساب
    // ═══════════════════════════════════════

    /// أضف مدة أخرى
    ///
    /// @معامل أخرى - المدة المراد إضافتها
    /// @أرجع مدة جديدة
    عام دالة أضف(أخرى: مدة) -> مدة {
        أرجع جديد مدة(هذا._ميلي + أخرى._ميلي)
    }

    /// اطرح مدة أخرى
    ///
    /// @معامل أخرى - المدة المراد طرحها
    /// @أرجع مدة جديدة
    عام دالة اطرح(أخرى: مدة) -> مدة {
        أرجع جديد مدة(هذا._ميلي - أخرى._ميلي)
    }

    /// اضرب في عامل
    ///
    /// @معامل عامل - معامل الضرب
    /// @أرجع مدة جديدة
    عام دالة اضرب(عامل: عدد) -> مدة {
        أرجع جديد مدة(هذا._ميلي * عامل)
    }

    // ═══════════════════════════════════════
    // التنسيق
    // ═══════════════════════════════════════

    /// نسّق كنص مقروء
    ///
    /// @أرجع المدة بصيغة مقروءة
    /// @مثال
    /// مدة.ساعات(25).إلى_نص()  // "1 يوم 1 ساعة"
    عام دالة إلى_نص() -> نص {
        متغير ميلي = هذا._ميلي
        إذا (ميلي < 0) { ميلي = -ميلي }

        متغير أيام = ميلي / 86400000
        ميلي = ميلي % 86400000
        متغير ساعات = ميلي / 3600000
        ميلي = ميلي % 3600000
        متغير دقائق = ميلي / 60000
        ميلي = ميلي % 60000
        متغير ثواني = ميلي / 1000

        متغير نتيجة = ""
        إذا (أيام > 0) {
            نتيجة = عدد_لنص(أيام) + " يوم "
        }
        إذا (ساعات > 0) {
            نتيجة = نتيجة + عدد_لنص(ساعات) + " ساعة "
        }
        إذا (دقائق > 0) {
            نتيجة = نتيجة + عدد_لنص(دقائق) + " دقيقة "
        }
        إذا (ثواني > 0 || نتيجة == "") {
            نتيجة = نتيجة + عدد_لنص(ثواني) + " ثانية"
        }
        أرجع نتيجة
    }
}

