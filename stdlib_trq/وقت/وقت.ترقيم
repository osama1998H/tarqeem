// وقت/وقت - Time Operations
// وقت/وقت - عمليات الوقت
//
// Provides time and datetime handling
// يوفر معالجة الوقت والتاريخ_ووقت

// =============================================================================
// وقت - Time Class
// =============================================================================

صدّر صنف وقت {
    عام ساعة: عدد
    عام دقيقة: عدد
    عام ثانية: عدد
    عام ميلي: عدد

    // Constructor with hour, minute, second
    // المنشئ مع الساعة والدقيقة والثانية
    منشئ(ساعة: عدد، دقيقة: عدد، ثانية: عدد) {
        هذا.ساعة = ساعة
        هذا.دقيقة = دقيقة
        هذا.ثانية = ثانية
        هذا.ميلي = 0
    }

    // Constructor with milliseconds
    // المنشئ مع الميلي ثانية
    منشئ_كامل(ساعة: عدد، دقيقة: عدد، ثانية: عدد، ميلي: عدد) {
        هذا.ساعة = ساعة
        هذا.دقيقة = دقيقة
        هذا.ثانية = ثانية
        هذا.ميلي = ميلي
    }

    // ======================================
    // Static Factory Methods
    // دوال مصنع ثابتة
    // ======================================

    // Get current time
    // احصل على الوقت الحالي
    ثابت_صنف دالة الآن() -> وقت {
        // Uses runtime: trq_time_now
        متغير بيانات = __وقت_الآن__()
        أرجع جديد وقت.منشئ_كامل(
            بيانات.ساعة،
            بيانات.دقيقة،
            بيانات.ثانية،
            بيانات.ميلي
        )
    }

    // Parse time from string (HH:MM:SS format)
    // حلل الوقت من نص (صيغة HH:MM:SS)
    ثابت_صنف دالة من_نص(نص: نص) -> وقت {
        // Uses runtime: trq_time_parse
        متغير بيانات = __حلل_وقت__(نص)
        أرجع جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
    }

    // Create from total seconds
    // أنشئ من إجمالي الثواني
    ثابت_صنف دالة من_ثواني(ثواني: عدد) -> وقت {
        متغير س = ثواني / 3600
        متغير باقي = ثواني % 3600
        متغير د = باقي / 60
        متغير ث = باقي % 60
        أرجع جديد وقت(س، د، ث)
    }

    // Create from total milliseconds
    // أنشئ من إجمالي الميلي ثانية
    ثابت_صنف دالة من_ميلي(ميلي: عدد) -> وقت {
        متغير إجمالي_ثواني = ميلي / 1000
        متغير م = ميلي % 1000
        متغير وقت_جديد = وقت.من_ثواني(إجمالي_ثواني)
        وقت_جديد.ميلي = م
        أرجع وقت_جديد
    }

    // Midnight (00:00:00)
    // منتصف الليل
    ثابت_صنف دالة منتصف_الليل() -> وقت {
        أرجع جديد وقت(0، 0، 0)
    }

    // Noon (12:00:00)
    // الظهر
    ثابت_صنف دالة الظهر() -> وقت {
        أرجع جديد وقت(12، 0، 0)
    }

    // ======================================
    // Time Arithmetic
    // الحساب مع الوقت
    // ======================================

    // Add seconds
    // أضف ثواني
    عام دالة أضف_ثواني(ثواني: عدد) -> وقت {
        متغير إجمالي = هذا.إلى_ثواني() + ثواني
        // Handle negative and overflow
        إجمالي = إجمالي % 86400
        إذا (إجمالي < 0) {
            إجمالي = إجمالي + 86400
        }
        متغير نتيجة = وقت.من_ثواني(إجمالي)
        نتيجة.ميلي = هذا.ميلي
        أرجع نتيجة
    }

    // Add minutes
    // أضف دقائق
    عام دالة أضف_دقائق(دقائق: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(دقائق * 60)
    }

    // Add hours
    // أضف ساعات
    عام دالة أضف_ساعات(ساعات: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(ساعات * 3600)
    }

    // Subtract seconds
    // اطرح ثواني
    عام دالة اطرح_ثواني(ثواني: عدد) -> وقت {
        أرجع هذا.أضف_ثواني(-ثواني)
    }

    // Difference in seconds between two times
    // الفرق بالثواني بين وقتين
    عام دالة فرق_ثواني(آخر: وقت) -> عدد {
        أرجع هذا.إلى_ثواني() - آخر.إلى_ثواني()
    }

    // ======================================
    // Conversion
    // التحويل
    // ======================================

    // Convert to total seconds
    // حوّل إلى إجمالي الثواني
    عام دالة إلى_ثواني() -> عدد {
        أرجع هذا.ساعة * 3600 + هذا.دقيقة * 60 + هذا.ثانية
    }

    // Convert to total milliseconds
    // حوّل إلى إجمالي الميلي ثانية
    عام دالة إلى_ميلي() -> عدد {
        أرجع هذا.إلى_ثواني() * 1000 + هذا.ميلي
    }

    // Convert to total minutes
    // حوّل إلى إجمالي الدقائق
    عام دالة إلى_دقائق() -> عدد {
        أرجع هذا.ساعة * 60 + هذا.دقيقة
    }

    // ======================================
    // Comparison
    // المقارنة
    // ======================================

    // Check if before another time
    // تحقق إذا قبل وقت آخر
    عام دالة قبل(آخر: وقت) -> منطقي {
        أرجع هذا.إلى_ميلي() < آخر.إلى_ميلي()
    }

    // Check if after another time
    // تحقق إذا بعد وقت آخر
    عام دالة بعد(آخر: وقت) -> منطقي {
        أرجع هذا.إلى_ميلي() > آخر.إلى_ميلي()
    }

    // Check if equal to another time
    // تحقق إذا يساوي وقت آخر
    عام دالة يساوي(آخر: وقت) -> منطقي {
        أرجع هذا.ساعة == آخر.ساعة &&
               هذا.دقيقة == آخر.دقيقة &&
               هذا.ثانية == آخر.ثانية &&
               هذا.ميلي == آخر.ميلي
    }

    // Check if between two times
    // تحقق إذا بين وقتين
    عام دالة بين(بداية: وقت، نهاية: وقت) -> منطقي {
        أرجع !هذا.قبل(بداية) && !هذا.بعد(نهاية)
    }

    // ======================================
    // Time Period
    // فترة الوقت
    // ======================================

    // Check if morning (6:00 - 11:59)
    // تحقق إذا صباح
    عام دالة صباح() -> منطقي {
        أرجع هذا.ساعة >= 6 && هذا.ساعة < 12
    }

    // Check if afternoon (12:00 - 17:59)
    // تحقق إذا ظهيرة
    عام دالة ظهيرة() -> منطقي {
        أرجع هذا.ساعة >= 12 && هذا.ساعة < 18
    }

    // Check if evening (18:00 - 20:59)
    // تحقق إذا مساء
    عام دالة مساء() -> منطقي {
        أرجع هذا.ساعة >= 18 && هذا.ساعة < 21
    }

    // Check if night (21:00 - 5:59)
    // تحقق إذا ليل
    عام دالة ليل() -> منطقي {
        أرجع هذا.ساعة >= 21 || هذا.ساعة < 6
    }

    // Get Arabic period name
    // احصل على اسم الفترة العربي
    عام دالة فترة() -> نص {
        إذا (هذا.صباح()) { أرجع "صباحاً" }
        إذا (هذا.ظهيرة()) { أرجع "ظهراً" }
        إذا (هذا.مساء()) { أرجع "مساءً" }
        أرجع "ليلاً"
    }

    // ======================================
    // Formatting
    // التنسيق
    // ======================================

    // Format to 24-hour string (HH:MM:SS)
    // نسّق إلى نص 24 ساعة
    عام دالة إلى_نص() -> نص {
        متغير س = ""
        متغير د = ""
        متغير ث = ""
        إذا (هذا.ساعة < 10) { س = "0" } وإلا { س = "" }
        س = س + __إلى_نص__(هذا.ساعة)
        إذا (هذا.دقيقة < 10) { د = "0" } وإلا { د = "" }
        د = د + __إلى_نص__(هذا.دقيقة)
        إذا (هذا.ثانية < 10) { ث = "0" } وإلا { ث = "" }
        ث = ث + __إلى_نص__(هذا.ثانية)
        أرجع س + ":" + د + ":" + ث
    }

    // Format to 12-hour string with AM/PM
    // نسّق إلى نص 12 ساعة
    عام دالة إلى_نص_12() -> نص {
        متغير س = هذا.ساعة
        متغير فترة = "ص"
        إذا (س >= 12) {
            فترة = "م"
            إذا (س > 12) {
                س = س - 12
            }
        }
        إذا (س == 0) {
            س = 12
        }
        متغير س_نص = __إلى_نص__(س)
        متغير د_نص = ""
        إذا (هذا.دقيقة < 10) { د_نص = "0" }
        د_نص = د_نص + __إلى_نص__(هذا.دقيقة)
        أرجع س_نص + ":" + د_نص + " " + فترة
    }

    // Format to Arabic time string
    // نسّق إلى نص عربي
    عام دالة إلى_نص_عربي() -> نص {
        أرجع هذا.إلى_نص_12() + " " + هذا.فترة()
    }

    // Format using pattern
    // نسّق باستخدام نمط
    عام دالة نسّق(نمط: نص) -> نص {
        // Uses runtime: trq_time_format
        أرجع __نسّق_وقت__(هذا.ساعة، هذا.دقيقة، هذا.ثانية، هذا.ميلي، نمط)
    }
}

// =============================================================================
// تاريخ_ووقت - DateTime Class
// =============================================================================

صدّر صنف تاريخ_ووقت {
    عام تاريخ: تاريخ
    عام وقت: وقت

    // Constructor with date and time
    // المنشئ مع التاريخ والوقت
    منشئ(تاريخ: تاريخ، وقت: وقت) {
        هذا.تاريخ = تاريخ
        هذا.وقت = وقت
    }

    // Constructor with components
    // المنشئ مع المكونات
    منشئ_كامل(سنة: عدد، شهر: عدد، يوم: عدد، ساعة: عدد، دقيقة: عدد، ثانية: عدد) {
        هذا.تاريخ = جديد تاريخ(سنة، شهر، يوم)
        هذا.وقت = جديد وقت(ساعة، دقيقة، ثانية)
    }

    // ======================================
    // Static Factory Methods
    // دوال مصنع ثابتة
    // ======================================

    // Get current datetime
    // احصل على التاريخ والوقت الحالي
    ثابت_صنف دالة الآن() -> تاريخ_ووقت {
        أرجع جديد تاريخ_ووقت(تاريخ.اليوم()، وقت.الآن())
    }

    // Create from Unix timestamp
    // أنشئ من طابع Unix
    ثابت_صنف دالة من_طابع(طابع: عدد) -> تاريخ_ووقت {
        // Uses runtime: trq_datetime_from_timestamp
        متغير بيانات = __تاريخ_ووقت_من_طابع__(طابع)
        متغير ت = جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
        متغير و = جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
        أرجع جديد تاريخ_ووقت(ت، و)
    }

    // Parse datetime from ISO string
    // حلل التاريخ والوقت من نص ISO
    ثابت_صنف دالة من_نص(نص: نص) -> تاريخ_ووقت {
        // Uses runtime: trq_datetime_parse
        متغير بيانات = __حلل_تاريخ_ووقت__(نص)
        متغير ت = جديد تاريخ(بيانات.سنة، بيانات.شهر، بيانات.يوم)
        متغير و = جديد وقت(بيانات.ساعة، بيانات.دقيقة، بيانات.ثانية)
        أرجع جديد تاريخ_ووقت(ت، و)
    }

    // ======================================
    // Component Access (shortcuts)
    // الوصول للمكونات (اختصارات)
    // ======================================

    عام دالة سنة() -> عدد { أرجع هذا.تاريخ.سنة }
    عام دالة شهر() -> عدد { أرجع هذا.تاريخ.شهر }
    عام دالة يوم() -> عدد { أرجع هذا.تاريخ.يوم }
    عام دالة ساعة() -> عدد { أرجع هذا.وقت.ساعة }
    عام دالة دقيقة() -> عدد { أرجع هذا.وقت.دقيقة }
    عام دالة ثانية() -> عدد { أرجع هذا.وقت.ثانية }

    // ======================================
    // Arithmetic
    // الحساب
    // ======================================

    // Add days
    // أضف أيام
    عام دالة أضف_أيام(أيام: عدد) -> تاريخ_ووقت {
        أرجع جديد تاريخ_ووقت(هذا.تاريخ.أضف_أيام(أيام)، هذا.وقت)
    }

    // Add hours
    // أضف ساعات
    عام دالة أضف_ساعات(ساعات: عدد) -> تاريخ_ووقت {
        متغير إجمالي_ثواني = هذا.وقت.إلى_ثواني() + ساعات * 3600
        متغير أيام_إضافية = إجمالي_ثواني / 86400
        متغير باقي_ثواني = إجمالي_ثواني % 86400
        إذا (باقي_ثواني < 0) {
            أيام_إضافية = أيام_إضافية - 1
            باقي_ثواني = باقي_ثواني + 86400
        }
        متغير وقت_جديد = وقت.من_ثواني(باقي_ثواني)
        متغير تاريخ_جديد = هذا.تاريخ.أضف_أيام(أيام_إضافية)
        أرجع جديد تاريخ_ووقت(تاريخ_جديد، وقت_جديد)
    }

    // Add minutes
    // أضف دقائق
    عام دالة أضف_دقائق(دقائق: عدد) -> تاريخ_ووقت {
        أرجع هذا.أضف_ساعات(0).أضف_ثواني(دقائق * 60)
    }

    // Add seconds
    // أضف ثواني
    عام دالة أضف_ثواني(ثواني: عدد) -> تاريخ_ووقت {
        متغير إجمالي = هذا.وقت.إلى_ثواني() + ثواني
        متغير أيام = إجمالي / 86400
        متغير باقي = إجمالي % 86400
        إذا (باقي < 0) {
            أيام = أيام - 1
            باقي = باقي + 86400
        }
        أرجع جديد تاريخ_ووقت(
            هذا.تاريخ.أضف_أيام(أيام)،
            وقت.من_ثواني(باقي)
        )
    }

    // ======================================
    // Comparison
    // المقارنة
    // ======================================

    عام دالة قبل(آخر: تاريخ_ووقت) -> منطقي {
        إذا (هذا.تاريخ.قبل(آخر.تاريخ)) { أرجع صحيح }
        إذا (هذا.تاريخ.بعد(آخر.تاريخ)) { أرجع خطأ }
        أرجع هذا.وقت.قبل(آخر.وقت)
    }

    عام دالة بعد(آخر: تاريخ_ووقت) -> منطقي {
        أرجع آخر.قبل(هذا)
    }

    عام دالة يساوي(آخر: تاريخ_ووقت) -> منطقي {
        أرجع هذا.تاريخ.يساوي(آخر.تاريخ) && هذا.وقت.يساوي(آخر.وقت)
    }

    // ======================================
    // Conversion
    // التحويل
    // ======================================

    // Convert to Unix timestamp
    // حوّل إلى طابع Unix
    عام دالة إلى_طابع() -> عدد {
        أرجع هذا.تاريخ.إلى_طابع() + هذا.وقت.إلى_ثواني()
    }

    // Convert to ISO string (YYYY-MM-DDTHH:MM:SS)
    // حوّل إلى نص ISO
    عام دالة إلى_iso() -> نص {
        أرجع هذا.تاريخ.إلى_iso() + "T" + هذا.وقت.إلى_نص()
    }

    // Convert to string (Arabic format)
    // حوّل إلى نص (صيغة عربية)
    عام دالة إلى_نص() -> نص {
        أرجع هذا.تاريخ.إلى_نص() + " " + هذا.وقت.إلى_نص_عربي()
    }

    // Format using pattern
    // نسّق باستخدام نمط
    عام دالة نسّق(نمط: نص) -> نص {
        // Uses runtime: trq_datetime_format
        أرجع __نسّق_تاريخ_ووقت__(
            هذا.تاريخ.سنة، هذا.تاريخ.شهر، هذا.تاريخ.يوم،
            هذا.وقت.ساعة، هذا.وقت.دقيقة، هذا.وقت.ثانية،
            نمط
        )
    }
}

// =============================================================================
// Shortcut Functions / دوال اختصار
// =============================================================================

// Get current datetime
// احصل على التاريخ والوقت الحالي
صدّر دالة الآن() -> تاريخ_ووقت {
    أرجع تاريخ_ووقت.الآن()
}

// Get current Unix timestamp
// احصل على طابع Unix الحالي
صدّر دالة طابع_الآن() -> عدد {
    أرجع تاريخ_ووقت.الآن().إلى_طابع()
}

// Get current time only
// احصل على الوقت الحالي فقط
صدّر دالة الوقت_الآن() -> وقت {
    أرجع وقت.الآن()
}

// Sleep for milliseconds
// نم لمدة ميلي ثانية
صدّر دالة نم(ميلي_ثانية: عدد) {
    // Uses runtime: trq_sleep
    __نم__(ميلي_ثانية)
}

// Sleep for seconds
// نم لمدة ثواني
صدّر دالة نم_ثواني(ثواني: عدد) {
    نم(ثواني * 1000)
}

// Measure execution time in milliseconds
// قس وقت التنفيذ بالميلي ثانية
صدّر دالة قس_وقت() -> عدد {
    // Uses runtime: trq_performance_now
    أرجع __وقت_أداء__()
}

// =============================================================================
// Duration Class (bonus)
// =============================================================================

صدّر صنف مدة {
    خاص _ميلي: عدد

    // Constructor from milliseconds
    // المنشئ من الميلي ثانية
    منشئ(ميلي_ثانية: عدد) {
        هذا._ميلي = ميلي_ثانية
    }

    // Factory methods
    // دوال المصنع
    ثابت_صنف دالة ثواني(ث: عدد) -> مدة { أرجع جديد مدة(ث * 1000) }
    ثابت_صنف دالة دقائق(د: عدد) -> مدة { أرجع جديد مدة(د * 60000) }
    ثابت_صنف دالة ساعات(س: عدد) -> مدة { أرجع جديد مدة(س * 3600000) }
    ثابت_صنف دالة أيام(أ: عدد) -> مدة { أرجع جديد مدة(أ * 86400000) }

    // Conversion
    // التحويل
    عام دالة إلى_ميلي() -> عدد { أرجع هذا._ميلي }
    عام دالة إلى_ثواني() -> عدد { أرجع هذا._ميلي / 1000 }
    عام دالة إلى_دقائق() -> عدد { أرجع هذا._ميلي / 60000 }
    عام دالة إلى_ساعات() -> عدد { أرجع هذا._ميلي / 3600000 }
    عام دالة إلى_أيام() -> عدد { أرجع هذا._ميلي / 86400000 }

    // Arithmetic
    // الحساب
    عام دالة أضف(أخرى: مدة) -> مدة {
        أرجع جديد مدة(هذا._ميلي + أخرى._ميلي)
    }

    عام دالة اطرح(أخرى: مدة) -> مدة {
        أرجع جديد مدة(هذا._ميلي - أخرى._ميلي)
    }

    عام دالة اضرب(عامل: عدد) -> مدة {
        أرجع جديد مدة(هذا._ميلي * عامل)
    }

    // Format as human-readable string
    // نسّق كنص مقروء
    عام دالة إلى_نص() -> نص {
        متغير ميلي = هذا._ميلي
        إذا (ميلي < 0) { ميلي = -ميلي }

        متغير أيام = ميلي / 86400000
        ميلي = ميلي % 86400000
        متغير ساعات = ميلي / 3600000
        ميلي = ميلي % 3600000
        متغير دقائق = ميلي / 60000
        ميلي = ميلي % 60000
        متغير ثواني = ميلي / 1000

        متغير نتيجة = ""
        إذا (أيام > 0) {
            نتيجة = __إلى_نص__(أيام) + " يوم "
        }
        إذا (ساعات > 0) {
            نتيجة = نتيجة + __إلى_نص__(ساعات) + " ساعة "
        }
        إذا (دقائق > 0) {
            نتيجة = نتيجة + __إلى_نص__(دقائق) + " دقيقة "
        }
        إذا (ثواني > 0 || نتيجة == "") {
            نتيجة = نتيجة + __إلى_نص__(ثواني) + " ثانية"
        }
        أرجع نتيجة
    }
}
