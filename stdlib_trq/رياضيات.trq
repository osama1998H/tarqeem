// رياضيات - Math Module
// رياضيات - وحدة الرياضيات

// Mathematical constants
صدّر ثابت باي = 3.141592653589793
صدّر ثابت هـ = 2.718281828459045  // Euler's number

// Absolute value
صدّر دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

// Absolute value for floats
صدّر دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع -س
    }
    أرجع س
}

// Maximum of two integers
صدّر دالة أقصى(أ: عدد، ب: عدد) -> عدد {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

// Minimum of two integers
صدّر دالة أدنى(أ: عدد، ب: عدد) -> عدد {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

// Check if number is even
صدّر دالة زوجي(س: عدد) -> منطقي {
    أرجع س % 2 == 0
}

// Check if number is odd
صدّر دالة فردي(س: عدد) -> منطقي {
    أرجع س % 2 != 0
}

// Power function (integer exponent)
صدّر دالة قوة(أساس: عدد، أس: عدد) -> عدد {
    إذا (أس == 0) {
        أرجع 1
    }
    متغير نتيجة = 1
    متغير ع = 0
    طالما (ع < أس) {
        نتيجة = نتيجة * أساس
        ع = ع + 1
    }
    أرجع نتيجة
}

// Built-in math functions from runtime:
// جذر_تربيعي، جا، جتا، ظا - provided by runtime/libtrq.c
