/// مشغّل الاختبارات
///
/// توفر هذه الوحدة أدوات لتشغيل وتنظيم الاختبارات
/// بما في ذلك دوال الإعداد والتنظيف
///
/// @منذ ١.٠.٠

استورد { نتيجة_اختبار، ملخص_الاختبارات، معلومات_اختبار } من "اختبار/نتائج"
استورد { خطأ_توكيد_مفصل، خطأ_تخطي } من "اختبار/توكيدات"

// ═══════════════════════════════════════════
// صنف مجموعة الاختبارات
// ═══════════════════════════════════════════

/// مجموعة اختبارات
///
/// تُستخدم لتجميع الاختبارات ذات الصلة معاً
/// مع دعم دوال الإعداد والتنظيف
///
/// @مثال
/// متغير مجموعة = جديد مجموعة_اختبارات("اختبارات الحاسبة")
/// مجموعة.شغّل()
صدّر صنف مجموعة_اختبارات {
    /// اسم المجموعة
    عام اسم: نص

    /// قائمة الاختبارات
    خاص _اختبارات: مصفوفة<معلومات_اختبار>

    /// ملخص النتائج
    عام ملخص: ملخص_الاختبارات

    /// هل تم التشغيل
    خاص _شُغِّل: منطقي

    /// المنشئ
    ///
    /// @معامل اسم - اسم المجموعة
    منشئ(اسم: نص) {
        هذا.اسم = اسم
        هذا._اختبارات = []
        هذا.ملخص = جديد ملخص_الاختبارات(اسم)
        هذا._شُغِّل = خطأ
    }

    /// تحقق إذا تم التشغيل
    عام دالة شُغِّل() -> منطقي {
        أرجع هذا._شُغِّل
    }

    /// أضف اختباراً
    ///
    /// @معامل معلومات - معلومات الاختبار
    عام دالة أضف(معلومات: معلومات_اختبار) {
        هذا._اختبارات.ألحق(معلومات)
    }

    /// أحصل على عدد الاختبارات
    عام دالة عدد() -> عدد {
        أرجع طول(هذا._اختبارات)
    }
}

// ═══════════════════════════════════════════
// دوال الإعداد والتنظيف
// ═══════════════════════════════════════════

/// صنف سياق الاختبار
///
/// يوفر سياقاً مشتركاً لمجموعة اختبارات
/// مع دعم للبيانات المشتركة والإعداد/التنظيف
صدّر صنف سياق_اختبار {
    /// بيانات مشتركة (مفتاح -> قيمة كنص)
    خاص _بيانات: مصفوفة<نص>
    خاص _مفاتيح: مصفوفة<نص>

    /// المنشئ
    منشئ() {
        هذا._بيانات = []
        هذا._مفاتيح = []
    }

    /// عيّن قيمة في السياق
    ///
    /// @معامل مفتاح - اسم المفتاح
    /// @معامل قيمة - القيمة
    عام دالة عيّن(مفتاح: نص، قيمة: نص) {
        // ابحث عن المفتاح الموجود
        متغير ع = 0
        طالما (ع < طول(هذا._مفاتيح)) {
            إذا (هذا._مفاتيح[ع] == مفتاح) {
                هذا._بيانات[ع] = قيمة
                أرجع
            }
            ع = ع + 1
        }
        // أضف مفتاح جديد
        هذا._مفاتيح.ألحق(مفتاح)
        هذا._بيانات.ألحق(قيمة)
    }

    /// أحصل على قيمة من السياق
    ///
    /// @معامل مفتاح - اسم المفتاح
    /// @أرجع القيمة أو نص فارغ إذا لم توجد
    عام دالة احصل(مفتاح: نص) -> نص {
        متغير ع = 0
        طالما (ع < طول(هذا._مفاتيح)) {
            إذا (هذا._مفاتيح[ع] == مفتاح) {
                أرجع هذا._بيانات[ع]
            }
            ع = ع + 1
        }
        أرجع ""
    }

    /// امسح جميع البيانات
    عام دالة امسح() {
        هذا._بيانات = []
        هذا._مفاتيح = []
    }
}

