}

/// أنشئ بيانات اختبار عشوائية
///
/// @معامل طول - طول المصفوفة المطلوبة
/// @معامل حد_أقصى - الحد الأقصى للقيم
/// @أرجع مصفوفة من الأعداد العشوائية
صدّر دالة بيانات_اختبار(الطول: عدد، حد_أقصى: عدد) -> مصفوفة<عدد> {
    متغير نتيجة: مصفوفة<عدد> = []
    متغير ع = 0
    طالما (ع < الطول) {
        // قيمة شبه عشوائية بسيطة
        متغير قيمة = ((ع * 7 + 13) % حد_أقصى)
        نتيجة.ألحق(قيمة)
        ع = ع + 1
    }
    أرجع نتيجة
}

