// دوال مساعدة للتقارير
// ═══════════════════════════════════════════

/// اطبع ترويسة الاختبارات
///
/// @معامل اسم - اسم مجموعة الاختبارات
صدّر دالة اطبع_ترويسة(اسم: نص) {
    اطبع("")
    اطبع("═══════════════════════════════════════════")
    اطبع("  " + اسم)
    اطبع("═══════════════════════════════════════════")
    اطبع("")
}

/// اطبع نتيجة اختبار واحد
///
/// @معامل نتيجة - نتيجة الاختبار
صدّر دالة اطبع_نتيجة(نتيجة: نتيجة_اختبار) {
    متغير رمز = نتيجة.رمز_الحالة()
    متغير حالة = نتيجة.وصف_الحالة()
    متغير مدة = ""

    إذا (نتيجة.مدة_ميلي > 0) {
        مدة = " (" + عدد_لنص(نتيجة.مدة_ميلي) + " مل.ث)"
    }

    اطبع("  " + رمز + " " + نتيجة.اسم + " - " + حالة + مدة)

    // اطبع تفاصيل الفشل
    إذا (نتيجة.فشل()) {
        اطبع("      الرسالة: " + نتيجة.رسالة_الخطأ)
        إذا (طول_نص(نتيجة.متوقع) > 0) {
            اطبع("      المتوقع: " + نتيجة.متوقع)
            اطبع("      الفعلي:  " + نتيجة.فعلي)
        }
    }
}

/// اطبع ملخص النتائج
///
/// @معامل ملخص - ملخص الاختبارات
صدّر دالة اطبع_ملخص(ملخص: ملخص_الاختبارات) {
    اطبع("")
    اطبع("═══════════════════════════════════════════")
    اطبع("  ملخص النتائج")
    اطبع("═══════════════════════════════════════════")
    اطبع("")

    اطبع("  الإجمالي:   " + عدد_لنص(ملخص.إجمالي))
    اطبع("  ناجحة:     " + عدد_لنص(ملخص.ناجحة))
    اطبع("  فاشلة:     " + عدد_لنص(ملخص.فاشلة))
    اطبع("  متخطاة:    " + عدد_لنص(ملخص.متخطاة))

    إذا (ملخص.أخطاء > 0) {
        اطبع("  أخطاء:     " + عدد_لنص(ملخص.أخطاء))
    }

    اطبع("")
    اطبع("  الوقت:      " + عدد_لنص(ملخص.إجمالي_الوقت) + " مل.ث")
    اطبع("  النسبة:     " + عدد_لنص(ملخص.نسبة_النجاح()) + "%")
    اطبع("")

    إذا (ملخص.كل_ناجح()) {
        اطبع("  ✓ جميع الاختبارات ناجحة!")
    } وإلا {
        اطبع("  ✗ بعض الاختبارات فشلت")
    }

    اطبع("")
}

/// اطبع شريط التقدم
///
/// @معامل حالي - الرقم الحالي
/// @معامل إجمالي - الإجمالي
/// @معامل عرض - عرض الشريط
صدّر دالة اطبع_تقدم(حالي: عدد، إجمالي: عدد، عرض: عدد) {
    متغير نسبة = (حالي * عرض) / إجمالي
    متغير شريط = "["

    متغير ع = 0
    طالما (ع < عرض) {
        إذا (ع < نسبة) {
            شريط = شريط + "█"
        } وإلا {
            شريط = شريط + "░"
        }
        ع = ع + 1
    }

    شريط = شريط + "] " + عدد_لنص(حالي) + "/" + عدد_لنص(إجمالي)
    اطبع(شريط)
}

