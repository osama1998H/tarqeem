/// تأكد من أن القيمة أكبر من حد معين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل حد - الحد الأدنى (غير شامل)
/// @مثال
/// تأكد_أكبر_من(عمر، ١٨)
صدّر دالة تأكد_أكبر_من(فعلي: عدد، حد: عدد) {
    إذا (فعلي <= حد) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت قيمة أكبر من " + عدد_لنص(حد)،
            "> " + عدد_لنص(حد)،
            عدد_لنص(فعلي)،
            "تأكد_أكبر_من"
        )
    }
}

/// تأكد من أن القيمة أكبر من أو تساوي حد معين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل حد - الحد الأدنى (شامل)
صدّر دالة تأكد_أكبر_أو_يساوي(فعلي: عدد، حد: عدد) {
    إذا (فعلي < حد) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت قيمة أكبر من أو تساوي " + عدد_لنص(حد)،
            ">= " + عدد_لنص(حد)،
            عدد_لنص(فعلي)،
            "تأكد_أكبر_أو_يساوي"
        )
    }
}

/// تأكد من أن القيمة أصغر من حد معين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل حد - الحد الأقصى (غير شامل)
/// @مثال
/// تأكد_أصغر_من(درجة_الحرارة، ١٠٠)
صدّر دالة تأكد_أصغر_من(فعلي: عدد، حد: عدد) {
    إذا (فعلي >= حد) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت قيمة أصغر من " + عدد_لنص(حد)،
            "< " + عدد_لنص(حد)،
            عدد_لنص(فعلي)،
            "تأكد_أصغر_من"
        )
    }
}

/// تأكد من أن القيمة أصغر من أو تساوي حد معين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل حد - الحد الأقصى (شامل)
صدّر دالة تأكد_أصغر_أو_يساوي(فعلي: عدد، حد: عدد) {
    إذا (فعلي > حد) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت قيمة أصغر من أو تساوي " + عدد_لنص(حد)،
            "<= " + عدد_لنص(حد)،
            عدد_لنص(فعلي)،
            "تأكد_أصغر_أو_يساوي"
        )
    }
}

/// تأكد من أن القيمة ضمن نطاق معين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل حد_أدنى - الحد الأدنى (شامل)
/// @معامل حد_أقصى - الحد الأقصى (شامل)
/// @مثال
/// تأكد_ضمن_نطاق(درجة، ٠، ١٠٠)
صدّر دالة تأكد_ضمن_نطاق(فعلي: عدد، حد_أدنى: عدد، حد_أقصى: عدد) {
    إذا (فعلي < حد_أدنى || فعلي > حد_أقصى) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "القيمة خارج النطاق المتوقع"،
            عدد_لنص(حد_أدنى) + " إلى " + عدد_لنص(حد_أقصى)،
            عدد_لنص(فعلي)،
            "تأكد_ضمن_نطاق"
        )
    }
}

