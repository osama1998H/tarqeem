/// تأكد من أن المصفوفة فارغة
///
/// @معامل مصفوفة - المصفوفة المراد فحصها
صدّر دالة تأكد_مصفوفة_فارغة(مصفوفة: مصفوفة<أي>) {
    إذا (طول(مصفوفة) > 0) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت مصفوفة فارغة"،
            "مصفوفة فارغة (طول = ٠)"،
            "مصفوفة بطول " + عدد_لنص(طول(مصفوفة))،
            "تأكد_مصفوفة_فارغة"
        )
    }
}

/// تأكد من أن المصفوفة غير فارغة
///
/// @معامل مصفوفة - المصفوفة المراد فحصها
صدّر دالة تأكد_مصفوفة_غير_فارغة(مصفوفة: مصفوفة<أي>) {
    إذا (طول(مصفوفة) == 0) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت مصفوفة غير فارغة"،
            "مصفوفة غير فارغة"،
            "مصفوفة فارغة"،
            "تأكد_مصفوفة_غير_فارغة"
        )
    }
}

/// تأكد من طول المصفوفة
///
/// @معامل مصفوفة - المصفوفة المراد فحصها
/// @معامل طول_متوقع - الطول المتوقع
صدّر دالة تأكد_طول_مصفوفة(مصفوفة: مصفوفة<أي>، طول_متوقع: عدد) {
    متغير الطول_الفعلي = طول(مصفوفة)
    إذا (الطول_الفعلي != طول_متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "طول المصفوفة لا يطابق المتوقع"،
            عدد_لنص(طول_متوقع)،
            عدد_لنص(الطول_الفعلي)،
            "تأكد_طول_مصفوفة"
        )
    }
}

/// تأكد من أن المصفوفة تحتوي على عنصر معين
///
/// @معامل مصفوفة - المصفوفة المراد البحث فيها
/// @معامل عنصر - العنصر المطلوب
صدّر دالة تأكد_مصفوفة_تحتوي(مصفوفة: مصفوفة<عدد>، عنصر: عدد) {
    متغير موجود = خطأ
    لكل ع في مصفوفة {
        إذا (ع == عنصر) {
            موجود = صحيح
            أوقف
        }
    }
    إذا (!موجود) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "المصفوفة لا تحتوي على العنصر المطلوب"،
            "مصفوفة تحتوي على " + عدد_لنص(عنصر)،
            "مصفوفة لا تحتوي على العنصر"،
            "تأكد_مصفوفة_تحتوي"
        )
    }
}

