// دوال المساواة
// ═══════════════════════════════════════════

/// تأكد من تساوي قيمتين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل متوقع - القيمة المتوقعة
/// @مثال
/// تأكد_يساوي(جمع(٢، ٣)، ٥)
صدّر دالة تأكد_يساوي(فعلي: عدد، متوقع: عدد) {
    إذا (فعلي != متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "القيمة الفعلية (" + عدد_لنص(فعلي) + ") لا تساوي المتوقعة (" + عدد_لنص(متوقع) + ")"،
            عدد_لنص(متوقع)،
            عدد_لنص(فعلي)،
            "تأكد_يساوي"
        )
    }
}

/// تأكد من تساوي نصين
///
/// @معامل فعلي - النص الفعلي
/// @معامل متوقع - النص المتوقع
/// @مثال
/// تأكد_يساوي_نص(اسم، "أحمد")
صدّر دالة تأكد_يساوي_نص(فعلي: نص، متوقع: نص) {
    إذا (فعلي != متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "النص الفعلي (\"" + فعلي + "\") لا يساوي المتوقع (\"" + متوقع + "\")"،
            متوقع،
            فعلي،
            "تأكد_يساوي_نص"
        )
    }
}

/// تأكد من تساوي قيمتين عشريتين
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل متوقع - القيمة المتوقعة
صدّر دالة تأكد_يساوي_عشري(فعلي: عدد_عشري، متوقع: عدد_عشري) {
    إذا (فعلي != متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "القيمة الفعلية لا تساوي المتوقعة"،
            عشري_لنص(متوقع)،
            عشري_لنص(فعلي)،
            "تأكد_يساوي_عشري"
        )
    }
}

/// تأكد من تساوي قيمتين عشريتين تقريباً
///
/// يستخدم للمقارنة بين الأعداد العشرية مع هامش خطأ
///
/// @معامل فعلي - القيمة الفعلية
/// @معامل متوقع - القيمة المتوقعة
/// @معامل دقة - هامش الخطأ المسموح (مثل ٠.٠٠١)
/// @مثال
/// تأكد_يساوي_تقريباً(٣.١٤١٥٩، ٣.١٤، ٠.٠١)
صدّر دالة تأكد_يساوي_تقريباً(فعلي: عدد_عشري، متوقع: عدد_عشري، دقة: عدد_عشري) {
    متغير فرق = فعلي - متوقع
    إذا (فرق < 0.0) {
        فرق = 0.0 - فرق
    }
    إذا (فرق > دقة) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "القيمة الفعلية ليست قريبة كفاية من المتوقعة (الفرق: " + عشري_لنص(فرق) + ")"،
            عشري_لنص(متوقع) + " ± " + عشري_لنص(دقة)،
            عشري_لنص(فعلي)،
            "تأكد_يساوي_تقريباً"
        )
    }
}

/// تأكد من عدم تساوي قيمتين
///
/// @معامل فعلي - القيمة الأولى
/// @معامل غير_متوقع - القيمة التي لا يجب أن تتساوى معها
/// @مثال
/// تأكد_لا_يساوي(س، ٠)
صدّر دالة تأكد_لا_يساوي(فعلي: عدد، غير_متوقع: عدد) {
    إذا (فعلي == غير_متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "القيمة الفعلية (" + عدد_لنص(فعلي) + ") تساوي القيمة غير المتوقعة"،
            "أي قيمة غير " + عدد_لنص(غير_متوقع)،
            عدد_لنص(فعلي)،
            "تأكد_لا_يساوي"
        )
    }
}

/// تأكد من عدم تساوي نصين
///
/// @معامل فعلي - النص الأول
/// @معامل غير_متوقع - النص الذي لا يجب أن يتساوى معه
صدّر دالة تأكد_لا_يساوي_نص(فعلي: نص، غير_متوقع: نص) {
    إذا (فعلي == غير_متوقع) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "النص الفعلي يساوي النص غير المتوقع"،
            "أي نص غير \"" + غير_متوقع + "\""،
            "\"" + فعلي + "\""،
            "تأكد_لا_يساوي_نص"
        )
    }
}

