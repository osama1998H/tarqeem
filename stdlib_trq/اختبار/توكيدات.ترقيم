// ═══════════════════════════════════════════

/// فشّل الاختبار فوراً
///
/// يستخدم لتعليم حالات يجب ألا تحدث
///
/// @معامل رسالة - سبب الفشل
/// @مثال
/// إذا (وصلنا_هنا) {
///     فشّل("لا يجب الوصول إلى هنا")
/// }
صدّر دالة فشّل(رسالة: نص) {
    ارمِ جديد خطأ_توكيد_مفصل(
        "فشل متعمد: " + رسالة،
        "لا فشل"،
        "فشل"،
        "فشّل"
    )
}

/// تخطّ الاختبار
///
/// يستخدم لتعليم اختبارات غير جاهزة للتنفيذ
///
/// @معامل سبب - سبب التخطي
صدّر دالة تخطّ(سبب: نص) {
    ارمِ جديد خطأ_تخطي(سبب)
}

/// صنف خطأ التخطي
///
/// يُستخدم داخلياً للإشارة إلى أن الاختبار تم تخطيه
صدّر صنف خطأ_تخطي يرث خطأ_تأكيد {
    /// سبب التخطي
    عام سبب: نص

    /// المنشئ
    منشئ(سبب: نص) {
        الأصل("تم تخطي الاختبار: " + سبب)
        هذا.سبب = سبب
    }
}
