/// تأكد من أن النص فارغ
///
/// @معامل النص - النص المراد فحصه
صدّر دالة تأكد_نص_فارغ(النص: نص) {
    إذا (طول(النص) > 0) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت نصاً فارغاً"،
            "\"\""،
            "\"" + النص + "\""،
            "تأكد_نص_فارغ"
        )
    }
}

/// تأكد من أن النص غير فارغ
///
/// @معامل النص - النص المراد فحصه
صدّر دالة تأكد_نص_غير_فارغ(النص: نص) {
    إذا (طول(النص) == 0) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "توقعت نصاً غير فارغ"،
            "نص غير فارغ"،
            "\"\""،
            "تأكد_نص_غير_فارغ"
        )
    }
}

/// تأكد من أن النص يحتوي على نص آخر
///
/// @معامل النص - النص الأساسي
/// @معامل جزء - الجزء المطلوب البحث عنه
صدّر دالة تأكد_يحتوي_نص(النص: نص، جزء: نص) {
    إذا (!نص_يحتوي(النص، جزء)) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "النص لا يحتوي على الجزء المطلوب"،
            "نص يحتوي على \"" + جزء + "\""،
            "\"" + النص + "\""،
            "تأكد_يحتوي_نص"
        )
    }
}

/// تأكد من أن النص يبدأ بنص معين
///
/// @معامل النص - النص الأساسي
/// @معامل بادئة - البادئة المتوقعة
صدّر دالة تأكد_يبدأ_بـ(النص: نص، بادئة: نص) {
    إذا (!نص_يبدأ_بـ(النص، بادئة)) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "النص لا يبدأ بالبادئة المطلوبة"،
            "نص يبدأ بـ \"" + بادئة + "\""،
            "\"" + النص + "\""،
            "تأكد_يبدأ_بـ"
        )
    }
}

/// تأكد من أن النص ينتهي بنص معين
///
/// @معامل النص - النص الأساسي
/// @معامل لاحقة - اللاحقة المتوقعة
صدّر دالة تأكد_ينتهي_بـ(النص: نص، لاحقة: نص) {
    إذا (!نص_ينتهي_بـ(النص، لاحقة)) {
        ارمِ جديد خطأ_توكيد_مفصل(
            "النص لا ينتهي باللاحقة المطلوبة"،
            "نص ينتهي بـ \"" + لاحقة + "\""،
            "\"" + النص + "\""،
            "تأكد_ينتهي_بـ"
        )
    }
}

