/// دوال التوكيد للاختبارات
///
/// توفر هذه الوحدة مجموعة شاملة من دوال التأكد للتحقق من صحة النتائج
/// في الاختبارات. تتبع مبدأ الوضوح والتوصيف الدقيق.
///
/// @منذ ١.٠.٠

// استيراد أصناف الأخطاء
استورد { خطأ_تأكيد } من "أخطاء"

// ═══════════════════════════════════════════
// صنف خطأ التوكيد المفصّل
// ═══════════════════════════════════════════

/// خطأ توكيد مع تفاصيل المقارنة
///
/// يوفر معلومات تفصيلية عن سبب فشل التوكيد
/// بما في ذلك القيمة المتوقعة والقيمة الفعلية
صدّر صنف خطأ_توكيد_مفصل يرث خطأ_تأكيد {
    /// القيمة المتوقعة كنص
    عام متوقع: نص

    /// القيمة الفعلية كنص
    عام فعلي: نص

    /// نوع التوكيد الذي فشل
    عام نوع_التوكيد: نص

    /// المنشئ الأساسي
    ///
    /// @معامل رسالة - رسالة الخطأ
    /// @معامل متوقع - القيمة المتوقعة
    /// @معامل فعلي - القيمة الفعلية
    /// @معامل نوع - نوع التوكيد
    منشئ(رسالة: نص، متوقع: نص، فعلي: نص، نوع: نص) {
        الأصل(رسالة)
        هذا.متوقع = متوقع
        هذا.فعلي = فعلي
        هذا.نوع_التوكيد = نوع
    }
}

// ═══════════════════════════════════════════
// دوال التأكد الأساسية
// ═══════════════════════════════════════════

/// تأكد من صحة شرط
///
/// يرمي خطأ_تأكيد إذا كان الشرط خاطئاً
///
/// @معامل شرط - الشرط المطلوب تحققه
/// @معامل رسالة - رسالة الخطأ (اختياري)
/// @مثال
/// تأكد(س > ٠)
/// تأكد(قائمة.طول() > ٠، "القائمة لا يجب أن تكون فارغة")
صدّر دالة تأكد(شرط: منطقي، رسالة: نص) {
    إذا (!شرط) {
        ارمِ جديد خطأ_توكيد_مفصل(
            رسالة،
            "صحيح"،
            "خطأ"،
            "تأكد"
        )
    }
}

/// تأكد من صحة شرط (بدون رسالة)
///
/// @معامل شرط - الشرط المطلوب تحققه
صدّر دالة تأكد_بسيط(شرط: منطقي) {
    تأكد(شرط، "فشل التأكيد")
}

