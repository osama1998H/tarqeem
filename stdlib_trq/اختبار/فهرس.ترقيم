/// وحدة الاختبارات الرئيسية
///
/// توفر هذه الوحدة إطار عمل شامل للاختبارات بلغة ترقيم
/// يتضمن دوال التوكيد ونتائج الاختبارات ومشغّل الاختبارات
///
/// ## المبادئ التصميمية
///
/// يتبع إطار الاختبارات فلسفة ترقيم العربية:
/// - **الوصف لا الترجمة**: استخدام مصطلحات عربية أصيلة
/// - **الوضوح**: أسماء واضحة ومفهومة للعربي
/// - **الاكتمال الذاتي**: لا اختصارات غامضة
///
/// ## طريقة الاستخدام
///
/// ### تعريف الاختبارات
/// الاختبارات هي دوال تبدأ بـ `اختبار_`:
///
/// ```
/// دالة اختبار_الجمع() {
///     تأكد_يساوي(٢ + ٣، ٥)
/// }
/// ```
///
/// ### دوال التوكيد الأساسية
///
/// | الدالة | الغرض |
/// |--------|-------|
/// | `تأكد(شرط، رسالة)` | تأكد من صحة شرط |
/// | `تأكد_يساوي(فعلي، متوقع)` | تأكد من تساوي قيمتين |
/// | `تأكد_لا_يساوي(فعلي، غير_متوقع)` | تأكد من عدم التساوي |
/// | `تأكد_صحيح(قيمة)` | تأكد أن القيمة صحيحة |
/// | `تأكد_خاطئ(قيمة)` | تأكد أن القيمة خاطئة |
/// | `تأكد_أكبر_من(فعلي، حد)` | تأكد أن القيمة أكبر |
/// | `تأكد_أصغر_من(فعلي، حد)` | تأكد أن القيمة أصغر |
/// | `تأكد_ضمن_نطاق(فعلي، أدنى، أقصى)` | تأكد من القيمة ضمن نطاق |
///
/// ### مثال كامل
///
/// ```
/// استورد { تأكد_يساوي، تأكد_صحيح، تأكد_أكبر_من } من "اختبار"
///
/// دالة اختبار_الحاسبة() {
///     // اختبار الجمع
///     تأكد_يساوي(جمع(٢، ٣)، ٥)
///
///     // اختبار القيم الموجبة
///     تأكد_أكبر_من(احسب_عاملي(٥)، ٠)
///
///     // اختبار الحالات الخاصة
///     تأكد_يساوي(جمع(٠، ٠)، ٠)
/// }
/// ```
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// إعادة تصدير من الوحدات الفرعية
// ═══════════════════════════════════════════

// --- دوال التوكيد ---
صدّر { تأكد، تأكد_بسيط } من "اختبار/توكيدات"
صدّر { تأكد_يساوي، تأكد_يساوي_نص، تأكد_يساوي_عشري } من "اختبار/توكيدات"
صدّر { تأكد_يساوي_تقريباً } من "اختبار/توكيدات"
صدّر { تأكد_لا_يساوي، تأكد_لا_يساوي_نص } من "اختبار/توكيدات"
صدّر { تأكد_صحيح، تأكد_خاطئ } من "اختبار/توكيدات"
صدّر { تأكد_أكبر_من، تأكد_أكبر_أو_يساوي } من "اختبار/توكيدات"
صدّر { تأكد_أصغر_من، تأكد_أصغر_أو_يساوي } من "اختبار/توكيدات"
صدّر { تأكد_ضمن_نطاق } من "اختبار/توكيدات"
صدّر { تأكد_يحتوي_نص، تأكد_يبدأ_بـ، تأكد_ينتهي_بـ } من "اختبار/توكيدات"
صدّر { تأكد_نص_فارغ، تأكد_نص_غير_فارغ } من "اختبار/توكيدات"
صدّر { تأكد_مصفوفة_فارغة، تأكد_مصفوفة_غير_فارغة } من "اختبار/توكيدات"
صدّر { تأكد_طول_مصفوفة، تأكد_مصفوفة_تحتوي } من "اختبار/توكيدات"
صدّر { فشّل، تخطّ } من "اختبار/توكيدات"
صدّر { خطأ_توكيد_مفصل، خطأ_تخطي } من "اختبار/توكيدات"

// --- أنواع النتائج ---
صدّر { نتيجة_اختبار، ملخص_الاختبارات، معلومات_اختبار } من "اختبار/نتائج"

// --- المشغّل ---
صدّر { مجموعة_اختبارات، سياق_اختبار } من "اختبار/مشغل"
صدّر { اطبع_ترويسة، اطبع_نتيجة، اطبع_ملخص، اطبع_تقدم } من "اختبار/مشغل"
صدّر { بيانات_اختبار } من "اختبار/مشغل"
