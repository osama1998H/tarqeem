/// أنواع نتائج الاختبارات
///
/// توفر هذه الوحدة الأصناف والتعدادات لتمثيل نتائج الاختبارات
/// بما في ذلك النجاح والفشل والتخطي
///
/// @منذ ١.٠.٠

استورد { خطأ_توكيد_مفصل، خطأ_تخطي } من "اختبار/توكيدات"

// ═══════════════════════════════════════════
// حالات الاختبار
// ═══════════════════════════════════════════

/// تعداد حالات نتيجة الاختبار
///
/// يمثل الحالات المختلفة التي يمكن أن ينتهي بها اختبار
تعداد حالة_الاختبار {
    /// الاختبار نجح
    نجح،
    /// الاختبار فشل
    فشل،
    /// تم تخطي الاختبار
    تُخُطِّي،
    /// حدث خطأ غير متوقع
    خطأ
}

// ═══════════════════════════════════════════
// صنف نتيجة الاختبار
// ═══════════════════════════════════════════

/// نتيجة اختبار واحد
///
/// يحتوي على جميع المعلومات حول نتيجة تشغيل اختبار واحد
///
/// @مثال
/// متغير نتيجة = جديد نتيجة_اختبار("اختبار_الجمع")
/// نتيجة.سجّل_نجاح()
صدّر صنف نتيجة_اختبار {
    /// اسم الاختبار
    عام اسم: نص

    /// حالة الاختبار
    عام حالة: عدد

    /// رسالة الخطأ (إن وجدت)
    عام رسالة_الخطأ: نص

    /// القيمة المتوقعة (عند الفشل)
    عام متوقع: نص

    /// القيمة الفعلية (عند الفشل)
    عام فعلي: نص

    /// مدة التنفيذ بالميلي ثانية
    عام مدة_ميلي: عدد

    /// المنشئ
    ///
    /// @معامل اسم - اسم الاختبار
    منشئ(اسم: نص) {
        هذا.اسم = اسم
        هذا.حالة = 0  // في الانتظار
        هذا.رسالة_الخطأ = ""
        هذا.متوقع = ""
        هذا.فعلي = ""
        هذا.مدة_ميلي = 0
    }

    /// سجّل نجاح الاختبار
    ///
    /// @معامل مدة - مدة التنفيذ بالميلي ثانية
    عام دالة سجّل_نجاح(مدة: عدد) {
        هذا.حالة = 1  // نجح
        هذا.مدة_ميلي = مدة
    }

    /// سجّل فشل الاختبار
    ///
    /// @معامل خطأ - خطأ التوكيد
    /// @معامل مدة - مدة التنفيذ
    عام دالة سجّل_فشل(رسالة: نص، متوقع: نص، فعلي: نص، مدة: عدد) {
        هذا.حالة = 2  // فشل
        هذا.رسالة_الخطأ = رسالة
        هذا.متوقع = متوقع
        هذا.فعلي = فعلي
        هذا.مدة_ميلي = مدة
    }

    /// سجّل تخطي الاختبار
    ///
    /// @معامل سبب - سبب التخطي
    عام دالة سجّل_تخطي(سبب: نص) {
        هذا.حالة = 3  // تُخُطِّي
        هذا.رسالة_الخطأ = سبب
    }

    /// سجّل خطأ غير متوقع
    ///
    /// @معامل رسالة - رسالة الخطأ
    /// @معامل مدة - مدة التنفيذ
    عام دالة سجّل_خطأ(رسالة: نص، مدة: عدد) {
        هذا.حالة = 4  // خطأ
        هذا.رسالة_الخطأ = رسالة
        هذا.مدة_ميلي = مدة
    }

    /// تحقق إذا نجح الاختبار
    عام دالة نجح() -> منطقي {
        أرجع هذا.حالة == 1
    }

    /// تحقق إذا فشل الاختبار
    عام دالة فشل() -> منطقي {
        أرجع هذا.حالة == 2
    }

    /// تحقق إذا تم تخطي الاختبار
    عام دالة تُخُطِّي() -> منطقي {
        أرجع هذا.حالة == 3
    }

    /// أحصل على رمز الحالة
    عام دالة رمز_الحالة() -> نص {
        تطابق (هذا.حالة) {
            حالة 1 => أرجع "✓"
            حالة 2 => أرجع "✗"
            حالة 3 => أرجع "○"
            حالة 4 => أرجع "!"
            غير_ذلك => أرجع "?"
        }
    }

    /// أحصل على وصف الحالة
    عام دالة وصف_الحالة() -> نص {
        تطابق (هذا.حالة) {
            حالة 1 => أرجع "نجح"
            حالة 2 => أرجع "فشل"
            حالة 3 => أرجع "تُخُطِّي"
            حالة 4 => أرجع "خطأ"
            غير_ذلك => أرجع "في الانتظار"
        }
    }
}

// ═══════════════════════════════════════════
// صنف ملخص الاختبارات
// ═══════════════════════════════════════════

/// ملخص نتائج مجموعة اختبارات
///
/// يجمع إحصائيات عن جميع الاختبارات المُشغَّلة
صدّر صنف ملخص_الاختبارات {
    /// اسم مجموعة الاختبارات
    عام اسم: نص

    /// إجمالي عدد الاختبارات
    عام إجمالي: عدد

    /// عدد الاختبارات الناجحة
    عام ناجحة: عدد

    /// عدد الاختبارات الفاشلة
    عام فاشلة: عدد

    /// عدد الاختبارات المتخطاة
    عام متخطاة: عدد

    /// عدد الاختبارات التي واجهت أخطاء
    عام أخطاء: عدد

    /// إجمالي وقت التنفيذ بالميلي ثانية
    عام إجمالي_الوقت: عدد

    /// قائمة نتائج الاختبارات الفردية
    عام نتائج: مصفوفة<نتيجة_اختبار>

    /// المنشئ
    ///
    /// @معامل اسم - اسم مجموعة الاختبارات
    منشئ(اسم: نص) {
        هذا.اسم = اسم
        هذا.إجمالي = 0
        هذا.ناجحة = 0
        هذا.فاشلة = 0
        هذا.متخطاة = 0
        هذا.أخطاء = 0
        هذا.إجمالي_الوقت = 0
        هذا.نتائج = []
    }

    /// أضف نتيجة اختبار
    ///
    /// @معامل نتيجة - نتيجة الاختبار
    عام دالة أضف(نتيجة: نتيجة_اختبار) {
        هذا.نتائج.ألحق(نتيجة)
        هذا.إجمالي = هذا.إجمالي + 1
        هذا.إجمالي_الوقت = هذا.إجمالي_الوقت + نتيجة.مدة_ميلي

        تطابق (نتيجة.حالة) {
            حالة 1 => هذا.ناجحة = هذا.ناجحة + 1
            حالة 2 => هذا.فاشلة = هذا.فاشلة + 1
            حالة 3 => هذا.متخطاة = هذا.متخطاة + 1
            حالة 4 => هذا.أخطاء = هذا.أخطاء + 1
            غير_ذلك => { }
        }
    }

    /// تحقق إذا نجحت جميع الاختبارات
    عام دالة كل_ناجح() -> منطقي {
        أرجع هذا.فاشلة == 0 و هذا.أخطاء == 0
    }

    /// أحصل على نسبة النجاح (٠ إلى ١٠٠)
    عام دالة نسبة_النجاح() -> عدد {
        إذا (هذا.إجمالي == 0) {
            أرجع 100
        }
        أرجع (هذا.ناجحة * 100) / هذا.إجمالي
    }

    /// أحصل على الاختبارات الفاشلة فقط
    عام دالة الفاشلة() -> مصفوفة<نتيجة_اختبار> {
        متغير فاشلة: مصفوفة<نتيجة_اختبار> = []
        لكل نتيجة في هذا.نتائج {
            إذا (نتيجة.فشل()) {
                فاشلة.ألحق(نتيجة)
            }
        }
        أرجع فاشلة
    }
}

// ═══════════════════════════════════════════
// صنف معلومات الاختبار
// ═══════════════════════════════════════════

/// معلومات تعريفية عن اختبار
///
/// يحتوي على البيانات الوصفية للاختبار قبل تشغيله
صدّر صنف معلومات_اختبار {
    /// اسم الاختبار
    عام اسم: نص

    /// وصف الاختبار
    عام وصف: نص

    /// هل هو اختبار متوقع فشله
    عام متوقع_الفشل: منطقي

    /// هل يجب تخطيه
    عام يُتخطى: منطقي

    /// سبب التخطي (إن وجد)
    عام سبب_التخطي: نص

    /// المنشئ الأساسي
    ///
    /// @معامل اسم - اسم الاختبار
    منشئ(اسم: نص) {
        هذا.اسم = اسم
        هذا.وصف = ""
        هذا.متوقع_الفشل = خطأ
        هذا.يُتخطى = خطأ
        هذا.سبب_التخطي = ""
    }

    /// المنشئ مع الوصف
    ///
    /// @معامل اسم - اسم الاختبار
    /// @معامل وصف - وصف الاختبار
    منشئ_مع_وصف(اسم: نص، وصف: نص) {
        هذا.اسم = اسم
        هذا.وصف = وصف
        هذا.متوقع_الفشل = خطأ
        هذا.يُتخطى = خطأ
        هذا.سبب_التخطي = ""
    }

    /// علّم الاختبار للتخطي
    ///
    /// @معامل سبب - سبب التخطي
    عام دالة تخطّ(سبب: نص) {
        هذا.يُتخطى = صحيح
        هذا.سبب_التخطي = سبب
    }

    /// علّم الاختبار كمتوقع الفشل
    عام دالة توقع_الفشل() {
        هذا.متوقع_الفشل = صحيح
    }
}

الحمد_لله
