/// الدوال الرياضية الأساسية
///
/// تحتوي هذه الوحدة على الدوال الرياضية الأساسية
/// مثل القيمة المطلقة والقوى والجذور والتقريب

// ═══════════════════════════════════════════
// القيمة المطلقة والعلامة
// ═══════════════════════════════════════════

/// القيمة المطلقة لعدد صحيح
///
/// @معامل س - العدد المدخل
/// @أرجع القيمة المطلقة (دائماً موجبة)
/// @مثال
/// اطبع(مطلق(-٥))  // ٥
/// اطبع(مطلق(٣))   // ٣
صدّر دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

/// القيمة المطلقة لعدد عشري
///
/// @معامل س - العدد العشري المدخل
/// @أرجع القيمة المطلقة
صدّر دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع -س
    }
    أرجع س
}

/// دالة العلامة
///
/// @معامل س - العدد المدخل
/// @أرجع -١ إذا سالب، ٠ إذا صفر، ١ إذا موجب
/// @مثال
/// اطبع(علامة(-١٠))  // -١
/// اطبع(علامة(٠))    // ٠
/// اطبع(علامة(٥))    // ١
صدّر دالة علامة(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -1
    }
    إذا (س > 0) {
        أرجع 1
    }
    أرجع 0
}

// ═══════════════════════════════════════════
// القوى والجذور
// ═══════════════════════════════════════════

/// دالة القوة (أساس وأس صحيحين)
///
/// @معامل أساس - الأساس
/// @معامل أس - الأس
/// @أرجع الأساس مرفوعاً للأس
/// @مثال
/// اطبع(قوة(٢، ٣))  // ٨
/// اطبع(قوة(٥، ٢))  // ٢٥
صدّر دالة قوة(أساس: عدد، أس: عدد) -> عدد {
    أرجع pow(أساس، أس)
}

/// دالة القوة (أساس وأس عشريين)
///
/// @معامل أساس - الأساس
/// @معامل أس - الأس
/// @أرجع الأساس مرفوعاً للأس
صدّر دالة قوة_عشري(أساس: عدد_عشري، أس: عدد_عشري) -> عدد_عشري {
    أرجع pow(أساس، أس)
}

/// الجذر التربيعي
///
/// @معامل س - العدد المدخل (يجب أن يكون غير سالب)
/// @أرجع الجذر التربيعي
/// @مثال
/// اطبع(جذر(٩.٠))   // ٣.٠
/// اطبع(جذر(٢.٠))   // ١.٤١٤...
صدّر دالة جذر(س: عدد_عشري) -> عدد_عشري {
    أرجع sqrt(س)
}

/// الجذر التكعيبي
///
/// @معامل س - العدد المدخل
/// @أرجع الجذر التكعيبي
/// @مثال
/// اطبع(جذر_تكعيبي(٢٧.٠))  // ٣.٠
/// اطبع(جذر_تكعيبي(٨.٠))   // ٢.٠
صدّر دالة جذر_تكعيبي(س: عدد_عشري) -> عدد_عشري {
    أرجع cbrt(س)
}

/// الجذر النوني
///
/// @معامل س - العدد المدخل
/// @معامل ن - درجة الجذر
/// @أرجع الجذر من الدرجة ن
صدّر دالة جذر_ن(س: عدد_عشري، ن: عدد) -> عدد_عشري {
    أرجع pow(س، 1.0 / ن)
}

// ═══════════════════════════════════════════
// اللوغاريتمات والأُسية
// ═══════════════════════════════════════════

/// اللوغاريتم الطبيعي
///
/// @معامل س - العدد المدخل (يجب أن يكون موجباً)
/// @أرجع اللوغاريتم الطبيعي (أساس هـ)
صدّر دالة لوغاريتم(س: عدد_عشري) -> عدد_عشري {
    أرجع log(س)
}

/// اللوغاريتم العشري
///
/// @معامل س - العدد المدخل (يجب أن يكون موجباً)
/// @أرجع اللوغاريتم أساس ١٠
صدّر دالة لوغاريتم10(س: عدد_عشري) -> عدد_عشري {
    أرجع log10(س)
}

/// لوغاريتم أساس ٢
///
/// @معامل س - العدد المدخل (يجب أن يكون موجباً)
/// @أرجع اللوغاريتم أساس ٢
صدّر دالة لوغاريتم2(س: عدد_عشري) -> عدد_عشري {
    أرجع log2(س)
}

/// الدالة الأُسية (هـ^س)
///
/// @معامل س - الأس
/// @أرجع هـ مرفوعاً للأس س
صدّر دالة اس(س: عدد_عشري) -> عدد_عشري {
    أرجع exp(س)
}

// ═══════════════════════════════════════════
// التقريب
// ═══════════════════════════════════════════

/// الأرضية - أكبر عدد صحيح أقل من أو يساوي س
///
/// @معامل س - العدد العشري المدخل
/// @أرجع أكبر عدد صحيح <= س
/// @مثال
/// اطبع(ارضية(٣.٧))   // ٣
/// اطبع(ارضية(-٢.٣))  // -٣
صدّر دالة ارضية(س: عدد_عشري) -> عدد {
    أرجع floor(س)
}

/// السقف - أصغر عدد صحيح أكبر من أو يساوي س
///
/// @معامل س - العدد العشري المدخل
/// @أرجع أصغر عدد صحيح >= س
/// @مثال
/// اطبع(سقف(٣.٢))   // ٤
/// اطبع(سقف(-٢.٧))  // -٢
صدّر دالة سقف(س: عدد_عشري) -> عدد {
    أرجع ceil(س)
}

/// التقريب لأقرب عدد صحيح
///
/// @معامل س - العدد العشري المدخل
/// @أرجع أقرب عدد صحيح
/// @مثال
/// اطبع(قرّب(٣.٤))  // ٣
/// اطبع(قرّب(٣.٦))  // ٤
صدّر دالة قرّب(س: عدد_عشري) -> عدد {
    أرجع round(س)
}

/// اقتطاع نحو الصفر
///
/// @معامل س - العدد العشري المدخل
/// @أرجع الجزء الصحيح فقط
/// @مثال
/// اطبع(اقطع(٣.٩))   // ٣
/// اطبع(اقطع(-٣.٩))  // -٣
صدّر دالة اقطع(س: عدد_عشري) -> عدد {
    أرجع trunc(س)
}

// ═══════════════════════════════════════════
// الأقل والأقصى والحصر
// ═══════════════════════════════════════════

/// الأقل بين عددين صحيحين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأصغر بينهما
صدّر دالة اقل(أ: عدد، ب: عدد) -> عدد {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقصى بين عددين صحيحين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأكبر بينهما
صدّر دالة اكبر(أ: عدد، ب: عدد) -> عدد {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقل بين عددين عشريين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأصغر بينهما
صدّر دالة اقل_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقصى بين عددين عشريين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأكبر بينهما
صدّر دالة اكبر_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// حصر عدد صحيح في نطاق
///
/// @معامل س - العدد المدخل
/// @معامل ادنى - الحد الأدنى
/// @معامل اقصى - الحد الأقصى
/// @أرجع س محصوراً في النطاق [أدنى، أقصى]
/// @مثال
/// اطبع(حصر(١٥، ٠، ١٠))  // ١٠
/// اطبع(حصر(-٥، ٠، ١٠))  // ٠
/// اطبع(حصر(٥، ٠، ١٠))   // ٥
صدّر دالة حصر(س: عدد، ادنى: عدد، اقصى: عدد) -> عدد {
    إذا (س < ادنى) {
        أرجع ادنى
    }
    إذا (س > اقصى) {
        أرجع اقصى
    }
    أرجع س
}

/// حصر عدد عشري في نطاق
///
/// @معامل س - العدد المدخل
/// @معامل ادنى - الحد الأدنى
/// @معامل اقصى - الحد الأقصى
/// @أرجع س محصوراً في النطاق
صدّر دالة حصر_عشري(س: عدد_عشري، ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
    إذا (س < ادنى) {
        أرجع ادنى
    }
    إذا (س > اقصى) {
        أرجع اقصى
    }
    أرجع س
}

// ═══════════════════════════════════════════
// القسمة والباقي
// ═══════════════════════════════════════════

/// باقي القسمة الصحيحة
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع باقي قسمة أ على ب
صدّر دالة باقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب
}

/// القسمة الصحيحة
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع ناتج قسمة أ على ب (بدون الكسر)
صدّر دالة قسمة_صحيحة(أ: عدد، ب: عدد) -> عدد {
    أرجع أ / ب
}

/// باقي إقليدس (دائماً موجب)
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع الباقي الإقليدي (٠ <= الناتج < |ب|)
صدّر دالة باقي_موجب(أ: عدد، ب: عدد) -> عدد {
    متغير ن = أ % ب
    إذا (ن < 0) {
        أرجع ن + مطلق(ب)
    }
    أرجع ن
}

// ═══════════════════════════════════════════
// نظرية الأعداد
// ═══════════════════════════════════════════

/// القاسم المشترك الأكبر
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع أكبر عدد يقسم كليهما
/// @مثال
/// اطبع(قاسم_مشترك(١٢، ٨))  // ٤
صدّر دالة قاسم_مشترك(أ: عدد، ب: عدد) -> عدد {
    أرجع gcd(أ، ب)
}

/// المضاعف المشترك الأصغر
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع أصغر عدد يقبل القسمة على كليهما
/// @مثال
/// اطبع(مضاعف_مشترك(٤، ٦))  // ١٢
صدّر دالة مضاعف_مشترك(أ: عدد، ب: عدد) -> عدد {
    أرجع lcm(أ، ب)
}

/// العاملي (ن!)
///
/// @معامل ن - العدد المدخل (يجب أن يكون غير سالب)
/// @أرجع ن عاملي (ن × (ن-١) × ... × ٢ × ١)
/// @مثال
/// اطبع(عاملي(٥))  // ١٢٠
صدّر دالة عاملي(ن: عدد) -> عدد {
    أرجع factorial(ن)
}

/// تحقق إذا العدد زوجي
///
/// @معامل س - العدد المدخل
/// @أرجع صحيح إذا كان العدد زوجياً
صدّر دالة زوجي(س: عدد) -> منطقي {
    أرجع س % 2 == 0
}

/// تحقق إذا العدد فردي
///
/// @معامل س - العدد المدخل
/// @أرجع صحيح إذا كان العدد فردياً
صدّر دالة فردي(س: عدد) -> منطقي {
    أرجع س % 2 != 0
}

/// تحقق إذا العدد أولي
///
/// @معامل ن - العدد المدخل
/// @أرجع صحيح إذا كان العدد أولياً
/// @مثال
/// اطبع(اولي(٧))   // صحيح
/// اطبع(اولي(١٠))  // خطأ
صدّر دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) {
        أرجع خطأ
    }
    إذا (ن <= 3) {
        أرجع صحيح
    }
    إذا (ن % 2 == 0 || ن % 3 == 0) {
        أرجع خطأ
    }
    متغير ع = 5
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0 || ن % (ع + 2) == 0) {
            أرجع خطأ
        }
        ع = ع + 6
    }
    أرجع صحيح
}

// ═══════════════════════════════════════════
// أسماء مستعارة
// ═══════════════════════════════════════════

/// أدنى - اسم مستعار لـ اقل
صدّر دالة أدنى(أ: عدد، ب: عدد) -> عدد {
    أرجع اقل(أ، ب)
}

/// أقصى - اسم مستعار لـ اكبر
صدّر دالة أقصى(أ: عدد، ب: عدد) -> عدد {
    أرجع اكبر(أ، ب)
}

