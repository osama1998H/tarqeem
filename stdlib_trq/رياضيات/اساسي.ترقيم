/// الدوال الرياضية الأساسية
///
/// تحتوي هذه الوحدة على الدوال الرياضية الأساسية
/// مثل القيمة المطلقة والقوى والجذور والتقريب
///
/// @ملاحظة الأسماء «جذر» و«جذر_تكعيبي» و«لوغاريتم» و«لوغاريتم10» و«سقف»
/// و«قرّب» و«قوة» يوفرها وقت التشغيل مباشرة بالاسم نفسه، فلا تُعرَّف هنا:
/// غلاف بالاسم ذاته يستدعي نفسه لا وقت التشغيل. تصل هذه الأسماء بالاستيراد
/// من «رياضيات» — أي `استورد { جذر } من "رياضيات"` — لا باستيراد هذا الملف
/// بمساره.

استورد { قوة، قوة_عدد، أرضية، اقتطع، لوغ2، أس } من "رياضيات"

// ═══════════════════════════════════════════
// القيمة المطلقة والعلامة
// ═══════════════════════════════════════════

/// القيمة المطلقة لعدد صحيح
///
/// @معامل س - العدد المدخل
/// @أرجع القيمة المطلقة (دائماً موجبة)
/// @مثال
/// اطبع(مطلق(-٥))  // ٥
/// اطبع(مطلق(٣))   // ٣
صدّر دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

/// القيمة المطلقة لعدد عشري
///
/// @معامل س - العدد العشري المدخل
/// @أرجع القيمة المطلقة
صدّر دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع -س
    }
    أرجع س
}

/// دالة العلامة
///
/// @معامل س - العدد المدخل
/// @أرجع -١ إذا سالب، ٠ إذا صفر، ١ إذا موجب
/// @مثال
/// اطبع(علامة(-١٠))  // -١
/// اطبع(علامة(٠))    // ٠
/// اطبع(علامة(٥))    // ١
صدّر دالة علامة(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -1
    }
    إذا (س > 0) {
        أرجع 1
    }
    أرجع 0
}

// ═══════════════════════════════════════════
// القوى والجذور
// ═══════════════════════════════════════════

/// دالة القوة للأعداد الصحيحة
///
/// @معامل أساس - الأساس
/// @معامل أس - الأس
/// @أرجع الأساس مرفوعاً للأس
/// @مثال
/// اطبع(قوة_صحيح(٢، ٣))  // ٨
/// اطبع(قوة_صحيح(٥، ٢))  // ٢٥
صدّر دالة قوة_صحيح(أساس: عدد، أس: عدد) -> عدد {
    أرجع قوة_عدد(أساس، أس)
}

/// دالة القوة (أساس وأس عشريين)
///
/// @معامل أساس - الأساس
/// @معامل أس - الأس
/// @أرجع الأساس مرفوعاً للأس
صدّر دالة قوة_عشري(أساس: عدد_عشري، أس: عدد_عشري) -> عدد_عشري {
    أرجع قوة(أساس، أس)
}

/// الجذر النوني
///
/// @معامل س - العدد المدخل
/// @معامل ن - درجة الجذر
/// @أرجع الجذر من الدرجة ن
صدّر دالة جذر_ن(س: عدد_عشري، ن: عدد) -> عدد_عشري {
    أرجع قوة(س، 1.0 / ن)
}

// ═══════════════════════════════════════════
// اللوغاريتمات والأُسية
// ═══════════════════════════════════════════

/// لوغاريتم أساس ٢
///
/// @معامل س - العدد المدخل (يجب أن يكون موجباً)
/// @أرجع اللوغاريتم أساس ٢
صدّر دالة لوغاريتم2(س: عدد_عشري) -> عدد_عشري {
    أرجع لوغ2(س)
}

/// الدالة الأُسية (هـ^س)
///
/// @معامل س - الأس
/// @أرجع هـ مرفوعاً للأس س
صدّر دالة اس(س: عدد_عشري) -> عدد_عشري {
    أرجع أس(س)
}

// ═══════════════════════════════════════════
// التقريب
// ═══════════════════════════════════════════

/// الأرضية - أكبر عدد صحيح أقل من أو يساوي س
///
/// @معامل س - العدد العشري المدخل
/// @أرجع أكبر عدد صحيح <= س
/// @مثال
/// اطبع(ارضية(٣.٧))   // ٣
/// اطبع(ارضية(-٢.٣))  // -٣
صدّر دالة ارضية(س: عدد_عشري) -> عدد {
    أرجع عدد(أرضية(س))
}

/// اقتطاع نحو الصفر
///
/// @معامل س - العدد العشري المدخل
/// @أرجع الجزء الصحيح فقط
/// @مثال
/// اطبع(اقطع(٣.٩))   // ٣
/// اطبع(اقطع(-٣.٩))  // -٣
صدّر دالة اقطع(س: عدد_عشري) -> عدد {
    أرجع عدد(اقتطع(س))
}

// ═══════════════════════════════════════════
// الأقل والأقصى والحصر
// ═══════════════════════════════════════════

/// الأقل بين عددين صحيحين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأصغر بينهما
صدّر دالة اقل(أ: عدد، ب: عدد) -> عدد {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقصى بين عددين صحيحين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأكبر بينهما
صدّر دالة اكبر(أ: عدد، ب: عدد) -> عدد {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقل بين عددين عشريين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأصغر بينهما
صدّر دالة اقل_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأقصى بين عددين عشريين
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع الأكبر بينهما
صدّر دالة اكبر_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// حصر عدد صحيح في نطاق
///
/// @معامل س - العدد المدخل
/// @معامل ادنى - الحد الأدنى
/// @معامل اقصى - الحد الأقصى
/// @أرجع س محصوراً في النطاق [أدنى، أقصى]
/// @مثال
/// اطبع(حصر(١٥، ٠، ١٠))  // ١٠
/// اطبع(حصر(-٥، ٠، ١٠))  // ٠
/// اطبع(حصر(٥، ٠، ١٠))   // ٥
صدّر دالة حصر(س: عدد، ادنى: عدد، اقصى: عدد) -> عدد {
    إذا (س < ادنى) {
        أرجع ادنى
    }
    إذا (س > اقصى) {
        أرجع اقصى
    }
    أرجع س
}

/// حصر عدد عشري في نطاق
///
/// @معامل س - العدد المدخل
/// @معامل ادنى - الحد الأدنى
/// @معامل اقصى - الحد الأقصى
/// @أرجع س محصوراً في النطاق
صدّر دالة حصر_عشري(س: عدد_عشري، ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
    إذا (س < ادنى) {
        أرجع ادنى
    }
    إذا (س > اقصى) {
        أرجع اقصى
    }
    أرجع س
}

// ═══════════════════════════════════════════
// القسمة والباقي
// ═══════════════════════════════════════════

/// باقي القسمة الصحيحة
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع باقي قسمة أ على ب
صدّر دالة باقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب
}

/// القسمة الصحيحة
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع ناتج قسمة أ على ب (بدون الكسر)
صدّر دالة قسمة_صحيحة(أ: عدد، ب: عدد) -> عدد {
    أرجع أ / ب
}

/// باقي إقليدس (دائماً موجب)
///
/// @معامل أ - المقسوم
/// @معامل ب - المقسوم عليه
/// @أرجع الباقي الإقليدي (٠ <= الناتج < |ب|)
صدّر دالة باقي_موجب(أ: عدد، ب: عدد) -> عدد {
    متغير ن = أ % ب
    إذا (ن < 0) {
        أرجع ن + مطلق(ب)
    }
    أرجع ن
}

// ═══════════════════════════════════════════
// نظرية الأعداد
// ═══════════════════════════════════════════

/// القاسم المشترك الأكبر
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع أكبر عدد يقسم كليهما
/// @مثال
/// اطبع(قاسم_مشترك(١٢، ٨))  // ٤
صدّر دالة قاسم_مشترك(أ: عدد، ب: عدد) -> عدد {
    متغير س = مطلق(أ)
    متغير ص = مطلق(ب)
    طالما (ص != 0) {
        متغير باقٍ = س % ص
        س = ص
        ص = باقٍ
    }
    أرجع س
}

/// المضاعف المشترك الأصغر
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @أرجع أصغر عدد يقبل القسمة على كليهما
/// @مثال
/// اطبع(مضاعف_مشترك(٤، ٦))  // ١٢
صدّر دالة مضاعف_مشترك(أ: عدد، ب: عدد) -> عدد {
    إذا (أ == 0 || ب == 0) {
        أرجع 0
    }
    أرجع مطلق(أ / قاسم_مشترك(أ، ب) * ب)
}

/// العاملي (ن!)
///
/// @معامل ن - العدد المدخل (يجب أن يكون غير سالب)
/// @أرجع ن عاملي (ن × (ن-١) × ... × ٢ × ١)
/// @مثال
/// اطبع(عاملي(٥))  // ١٢٠
صدّر دالة عاملي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }
    متغير نتيجة = 1
    لكل (متغير ع = 2؛ ع <= ن؛ ع++) {
        نتيجة = نتيجة * ع
    }
    أرجع نتيجة
}

/// تحقق إذا العدد زوجي
///
/// @معامل س - العدد المدخل
/// @أرجع صحيح إذا كان العدد زوجياً
صدّر دالة زوجي(س: عدد) -> منطقي {
    أرجع س % 2 == 0
}

/// تحقق إذا العدد فردي
///
/// @معامل س - العدد المدخل
/// @أرجع صحيح إذا كان العدد فردياً
صدّر دالة فردي(س: عدد) -> منطقي {
    أرجع س % 2 != 0
}

/// تحقق إذا العدد أولي
///
/// @معامل ن - العدد المدخل
/// @أرجع صحيح إذا كان العدد أولياً
/// @مثال
/// اطبع(اولي(٧))   // صحيح
/// اطبع(اولي(١٠))  // خطأ
صدّر دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) {
        أرجع خطأ
    }
    إذا (ن <= 3) {
        أرجع صحيح
    }
    إذا (ن % 2 == 0 || ن % 3 == 0) {
        أرجع خطأ
    }
    متغير ع = 5
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0 || ن % (ع + 2) == 0) {
            أرجع خطأ
        }
        ع = ع + 6
    }
    أرجع صحيح
}

// ═══════════════════════════════════════════
// أسماء مستعارة
// ═══════════════════════════════════════════

/// أدنى - اسم مستعار لـ اقل
صدّر دالة أدنى(أ: عدد، ب: عدد) -> عدد {
    أرجع اقل(أ، ب)
}

/// أقصى - اسم مستعار لـ اكبر
صدّر دالة أقصى(أ: عدد، ب: عدد) -> عدد {
    أرجع اكبر(أ، ب)
}

