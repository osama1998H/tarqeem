// =============================================================================
// Basic Trigonometric Functions / الدوال المثلثية الأساسية
// All angles are in radians / جميع الزوايا بالراديان
// =============================================================================

// Sine
// الجيب (جا)
صدّر دالة جا(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_sin
    أرجع __جا__(س)
}

// Cosine
// جيب التمام (جتا)
صدّر دالة جتا(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_cos
    أرجع __جتا__(س)
}

// Tangent
// الظل (ظا)
صدّر دالة ظا(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_tan
    أرجع __ظا__(س)
}

