// =============================================================================
// Inverse Trigonometric Functions / الدوال المثلثية العكسية
// Return values are in radians / القيم المرجعة بالراديان
// =============================================================================

// Arc sine (inverse sine)
// الجيب العكسي
صدّر دالة جا_عكسي(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_asin
    أرجع __جا_عكسي__(س)
}

// Arc cosine (inverse cosine)
// جيب التمام العكسي
صدّر دالة جتا_عكسي(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_acos
    أرجع __جتا_عكسي__(س)
}

// Arc tangent (inverse tangent)
// الظل العكسي
صدّر دالة ظا_عكسي(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_atan
    أرجع __ظا_عكسي__(س)
}

// Arc tangent of y/x (handles quadrants)
// الظل العكسي لـ ص/س (يعالج الأرباع)
صدّر دالة ظا_عكسي2(ص: عدد_عشري، س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_atan2
    أرجع __ظا_عكسي2__(ص، س)
}

