// =============================================================================
// Angle Conversion / تحويل الزوايا
// =============================================================================

// Convert degrees to radians
// تحويل الدرجات إلى راديان
صدّر دالة الى_راديان(درجات: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_to_radians
    أرجع __الى_راديان__(درجات)
}

// Convert radians to degrees
// تحويل الراديان إلى درجات
صدّر دالة الى_درجات(راديان: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_to_degrees
    أرجع __الى_درجات__(راديان)
}

// =============================================================================
// Convenience Functions with Degrees / دوال سهلة بالدرجات
// =============================================================================

// Sine in degrees
// الجيب بالدرجات
صدّر دالة جا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع جا(الى_راديان(درجات))
}

// Cosine in degrees
// جيب التمام بالدرجات
صدّر دالة جتا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع جتا(الى_راديان(درجات))
}

// Tangent in degrees
// الظل بالدرجات
صدّر دالة ظا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع ظا(الى_راديان(درجات))
}
