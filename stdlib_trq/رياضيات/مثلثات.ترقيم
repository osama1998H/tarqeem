/// الدوال المثلثية
///
/// تحتوي هذه الوحدة على جميع الدوال المثلثية الأساسية والعكسية والزائدية
///
/// @ملاحظة جميع الزوايا بالراديان ما لم يُذكر غير ذلك

// ═══════════════════════════════════════════
// الدوال المثلثية الأساسية
// ═══════════════════════════════════════════

/// الجيب (جا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع جيب الزاوية
/// @مثال
/// اطبع(جا(٠.٠))      // ٠.٠
/// اطبع(جا(باي/٢))    // ١.٠
صدّر دالة جا(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب(س)
}

/// جيب التمام (جتا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع جيب تمام الزاوية
/// @مثال
/// اطبع(جتا(٠.٠))    // ١.٠
/// اطبع(جتا(باي))    // -١.٠
صدّر دالة جتا(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب_التمام(س)
}

/// الظل (ظا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع ظل الزاوية
/// @تحذير غير معرف عند باي/٢ + ن×باي
صدّر دالة ظا(س: عدد_عشري) -> عدد_عشري {
    أرجع ظل(س)
}

/// ظل التمام (ظتا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع ظل تمام الزاوية
/// @تحذير غير معرف عند ن×باي
صدّر دالة ظتا(س: عدد_عشري) -> عدد_عشري {
    أرجع ظل_التمام(س)
}

/// القاطع (قا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع قاطع الزاوية (١/جتا)
صدّر دالة قا(س: عدد_عشري) -> عدد_عشري {
    أرجع قاطع(س)
}

/// قاطع التمام (قتا)
///
/// @معامل س - الزاوية بالراديان
/// @أرجع قاطع تمام الزاوية (١/جا)
صدّر دالة قتا(س: عدد_عشري) -> عدد_عشري {
    أرجع قاطع_التمام(س)
}

// ═══════════════════════════════════════════
// الدوال المثلثية العكسية
// ═══════════════════════════════════════════

/// الجيب العكسي
///
/// @معامل س - القيمة (يجب أن تكون بين -١ و ١)
/// @أرجع الزاوية بالراديان
صدّر دالة جا_عكسي(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب_عكسي(س)
}

/// جيب التمام العكسي
///
/// @معامل س - القيمة (يجب أن تكون بين -١ و ١)
/// @أرجع الزاوية بالراديان
صدّر دالة جتا_عكسي(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب_تمام_عكسي(س)
}

/// الظل العكسي
///
/// @معامل س - القيمة
/// @أرجع الزاوية بالراديان
صدّر دالة ظا_عكسي(س: عدد_عشري) -> عدد_عشري {
    أرجع ظل_عكسي(س)
}

/// الظل العكسي بإحداثيين
///
/// يحسب زاوية النقطة (س، ص) من المحور الموجب
/// ويعالج جميع الأرباع بشكل صحيح
///
/// @معامل ص - الإحداثي الصادي
/// @معامل س - الإحداثي السيني
/// @أرجع الزاوية بالراديان (من -باي إلى باي)
صدّر دالة ظا_عكسي2(ص: عدد_عشري، س: عدد_عشري) -> عدد_عشري {
    أرجع ظل_عكسي2(ص، س)
}

// ═══════════════════════════════════════════
// الدوال الزائدية
// ═══════════════════════════════════════════

/// الجيب الزائدي
///
/// @معامل س - القيمة المدخلة
/// @أرجع الجيب الزائدي
صدّر دالة جا_زائدي(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب_زائدي(س)
}

/// جيب التمام الزائدي
///
/// @معامل س - القيمة المدخلة
/// @أرجع جيب التمام الزائدي
صدّر دالة جتا_زائدي(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب_تمام_زائدي(س)
}

/// الظل الزائدي
///
/// @معامل س - القيمة المدخلة
/// @أرجع الظل الزائدي
صدّر دالة ظا_زائدي(س: عدد_عشري) -> عدد_عشري {
    أرجع ظل_زائدي(س)
}

// ═══════════════════════════════════════════
// تحويل الزوايا
// ═══════════════════════════════════════════

/// تحويل الدرجات إلى راديان
///
/// @معامل درجات - الزاوية بالدرجات
/// @أرجع الزاوية بالراديان
/// @مثال
/// اطبع(الى_راديان(١٨٠.٠))  // ٣.١٤١٥٩...
صدّر دالة الى_راديان(درجات: عدد_عشري) -> عدد_عشري {
    أرجع راديان(درجات)
}

/// تحويل الراديان إلى درجات
///
/// @معامل راديان - الزاوية بالراديان
/// @أرجع الزاوية بالدرجات
/// @مثال
/// اطبع(الى_درجات(باي))  // ١٨٠.٠
صدّر دالة الى_درجات(ر: عدد_عشري) -> عدد_عشري {
    أرجع درجات(ر)
}

// ═══════════════════════════════════════════
// دوال سهلة بالدرجات
// ═══════════════════════════════════════════

/// الجيب بالدرجات
///
/// @معامل درجات - الزاوية بالدرجات
/// @أرجع جيب الزاوية
/// @مثال
/// اطبع(جا_درجات(٩٠.٠))  // ١.٠
صدّر دالة جا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع جا(الى_راديان(درجات))
}

/// جيب التمام بالدرجات
///
/// @معامل درجات - الزاوية بالدرجات
/// @أرجع جيب تمام الزاوية
/// @مثال
/// اطبع(جتا_درجات(٠.٠))  // ١.٠
صدّر دالة جتا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع جتا(الى_راديان(درجات))
}

/// الظل بالدرجات
///
/// @معامل درجات - الزاوية بالدرجات
/// @أرجع ظل الزاوية
/// @مثال
/// اطبع(ظا_درجات(٤٥.٠))  // ١.٠
صدّر دالة ظا_درجات(درجات: عدد_عشري) -> عدد_عشري {
    أرجع ظا(الى_راديان(درجات))
}

