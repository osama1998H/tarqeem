// رياضيات/اساسي - Basic Math Functions
// رياضيات/اساسي - الدوال الرياضية الأساسية

// =============================================================================
// Absolute Value and Sign / القيمة المطلقة والعلامة
// =============================================================================

// Absolute value of integer
// القيمة المطلقة لعدد صحيح
صدّر دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

// Absolute value of float
// القيمة المطلقة لعدد عشري
صدّر دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_abs_float
    أرجع __مطلق_عشري__(س)
}

// Sign function (-1, 0, or 1)
// دالة العلامة (-1، 0، أو 1)
صدّر دالة علامة(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -1
    }
    إذا (س > 0) {
        أرجع 1
    }
    أرجع 0
}

// =============================================================================
// Power and Roots / القوى والجذور
// =============================================================================

// Power function (integer base and exponent)
// دالة القوة (أساس وأس صحيحين)
صدّر دالة قوة(أساس: عدد، أس: عدد) -> عدد {
    // Uses runtime: trq_pow_int
    أرجع __قوة__(أساس، أس)
}

// Power function (float base and exponent)
// دالة القوة (أساس وأس عشريين)
صدّر دالة قوة_عشري(أساس: عدد_عشري، أس: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_pow_float
    أرجع __قوة_عشري__(أساس، أس)
}

// Square root
// الجذر التربيعي
صدّر دالة جذر(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_sqrt
    أرجع __جذر__(س)
}

// Cube root
// الجذر التكعيبي
صدّر دالة جذر_تكعيبي(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_cbrt
    أرجع __جذر_تكعيبي__(س)
}

// Nth root
// الجذر النوني
صدّر دالة جذر_ن(س: عدد_عشري، ن: عدد) -> عدد_عشري {
    // Uses runtime: trq_nroot
    أرجع __جذر_ن__(س، ن)
}

// =============================================================================
// Logarithms and Exponentials / اللوغاريتمات والأُسية
// =============================================================================

// Natural logarithm (ln)
// اللوغاريتم الطبيعي
صدّر دالة لوغاريتم(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_log
    أرجع __لوغاريتم__(س)
}

// Base-10 logarithm
// اللوغاريتم العشري
صدّر دالة لوغاريتم10(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_log10
    أرجع __لوغاريتم10__(س)
}

// Base-2 logarithm
// لوغاريتم أساس 2
صدّر دالة لوغاريتم2(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_log2
    أرجع __لوغاريتم2__(س)
}

// Exponential function (e^x)
// الدالة الأُسية (هـ^س)
صدّر دالة اس(س: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_exp
    أرجع __اس__(س)
}

// =============================================================================
// Rounding / التقريب
// =============================================================================

// Floor - largest integer <= x
// الأرضية - أكبر عدد صحيح <= س
صدّر دالة ارضية(س: عدد_عشري) -> عدد {
    // Uses runtime: trq_floor
    أرجع __ارضية__(س)
}

// Ceiling - smallest integer >= x
// السقف - أصغر عدد صحيح >= س
صدّر دالة سقف(س: عدد_عشري) -> عدد {
    // Uses runtime: trq_ceil
    أرجع __سقف__(س)
}

// Round to nearest integer
// التقريب لأقرب عدد صحيح
صدّر دالة قرّب(س: عدد_عشري) -> عدد {
    // Uses runtime: trq_round
    أرجع __قرّب__(س)
}

// Truncate toward zero
// اقتطاع نحو الصفر
صدّر دالة اقطع(س: عدد_عشري) -> عدد {
    // Uses runtime: trq_trunc
    أرجع __اقطع__(س)
}

// =============================================================================
// Min, Max, Clamp / الأقل، الأقصى، الحصر
// =============================================================================

// Minimum of two integers
// الأقل بين عددين صحيحين
صدّر دالة اقل(أ: عدد، ب: عدد) -> عدد {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

// Maximum of two integers
// الأقصى بين عددين صحيحين
صدّر دالة اكبر(أ: عدد، ب: عدد) -> عدد {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

// Minimum of two floats
// الأقل بين عددين عشريين
صدّر دالة اقل_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_min_float
    أرجع __اقل_عشري__(أ، ب)
}

// Maximum of two floats
// الأقصى بين عددين عشريين
صدّر دالة اكبر_عشري(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_max_float
    أرجع __اكبر_عشري__(أ، ب)
}

// Clamp integer to range [min, max]
// حصر عدد صحيح في نطاق [أدنى، أقصى]
صدّر دالة حصر(س: عدد، ادنى: عدد، اقصى: عدد) -> عدد {
    إذا (س < ادنى) {
        أرجع ادنى
    }
    إذا (س > اقصى) {
        أرجع اقصى
    }
    أرجع س
}

// Clamp float to range [min, max]
// حصر عدد عشري في نطاق [أدنى، أقصى]
صدّر دالة حصر_عشري(س: عدد_عشري، ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_clamp_float
    أرجع __حصر_عشري__(س، ادنى، اقصى)
}

// =============================================================================
// Division and Modulo / القسمة والباقي
// =============================================================================

// Integer modulo (remainder)
// باقي القسمة الصحيحة
صدّر دالة باقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب
}

// Integer division
// القسمة الصحيحة
صدّر دالة قسمة_صحيحة(أ: عدد، ب: عدد) -> عدد {
    أرجع أ / ب
}

// Euclidean modulo (always positive)
// باقي إقليدس (دائماً موجب)
صدّر دالة باقي_موجب(أ: عدد، ب: عدد) -> عدد {
    // Uses runtime: trq_mod
    أرجع __باقي_موجب__(أ، ب)
}

// =============================================================================
// Number Theory / نظرية الأعداد
// =============================================================================

// Greatest common divisor (GCD)
// القاسم المشترك الأكبر
صدّر دالة قاسم_مشترك(أ: عدد، ب: عدد) -> عدد {
    // Uses runtime: trq_gcd
    أرجع __قاسم_مشترك__(أ، ب)
}

// Least common multiple (LCM)
// المضاعف المشترك الأصغر
صدّر دالة مضاعف_مشترك(أ: عدد، ب: عدد) -> عدد {
    // Uses runtime: trq_lcm
    أرجع __مضاعف_مشترك__(أ، ب)
}

// Factorial (n!)
// العاملي (ن!)
صدّر دالة عاملي(ن: عدد) -> عدد {
    // Uses runtime: trq_factorial
    أرجع __عاملي__(ن)
}

// Check if number is even
// تحقق إذا العدد زوجي
صدّر دالة زوجي(س: عدد) -> منطقي {
    أرجع س % 2 == 0
}

// Check if number is odd
// تحقق إذا العدد فردي
صدّر دالة فردي(س: عدد) -> منطقي {
    أرجع س % 2 != 0
}

// Check if number is prime (simple implementation)
// تحقق إذا العدد أولي (تنفيذ بسيط)
صدّر دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) {
        أرجع خطأ
    }
    إذا (ن <= 3) {
        أرجع صحيح
    }
    إذا (ن % 2 == 0 || ن % 3 == 0) {
        أرجع خطأ
    }
    متغير ع = 5
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0 || ن % (ع + 2) == 0) {
            أرجع خطأ
        }
        ع = ع + 6
    }
    أرجع صحيح
}

// =============================================================================
// Aliases / أسماء مستعارة
// =============================================================================

// أدنى is alias for اقل
// أقصى is alias for اكبر
صدّر دالة أدنى(أ: عدد، ب: عدد) -> عدد {
    أرجع اقل(أ، ب)
}

صدّر دالة أقصى(أ: عدد، ب: عدد) -> عدد {
    أرجع اكبر(أ، ب)
}
