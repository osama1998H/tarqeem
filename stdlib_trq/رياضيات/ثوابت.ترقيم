// لوغاريتم 2 الطبيعي
صدّر ثابت لن2: عدد_عشري = 0.6931471805599453

// Natural log of 10 (ln 10)
// لوغاريتم 10 الطبيعي
صدّر ثابت لن10: عدد_عشري = 2.302585092994046

// Log base 2 of e
// لوغاريتم هـ أساس 2
صدّر ثابت لوغ2_هـ: عدد_عشري = 1.4426950408889634

// Log base 10 of e
// لوغاريتم هـ أساس 10
صدّر ثابت لوغ10_هـ: عدد_عشري = 0.4342944819032518

