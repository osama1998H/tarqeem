// =============================================================================
// Fundamental Constants / الثوابت الأساسية
// =============================================================================

// Pi (π) - ratio of circumference to diameter
// باي (ط) - نسبة المحيط للقطر
صدّر ثابت باي: عدد_عشري = 3.141592653589793

// Tau (τ = 2π) - ratio of circumference to radius
// تاو (2ط) - نسبة المحيط للنصف قطر
صدّر ثابت تاو: عدد_عشري = 6.283185307179586

// Euler's number (e) - base of natural logarithm
// عدد أويلر (هـ) - أساس اللوغاريتم الطبيعي
صدّر ثابت هـ: عدد_عشري = 2.718281828459045

// Golden ratio (φ) - (1 + √5) / 2
// النسبة الذهبية (ذهبي) - (1 + √5) / 2
صدّر ثابت ذهبي: عدد_عشري = 1.618033988749895

// =============================================================================
// Square Roots / الجذور التربيعية
// =============================================================================

// Square root of 2
// جذر 2
صدّر ثابت جذر2: عدد_عشري = 1.4142135623730951

// Square root of 3
// جذر 3
صدّر ثابت جذر3: عدد_عشري = 1.7320508075688772

// Square root of 5
// جذر 5
صدّر ثابت جذر5: عدد_عشري = 2.23606797749979

// 1 / √2 = √2 / 2
// 1 / جذر2 = جذر2 / 2
صدّر ثابت جذر2_عكسي: عدد_عشري = 0.7071067811865476

// =============================================================================
// Natural Logarithms / اللوغاريتمات الطبيعية
// =============================================================================

