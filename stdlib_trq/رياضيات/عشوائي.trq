// رياضيات/عشوائي - Random Number Generation
// رياضيات/عشوائي - توليد الأرقام العشوائية

// =============================================================================
// مولد_عشوائي - Random Generator Class
// =============================================================================

صدّر صنف مولد_عشوائي {
    خاص _بذرة: عدد

    // Constructor - uses time-based seed
    // المنشئ - يستخدم بذرة مبنية على الوقت
    منشئ() {
        // Seed is auto-initialized by runtime
        // البذرة تُهيأ تلقائياً من المكتبة
        هذا._بذرة = 0
    }

    // Constructor with explicit seed
    // المنشئ مع بذرة محددة
    // Note: Requires overloaded constructors support
    // منشئ_بذرة(بذرة: عدد) {
    //     __بذرة_عشوائي__(بذرة)
    //     هذا._بذرة = بذرة
    // }

    // Set seed
    // تعيين البذرة
    عام دالة عيّن_بذرة(بذرة: عدد) {
        __بذرة_عشوائي__(بذرة)
        هذا._بذرة = بذرة
    }

    // Get random integer
    // أحصل على عدد عشوائي
    عام دالة عدد() -> عدد {
        // Uses runtime: trq_random_int
        أرجع __عشوائي_عدد__()
    }

    // Get random integer in range [min, max]
    // أحصل على عدد عشوائي في نطاق [أدنى، أقصى]
    عام دالة عدد_بين(ادنى: عدد، اقصى: عدد) -> عدد {
        // Uses runtime: trq_random_int_range
        أرجع __عشوائي_عدد_بين__(ادنى، اقصى)
    }

    // Get random float in [0.0, 1.0)
    // أحصل على عدد عشري عشوائي في [0.0، 1.0)
    عام دالة عشري() -> عدد_عشري {
        // Uses runtime: trq_random_float
        أرجع __عشوائي_عشري__()
    }

    // Get random float in range [min, max)
    // أحصل على عدد عشري عشوائي في نطاق [أدنى، أقصى)
    عام دالة عشري_بين(ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
        // Uses runtime: trq_random_float_range
        أرجع __عشوائي_عشري_بين__(ادنى، اقصى)
    }

    // Get random boolean
    // أحصل على منطقي عشوائي
    عام دالة منطقي() -> منطقي {
        // Uses runtime: trq_random_bool
        أرجع __عشوائي_منطقي__()
    }

    // Get random element from array
    // اختر عنصر عشوائي من مصفوفة
    // Note: Requires generic method support
    // عام دالة اختر<ن>(قائمة: مصفوفة<ن>) -> ن {
    //     متغير فهرس = هذا.عدد_بين(0، __طول_مصفوفة__(قائمة) - 1)
    //     أرجع قائمة[فهرس]
    // }

    // Shuffle array in place
    // خلط المصفوفة في مكانها
    // Note: Requires generic method support
    // عام دالة خلط<ن>(قائمة: مصفوفة<ن>) {
    //     متغير طول = __طول_مصفوفة__(قائمة)
    //     متغير ع = طول - 1
    //     طالما (ع > 0) {
    //         متغير ي = هذا.عدد_بين(0، ع)
    //         متغير مؤقت = قائمة[ع]
    //         قائمة[ع] = قائمة[ي]
    //         قائمة[ي] = مؤقت
    //         ع = ع - 1
    //     }
    // }
}

// =============================================================================
// Global Shortcut Functions / دوال اختصار عامة
// These use a global random generator
// تستخدم مولد عشوائي عام
// =============================================================================

// Get random integer
// أحصل على عدد عشوائي
صدّر دالة عشوائي() -> عدد {
    // Uses runtime: trq_random_int
    أرجع __عشوائي_عدد__()
}

// Get random integer in range [min, max]
// أحصل على عدد عشوائي في نطاق [أدنى، أقصى]
صدّر دالة عشوائي_بين(ادنى: عدد، اقصى: عدد) -> عدد {
    // Uses runtime: trq_random_int_range
    أرجع __عشوائي_عدد_بين__(ادنى، اقصى)
}

// Get random float in [0.0, 1.0)
// أحصل على عدد عشري عشوائي في [0.0، 1.0)
صدّر دالة عشوائي_عشري() -> عدد_عشري {
    // Uses runtime: trq_random_float
    أرجع __عشوائي_عشري__()
}

// Get random float in range [min, max)
// أحصل على عدد عشري عشوائي في نطاق [أدنى، أقصى)
صدّر دالة عشوائي_عشري_بين(ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
    // Uses runtime: trq_random_float_range
    أرجع __عشوائي_عشري_بين__(ادنى، اقصى)
}

// Get random boolean (coin flip)
// أحصل على منطقي عشوائي (قلب العملة)
صدّر دالة عشوائي_منطقي() -> منطقي {
    // Uses runtime: trq_random_bool
    أرجع __عشوائي_منطقي__()
}

// Set random seed
// تعيين بذرة العشوائية
صدّر دالة بذرة_عشوائي(بذرة: عدد) {
    // Uses runtime: trq_random_seed
    __بذرة_عشوائي__(بذرة)
}

// =============================================================================
// Random Utilities / أدوات عشوائية
// =============================================================================

// Roll a dice with n sides (1 to n)
// ارمِ نرداً بـ ن وجوه (1 إلى ن)
صدّر دالة نرد(وجوه: عدد) -> عدد {
    أرجع عشوائي_بين(1، وجوه)
}

// Flip a coin (true/false)
// اقلب عملة (صحيح/خطأ)
صدّر دالة عملة() -> منطقي {
    أرجع عشوائي_منطقي()
}

// Get random percentage (0-100)
// أحصل على نسبة عشوائية (0-100)
صدّر دالة نسبة_عشوائية() -> عدد {
    أرجع عشوائي_بين(0، 100)
}

// Check if random chance succeeds (percentage 0-100)
// تحقق إذا الفرصة العشوائية نجحت (نسبة 0-100)
صدّر دالة فرصة(نسبة: عدد) -> منطقي {
    أرجع عشوائي_بين(1، 100) <= نسبة
}
