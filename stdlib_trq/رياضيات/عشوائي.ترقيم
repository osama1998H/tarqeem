/// توليد الأرقام العشوائية
///
/// تحتوي هذه الوحدة على صنف مولد الأعداد العشوائية ودوال مساعدة

// ═══════════════════════════════════════════
// صنف مولد العشوائي
// ═══════════════════════════════════════════

/// صنف مولد الأعداد العشوائية
///
/// @مثال
/// متغير م = جديد مولد_عشوائي()
/// اطبع(م.عدد_بين(١، ١٠))

صدّر صنف مولد_عشوائي {
    خاص _بذرة: عدد

    /// المنشئ - يستخدم بذرة مبنية على الوقت
    منشئ() {
        هذا._بذرة = 0
    }

    /// تعيين البذرة
    ///
    /// @معامل بذرة - قيمة البذرة لتوليد تسلسل محدد
    عام دالة عيّن_بذرة(بذرة: عدد) {
        بذرة_عشوائية(بذرة)
        هذا._بذرة = بذرة
    }

    /// أحصل على عدد صحيح عشوائي
    ///
    /// @أرجع عدد صحيح عشوائي
    عام دالة عدد() -> عدد {
        أرجع عشوائي_عدد()
    }

    /// أحصل على عدد صحيح عشوائي في نطاق
    ///
    /// @معامل ادنى - الحد الأدنى (شامل)
    /// @معامل اقصى - الحد الأقصى (شامل)
    /// @أرجع عدد عشوائي في النطاق [أدنى، أقصى]
    عام دالة عدد_بين(ادنى: عدد، اقصى: عدد) -> عدد {
        أرجع عشوائي_نطاق(ادنى، اقصى)
    }

    /// أحصل على عدد عشري عشوائي في [٠.٠، ١.٠)
    ///
    /// @أرجع عدد عشري عشوائي
    عام دالة عشري() -> عدد_عشري {
        أرجع عشوائي_عشري()
    }

    /// أحصل على عدد عشري عشوائي في نطاق
    ///
    /// @معامل ادنى - الحد الأدنى (شامل)
    /// @معامل اقصى - الحد الأقصى (غير شامل)
    /// @أرجع عدد عشري عشوائي في النطاق
    عام دالة عشري_بين(ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
        أرجع عشوائي_عشري_نطاق(ادنى، اقصى)
    }

    /// أحصل على قيمة منطقية عشوائية
    ///
    /// @أرجع صحيح أو خطأ عشوائياً
    عام دالة منطقي() -> منطقي {
        أرجع عشوائي_منطقي()
    }
}

// ═══════════════════════════════════════════
// دوال اختصار عامة
// ═══════════════════════════════════════════

/// أحصل على عدد صحيح عشوائي
///
/// @أرجع عدد صحيح عشوائي
صدّر دالة عشوائي() -> عدد {
    أرجع عشوائي_عدد()
}

/// أحصل على عدد صحيح عشوائي في نطاق
///
/// @معامل ادنى - الحد الأدنى (شامل)
/// @معامل اقصى - الحد الأقصى (شامل)
/// @أرجع عدد عشوائي في النطاق [أدنى، أقصى]
/// @مثال
/// متغير رقم = عشوائي_بين(١، ١٠٠)
صدّر دالة عشوائي_بين(ادنى: عدد، اقصى: عدد) -> عدد {
    أرجع عشوائي_نطاق(ادنى، اقصى)
}

/// أحصل على عدد عشري عشوائي في [٠.٠، ١.٠)
///
/// @أرجع عدد عشري عشوائي بين ٠ و ١
صدّر دالة عشوائي_عشري_اساسي() -> عدد_عشري {
    أرجع عشوائي_عشري()
}

/// أحصل على عدد عشري عشوائي في نطاق
///
/// @معامل ادنى - الحد الأدنى
/// @معامل اقصى - الحد الأقصى
/// @أرجع عدد عشري عشوائي في النطاق
صدّر دالة عشوائي_عشري_بين(ادنى: عدد_عشري، اقصى: عدد_عشري) -> عدد_عشري {
    أرجع عشوائي_عشري_نطاق(ادنى، اقصى)
}

/// أحصل على قيمة منطقية عشوائية
///
/// @أرجع صحيح أو خطأ عشوائياً (مثل قلب عملة)
صدّر دالة عشوائي_منطقي_اساسي() -> منطقي {
    أرجع عشوائي_منطقي()
}

/// تعيين بذرة العشوائية
///
/// @معامل بذرة - قيمة البذرة
/// @ملاحظة استخدم نفس البذرة للحصول على نفس التسلسل العشوائي
صدّر دالة بذرة_عشوائي(بذرة: عدد) {
    بذرة_عشوائية(بذرة)
}

// ═══════════════════════════════════════════
// أدوات عشوائية
// ═══════════════════════════════════════════

/// ارمِ نرداً بعدد وجوه محدد
///
/// @معامل وجوه - عدد وجوه النرد
/// @أرجع رقم من ١ إلى عدد الوجوه
/// @مثال
/// متغير نتيجة = نرد(٦)  // يرجع ١ إلى ٦
صدّر دالة نرد(وجوه: عدد) -> عدد {
    أرجع عشوائي_بين(1، وجوه)
}

/// اقلب عملة
///
/// @أرجع صحيح أو خطأ بشكل عشوائي
صدّر دالة عملة() -> منطقي {
    أرجع عشوائي_منطقي()
}

/// أحصل على نسبة عشوائية
///
/// @أرجع عدد من ٠ إلى ١٠٠
صدّر دالة نسبة_عشوائية() -> عدد {
    أرجع عشوائي_بين(0، 100)
}

/// تحقق إذا الفرصة العشوائية نجحت
///
/// @معامل نسبة - نسبة النجاح (٠ إلى ١٠٠)
/// @أرجع صحيح إذا نجحت الفرصة
/// @مثال
/// إذا (فرصة(٢٥)) {
///     اطبع("نجحت! (٢٥٪ احتمال)")
/// }
صدّر دالة فرصة(نسبة: عدد) -> منطقي {
    أرجع عشوائي_بين(1، 100) <= نسبة
}
