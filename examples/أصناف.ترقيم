/// الأصناف: المواثيق، الرؤية، المنشئات، الوراثة، والخواص
///
/// يجمع هذا الملف نموذج البرمجة الكائنية في ترقيم. قسمه الأخير ليس عرضاً
/// للميزات بل حارس انحدار: يقرأ أعضاءً موروثة من خلال الصنف المشتق نفسه.
///
/// @منذ ١.١.٠

// ═══════════════════════════════════════════
// الميثاق: عقد يُلزم الصنف بتنفيذ دوال بعينها
// ═══════════════════════════════════════════

/// عقد يفرض على الملتزم به دالة طباعة
ميثاق قابل_للطباعة {
    دالة اطبع_معلومات()
}

// ═══════════════════════════════════════════
// الرؤية: عام، خاص، محمي
// ═══════════════════════════════════════════

/// حساب مصرفي — الرصيد خاص، ولا يُقرأ إلا عبر دالة عامة
صنف حساب {
    عام اسم_المالك: نص
    خاص الرصيد: عدد
    محمي الحد_الائتماني: عدد

    منشئ(اسم: نص، رصيد: عدد) {
        هذا.اسم_المالك = اسم
        هذا.الرصيد = رصيد
        هذا.الحد_الائتماني = 1000
    }

    /// اقرأ الرصيد الخاص من خلال واجهة عامة
    عام دالة احصل_الرصيد() -> عدد {
        أرجع هذا.الرصيد
    }
}

// ═══════════════════════════════════════════
// صنف يلتزم بميثاق، وخواصه تحرس حقولاً خاصة
// ═══════════════════════════════════════════

صنف شخص يلتزم قابل_للطباعة {
    // حقول داعمة خاصة، تُقرأ وتُكتب عبر الخواص أدناه
    خاص _اسم: نص
    خاص _عمر: عدد

    منشئ(اسم: نص، عمر: عدد) {
        هذا._اسم = اسم
        هذا._عمر = عمر
    }

    // تنفيذ ما يفرضه الميثاق
    عام دالة اطبع_معلومات() {
        اطبع("الاسم: " + هذا._اسم)
        اطبع("العمر: " + هذا._عمر)
    }

    /// خاصية كاملة: تُقرأ بـ«احصل» وتُكتب بـ«عيّن»
    خاصية اسم: نص {
        احصل {
            أرجع هذا._اسم
        }
        عيّن(قيمة) {
            هذا._اسم = قيمة
        }
    }

    /// خاصية للقراءة فقط: بلا «عيّن»
    خاصية عمر: عدد {
        احصل {
            أرجع هذا._عمر
        }
    }
}

// ═══════════════════════════════════════════
// الوراثة: «يرث» و«الأصل» وتجاوز الدوال
// ═══════════════════════════════════════════

صنف موظف يرث شخص {
    خاص راتب: عدد_عشري
    خاص منصب: نص

    منشئ(اسم: نص، عمر: عدد، راتب: عدد_عشري، منصب: نص) {
        // «الأصل(...)» تستدعي منشئ الأب
        الأصل(اسم، عمر)
        هذا.راتب = راتب
        هذا.منصب = منصب
    }

    // تجاوز دالة الأب، مع استدعائها بـ«الأصل.»
    عام دالة اطبع_معلومات() {
        الأصل.اطبع_معلومات()
        اطبع("المنصب: " + هذا.منصب)
        اطبع("الراتب: " + هذا.راتب)
    }
}

// ═══════════════════════════════════════════
// الخواص التلقائية: بلا حقل داعم وبقيمة افتراضية
// ═══════════════════════════════════════════

صنف نقطة {
    خاصية س: عدد = 0
    خاصية ص: عدد = 0

    منشئ(س: عدد، ص: عدد) {
        هذا.س = س
        هذا.ص = ص
    }
}

// ═══════════════════════════════════════════
// حارس انحدار: قراءة الموروث من خلال المشتق
//
// يقرأ هذا القسم أعضاءً موروثة من خلال الصنف المشتق نفسه — وهو الشكل الذي
// يتجنبه القسم السابق بالمصادفة، لأن «موظف» لا يسند إلا حقوله الخاصة،
// وقراءة الموروث تحدث داخل دوال الأصل حيث «هذا» من نمط الأصل.
// ═══════════════════════════════════════════

صنف شكل {
    عام عرض: عدد
    خاصية اسم: نص = ""

    منشئ(عرض: عدد، اسم: نص) {
        هذا.عرض = عرض
        هذا.اسم = اسم
    }
}

صنف مستطيل يرث شكل {
    عام طول: عدد

    منشئ(عرض: عدد، طول: عدد) {
        الأصل(عرض، "مستطيل")
        هذا.طول = طول
    }

    // تقرأ «عرض» الموروث من داخل الصنف المشتق
    عام دالة مساحة() -> عدد {
        أرجع هذا.عرض * هذا.طول
    }
}

صنف مربع يرث مستطيل {
    منشئ(ضلع: عدد) {
        الأصل(ضلع، ضلع)
        هذا.اسم = "مربع"
    }
}

// ═══════════════════════════════════════════
// الاستخدام
// ═══════════════════════════════════════════

اطبع("=== الرؤية ===")
متغير حسابي = جديد حساب("أحمد"، 5000)
اطبع("اسم المالك: " + حسابي.اسم_المالك)
اطبع("الرصيد (عبر دالة عامة): " + حسابي.احصل_الرصيد())

اطبع("=== الميثاق والوراثة ===")
متغير شخص١ = جديد شخص("أحمد"، 30)
شخص١.اطبع_معلومات()

متغير موظف١ = جديد موظف("محمد"، 35، 10000.0، "مهندس")
موظف١.اطبع_معلومات()

اطبع("=== الخواص ===")
// القراءة عبر «احصل»، والكتابة عبر «عيّن»
اطبع(شخص١.اسم)
اطبع(شخص١.عمر)
شخص١.اسم = "محمود"
اطبع(شخص١.اسم)

// خاصيتان تلقائيتان مستقلتان: لكلٍّ خانتها الخاصة
متغير ن = جديد نقطة(3، 4)
اطبع(ن.س)
اطبع(ن.ص)

اطبع("=== الموروث من خلال المشتق ===")
متغير ر = جديد مستطيل(3، 4)
اطبع(ر.اسم)
اطبع(ر.عرض)
اطبع(ر.طول)
اطبع(ر.مساحة())

// مستوى ثانٍ من الوراثة: «عرض» موروث عبر حلقتين، و«اسم» خاصية موروثة
متغير م = جديد مربع(5)
اطبع(م.اسم)
اطبع(م.عرض)
اطبع(م.طول)

// لا يستدعي هذا المثال «م.مساحة()»: استدعاء دالة مُعلَنة في صنف جَدّ من خلال
// مرجع الصنف الحفيد لا يُربَط أصلياً بعد — راجع المسألة ٢٥٣.

الحمد_لله
