بسم_الله

/// مثال على استخدام مكتبة الرسوميات
/// برنامج بسيط يرسم أشكالاً ملونة في نافذة

استورد {
    هيئ، أنهِ،
    أنشئ_نافذة، أغلق_نافذة،
    امسح، اعرض، عيّن_لون،
    ارسم_مستطيل، ارسم_مستطيل_ممتلئ،
    ارسم_دائرة، ارسم_دائرة_ممتلئة،
    ارسم_خط،
    استطلع_حدث، نوع_الحدث، مفتاح_الحدث،
    تأخير،
    لون_أبيض، لون_أحمر، لون_أخضر، لون_أزرق،
    لون_أصفر، لون_برتقالي، لون_أسود،
    حدث_إغلاق، حدث_ضغط_مفتاح،
    مفتاح_هروب
} من "رسوميات"

// تهيئة الرسوميات
إذا (هيئ() == ٠) {
    اطبع("فشل في تهيئة الرسوميات!")
} وإلا {
    // إنشاء نافذة
    متغير نافذة = أنشئ_نافذة("مثال ترقيم - رسوميات", ٨٠٠, ٦٠٠)

    إذا (نافذة < ٠) {
        اطبع("فشل في إنشاء النافذة!")
    } وإلا {
        اطبع("تم إنشاء النافذة بنجاح!")

        متغير يعمل = صحيح
        متغير إطار = ٠

        // حلقة الرسم الرئيسية
        طالما (يعمل) {
            // معالجة الأحداث
            طالما (استطلع_حدث() == ١) {
                إذا (نوع_الحدث() == حدث_إغلاق) {
                    يعمل = خطأ
                }
                إذا (نوع_الحدث() == حدث_ضغط_مفتاح) {
                    إذا (مفتاح_الحدث() == مفتاح_هروب) {
                        يعمل = خطأ
                    }
                }
            }

            // مسح الشاشة بلون أسود
            عيّن_لون(نافذة, لون_أسود())
            امسح(نافذة)

            // رسم خلفية متدرجة
            لكل (متغير ي = ٠؛ ي < ٦٠٠؛ ي = ي + ٢٠) {
                متغير لون_خلفية = ٢٠ + (ي / ١٥)
                عيّن_لون(نافذة, لون_خلفية, لون_خلفية, ٥٠)
                ارسم_مستطيل_ممتلئ(نافذة, ٠, ي, ٨٠٠, ٢٠)
            }

            // رسم عنوان
            عيّن_لون(نافذة, لون_أبيض())
            ارسم_مستطيل_ممتلئ(نافذة, ٢٥٠, ٣٠, ٣٠٠, ٦٠)
            عيّن_لون(نافذة, لون_أزرق())
            ارسم_مستطيل(نافذة, ٢٤٨, ٢٨, ٣٠٤, ٦٤)

            // رسم مستطيل أحمر
            عيّن_لون(نافذة, لون_أحمر())
            ارسم_مستطيل_ممتلئ(نافذة, ١٠٠, ١٥٠, ١٥٠, ١٠٠)

            // رسم مستطيل أخضر
            عيّن_لون(نافذة, لون_أخضر())
            ارسم_مستطيل_ممتلئ(نافذة, ٣٢٥, ١٥٠, ١٥٠, ١٠٠)

            // رسم مستطيل أزرق
            عيّن_لون(نافذة, لون_أزرق())
            ارسم_مستطيل_ممتلئ(نافذة, ٥٥٠, ١٥٠, ١٥٠, ١٠٠)

            // رسم دوائر
            عيّن_لون(نافذة, لون_أصفر())
            ارسم_دائرة_ممتلئة(نافذة, ١٧٥, ٣٥٠, ٦٠)

            عيّن_لون(نافذة, لون_برتقالي())
            ارسم_دائرة_ممتلئة(نافذة, ٤٠٠, ٣٥٠, ٦٠)

            عيّن_لون(نافذة, ٢٥٥, ٠, ٢٥٥)  // أرجواني
            ارسم_دائرة_ممتلئة(نافذة, ٦٢٥, ٣٥٠, ٦٠)

            // رسم إطار حول الدوائر
            عيّن_لون(نافذة, لون_أبيض())
            ارسم_دائرة(نافذة, ١٧٥, ٣٥٠, ٦٥)
            ارسم_دائرة(نافذة, ٤٠٠, ٣٥٠, ٦٥)
            ارسم_دائرة(نافذة, ٦٢٥, ٣٥٠, ٦٥)

            // رسم خطوط زخرفية
            عيّن_لون(نافذة, ٠, ٢٥٥, ٢٥٥)  // سماوي
            ارسم_خط(نافذة, ٥٠, ٤٥٠, ٧٥٠, ٤٥٠)
            ارسم_خط(نافذة, ٥٠, ٤٦٠, ٧٥٠, ٤٦٠)

            // رسم نمط متحرك
            متغير إزاحة = إطار % ٤٠
            عيّن_لون(نافذة, ٢٠٠, ٢٠٠, ٢٥٥)
            لكل (متغير س = إزاحة؛ س < ٨٠٠؛ س = س + ٤٠) {
                ارسم_مستطيل_ممتلئ(نافذة, س, ٥٠٠, ٢٠, ٢٠)
            }

            // رسم إطار الشاشة
            عيّن_لون(نافذة, لون_أبيض())
            ارسم_مستطيل(نافذة, ١٠, ١٠, ٧٨٠, ٥٨٠)

            // عرض الرسم
            اعرض(نافذة)

            // تأخير لتقليل استهلاك المعالج
            تأخير(١٦)  // ~٦٠ إطار في الثانية
            إطار = إطار + ١
        }

        // إغلاق النافذة
        أغلق_نافذة(نافذة)
        اطبع("تم إغلاق النافذة")
    }

    // إنهاء الرسوميات
    أنهِ()
    اطبع("تم إنهاء الرسوميات")
}

الحمد_لله
