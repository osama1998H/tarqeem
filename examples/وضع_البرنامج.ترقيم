// وضع البرنامج - Program Mode
// مثال على استخدام دالة رئيسية() كنقطة دخول البرنامج
//
// في وضع البرنامج، يتم تنفيذ الكود داخل دالة رئيسية() فقط.
// المتغيرات العامة مسموحة، لكن الجمل التنفيذية خارج الدالة غير مسموحة.

// متغير عام - Global variable (allowed)
متغير الاسم: نص = "ترقيم"
ثابت الإصدار = "1.0.0"

// دالة مساعدة - Helper function
دالة تحية(اسم: نص) {
    اطبع("مرحباً يا " + اسم + "!")
}

// دالة حساب - Calculation function
دالة مضروب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }
    أرجع ن * مضروب(ن - 1)
}

// نقطة الدخول الرئيسية - Main entry point
دالة رئيسية() {
    اطبع("=== وضع البرنامج ===")
    اطبع("الإصدار: " + الإصدار)

    تحية(الاسم)

    اطبع("مضروب 5 = " + مضروب(5))
    اطبع("مضروب 10 = " + مضروب(10))

    اطبع("=== انتهى البرنامج ===")
}

