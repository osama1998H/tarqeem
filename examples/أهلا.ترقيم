// مثال على استخدام امتداد الملف العربي (.ترقيم)
// Example of using Arabic file extension (.ترقيم)
//
// هذا الملف يوضح أن ترقيم يدعم كلا الامتدادين:
// - .trq (امتداد ASCII)
// - .ترقيم (امتداد عربي)

// تعريف متغيرات
متغير رسالة = "أهلاً وسهلاً!";
متغير اسم = "ترقيم";

// طباعة الرسالة
اطبع(رسالة);
اطبع("مرحباً بك في لغة " + اسم);

// دالة بسيطة
دالة تحية(اسم_شخص: نص) -> نص {
    أرجع "أهلاً يا " + اسم_شخص + "!";
}

// استدعاء الدالة
متغير نتيجة = تحية("صديقي");
اطبع(نتيجة);
