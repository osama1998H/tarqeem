// وراثة الحقول والخواص
//
// يقرأ هذا المثال أعضاءً موروثة من خلال الصنف المشتق نفسه — وهو الشكل الذي
// يتجنبه مثال «صنف» بالمصادفة، لأن المشتق فيه لا يسند إلا حقوله الخاصة،
// وقراءة الموروث تحدث داخل دوال الأصل حيث «هذا» من نمط الأصل.

صنف شكل {
    عام عرض: عدد
    خاصية اسم: نص = ""

    منشئ(عرض: عدد، اسم: نص) {
        هذا.عرض = عرض
        هذا.اسم = اسم
    }
}

صنف مستطيل يرث شكل {
    عام طول: عدد

    منشئ(عرض: عدد، طول: عدد) {
        الأصل(عرض، "مستطيل")
        هذا.طول = طول
    }

    // تقرأ «عرض» الموروث من داخل الصنف المشتق
    عام دالة مساحة() -> عدد {
        أرجع هذا.عرض * هذا.طول
    }
}

صنف مربع يرث مستطيل {
    منشئ(ضلع: عدد) {
        الأصل(ضلع، ضلع)
        هذا.اسم = "مربع"
    }
}

متغير ر = جديد مستطيل(3، 4)
اطبع(ر.اسم)
اطبع(ر.عرض)
اطبع(ر.طول)
اطبع(ر.مساحة())

// مستوى ثانٍ من الوراثة: «عرض» موروث عبر حلقتين، و«اسم» خاصية موروثة
متغير م = جديد مربع(5)
اطبع(م.اسم)
اطبع(م.عرض)
اطبع(م.طول)

// لا يستدعي هذا المثال «م.مساحة()»: استدعاء دالة مُعلَنة في صنف جَدّ من خلال
// مرجع الصنف الحفيد لا يُربَط أصلياً بعد — راجع المسألة ٢٥٣.

