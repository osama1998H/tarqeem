/// أساسيات ترقيم: المتغيرات والأنواع، التحكم بالتدفق، والمصفوفات
///
/// يجمع هذا الملف اللبنات التي يقوم عليها كل برنامج: كيف تُعلَن القيم، كيف
/// يتفرّع التنفيذ ويتكرّر، وكيف تُبنى المصفوفات وتُقرأ.
///
/// @منذ ١.١.٠

// ═══════════════════════════════════════════
// المتغيرات والأنواع
// ═══════════════════════════════════════════

// «متغير» يقبل إعادة الإسناد، ونوعه يُستنتج من قيمته الأولى
متغير اسم = "أحمد"
متغير عمر = 25
متغير راتب = 5000.50
متغير متزوج = صحيح

// «ثابت» لا يقبل إعادة الإسناد
ثابت باي = 3.14159
ثابت اسم_البرنامج = "ترقيم"

// النوع يُحدَّد صراحةً بعد النقطتين حين لا تكفي القيمة لاستنتاجه
متغير عداد: عدد = 0
متغير رسالة: نص = "مرحباً"
متغير نشط: منطقي = خطأ

// المصفوفات: عناصرها مفصولة بالفاصلة العربية «،»
ثابت أرقام = [1، 2، 3، 4، 5]
ثابت أسماء = ["أحمد"، "محمد"، "علي"]

// ═══════════════════════════════════════════
// دوال اختبار المصفوفات
// ═══════════════════════════════════════════

/// ابنِ مصفوفة أعداد عنصراً عنصراً واقرأها
دالة اعرض_بناء_مصفوفة() {
    اطبع("=== بناء مصفوفة ===")

    // «مصفوفة<عدد>» نمط معمم: مصفوفة عناصرها أعداد
    متغير قيم: مصفوفة<عدد> = []

    قيم.ألحق(10)
    قيم.ألحق(20)
    قيم.ألحق(30)

    اطبع("الطول: " + طول(قيم))
    اطبع("العنصر الأول: " + قيم[0])
    اطبع("العنصر الأخير: " + قيم[2])

    اطبع("جميع العناصر:")
    لكل قيمة في قيم {
        اطبع(قيمة)
    }
}

/// اقرأ مصفوفة ثنائية الأبعاد: مصفوفة عناصرها مصفوفات
دالة اعرض_مصفوفة_ثنائية() {
    اطبع("=== مصفوفة ثنائية ===")

    متغير شبكة: مصفوفة<مصفوفة<عدد>> = []

    متغير صف١: مصفوفة<عدد> = [1، 2، 3]
    متغير صف٢: مصفوفة<عدد> = [4، 5، 6]

    شبكة.ألحق(صف١)
    شبكة.ألحق(صف٢)

    اطبع("عدد الصفوف: " + طول(شبكة))

    اطبع("محتوى الصف الأول:")
    لكل عنصر في شبكة[0] {
        اطبع(عنصر)
    }
}

// ═══════════════════════════════════════════
// طباعة القيم المُعلَنة
// ═══════════════════════════════════════════

اطبع("=== المتغيرات والأنواع ===")
اطبع(اسم)
اطبع(عمر)
اطبع(راتب)
اطبع(متزوج)
اطبع(باي)
اطبع(اسم_البرنامج)
اطبع(عداد)
اطبع(رسالة)
اطبع(نشط)
اطبع(أرقام)

// ═══════════════════════════════════════════
// التحكم بالتدفق
// ═══════════════════════════════════════════

اطبع("=== الشرط ===")

إذا (عمر >= 18) {
    اطبع("بالغ")
} وإلا إذا (عمر >= 13) {
    اطبع("مراهق")
} وإلا {
    اطبع("طفل")
}

اطبع("=== حلقة طالما ===")

طالما (عداد < 5) {
    اطبع(عداد)
    عداد++
}

اطبع("=== حلقة لكل ===")

// حلقة بنمط سي: التهيئة؛ الشرط؛ الخطوة — مفصولة بالفاصلة المنقوطة «؛»
لكل (متغير ع = 0؛ ع < 5؛ ع++) {
    اطبع(ع)
}

اطبع("=== حلقة لكل-في ===")

لكل رقم في أرقام {
    اطبع(رقم * 2)
}

لكل اسم_في_القائمة في أسماء {
    اطبع(اسم_في_القائمة)
}

اطبع("=== التطابق ===")

// ذراع واحدة تقبل عدة قيم، و«غير_ذلك» هي الفرع الافتراضي
متغير يوم = "السبت"
تطابق (يوم) {
    حالة "السبت"، "الأحد" => اطبع("عطلة")
    حالة "الجمعة" => اطبع("نهاية الأسبوع")
    غير_ذلك => اطبع("يوم عمل")
}

// ═══════════════════════════════════════════
// المصفوفات
// ═══════════════════════════════════════════

اعرض_بناء_مصفوفة()
اعرض_مصفوفة_ثنائية()

اطبع("=== انتهى ===")

الحمد_لله
