// حاسبة بسيطة للويب
// Simple Web Calculator
//
// ترجم هذا الملف إلى WebAssembly:
// Compile this file to WebAssembly:
//   tarqeem compile حاسبة.ترقيم --emit-wasm --wasm-js-bindings --wasm-export-all -o حاسبة

// دالة الجمع - تُصدّر لاستخدامها في JavaScript
// Addition function - exported for JavaScript use
صدّر دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب;
}

// دالة الطرح
// Subtraction function
صدّر دالة طرح(أ: عدد، ب: عدد) -> عدد {
    أرجع أ - ب;
}

// دالة الضرب
// Multiplication function
صدّر دالة ضرب(أ: عدد، ب: عدد) -> عدد {
    أرجع أ * ب;
}

// دالة القسمة
// Division function
صدّر دالة قسمة(أ: عدد، ب: عدد) -> عدد {
    إذا (ب == 0) {
        أرجع 0;  // تجنب القسمة على صفر
    }
    أرجع أ / ب;
}

// دالة القوة
// Power function
صدّر دالة حساب_القوة(أساس: عدد، أس: عدد) -> عدد {
    متغير نتيجة = 1;
    لكل (متغير ع = 0؛ ع < أس؛ ع++) {
        نتيجة = نتيجة * أساس;
    }
    أرجع نتيجة;
}

// دالة باقي القسمة
// Modulo function
صدّر دالة حساب_الباقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب;
}

// دالة حساب المضروب
// Factorial function
صدّر دالة مضروب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1;
    }
    أرجع ن * مضروب(ن - 1);
}

// دالة حساب متتالية فيبوناتشي
// Fibonacci function
صدّر دالة فيبوناتشي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

