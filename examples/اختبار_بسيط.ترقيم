بسم_الله

// اختبار بسيط جداً للمترجم

// دالة جمع
دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب;
}

// دالة ضرب
دالة ضرب(أ: عدد، ب: عدد) -> عدد {
    أرجع أ * ب;
}

// دالة مع متغير محلي
دالة مضاعفة(س: عدد) -> عدد {
    متغير نتيجة = س * 2;
    أرجع نتيجة;
}

// دالة مع شرط
دالة القيمة_المطلقة(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع 0 - س;
    }
    أرجع س;
}

// دالة تعاودية 
دالة احسب_عاملي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1;
    }
    أرجع ن * احسب_عاملي(ن - 1);
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== اختبار بسيط ===");

    متغير س = 5;
    متغير ع = 3;

    متغير مجموع = جمع(س، ع);
    اطبع("5 + 3 = ");
    اطبع(مجموع);

    متغير حاصل = ضرب(س، ع);
    اطبع("5 * 3 = ");
    اطبع(حاصل);

    متغير مضاعف = مضاعفة(س);
    اطبع("5 * 2 = ");
    اطبع(مضاعف);

    متغير مطلق = القيمة_المطلقة(0 - 7);
    اطبع("|-7| = ");
    اطبع(مطلق);

    متغير عاملي_خمسة = احسب_عاملي(5);
    اطبع("5! = ");
    اطبع(عاملي_خمسة);

    اطبع("=== انتهى ===");
}

