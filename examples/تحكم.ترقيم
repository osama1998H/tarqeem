// أمثلة على التحكم بالتدفق
// Examples of control flow

متغير عمر = 20;

// الشرط إذا-وإلا
إذا (عمر >= 18) {
    اطبع("بالغ");
} وإلا إذا (عمر >= 13) {
    اطبع("مراهق");
} وإلا {
    اطبع("طفل");
}

// حلقة طالما
متغير عداد = 0;
طالما (عداد < 5) {
    اطبع(عداد);
    عداد++;
}

// حلقة لكل
لكل (متغير ع = 0؛ ع < 10؛ ع++) {
    اطبع(ع);
}

// حلقة لكل-في
ثابت أرقام = [1، 2، 3، 4، 5];
لكل رقم في أرقام {
    اطبع(رقم * 2);
}

// التطابق
متغير يوم = "السبت";
تطابق (يوم) {
    حالة "السبت"، "الأحد" => اطبع("عطلة")
    حالة "الجمعة" => اطبع("نهاية الأسبوع")
    غير_ذلك => اطبع("يوم عمل")
}
