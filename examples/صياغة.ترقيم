/// الصياغة: وضع البرنامج، توزيع الكود على أسطر، وأسماء من كلمات مفتاحية
///
/// يوضّح هذا الملف نقطة الدخول الصريحة `دالة رئيسية()`، وما تسمح به الصياغة
/// داخل الأقواس المفتوحة وما لا تسمح به خارجها، وأسماء الأعضاء المأخوذة من
/// أسماء الأنماط.
///
/// @منذ ١.١.٠

// ═══════════════════════════════════════════
// وضع البرنامج
//
// في وضع البرنامج تُنفَّذ الجمل داخل «رئيسية» وحدها. الإعلانات العليا
// (متغير، ثابت، دالة، صنف، تعداد) مسموحة؛ أما جملة تنفيذية في المستوى
// الأعلى فتتعارض مع وجود «رئيسية» وتُنتج الخطأ ت٠٢٠١.
// ═══════════════════════════════════════════

// متغيرات عامة — إعلانات، لا جمل تنفيذية
/// اسم اللغة، يُقرأ داخل «رئيسية»
متغير الاسم: نص = "ترقيم"
ثابت الإصدار = "1.0.0"

/// حيِّ شخصاً باسمه
دالة تحية(اسم: نص) {
    اطبع("مرحباً يا " + اسم + "!")
}

/// احسب مضروب عدد تعاودياً
///
/// @معامل ن - العدد
/// @أرجع حاصل ضرب الأعداد من ١ إلى ن
دالة مضروب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }
    أرجع ن * مضروب(ن - 1)
}

// ═══════════════════════════════════════════
// قائمة معاملات موزعة على أسطر
// ═══════════════════════════════════════════

/// اجمع ثلاثة أعداد
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @معامل ج - العدد الثالث
/// @أرجع مجموع الأعداد الثلاثة
دالة اجمع(
    أ: عدد،
    ب: عدد،
    ج: عدد
) -> عدد {
    أرجع أ + ب + ج
}

// ═══════════════════════════════════════════
// أسماء مأخوذة من أسماء الأنماط
// ═══════════════════════════════════════════

/// صنف يستخدم أسماء الأنماط أسماءً لأعضائه
صنف بطاقة {
    // «نص» اسم نمط، ويصلح اسماً لحقل
    خاص نص: نص
    خاص ترتيب: عدد

    منشئ(نص: نص، ترتيب: عدد) {
        هذا.نص = نص
        هذا.ترتيب = ترتيب
    }

    /// «عدد» اسم نمط، ويصلح اسماً لدالة عضو
    ///
    /// @أرجع رقم ترتيب البطاقة
    عام دالة عدد() -> عدد {
        أرجع هذا.ترتيب
    }

    /// اقرأ النص المحفوظ
    ///
    /// @أرجع النص
    عام دالة اقرأ() -> نص {
        أرجع هذا.نص
    }
}

/// حالات نتيجة العملية — «خطأ» يصلح اسماً لحالة تعداد
تعداد النتيجة {
    نجح،
    خطأ
}

// ═══════════════════════════════════════════
// نقطة الدخول
// ═══════════════════════════════════════════

دالة رئيسية() {
    اطبع("=== وضع البرنامج ===")
    اطبع("الإصدار: " + الإصدار)

    تحية(الاسم)

    اطبع("مضروب 5 = " + مضروب(5))
    اطبع("مضروب 10 = " + مضروب(10))

    اطبع("=== الأسطر المتعددة ===")

    // استدعاء موزع على أسطر
    متغير مجموع = اجمع(
        1،
        2،
        3
    )
    اطبع("المجموع: " + مجموع)

    // قيمة مصفوفة موزعة
    ثابت أرقام = [
        10، 20،
        30
    ]
    اطبع("العنصر الثاني: " + أرقام[1])

    // شرط طويل موزع بين قوسي «إذا»
    إذا (مجموع > 5 &&
         مجموع < 10) {
        اطبع("المجموع في النطاق")
    }

    // تعبير موزع: الأقواس هي ما يسمح بذلك
    ثابت متطابق = (مجموع == 6 &&
                   أرقام[0] == 10)
    اطبع("متطابق: " + متطابق)

    اطبع("=== أسماء من كلمات مفتاحية ===")

    متغير بطاقتي = جديد بطاقة("ترقيم"، 7)
    اطبع("النص: " + بطاقتي.اقرأ())
    اطبع("العدد: " + بطاقتي.عدد())

    متغير حالة_العملية = النتيجة::خطأ
    تطابق (حالة_العملية) {
        حالة النتيجة::نجح => اطبع("الحالة: نجح")
        حالة النتيجة::خطأ => اطبع("الحالة: خطأ")
        غير_ذلك => اطبع("الحالة: غير معروفة")
    }

    // «خطأ» المجرَّدة تبقى قيمة منطقية
    اطبع("القيمة المنطقية: " + خطأ)

    اطبع("=== الأرقام العربية-الهندية ===")

    // الأرقام ٠-٩ تُقبل حيث تُقبل 0-9، وقيمتها واحدة. بقية هذا الملف تكتبها
    // بالأرقام اللاتينية كما تفعل بقية الأمثلة.
    ثابت بالعربية = ٤٢
    اطبع("٤٢ == 42: " + (بالعربية == 42))

    اطبع("=== الصيغة الأُسية ===")

    ثابت صغير: عدد_عشري = 2.5e-3
    ثابت كبير: عدد_عشري = 1.5e3
    اطبع("صغير: " + صغير)
    اطبع("كبير: " + كبير)

    اطبع("=== انتهى البرنامج ===")
}

