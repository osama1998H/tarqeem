// اختبار المصفوفات -
// :  (قائمة، مكدس، طابور)

// - اختبار المصفوفة
دالة اختبار_مصفوفة() {
    اطبع("=== اختبار المصفوفة ===")

    متغير أرقام: مصفوفة<عدد> = []

    أرقام.ألحق(10)
    أرقام.ألحق(20)
    أرقام.ألحق(30)

    اطبع("الطول: ")
    اطبع(طول(أرقام))

    اطبع("العنصر الأول: ")
    اطبع(أرقام[0])

    اطبع("العنصر الأخير: ")
    اطبع(أرقام[2])

    اطبع("جميع العناصر:")
    لكل رقم في أرقام {
        اطبع(رقم)
    }
}

دالة اختبار_عمليات() {
    اطبع("=== اختبار العمليات ===")

    ثابت أسماء = ["أحمد"، "محمد"، "علي"]
    اطبع("الأسماء:")
    لكل اسم في أسماء {
        اطبع(اسم)
    }
    اطبع("عدد الأسماء: ")
    اطبع(طول(أسماء))
}

دالة اختبار_مصفوفة_ثنائية() {
    اطبع("=== اختبار المصفوفة الثنائية ===")

    متغير شبكة: مصفوفة<مصفوفة<عدد>> = []

    متغير صف1: مصفوفة<عدد> = [1، 2، 3]
    متغير صف2: مصفوفة<عدد> = [4، 5، 6]

    شبكة.ألحق(صف1)
    شبكة.ألحق(صف2)

    اطبع("عدد الصفوف: ")
    اطبع(طول(شبكة))

    اطبع("محتوى الصف الأول:")
    لكل عنصر في شبكة[0] {
        اطبع(عنصر)
    }
}

دالة رئيسية() {
    اختبار_مصفوفة()
    اختبار_عمليات()
    اختبار_مصفوفة_ثنائية()
    اطبع("=== انتهى الاختبار ===")
}

رئيسية()

