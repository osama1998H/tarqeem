// اختبار المصفوفات - Array Test
// Test built-in array functionality
// Note: stdlib classes (قائمة، مكدس، طابور) require import system fix

// Test Array - اختبار المصفوفة
دالة اختبار_مصفوفة() {
    اطبع("=== اختبار المصفوفة ===")

    // Create an array
    متغير أرقام: مصفوفة<عدد> = []

    // Add elements using append
    أرقام.ألحق(10)
    أرقام.ألحق(20)
    أرقام.ألحق(30)

    اطبع("الطول: ")
    اطبع(طول(أرقام))

    // Access elements by index
    اطبع("العنصر الأول: ")
    اطبع(أرقام[0])

    اطبع("العنصر الأخير: ")
    اطبع(أرقام[2])

    // Iterate over array
    اطبع("جميع العناصر:")
    لكل رقم في أرقام {
        اطبع(رقم)
    }
}

// Test array operations
دالة اختبار_عمليات() {
    اطبع("=== اختبار العمليات ===")

    ثابت أسماء = ["أحمد"، "محمد"، "علي"]
    اطبع("الأسماء:")
    لكل اسم في أسماء {
        اطبع(اسم)
    }
    اطبع("عدد الأسماء: ")
    اطبع(طول(أسماء))
}

// Test nested arrays (2D)
دالة اختبار_مصفوفة_ثنائية() {
    اطبع("=== اختبار المصفوفة الثنائية ===")

    متغير شبكة: مصفوفة<مصفوفة<عدد>> = []

    متغير صف1: مصفوفة<عدد> = [1، 2، 3]
    متغير صف2: مصفوفة<عدد> = [4، 5، 6]

    شبكة.ألحق(صف1)
    شبكة.ألحق(صف2)

    اطبع("عدد الصفوف: ")
    اطبع(طول(شبكة))

    اطبع("محتوى الصف الأول:")
    لكل عنصر في شبكة[0] {
        اطبع(عنصر)
    }
}

// Main function
دالة رئيسية() {
    اختبار_مصفوفة()
    اختبار_عمليات()
    اختبار_مصفوفة_ثنائية()
    اطبع("=== انتهى الاختبار ===")
}

