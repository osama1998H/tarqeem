بسم_الله

/// توزيع الكود على أسطر متعددة، وأسماء من كلمات مفتاحية
///
/// يوضّح هذا المثال ما تسمح به الصياغة داخل الأقواس المفتوحة، وما لا تسمح به
/// خارجها، وأسماء الأعضاء المأخوذة من أسماء الأنماط.
///
/// @منذ ١.١.٠

// ═══════════════════════════════════════════
// قائمة معاملات موزعة على أسطر
// ═══════════════════════════════════════════

/// اجمع ثلاثة أعداد
///
/// @معامل أ - العدد الأول
/// @معامل ب - العدد الثاني
/// @معامل ج - العدد الثالث
/// @أرجع مجموع الأعداد الثلاثة
دالة اجمع(
    أ: عدد،
    ب: عدد،
    ج: عدد
) -> عدد {
    أرجع أ + ب + ج
}

// ═══════════════════════════════════════════
// أسماء مأخوذة من أسماء الأنماط
// ═══════════════════════════════════════════

/// صنف يستخدم أسماء الأنماط أسماءً لأعضائه
صنف بطاقة {
    // «نص» اسم نمط، ويصلح اسماً لحقل
    خاص نص: نص
    خاص ترتيب: عدد

    منشئ(نص: نص، ترتيب: عدد) {
        هذا.نص = نص
        هذا.ترتيب = ترتيب
    }

    /// «عدد» اسم نمط، ويصلح اسماً لدالة عضو
    ///
    /// @أرجع رقم ترتيب البطاقة
    عام دالة عدد() -> عدد {
        أرجع هذا.ترتيب
    }

    /// اقرأ النص المحفوظ
    ///
    /// @أرجع النص
    عام دالة اقرأ() -> نص {
        أرجع هذا.نص
    }
}

/// حالات نتيجة العملية — «خطأ» يصلح اسماً لحالة تعداد
تعداد النتيجة {
    نجح،
    خطأ
}

دالة رئيسية() {
    اطبع("=== الأسطر المتعددة ===")

    // استدعاء موزع على أسطر
    متغير مجموع = اجمع(
        ١،
        ٢،
        ٣
    )
    اطبع("المجموع: " + مجموع)

    // قيمة مصفوفة موزعة
    ثابت أرقام = [
        ١٠، ٢٠،
        ٣٠
    ]
    اطبع("العنصر الثاني: " + أرقام[١])

    // شرط طويل موزع بين قوسي «إذا»
    إذا (مجموع > ٥ &&
         مجموع < ١٠) {
        اطبع("المجموع في النطاق")
    }

    // تعبير موزع: الأقواس هي ما يسمح بذلك
    ثابت متطابق = (مجموع == ٦ &&
                   أرقام[٠] == ١٠)
    اطبع("متطابق: " + متطابق)

    اطبع("=== أسماء من كلمات مفتاحية ===")

    متغير بطاقتي = جديد بطاقة("ترقيم"، ٧)
    اطبع("النص: " + بطاقتي.اقرأ())
    اطبع("العدد: " + بطاقتي.عدد())

    متغير حالة_العملية = النتيجة::خطأ
    تطابق (حالة_العملية) {
        حالة النتيجة::نجح => اطبع("الحالة: نجح")
        حالة النتيجة::خطأ => اطبع("الحالة: خطأ")
        غير_ذلك => اطبع("الحالة: غير معروفة")
    }

    // «خطأ» المجرَّدة تبقى قيمة منطقية
    اطبع("القيمة المنطقية: " + خطأ)

    اطبع("=== الصيغة الأُسية ===")

    ثابت صغير: عدد_عشري = ٢.٥e-٣
    ثابت كبير: عدد_عشري = ١.٥e٣
    اطبع("صغير: " + صغير)
    اطبع("كبير: " + كبير)
}

