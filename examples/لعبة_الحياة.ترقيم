/// لعبة الحياة لكونواي — برنامج كامل على شبكة ثنائية الأبعاد
///
/// يبني هذا المثال شبكة ملتفّة الأطراف، ويطبّق قواعد كونواي عليها خمسة أجيال.
/// يجمع المصفوفات المتداخلة، والحلقات المتشعّبة، و«استمر»، وبناء النص داخل حلقة.
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// ثوابت الشبكة
// ═══════════════════════════════════════════

/// عدد أعمدة الشبكة
ثابت عرض = 20
ثابت ارتفاع = 10
ثابت اجيال = 5

// رموز العرض
ثابت خلية_حية = "█"
ثابت خلية_ميتة = "░"

/// أنشئ شبكة جديدة بالأبعاد المطلوبة
دالة انشاء_شبكة(ع: عدد، ط: عدد) -> مصفوفة<مصفوفة<منطقي>> {
    متغير شبكة: مصفوفة<مصفوفة<منطقي>> = []

    لكل (متغير ص = 0؛ ص < ط؛ ص++) {
        متغير صف: مصفوفة<منطقي> = []
        لكل (متغير س = 0؛ س < ع؛ س++) {
            صف.ألحق(خطأ)
        }
        شبكة.ألحق(صف)
    }

    أرجع شبكة
}

/// عُدّ الجيران الأحياء حول خلية، مع التفاف الأطراف
دالة عد_الجيران(شبكة: مصفوفة<مصفوفة<منطقي>>، س: عدد، ص: عدد) -> عدد {
    متغير العدد = 0

    // فحص الجيران الثمانية
    لكل (متغير دص = -1؛ دص <= 1؛ دص++) {
        لكل (متغير دس = -1؛ دس <= 1؛ دس++) {
            // تجاهل الخلية نفسها
            إذا (دص == 0 && دس == 0) {
                استمر
            }

            // حساب إحداثيات الجار مع الالتفاف
            متغير جار_س = (س + دس + عرض) % عرض
            متغير جار_ص = (ص + دص + ارتفاع) % ارتفاع

            // عد الجار إذا كان حياً
            إذا (شبكة[جار_ص][جار_س]) {
                العدد++
            }
        }
    }

    أرجع العدد
}

/// احسب الجيل التالي بتطبيق قواعد كونواي
دالة الجيل_التالي(شبكة: مصفوفة<مصفوفة<منطقي>>) -> مصفوفة<مصفوفة<منطقي>> {
    متغير شبكة_جديدة = انشاء_شبكة(عرض، ارتفاع)

    لكل (متغير ص = 0؛ ص < ارتفاع؛ ص++) {
        لكل (متغير س = 0؛ س < عرض؛ س++) {
            متغير جيران = عد_الجيران(شبكة، س، ص)
            متغير حية = شبكة[ص][س]

            // قواعد كونواي:
            // 1. خلية حية مع 2 أو 3 جيران تبقى حية
            // 2. خلية ميتة مع 3 جيران بالضبط تصبح حية
            // 3. أي حالة أخرى تموت/تبقى ميتة

            إذا (حية && (جيران == 2 || جيران == 3)) {
                شبكة_جديدة[ص][س] = صحيح
            } وإلا إذا (!حية && جيران == 3) {
                شبكة_جديدة[ص][س] = صحيح
            } وإلا {
                شبكة_جديدة[ص][س] = خطأ
            }
        }
    }

    أرجع شبكة_جديدة
}

/// اطبع الشبكة مسبوقة برقم جيلها
دالة اطبع_الشبكة(شبكة: مصفوفة<مصفوفة<منطقي>>، رقم_الجيل: عدد) {
    اطبع("═══════════════════════════════════")
    اطبع("الجيل رقم: " + رقم_الجيل)
    اطبع("═══════════════════════════════════")

    لكل صف في شبكة {
        متغير سطر = ""
        لكل خلية في صف {
            إذا (خلية) {
                سطر = سطر + خلية_حية
            } وإلا {
                سطر = سطر + خلية_ميتة
            }
        }
        اطبع(سطر)
    }
    اطبع("")
}

/// أضف نمط الطائرة الشراعية (Glider)
دالة اضف_طائرة(شبكة: مصفوفة<مصفوفة<منطقي>>، س: عدد، ص: عدد) {
    // نمط الطائرة الشراعية:
    //   █
    //     █
    // █ █ █
    شبكة[ص][س + 1] = صحيح
    شبكة[ص + 1][س + 2] = صحيح
    شبكة[ص + 2][س] = صحيح
    شبكة[ص + 2][س + 1] = صحيح
    شبكة[ص + 2][س + 2] = صحيح
}

/// أضف نمط المذبذب (Blinker)
دالة اضف_مذبذب(شبكة: مصفوفة<مصفوفة<منطقي>>، س: عدد، ص: عدد) {
    // نمط المذبذب (أفقي):
    // █ █ █
    شبكة[ص][س] = صحيح
    شبكة[ص][س + 1] = صحيح
    شبكة[ص][س + 2] = صحيح
}

/// أضف نمط الكتلة الثابتة (Block)
دالة اضف_كتلة(شبكة: مصفوفة<مصفوفة<منطقي>>، س: عدد، ص: عدد) {
    // نمط الكتلة (ثابت لا يتغير):
    // █ █
    // █ █
    شبكة[ص][س] = صحيح
    شبكة[ص][س + 1] = صحيح
    شبكة[ص + 1][س] = صحيح
    شبكة[ص + 1][س + 1] = صحيح
}

/// عُدّ الخلايا الحية في الشبكة
دالة عد_الأحياء(شبكة: مصفوفة<مصفوفة<منطقي>>) -> عدد {
    متغير مجموع = 0

    لكل صف في شبكة {
        لكل خلية في صف {
            إذا (خلية) {
                مجموع++
            }
        }
    }

    أرجع مجموع
}

/// نقطة الدخول: تبني الشبكة وتشغّل المحاكاة
دالة رئيسية() {
    اطبع("╔═══════════════════════════════════════╗")
    اطبع("║   لعبة الحياة لكونواي - ترقيم         ║")
    اطبع("╚═══════════════════════════════════════╝")
    اطبع("")

    // إنشاء الشبكة
    متغير شبكة = انشاء_شبكة(عرض، ارتفاع)

    // إضافة الأنماط
    اضف_طائرة(شبكة، 1، 1)     // طائرة شراعية
    اضف_مذبذب(شبكة، 10، 4)    // مذبذب
    اضف_كتلة(شبكة، 15، 1)     // كتلة ثابتة

    // طباعة الحالة الأولية
    اطبع_الشبكة(شبكة، 0)
    اطبع("عدد الخلايا الحية: " + عد_الأحياء(شبكة))

    // تشغيل المحاكاة
    لكل (متغير جيل = 1؛ جيل <= اجيال؛ جيل++) {
        شبكة = الجيل_التالي(شبكة)
        اطبع_الشبكة(شبكة، جيل)
        اطبع("عدد الخلايا الحية: " + عد_الأحياء(شبكة))
    }

    اطبع("انتهت المحاكاة!")
}

