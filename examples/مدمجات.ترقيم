اطبع(بالأرقام_العربية(قيمة_رقم_عربي("٥") * 111))

// وبها تُبنى حروفٌ محسوبة عامةً، لا أرقاماً فقط: الفرق بين حرفٍ صغير
// ونظيره الكبير في اللاتينية ٣٢ رمزاً
دالة إلى_كبير_لاتيني(حرف: نص) -> نص {
    ثابت رمز = حرف_إلى_رمز(حرف)
    إذا (رمز >= 97 && رمز <= 122) {
        أرجع رمز_إلى_حرف(رمز - 32)
    }
    أرجع حرف
}

