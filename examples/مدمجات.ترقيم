// والنص في الاتجاهين. ولم يكن ذلك ممكناً بـ«نص» وحدها: «نص(٧)» تكتب «7»
// لاتينياً، ولا صيغة تكتبه «٧».

/// الرقم العربي-الهندي المقابل لقيمة من ٠ إلى ٩، و«» لغيرها
///
/// @معامل قيمة - القيمة المكتوبة
/// @أرجع رقمها العربي-الهندي
دالة رقم_عربي_من_قيمة(قيمة: عدد) -> نص {
    إذا (قيمة >= 0 && قيمة <= 9) {
        أرجع رمز_إلى_حرف(1632 + قيمة)
    }
    أرجع ""
}

/// عددٌ غير سالب مكتوباً بالأرقام العربية-الهندية
///
/// @معامل عدد - العدد المكتوب
/// @أرجع نصه بالأرقام العربية-الهندية
دالة بالأرقام_العربية(قيمة: عدد) -> نص {
    إذا (قيمة == 0) {
        أرجع رقم_عربي_من_قيمة(0)
    }
    متغير باقي = قيمة
    متغير نتيجة = ""
    طالما (باقي > 0) {
        نتيجة = رقم_عربي_من_قيمة(باقي % 10) + نتيجة
        باقي = باقي / 10
    }
    أرجع نتيجة
}

