بسم_الله

/// المدمجات: الدوال المتاحة بلا استيراد
///
/// المدمجة ليست دالة مكتبة، بل عملية لا يمكن التعبير عنها بترقيم نفسها —
/// فتنزل إلى تعليمة في التمثيل الوسيط أو إلى نداءٍ في مكتبة وقت التشغيل.
/// عمليات البتات من الأولى، و«حرف_إلى_رمز» و«رمز_إلى_حرف» من الثانية. يجمع
/// هذا الملف أمثلة
/// تُنفَّذ في الأوضاع الثلاثة (المفسّر، الترجمة الفورية، الترجمة الأصلية)
/// فيكشف التكامل المستمر أي خرج تختلف فيه الخلفيات.
///
/// @منذ ١.١.٠

// ═══════════════════════════════════════════
// بتات_و — الضرب المنطقي بين البتات
// ═══════════════════════════════════════════
//
// ترقيم لا تملك عامل «&»، فعمليات البتات دوالٌ لا رموز. وبادئة «بتات_»
// لأن «و» و«أو» كلمتان مفتاحيتان، فلا يصح أن يكون أحدهما اسماً بمفرده.

/// هل البتّ المحدد بالقناع مرفوع في الأذونات؟
///
/// @معامل أذونات - مجموعة البتات المفحوصة
/// @معامل قناع - البتّ المطلوب، مثل ٤ للقراءة
/// @أرجع صحيح إن كان البتّ مرفوعاً
دالة هل_مسموح(أذونات: عدد، قناع: عدد) -> منطقي {
    أرجع بتات_و(أذونات، قناع) != 0
}

/// البايت الأدنى من عدد — أي بتاته الثمانية الأولى
دالة البايت_الأدنى(قيمة: عدد) -> عدد {
    أرجع بتات_و(قيمة، 255)
}

اطبع("=== بتات_و ===")

// كل بتّ في الناتج مرفوع إن كان مرفوعاً في الطرفين معاً:
// 12 = 1100، و10 = 1010، فالمشترك بينهما 1000 أي 8
اطبع(بتات_و(12، 10))

// القناع الصفري يمحو كل شيء، والقناع المطابق يُبقي القيمة كما هي
اطبع(بتات_و(255، 0))
اطبع(بتات_و(7، 7))

// «عدد» صحيح ذو إشارة بـ٦٤ بتّاً، و«-1» كل بتاته مرفوعة، فهو القناع المحايد
اطبع("=== أعداد سالبة ===")
اطبع(بتات_و(-1، 255))
اطبع(بتات_و(-2، 3))
اطبع(بتات_و(-8، -3))

// الناتج عددٌ كامل الحقوق: يُجمع ويُقارن ويُمرَّر إلى الدوال. طباعته وحدها
// لا تُثبت ذلك — قيمة بنوع مفقود تُطبع سليمة ثم تُركَّب خطأً.
اطبع("=== تركيب الناتج ===")
اطبع(نوع(بتات_و(1، 1)))
اطبع(بتات_و(12، 10) + 1)
اطبع(بتات_و(12، 10) == 8)

ثابت قراءة = 4
ثابت كتابة = 2
ثابت تنفيذ = 1
ثابت أذونات_الملف = 6

اطبع("=== قناع الأذونات ===")
اطبع(هل_مسموح(أذونات_الملف، قراءة))
اطبع(هل_مسموح(أذونات_الملف، كتابة))
اطبع(هل_مسموح(أذونات_الملف، تنفيذ))

// 4660 = 0x1234، فبايته الأدنى 0x34 أي 52
اطبع("=== قصّ البتات ===")
اطبع(البايت_الأدنى(4660))

// فحص الفردية: البتّ الأدنى وحده يكفي
اطبع(بتات_و(4660، 1) == 1)
اطبع(بتات_و(4661، 1) == 1)

// ═══════════════════════════════════════════
// بتات_أو — الجمع المنطقي بين البتات
// ═══════════════════════════════════════════
//
// «بتات_و» تفحص البتات ولا تبنيها، و«بتات_أو» ترفعها. وبهما معاً يُستبدل
// حقلٌ مضغوط: تمحوه الأولى ثم تكتبه الثانية.

/// امنح إذناً جديداً دون المساس بالأذونات الأخرى
دالة امنح(أذونات: عدد، قناع: عدد) -> عدد {
    أرجع بتات_أو(أذونات، قناع)
}

/// استبدل البايت الأدنى من عدد، وأبقِ ما فوقه على حاله
///
/// «-256» معكوس قناع البايت الأدنى، وبه يُمحى الحقل قبل كتابته. وهو مكتوب
/// هنا عدداً سالباً، ثم يُحسب في «بتات_نفي» أدناه.
دالة استبدل_البايت_الأدنى(قيمة: عدد، بايت: عدد) -> عدد {
    أرجع بتات_أو(بتات_و(قيمة، -256)، بايت)
}

اطبع("=== بتات_أو ===")

// كل بتّ مرفوع في أحد الطرفين يُرفع في الناتج:
// 12 = 1100، و10 = 1010، فمجموع بتاتهما 1110 أي 14
اطبع(بتات_أو(12، 10))

// الصفر لا يرفع شيئاً، فهو المحايد هنا — بعكس دوره الماحي في «بتات_و»
اطبع(بتات_أو(255، 0))
اطبع(بتات_أو(0، 0))

// و«-1» كل بتاته مرفوعة، فهو المُبتلِع هنا والمحايد هناك
اطبع("=== أعداد سالبة (أو) ===")
اطبع(بتات_أو(-1، 0))
اطبع(بتات_أو(-2، 1))
اطبع(بتات_أو(-16، 3))

اطبع("=== تركيب الناتج (أو) ===")
اطبع(نوع(بتات_أو(1، 2)))
اطبع(بتات_أو(12، 10) + 1)
اطبع(بتات_أو(12، 10) == 14)

// أذونات_الملف = 6 أي قراءة وكتابة، فمنحُ التنفيذ يجعلها 7
اطبع("=== منح الأذونات ===")
متغير بعد_المنح = امنح(أذونات_الملف، تنفيذ)
اطبع(بعد_المنح)
اطبع(هل_مسموح(بعد_المنح، تنفيذ))
اطبع(هل_مسموح(بعد_المنح، قراءة))

// 0x1234 يصير 0x12AB أي 4779، وبايته الأدنى 0xAB أي 171
اطبع("=== استبدال حقل ===")
اطبع(استبدل_البايت_الأدنى(4660، 171))
اطبع(البايت_الأدنى(استبدل_البايت_الأدنى(4660، 171)))

// ═══════════════════════════════════════════
// بتات_أو_حصري — الجمع المنطقي الحصري بين البتات
// ═══════════════════════════════════════════
//
// «بتات_و» تفحص البتات و«بتات_أو» ترفعها، وكلتاهما لا تخفض بتّاً مرفوعاً.
// و«بتات_أو_حصري» تقلبه: يُرفع البتّ في أحد الطرفين لا في كليهما.
// و«حصري» وصفٌ لما تفعله، لا نقلاً لحروف XOR.

/// اقلب البتات التي يحددها القناع، وأبقِ ما عداها
دالة بدّل(أذونات: عدد، قناع: عدد) -> عدد {
    أرجع بتات_أو_حصري(أذونات، قناع)
}

/// متمم العدد — كل بتّ مرفوع يُخفض والعكس
///
/// «-1» كل بتاته مرفوعة، فقلبُ العدد بها يقلب بتاته جميعاً. وبهذا صار
/// معكوس القناع محسوباً بدل أن يُكتب عدداً سالباً كما في «استبدل_البايت_الأدنى» أعلاه.
دالة متمم(قيمة: عدد) -> عدد {
    أرجع بتات_أو_حصري(قيمة، -1)
}

اطبع("=== بتات_أو_حصري ===")

// 12 = 1100، و10 = 1010، فالمختلف بينهما 0110 أي 6
اطبع(بتات_أو_حصري(12، 10))

// الصفر لا يقلب شيئاً، والعدد مع نفسه يُلغي نفسه
اطبع(بتات_أو_حصري(255، 0))
اطبع(بتات_أو_حصري(7، 7))

// قلبُ القناع مرتين يعيد القيمة كما كانت — وهذا وحده ما يميز «أو_حصري»
// عن أختيها: لا تحتاج عمليةً ثانية لتتراجع
اطبع("=== القلب مرتين يعيد الأصل ===")
// «الأصل» وحدها كلمة مفتاحية — مرجع الصنف الأب — فلا تصلح اسماً هنا
ثابت قيمة_البداية = 4660
ثابت قناع_التبديل = 43981
اطبع(بدّل(بدّل(قيمة_البداية، قناع_التبديل)، قناع_التبديل) == قيمة_البداية)
اطبع(بدّل(بدّل(-7، قناع_التبديل)، قناع_التبديل) == -7)

// المتمم: ما عجزت عنه «بتات_و» و«بتات_أو» معاً
اطبع("=== المتمم ===")
اطبع(متمم(0))
اطبع(متمم(5))
اطبع(متمم(-1))

// ومنه يُحسب معكوس قناع البايت الأدنى، وهو «-256» المكتوب يدوياً أعلاه
اطبع(متمم(255))
اطبع(متمم(255) == -256)
اطبع(بتات_أو(بتات_و(4660، متمم(255))، 171))

اطبع("=== تركيب الناتج (أو_حصري) ===")
اطبع(نوع(بتات_أو_حصري(1، 2)))
اطبع(بتات_أو_حصري(12، 10) + 1)
اطبع(بتات_أو_حصري(12، 10) == 6)

// الأذونات = 6 أي قراءة وكتابة، فتبديل الكتابة يخفضها ثم يعيدها
اطبع("=== تبديل الأذونات ===")
متغير بعد_التبديل = بدّل(أذونات_الملف، كتابة)
اطبع(بعد_التبديل)
اطبع(هل_مسموح(بعد_التبديل، كتابة))
اطبع(هل_مسموح(بعد_التبديل، قراءة))
اطبع(بدّل(بعد_التبديل، كتابة) == أذونات_الملف)

// العمليات الثلاث معاً: المختلف = المجموع ناقص المشترك
اطبع("=== العلاقة بين الثلاث ===")
اطبع(بتات_أو_حصري(12، 10) == بتات_أو(12، 10) - بتات_و(12، 10))

// ═══════════════════════════════════════════
// بتات_نفي — قلب كل بتّ في العدد
// ═══════════════════════════════════════════
//
// الثلاث السابقة ثنائية، وهذه أحادية: تقلب بتات العدد جميعاً بلا قناع.
// وهي غير «ليس» المنطقية: تلك تنفي قيمة منطقية، وهذه تقلب بتات عدد.
//
// ما تفعله كان بالإمكان قبلها — «بتات_أو_حصري(س، -1)» يقلب البتات جميعاً —
// لكن ذلك الشكل يشترط في قارئه أن يعرف أن «-1» كل بتاته مرفوعة. فهذه
// تسمية للعملية لا قدرة جديدة، والمثالان أدناه يؤكدان تطابقهما.

/// معكوس القناع: البتات التي لا يشملها
دالة معكوس(قناع: عدد) -> عدد {
    أرجع بتات_نفي(قناع)
}

اطبع("=== بتات_نفي ===")

// كل بتّ مرفوع يُخفض وكل مخفوض يُرفع
اطبع(بتات_نفي(0))
اطبع(بتات_نفي(-1))
اطبع(بتات_نفي(5))

// في عدد صحيح ذي إشارة، قلب البتات هو «-س - ١» بالضبط
اطبع("=== النفي وحساب الأعداد ===")
اطبع(بتات_نفي(42) == -43)
اطبع(بتات_نفي(-43) == 42)

// والقلب مرتين يعيد الأصل، كما في «بتات_أو_حصري»
اطبع(بتات_نفي(بتات_نفي(4660)) == 4660)

// وتطابقها مع الشكل الذي كان يقوم مقامها
اطبع("=== النفي و«أو_حصري» ===")
اطبع(بتات_نفي(4660) == بتات_أو_حصري(4660، -1))
اطبع(بتات_نفي(255) == متمم(255))

// وبها يُحسب «-256» المكتوب يدوياً في «استبدل_البايت_الأدنى» أعلاه
اطبع("=== قناع محسوب ===")
اطبع(معكوس(255))
اطبع(بتات_أو(بتات_و(4660، معكوس(255))، 171))
اطبع(بتات_أو(بتات_و(4660، معكوس(255))، 171) == استبدل_البايت_الأدنى(4660، 171))

اطبع("=== تركيب الناتج (نفي) ===")
اطبع(نوع(بتات_نفي(1)))
اطبع(بتات_نفي(255) + 256)
اطبع(بتات_نفي(255) == -256)

// ═══════════════════════════════════════════
// بتات_إزاحة_يسار — نقل البتات نحو الأعلى
// ═══════════════════════════════════════════
//
// الأربع السابقة تعالج كل بتّ في موضعه: تجمعه بنظيره أو تقلبه. وهذه أول
// عملية تُغيّر المواضع نفسها — تدفع بتات العدد ن خانةً نحو اليسار، وتملأ
// الخانات التي أخلتها أصفاراً.

/// البتّ المفرد عند موضع: ١ في الموضع صفر، ٢ في الأول، ٤ في الثاني…
///
/// @معامل موضع - رقم الخانة من ٠ إلى ٦٣
/// @أرجع عدداً بتّه الوحيد المرفوع عند ذلك الموضع
دالة بتّ(موضع: عدد) -> عدد {
    أرجع بتات_إزاحة_يسار(1، موضع)
}

اطبع("=== بتات_إزاحة_يسار ===")

// الإزاحة بمقدار صفر لا تحرّك شيئاً، وكل خطوة بعدها تضاعف
اطبع(بتات_إزاحة_يسار(1، 0))
اطبع(بتات_إزاحة_يسار(1، 1))
اطبع(بتات_إزاحة_يسار(1، 10))
اطبع(بتات_إزاحة_يسار(3، 4))

// فالإزاحة يساراً ضربٌ في قوى الاثنين، ما دام البتّ الأعلى لم يبلغ خانة الإشارة
اطبع("=== الإزاحة والضرب ===")
اطبع(بتات_إزاحة_يسار(7، 5) == 7 * 2 ** 5)
اطبع(بتات_إزاحة_يسار(-6، 3) == -6 * 2 ** 3)

// «عدد» صحيح ذو إشارة بـ٦٤ بتّاً، فالخانة ٦٣ هي خانة الإشارة: البتّ الذي
// يبلغها يجعل العدد سالباً، وهنالك تنقطع علاقة الإزاحة بالضرب
اطبع("=== خانة الإشارة ===")
اطبع(بتات_إزاحة_يسار(1، 62))
اطبع(بتات_إزاحة_يسار(1، 63))

// ── مقدار الإزاحة: من ٠ إلى ٦٣ ──
//
// ما خرج عن هذا النطاق يُرجع صفراً، وهو الجواب الحسابي لا قيمةً بديلة:
// إزاحة عدد بـ٦٤ خانةً فأكثر تُخرج بتاته جميعاً خارج الأربع والستين،
// فلا يبقى منها شيء. والمقدار السالب ليس إزاحةً يميناً — لتلك اسمها.
اطبع("=== خارج النطاق ===")
اطبع(بتات_إزاحة_يسار(1، 64))
اطبع(بتات_إزاحة_يسار(255، 1000))
اطبع(بتات_إزاحة_يسار(1، -1))

// والقاعدة نفسها للمقدار المحسوب وقت التشغيل، لا للمكتوب حرفاً فحسب
متغير مقدار = 3
اطبع(بتات_إزاحة_يسار(5، مقدار))
مقدار = 64
اطبع(بتات_إزاحة_يسار(5، مقدار))

// ── الفائدة: بناء الأقنعة بدل كتابتها ──
//
// الأذونات أعلاه كُتبت أعداداً: ٤ و٢ و١. وبالإزاحة تُبنى من مواضعها، فتتضح
// العلاقة بينها. وبها تكتمل العائلة: «بتات_إزاحة_يسار» تصنع القناع،
// و«بتات_أو» ترفع بتّه، و«بتات_و» مع «بتات_نفي» تخفضه.

/// يرفع البتّ عند الموضع المحدد
دالة ارفع_بتّ(قيمة: عدد، موضع: عدد) -> عدد {
    أرجع بتات_أو(قيمة، بتّ(موضع))
}

/// يخفض البتّ عند الموضع المحدد
دالة اخفض_بتّ(قيمة: عدد، موضع: عدد) -> عدد {
    أرجع بتات_و(قيمة، بتات_نفي(بتّ(موضع)))
}

اطبع("=== الأقنعة المبنية ===")
اطبع(بتّ(0))
اطبع(بتّ(1))
اطبع(بتّ(2))
اطبع(بتّ(2) == قراءة)
اطبع(بتّ(1) == كتابة)
اطبع(بتّ(0) == تنفيذ)

اطبع("=== رفع البتّ وخفضه ===")
متغير أذونات = 0
أذونات = ارفع_بتّ(أذونات، 2)
أذونات = ارفع_بتّ(أذونات، 1)
اطبع(أذونات)
اطبع(أذونات == أذونات_الملف)
اطبع(هل_مسموح(أذونات، قراءة))
اطبع(اخفض_بتّ(أذونات، 1))
اطبع(هل_مسموح(اخفض_بتّ(أذونات، 1)، كتابة))

// وبها يُبنى قناع البايت الأدنى — ٢٥٥ — بدل كتابته: بتّ الخانة الثامنة ناقص واحد
اطبع("=== قناع محسوب بالإزاحة ===")
اطبع(بتّ(8) - 1)
اطبع(بتّ(8) - 1 == 255)
اطبع(بتات_و(4660، بتّ(8) - 1))

اطبع("=== تركيب الناتج (إزاحة) ===")
اطبع(نوع(بتات_إزاحة_يسار(1، 3)))
اطبع(بتات_إزاحة_يسار(1، 3) + 1)
اطبع(بتات_إزاحة_يسار(1، 3) == 8)

// ═══════════════════════════════════════════
// بتات_إزاحة_يمين — نقل البتات نحو الأدنى
// ═══════════════════════════════════════════
//
// الاتجاه المعاكس، وليس نظيراً مطابقاً له: الإزاحة يساراً تُخلي الخانات
// الدنيا فتملؤها أصفاراً، وهذه تُخلي الخانات العليا فتملؤها بخانة الإشارة —
// أي تكرِّر إشارة العدد. فالسالب يبقى سالباً مهما أُزيح.
//
// وبها يُقرأ الحقل الذي بنته أختها: تلك تصنع القناع في موضعه، وهذه تُنزل
// ما انتقاه القناع إلى قيمته.

/// البايت الأعلى من كلمة من ستة عشر بتّاً
///
