// وكون الجواب `""` لا «لا_شيء» يجعل الفحص قياساً للطول لا مقارنةً بالغياب
دالة إعداد(اسم: نص، افتراضي: نص) -> نص {
    متغير قيمة = متغير_بيئة(اسم)
    إذا (طول(قيمة) == 0) {
        أرجع افتراضي
    }
    أرجع قيمة
}

