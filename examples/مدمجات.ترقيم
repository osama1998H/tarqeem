// ═══════════════════════════════════════════
// احذف_مسار — حذف ما في المسار
// ═══════════════════════════════════════════
//
// أختُ «حالة_مسار»: تلك تسأل نظام الملفات، وهذه تعمل فيه. وهي أول مدمجة أساسية
// أثرُها في نظام الملفات لا رجعة فيه — «اكتب_مجرى» تكتب، لكنها لا تبلغ إلا
// المخرج القياسي ومجرى الخطأ، إذ لا شيء في اللغة يفتح ملفاً بعد.
//
// وهي «unlink(2)» للملف و«rmdir(2)» للمجلد الفارغ، وتُجمَع فيها «احذف_ملف»
// و«احذف_مجلد».
//
// والمُنتقي بينهما «lstat» لا «stat»: الوصلة الرمزية تُحذف بنفسها ولا تُرمَد،
// فهذه تعمل على **الاسم** حيث تسأل أختها عن **الهدف**. ولو اتُّبعت الوصلة لصارت
// الوصلةُ إلى مجلدٍ مرفوضةً، وهي مقبولةٌ في «احذف_ملف» اليوم؛ والأسوأ أن الوصلة
// المقطوعة تُقرأ معدومةً في «حالة_مسار»، فما بُني على «stat» لا يحذفها أبداً.
//
// وهي **غير متعدية**: المجلد غير الفارغ مرفوض، فيبقى عقد «احذف_مجلد» كما هو،
// والحذف المتعدي حلقةٌ في المكتبة القياسية لا مدمجةٌ ثانية — كما أن إنشاء
// المجلدات المتداخلة حلقةٌ لا مدمجة.
//
// والعملية كليّة: المعدوم، والاسم الفارغ، و«لا_شيء»، وما لا يُقرأ لمنع — جوابها
// «خطأ» جميعاً، ولا ترمي ولا تتوقف.
//
// ⚠ لا شيء يُحذف في هذا الملف. أما بنود النجاح فاختباراتُ الوحدة، حيث يُهيَّأ ما
// يُحذف ويُعاد تهيئته لكل خلفية. وهذا يضيّق ما تقرّر في «حالة_مسار»: المدمجة
// **الحاذفة** لا يُغيّر مثالُها هذا الحدّ ولو صار في اللغة ما يُنشئ ملفاً.

اطبع("=== احذف_مسار ===")
اطبع(احذف_مسار("لا_يوجد_هذا_المسار"))
اطبع(احذف_مسار(""))

// المجلد غير الفارغ مرفوض، و«.» غير فارغ حيث شُغِّل البرنامج — بل النظام يرفض
// «rmdir(".")» على كل حال. فالمجلد باقٍ بعد الرفض، وهذا ما تُثبته أختُها
اطبع("=== المجلد العامر ===")
اطبع(احذف_مسار("."))
اطبع(حالة_مسار("."، ٠))

// «لا_شيء» جوابها «خطأ» لا خطأ تنفيذ
اطبع("=== لا_شيء ===")
متغير غائب_حذف: نص? = لا_شيء
اطبع(احذف_مسار(غائب_حذف))

// الاسمان المجموعان، مكتوبَين أغلفةً كما يصيران في المكتبة القياسية. ولكلٍّ
// منهما فرقٌ موثَّق عند حافةٍ واحدة: النوعُ الذي يسألان عنه يأتي من
// «حالة_مسار» التي تتبع الوصلات، فالوصلةُ إلى مجلدٍ يرفضها «احذف_ملف» ويقبلها
// «احذف_مجلد» — عكسَ ما يفعله الاسمان اليوم
اطبع("=== أغلفة (حذف) ===")
دالة احذف_ملف(م: نص) -> منطقي {
    إذا (حالة_مسار(م، ٠) == ٢) {
        أرجع خطأ
    }
    أرجع احذف_مسار(م)
}
دالة احذف_مجلد(م: نص) -> منطقي {
    إذا (حالة_مسار(م، ٠) != ٢) {
        أرجع خطأ
    }
    أرجع احذف_مسار(م)
}
اطبع(احذف_ملف("."))
اطبع(احذف_مجلد("لا_يوجد_هذا_المسار"))

// الجواب «منطقي» يُسأل عن نوعه ويُنفى ويُقارَن. والطباعة وحدها لا تُثبت ذلك:
// منطقيٌّ بنوع مفقود لا تطبع منه الترجمة الأصلية شيئاً وتخرج بصفر. ولاحظ أن
// الجمع لا يصلح كاشفاً هنا كما صلح في «حالة_مسار» — العامل «+» مرفوض على
// «منطقي» في التحليل الدلالي أصلاً — فمكانه النفي
اطبع("=== تركيب الناتج (حذف) ===")
اطبع(نوع(احذف_مسار("لا_يوجد_هذا_المسار")))
اطبع(احذف_مسار("لا_يوجد_هذا_المسار") == خطأ)
إذا (ليس احذف_مسار("لا_يوجد_هذا_المسار")) {
    اطبع("لم يُحذف")
}

// ═══════════════════════════════════════════
// معاملات_البرنامج — معاملات سطر الأوامر
// ═══════════════════════════════════════════
//
// أول مدمجة تقرأ ما سُئل عنه البرنامج: «متغير_بيئة» تقرأ ما حوله، وهذه تقرأ ما
// وُجِّه إليه. وبها تكتمل أداة سطر الأوامر التي بدأتها «أنهِ_البرنامج» — تلك
// تُبلِّغ مَن شغّل البرنامج بما انتهى إليه، وهذه تقرأ ما طلبه منه.
//
// ولا يبلغها تركيبٌ ممّا قبلها: المعاملات متجهٌ آخر غير البيئة، ولا صيغة في
// اللغة تصل إليه.
//
// **واسم البرنامج ليس منها.** وهذا ما يُبقي الخلفيات متفقة: اسمه في الترجمة
// الأصلية مسارُ الملف التنفيذي، وفي المفسّر مسارُ الملف المصدري — فلو عُدَّ منها
// لاختلف الجواب بينهما أبداً. وبإخراجه يصير جوابُ البرنامج الذي لا معامل له
// مصفوفةً فارغة في الخلفيات الثلاث سواء، وهو ما يجعل هذا المثال ممكناً أصلاً.
//
// والعملية كليّة: لا معاملَ له جوابه مصفوفة فارغة — قيمةً لا سنتاً — وما ليس
// ترميزاً سليماً يُقرأ قراءةً متساهلة لا يُحذف. والنداء المتكرر يُجيب بما أجاب
// أولَ مرة: المعاملات تُقرأ ولا تُستهلَك، بخلاف «اقرأ_مجرى».
//
// ⚠ يُشغَّل هذا الملف في التكامل المستمر بلا معاملات، فالبند الوحيد الذي يظهر
// هنا هو الفارغ. أما بنود النجاح فاختباراتُ الوحدة، حيث تُمرَّر المعاملات إلى
// العملية الابنة. وهذا يضيّق ما تقرّر في «حالة_مسار» من جهةٍ أخرى: لا يُقاس
// المثال بما يستطيع تهيئته، بل بما لا يتغيّر بتغيّر طريقة تشغيله.

اطبع("=== معاملات_البرنامج ===")
متغير المعاملات = معاملات_البرنامج()
اطبع(طول(المعاملات))

// طباعة المصفوفة الفارغة سليمة في الخلفيات الثلاث لأن حلقة العناصر لا تُنفَّذ
// أصلاً. أما المصفوفة العامرة من النصوص فتطبع الترجمة الأصلية عناوين عناصرها لا
// قيمها (المسألة ٣٥٩)، فلا تُطبع هنا ولا في الاختبارات
اطبع(المعاملات)

// الحلقة على مصفوفة فارغة لا تدور، فلا يظهر منها سطر
اطبع("=== الحلقة ===")
لكل معامل في المعاملات {
    اطبع("معامل: " + معامل)
}
اطبع("انتهت الحلقة")

// النداء المتكرر يُجيب بما أجاب أولَ مرة
اطبع("=== التكرار ===")
اطبع(طول(معاملات_البرنامج()) == طول(معاملات_البرنامج()))

// النوع يُسأل عنه، والطول يُقاس. ولا يصلح هنا ما صلح في «حالة_مسار» من جمعٍ ولا
// ما صلح في «احذف_مسار» من نفي: الجواب مصفوفة، فكاشفُ النوع المفقود هو «نوع»
// وتركيبُ عنصرٍ منها — وذلك يقتضي عنصراً، فمكانه اختبارات الوحدة
اطبع("=== تركيب الناتج (معاملات) ===")
اطبع(نوع(معاملات_البرنامج()))

// ═══════════════════════════════════════════
// افتح_ملف — فتح ملف بمعرِّف يعرفه زوج المجاري
// ═══════════════════════════════════════════
//
// أول مدمجة تُنشئ **معرِّفاً** يبقى بعدها: ما قبلها من المجاري يعرف المخرج القياسي
// ومجرى الخطأ ومجرى الدخل وحدها، وبها صار للبرنامج أن يفتح ملفاً ويقرأه أو يكتب
// فيه بالبايت. وهي تجمع الفواتح الثلاث في وقت التشغيل خلف وضعٍ واحد: «٠» قراءة،
// و«١» كتابة تُنشئ أو تقتطع، و«٢» إلحاق تُنشئ ولا تمحو.
//
// والمعرِّف «٣» أو أكثر أبداً، لأن «٠» و«١» و«٢» محفوظة للمجاري القياسية — فيمضي
// الجواب إلى «اكتب_مجرى» أو «اقرأ_مجرى» بلا مزاحمة.
//
// **والجواب «-١» عند الفشل لا «٠»**، وهذا مُلزَم لا مُختار: «٠» هو مجرى الدخل، فلو
// أجاب الفشلُ به لقرأ «اقرأ_مجرى(٠، ن)» لوحة المفاتيح ونجح. والوضع يُفحص قبل
// المسار، كما تفحص «حالة_مسار» حقلها قبل مسارها، فوضعٌ مجهول لا يُنشئ شيئاً.
//
// والعملية كليّة: كل زوج (نص، عدد) نداءٌ صالح، لا ترمي ولا تتوقف.
//
// ⚠ هذا القسم يعرض **الرفض وحده**، ولا يفتح ملفاً ولا يُنشئه: المثال يجري في جذر
// المستودع، فما يُنشئه أثرٌ يبقى. ودورةُ الفتح والكتابة والقراءة كاملةً في
// اختبارات الخلفيات الثلاث، حيث للتجهيزات مجلدٌ مؤقت خاص بها.
//
// ⚠ وما يُكتب في معرِّفٍ لا يبلغ الملف يقيناً قبل نهاية البرنامج: «اكتب_مجرى» لا
// تُفرِغ المخزن في مسار المعرِّف، ولا شيء في اللغة يُغلق معرِّفاً بعد. تُفرَّغ
// الكتابات كلها عند انتهاء البرنامج، وسيُعجّلها «اغلق_ملف».

اطبع("=== افتح_ملف ===")

// مسارٌ لا شيء فيه: لا معرِّف يُفتح عليه
اطبع(افتح_ملف("لا_يوجد_هذا_الملف_في_أي_مكان.نص"، ٠))

// والاسم الفارغ كذلك
اطبع(افتح_ملف(""، ٠))

// ولا_شيء: المسار مؤشِّر، فله جوابٌ لا خطأ نوع
متغير غائب_فتح: نص? = لا_شيء
اطبع(افتح_ملف(غائب_فتح، ٠))

اطبع("=== وضع مجهول ===")

// «٣» هو «وضع_قراءة_كتابة» في stdlib/ملفات/ملف.ترقيم، ولا اتجاه هنا يخدمه —
// فيُرفض مع بقية الأوضاع المجهولة بدل أن يُخدَم بأحد نصفيه
اطبع(افتح_ملف("."، ٣))
اطبع(افتح_ملف("."، ٩))
اطبع(افتح_ملف("."، ٠ - ١))

// والمجلد مرفوض في الأوضاع الثلاثة، مخالفةً مقصودة لـ«open(2)»: النظم الشبيهة
// بيونكس تفتحه وويندوز لا يفتحه، فلو نُقل النداء حرفياً لاختلف الجواب بالمنصة —
// وذلك صفٌّ من صفوف العقد. وموضع اختباره اختبارات الخلفيات

اطبع("=== غلاف الفتح ===")

/// هل يمكن فتح المسار في هذا الوضع؟
///
/// @معامل مسار - المسار المسؤول عنه
/// @معامل وضع - ٠ قراءة، ١ كتابة، ٢ إلحاق
دالة هل_يُفتح(مسار: نص، وضع: عدد) -> منطقي {
    أرجع افتح_ملف(مسار، وضع) != ٠ - ١
}

اطبع(هل_يُفتح("لا_يوجد_هذا_الملف_في_أي_مكان.نص"، ٠))
اطبع(هل_يُفتح("."، ٩))

// النوع يُسأل عنه، والجواب عددٌ يُحسب: كاشفا النوع المفقود في المدمجات القياسية
اطبع("=== تركيب الناتج (فتح) ===")
اطبع(نوع(افتح_ملف("."، ٩)))
اطبع(افتح_ملف("."، ٩) + ١)
اطبع(افتح_ملف("."، ٩) == ٠ - ١)

// ═══════════════════════════════════════════
// أنهِ_البرنامج — الإنهاء بحالة خروج صريحة
// ═══════════════════════════════════════════
//
// ⚠ هذا القسم يبقى **آخر** الملف. ما بعد نداء الإنهاء لا يُنفَّذ، فأيّ مثال
// يُضاف بعده لن يُنفَّذ ولن يظهر في الخرج المتوقع.
//
// أول مدمجة نتيجتها المرئية **حالة الخروج** لا قيمة: بها يُبلِّغ البرنامج مَن
// شغّله بما انتهى إليه، وهو ما لم يكن ممكناً قبلها — «توقف» حالتها ١ دائماً
// وتطبع رسالة، ونداءات الإنهاء في مكتبة وقت التشغيل كلها مثبَّتة على ١.
//
// والحالة هي «حالة & ٢٥٥» — ثمانية بتات هي عرض حالة الخروج في النظام، و«عدد»
// أربع وستون — فالعملية كليّة: ٣٠٠ تصير ٤٤، و-١ تصير ٢٥٥، و٢٥٦ تصير ٠. والقناع
// يُطبَّق في الخلفيات كلها لا في النظام، فالجواب واحد على كل منصة.
//
// ولا تلتقطها «حاول»: هي إنهاءٌ لا استثناء، فتمرّ بكل معالج.

/// أنهِ البرنامج إن كان الإعداد ناقصاً
///
/// @معامل مكتمل - هل اكتملت الإعدادات؟
دالة تحقق_من_الإعداد(مكتمل: منطقي) {
    إذا (ليس مكتمل) {
        أنهِ_البرنامج(١)
    }
}

اطبع("=== أنهِ_البرنامج ===")
تحقق_من_الإعداد(صحيح)
اطبع("الإعداد مكتمل")

// وحالة ٠ هي النجاح، وهي وحدها ما يصلح في هذا الملف: كل مهمة في التكامل المستمر
// تفشل على حالة غير صفرية. أما الحالات غير الصفرية فتغطيها اختبارات الوحدة
اطبع("=== قبل الإنهاء ===")
أنهِ_البرنامج(٠)

// السطر التالي لا يُنفَّذ، وغيابه من الخرج المتوقع هو البرهان
اطبع("لا يُطبع — ما بعد الإنهاء لا يُنفَّذ")

