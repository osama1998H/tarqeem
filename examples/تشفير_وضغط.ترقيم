/// التشفير والضغط: بصمة SHA-256، الترميز الست عشري، وضغط GZIP
///
/// يستورد هذا الملف من وحدتين قياسيتين، ويتحقق من سلامة البيانات بمقارنة
/// البصمات قبل الضغط وبعد فكّه.
///
/// @منذ ١.٠.٠

استورد { احسب_بصمة، طابق_بصمة، إلى_ست_عشري، من_ست_عشري } من "تشفير"
استورد { اضغط، فك_الضغط } من "ضغط"

// ═══════════════════════════════════════════
// البصمة: SHA-256
// ═══════════════════════════════════════════

اطبع("=== البصمة ===")

متغير محتوى = "مرحباً بالعالم"
متغير بصمة = احسب_بصمة(محتوى)
اطبع("النص: " + محتوى)
اطبع("البصمة: " + بصمة)

// النص نفسه يعطي البصمة نفسها دائماً
متغير بصمة٢ = احسب_بصمة("مرحباً بالعالم")
إذا (طابق_بصمة(بصمة، بصمة٢)) {
    اطبع("البصمتان متطابقتان!")
} وإلا {
    اطبع("البصمتان مختلفتان")
}

// ونص مختلف يعطي بصمة مختلفة
متغير بصمة_مختلفة = احسب_بصمة("محتوى مختلف")
اطبع("بصمة المحتوى المختلف: " + بصمة_مختلفة)

إذا (طابق_بصمة(بصمة، بصمة_مختلفة)) {
    اطبع("خطأ: يجب أن تكون مختلفة!")
} وإلا {
    اطبع("صحيح: البصمات مختلفة كما هو متوقع")
}

// ═══════════════════════════════════════════
// الترميز الست عشري
// ═══════════════════════════════════════════

اطبع("=== الترميز الست عشري ===")

متغير نص_للترميز = "ترقيم"
متغير مرمز = إلى_ست_عشري(نص_للترميز)
اطبع("النص الأصلي: " + نص_للترميز)
اطبع("الترميز الست عشري: " + مرمز)
اطبع("بعد فك الترميز: " + من_ست_عشري(مرمز))

// ═══════════════════════════════════════════
// الضغط: GZIP
//
// تنبيه: «طول» تعدّ الأحرف في المفسّر والبايتات في الترجمة الأصلية، فأطوال
// النص العربي أدناه تختلف بين الوضعين — المسألة ١٨٥. لذلك يحمل هذا الملف
// المدخل «تشفير_وضغط:native» في KNOWN_DIVERGENT بملف examples.yml.
// ═══════════════════════════════════════════

اطبع("=== الضغط ===")

متغير نص_طويل = "هذا نص طويل يتكرر عدة مرات. "
نص_طويل = نص_طويل + نص_طويل + نص_طويل + نص_طويل
نص_طويل = نص_طويل + نص_طويل + نص_طويل + نص_طويل

اطبع("طول النص الأصلي: " + نص(طول(نص_طويل)) + " حرف")

متغير مضغوط = اضغط(نص_طويل)
اطبع("حجم البيانات المضغوطة: " + نص(طول(مضغوط)) + " بايت")

متغير نسبة = (طول(مضغوط) * 100) / طول(نص_طويل)
اطبع("نسبة الضغط: " + نص(نسبة) + "%")

متغير مفكوك = فك_الضغط(مضغوط)
اطبع("طول النص بعد فك الضغط: " + نص(طول(مفكوك)) + " حرف")

// التحقق الأول: مقارنة نصية مباشرة
إذا (نص_طويل == مفكوك) {
    اطبع("تم التحقق: البيانات سليمة بعد فك الضغط!")
} وإلا {
    اطبع("خطأ: البيانات تالفة!")
}

// التحقق الثاني: مقارنة البصمتين
إذا (طابق_بصمة(احسب_بصمة(نص_طويل)، احسب_بصمة(مفكوك))) {
    اطبع("تطابق البصمات: البيانات متطابقة تماماً!")
}

الحمد_لله
