بسم_الله

// مثال على استخدام الخواص (Properties) في ترقيم

// صنف نقطة مع خاصية تلقائية
صنف نقطة {
    // خواص تلقائية مع قيم افتراضية
    خاصية س: عدد = 0
    خاصية ص: عدد = 0

    منشئ(س: عدد، ص: عدد) {
        هذا.س = س
        هذا.ص = ص
    }
}

// صنف شخص مع خواص متعددة
صنف شخص {
    // حقول داعمة خاصة
    خاص _اسم: نص
    خاص _عمر: عدد

    // منشئ
    منشئ(اسم: نص، عمر: عدد) {
        هذا._اسم = اسم
        هذا._عمر = عمر
    }

    // خاصية مع احصل وعيّن كاملة
    خاصية اسم: نص {
        احصل {
            أرجع هذا._اسم
        }
        عيّن(قيمة) {
            هذا._اسم = قيمة
        }
    }

    // خاصية للقراءة فقط
    خاصية عمر: عدد {
        احصل {
            أرجع هذا._عمر
        }
    }
}

// الاختبار
متغير ن = جديد نقطة(3، 4)
اطبع(ن.س)
اطبع(ن.ص)

متغير ش = جديد شخص("أحمد"، 25)
اطبع(ش.اسم)
اطبع(ش.عمر)

ش.اسم = "محمد"
اطبع(ش.اسم)

الحمد_لله
