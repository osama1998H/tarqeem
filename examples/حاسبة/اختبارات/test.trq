بسم_الله

// اختبارات الحاسبة العلمية
//
// هذا الملف يحتوي على اختبارات للتحقق من صحة
// وظائف الحاسبة الأساسية

// ═══════════════════════════════════════════
// دوال مساعدة
// ═══════════════════════════════════════════

// القيمة المطلقة
دالة مطلق_صحيح(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع 0 - س;
    }
    أرجع س;
}

// التحقق من عدد أولي
دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) { أرجع خطأ; }
    إذا (ن <= 3) { أرجع صحيح; }
    إذا (ن % 2 == 0) { أرجع خطأ; }
    متغير ع = 3;
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0) { أرجع خطأ; }
        ع = ع + 2;
    }
    أرجع صحيح;
}

// التحقق من زوجي
دالة زوجي(ن: عدد) -> منطقي {
    أرجع ن % 2 == 0;
}

// التحقق من فردي
دالة فردي(ن: عدد) -> منطقي {
    أرجع ن % 2 != 0;
}

// العاملي
دالة عاملي_حساب(ن: عدد) -> عدد {
    إذا (ن <= 1) { أرجع 1; }
    متغير نتيجة = 1;
    متغير ع = 2;
    طالما (ع <= ن) {
        نتيجة = نتيجة * ع;
        ع = ع + 1;
    }
    أرجع نتيجة;
}

// القاسم المشترك الأكبر
دالة قاسم_اكبر(أ: عدد، ب: عدد) -> عدد {
    متغير س = مطلق_صحيح(أ);
    متغير ص = مطلق_صحيح(ب);
    طالما (ص != 0) {
        متغير مؤقت = ص;
        ص = س % ص;
        س = مؤقت;
    }
    أرجع س;
}

// المضاعف المشترك الأصغر
دالة مضاعف_اصغر(أ: عدد، ب: عدد) -> عدد {
    إذا (أ == 0 || ب == 0) { أرجع 0; }
    أرجع مطلق_صحيح(أ * ب) / قاسم_اكبر(أ، ب);
}

// ═══════════════════════════════════════════
// اختبارات الدوال الرياضية الأساسية
// ═══════════════════════════════════════════

دالة اختبار_مطلق() {
    إذا (مطلق_صحيح(-5) != 5) { اطبع("فشل: مطلق(-5)\n"); }
    إذا (مطلق_صحيح(5) != 5) { اطبع("فشل: مطلق(5)\n"); }
    إذا (مطلق_صحيح(0) != 0) { اطبع("فشل: مطلق(0)\n"); }
}

// ═══════════════════════════════════════════
// اختبارات نظرية الأعداد
// ═══════════════════════════════════════════

دالة اختبار_اولي() {
    إذا (اولي(2) != صحيح) { اطبع("فشل: اولي(2)\n"); }
    إذا (اولي(7) != صحيح) { اطبع("فشل: اولي(7)\n"); }
    إذا (اولي(11) != صحيح) { اطبع("فشل: اولي(11)\n"); }
    إذا (اولي(4) != خطأ) { اطبع("فشل: اولي(4)\n"); }
    إذا (اولي(1) != خطأ) { اطبع("فشل: اولي(1)\n"); }
}

دالة اختبار_عاملي() {
    إذا (عاملي_حساب(0) != 1) { اطبع("فشل: عاملي(0)\n"); }
    إذا (عاملي_حساب(1) != 1) { اطبع("فشل: عاملي(1)\n"); }
    إذا (عاملي_حساب(5) != 120) { اطبع("فشل: عاملي(5)\n"); }
    إذا (عاملي_حساب(6) != 720) { اطبع("فشل: عاملي(6)\n"); }
}

دالة اختبار_زوجي_فردي() {
    إذا (زوجي(2) != صحيح) { اطبع("فشل: زوجي(2)\n"); }
    إذا (زوجي(4) != صحيح) { اطبع("فشل: زوجي(4)\n"); }
    إذا (زوجي(3) != خطأ) { اطبع("فشل: زوجي(3)\n"); }
    إذا (فردي(3) != صحيح) { اطبع("فشل: فردي(3)\n"); }
    إذا (فردي(2) != خطأ) { اطبع("فشل: فردي(2)\n"); }
}

دالة اختبار_قاسم_مشترك() {
    إذا (قاسم_اكبر(12، 8) != 4) { اطبع("فشل: قاسم(12,8)\n"); }
    إذا (قاسم_اكبر(21، 14) != 7) { اطبع("فشل: قاسم(21,14)\n"); }
    إذا (قاسم_اكبر(17، 13) != 1) { اطبع("فشل: قاسم(17,13)\n"); }
}

دالة اختبار_مضاعف_مشترك() {
    إذا (مضاعف_اصغر(4، 6) != 12) { اطبع("فشل: مضاعف(4,6)\n"); }
    إذا (مضاعف_اصغر(3، 5) != 15) { اطبع("فشل: مضاعف(3,5)\n"); }
}

// ═══════════════════════════════════════════
// الدالة الرئيسية للاختبارات
// ═══════════════════════════════════════════

دالة رئيسي() {
    اطبع("جاري تشغيل الاختبارات...\n");

    اختبار_مطلق();
    اطبع("✓ اختبار المطلق نجح\n");

    اختبار_اولي();
    اطبع("✓ اختبار الأولي نجح\n");

    اختبار_عاملي();
    اطبع("✓ اختبار العاملي نجح\n");

    اختبار_زوجي_فردي();
    اطبع("✓ اختبار الزوجي والفردي نجح\n");

    اختبار_قاسم_مشترك();
    اطبع("✓ اختبار القاسم المشترك نجح\n");

    اختبار_مضاعف_مشترك();
    اطبع("✓ اختبار المضاعف المشترك نجح\n");

    اطبع("\n═══════════════════════════════════\n");
    اطبع("جميع الاختبارات نجحت!\n");
    اطبع("═══════════════════════════════════\n");
}

الحمد_لله
