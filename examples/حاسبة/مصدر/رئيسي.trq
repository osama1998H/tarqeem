بسم_الله

/// ═══════════════════════════════════════════════════════════════════
/// الحاسبة العلمية - مثال على استخدام لغة ترقيم
/// ═══════════════════════════════════════════════════════════════════
///
/// هذا البرنامج يوضح استخدام:
/// - دوال الإدخال والإخراج
/// - الدوال الرياضية
/// - هياكل التحكم
///
/// @مؤلف فريق ترقيم
/// @نسخة ١.٠.٠

// ═══════════════════════════════════════════
// الثوابت
// ═══════════════════════════════════════════

ثابت باي = 3.141592653589793

// ═══════════════════════════════════════════
// متغيرات عامة
// ═══════════════════════════════════════════

متغير عدد_العمليات = 0
متغير اخر_نتيجة: عدد_عشري = 0.0

// ═══════════════════════════════════════════
// دوال الرياضيات الأساسية
// ═══════════════════════════════════════════

/// القيمة المطلقة
دالة مطلق(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع -س
    }
    أرجع س
}

/// القيمة المطلقة لعدد عشري
دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع -س
    }
    أرجع س
}

/// الجذر التربيعي باستخدام طريقة نيوتن
دالة جذر(س: عدد_عشري) -> عدد_عشري {
    إذا (س <= 0.0) {
        أرجع 0.0
    }

    متغير تخمين = س / 2.0
    متغير عداد = 0

    طالما (عداد < 50) {
        متغير تخمين_جديد = (تخمين + س / تخمين) / 2.0
        إذا (مطلق_عشري(تخمين_جديد - تخمين) < 0.0000001) {
            أرجع تخمين_جديد
        }
        تخمين = تخمين_جديد
        عداد = عداد + 1
    }

    أرجع تخمين
}

/// دالة القوة (أس صحيح)
دالة قوة(قاعدة: عدد_عشري، اس: عدد) -> عدد_عشري {
    إذا (اس == 0) {
        أرجع 1.0
    }

    متغير نتيجة = 1.0
    متغير ق = اس

    إذا (ق < 0) {
        ق = -ق
    }

    متغير عداد = 0
    طالما (عداد < ق) {
        نتيجة = نتيجة * قاعدة
        عداد = عداد + 1
    }

    إذا (اس < 0) {
        أرجع 1.0 / نتيجة
    }

    أرجع نتيجة
}

/// العاملي
دالة عاملي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }

    متغير نتيجة = 1
    متغير ع = 2

    طالما (ع <= ن) {
        نتيجة = نتيجة * ع
        ع = ع + 1
    }

    أرجع نتيجة
}

/// التحقق من عدد أولي
دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) {
        أرجع خطأ
    }
    إذا (ن <= 3) {
        أرجع صحيح
    }
    إذا (ن % 2 == 0) {
        أرجع خطأ
    }

    متغير ع = 3
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0) {
            أرجع خطأ
        }
        ع = ع + 2
    }

    أرجع صحيح
}

/// القاسم المشترك الأكبر
دالة قاسم_مشترك(أ: عدد، ب: عدد) -> عدد {
    متغير س = مطلق(أ)
    متغير ص = مطلق(ب)

    طالما (ص != 0) {
        متغير مؤقت = ص
        ص = س % ص
        س = مؤقت
    }

    أرجع س
}

/// المضاعف المشترك الأصغر
دالة مضاعف_مشترك(أ: عدد، ب: عدد) -> عدد {
    أرجع مطلق(أ * ب) / قاسم_مشترك(أ، ب)
}

/// التحقق من زوجي
دالة زوجي(ن: عدد) -> منطقي {
    أرجع ن % 2 == 0
}

/// التحقق من فردي
دالة فردي(ن: عدد) -> منطقي {
    أرجع ن % 2 != 0
}

/// الأقل بين عددين
دالة اقل(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ < ب) {
        أرجع أ
    }
    أرجع ب
}

/// الأكبر بين عددين
دالة اكبر(أ: عدد_عشري، ب: عدد_عشري) -> عدد_عشري {
    إذا (أ > ب) {
        أرجع أ
    }
    أرجع ب
}

/// جيب الزاوية (تقريب بسيط)
دالة جا(س: عدد_عشري) -> عدد_عشري {
    // تطبيع الزاوية
    متغير ز = س
    طالما (ز > باي) {
        ز = ز - 2.0 * باي
    }
    طالما (ز < -باي) {
        ز = ز + 2.0 * باي
    }

    // سلسلة تايلور للجيب
    متغير حد = ز
    متغير مجموع = حد
    متغير ن = 1

    طالما (ن < 10) {
        حد = -حد * ز * ز / __الى_عشري__((2 * ن) * (2 * ن + 1))
        مجموع = مجموع + حد
        ن = ن + 1
    }

    أرجع مجموع
}

/// جيب تمام الزاوية
دالة جتا(س: عدد_عشري) -> عدد_عشري {
    أرجع جا(س + باي / 2.0)
}

/// تحويل درجات إلى راديان
دالة درجات_الى_راديان(درجات: عدد_عشري) -> عدد_عشري {
    أرجع درجات * باي / 180.0
}

/// تحويل راديان إلى درجات
دالة راديان_الى_درجات(راديان: عدد_عشري) -> عدد_عشري {
    أرجع راديان * 180.0 / باي
}

// ═══════════════════════════════════════════
// دوال العرض والتنسيق
// ═══════════════════════════════════════════

/// اطبع ترويسة البرنامج
دالة اطبع_ترويسة() {
    اطبع("\n")
    اطبع("══════════════════════════════════════════════════\n")
    اطبع("       الحاسبة العلمية - ترقيم ١.٠              \n")
    اطبع("══════════════════════════════════════════════════\n")
    اطبع("\n")
}

/// اطبع القائمة الرئيسية
دالة اطبع_القائمة() {
    اطبع("╔════════════════════════════════════════╗\n")
    اطبع("║           القائمة الرئيسية             ║\n")
    اطبع("╠════════════════════════════════════════╣\n")
    اطبع("║  1. العمليات الحسابية الأساسية         ║\n")
    اطبع("║  2. الدوال الرياضية المتقدمة           ║\n")
    اطبع("║  3. حساب المثلثات                      ║\n")
    اطبع("║  4. نظرية الأعداد                      ║\n")
    اطبع("║  5. معلومات البرنامج                   ║\n")
    اطبع("║  0. خروج                               ║\n")
    اطبع("╚════════════════════════════════════════╝\n")
    اطبع("\n")
}

/// اطبع نتيجة العملية
دالة اطبع_نتيجة(نتيجة: عدد_عشري) {
    اطبع("\n")
    اطبع("┌────────────────────────────────────────┐\n")
    اطبع("│ النتيجة: ")
    اطبع(__الى_نص_عشري__(نتيجة))
    اطبع("\n")
    اطبع("└────────────────────────────────────────┘\n")

    // تحديث آخر نتيجة
    اخر_نتيجة = نتيجة
    عدد_العمليات = عدد_العمليات + 1
}

/// اطبع نتيجة عدد صحيح
دالة اطبع_نتيجة_صحيحة(نتيجة: عدد) {
    اطبع_نتيجة(__الى_عشري__(نتيجة))
}

// ═══════════════════════════════════════════
// العمليات الحسابية الأساسية
// ═══════════════════════════════════════════

/// قائمة العمليات الأساسية
دالة عمليات_اساسية() {
    اطبع_ترويسة()
    اطبع("═══════ العمليات الحسابية الأساسية ═══════\n")
    اطبع("\n")
    اطبع("  1. الجمع (+)\n")
    اطبع("  2. الطرح (-)\n")
    اطبع("  3. الضرب (×)\n")
    اطبع("  4. القسمة (÷)\n")
    اطبع("  5. باقي القسمة (%)\n")
    اطبع("  0. رجوع\n")
    اطبع("\n")

    اطبع("اختر العملية: ")
    متغير اختيار = __ادخل_عدد__()

    إذا (اختيار == 0) {
        أرجع
    }

    اطبع("أدخل العدد الأول: ")
    متغير أ = __ادخل_عشري__()

    اطبع("أدخل العدد الثاني: ")
    متغير ب = __ادخل_عشري__()

    متغير نتيجة: عدد_عشري = 0.0

    تطابق (اختيار) {
        حالة 1 => {
            نتيجة = أ + ب
        }
        حالة 2 => {
            نتيجة = أ - ب
        }
        حالة 3 => {
            نتيجة = أ * ب
        }
        حالة 4 => {
            إذا (ب == 0.0) {
                اطبع("خطأ: لا يمكن القسمة على صفر!\n")
                أرجع
            }
            نتيجة = أ / ب
        }
        حالة 5 => {
            إذا (ب == 0.0) {
                اطبع("خطأ: لا يمكن القسمة على صفر!\n")
                أرجع
            }
            نتيجة = __باقي_عشري__(أ، ب)
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n")
            أرجع
        }
    }

    اطبع_نتيجة(نتيجة)
}

// ═══════════════════════════════════════════
// الدوال الرياضية المتقدمة
// ═══════════════════════════════════════════

/// قائمة الدوال المتقدمة
دالة دوال_متقدمة() {
    اطبع_ترويسة()
    اطبع("═══════ الدوال الرياضية المتقدمة ═══════\n")
    اطبع("\n")
    اطبع("  1. الجذر التربيعي (√)\n")
    اطبع("  2. القوة (أس)\n")
    اطبع("  3. القيمة المطلقة (|س|)\n")
    اطبع("  4. الأقل والأكبر\n")
    اطبع("  0. رجوع\n")
    اطبع("\n")

    اطبع("اختر العملية: ")
    متغير اختيار = __ادخل_عدد__()

    تطابق (اختيار) {
        حالة 0 => { أرجع }
        حالة 1 => {
            اطبع("أدخل العدد: ")
            متغير س = __ادخل_عشري__()

            إذا (س < 0.0) {
                اطبع("خطأ: لا يمكن حساب الجذر التربيعي لعدد سالب!\n")
                أرجع
            }

            اطبع_نتيجة(جذر(س))
        }
        حالة 2 => {
            اطبع("أدخل الأساس: ")
            متغير ق = __ادخل_عشري__()
            اطبع("أدخل الأس: ")
            متغير اس = __ادخل_عدد__()

            اطبع_نتيجة(قوة(ق، اس))
        }
        حالة 3 => {
            اطبع("أدخل العدد: ")
            متغير س = __ادخل_عشري__()

            اطبع_نتيجة(مطلق_عشري(س))
        }
        حالة 4 => {
            اطبع("أدخل العدد الأول: ")
            متغير أ = __ادخل_عشري__()
            اطبع("أدخل العدد الثاني: ")
            متغير ب = __ادخل_عشري__()

            اطبع("\n")
            اطبع("الأقل: ")
            اطبع(__الى_نص_عشري__(اقل(أ، ب)))
            اطبع("\n")
            اطبع("الأكبر: ")
            اطبع(__الى_نص_عشري__(اكبر(أ، ب)))
            اطبع("\n")
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n")
        }
    }
}

// ═══════════════════════════════════════════
// حساب المثلثات
// ═══════════════════════════════════════════

/// قائمة دوال المثلثات
دالة حساب_مثلثات() {
    اطبع_ترويسة()
    اطبع("═══════ حساب المثلثات ═══════\n")
    اطبع("\n")
    اطبع("  1. جيب الزاوية (جا)\n")
    اطبع("  2. جيب تمام الزاوية (جتا)\n")
    اطبع("  3. تحويل درجات ↔ راديان\n")
    اطبع("  0. رجوع\n")
    اطبع("\n")

    اطبع("اختر العملية: ")
    متغير اختيار = __ادخل_عدد__()

    تطابق (اختيار) {
        حالة 0 => { أرجع }
        حالة 1 => {
            اطبع("أدخل الزاوية (بالدرجات): ")
            متغير زاوية = __ادخل_عشري__()
            متغير راديان = درجات_الى_راديان(زاوية)
            اطبع_نتيجة(جا(راديان))
        }
        حالة 2 => {
            اطبع("أدخل الزاوية (بالدرجات): ")
            متغير زاوية = __ادخل_عشري__()
            متغير راديان = درجات_الى_راديان(زاوية)
            اطبع_نتيجة(جتا(راديان))
        }
        حالة 3 => {
            اطبع("  1. درجات → راديان\n")
            اطبع("  2. راديان → درجات\n")
            اطبع("اختر: ")
            متغير فرعي = __ادخل_عدد__()

            إذا (فرعي == 1) {
                اطبع("أدخل الدرجات: ")
                متغير درجات = __ادخل_عشري__()
                اطبع_نتيجة(درجات_الى_راديان(درجات))
            } وإلا {
                اطبع("أدخل الراديان: ")
                متغير راد = __ادخل_عشري__()
                اطبع_نتيجة(راديان_الى_درجات(راد))
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n")
        }
    }
}

// ═══════════════════════════════════════════
// نظرية الأعداد
// ═══════════════════════════════════════════

/// قائمة دوال نظرية الأعداد
دالة نظرية_اعداد() {
    اطبع_ترويسة()
    اطبع("═══════ نظرية الأعداد ═══════\n")
    اطبع("\n")
    اطبع("  1. التحقق من عدد أولي\n")
    اطبع("  2. العاملي (ن!)\n")
    اطبع("  3. القاسم المشترك الأكبر\n")
    اطبع("  4. المضاعف المشترك الأصغر\n")
    اطبع("  5. زوجي أم فردي\n")
    اطبع("  0. رجوع\n")
    اطبع("\n")

    اطبع("اختر العملية: ")
    متغير اختيار = __ادخل_عدد__()

    تطابق (اختيار) {
        حالة 0 => { أرجع }
        حالة 1 => {
            اطبع("أدخل العدد: ")
            متغير ن = __ادخل_عدد__()

            إذا (اولي(ن)) {
                اطبع("\n✓ العدد ")
                اطبع(__الى_نص__(ن))
                اطبع(" عدد أولي\n")
            } وإلا {
                اطبع("\n✗ العدد ")
                اطبع(__الى_نص__(ن))
                اطبع(" ليس عدداً أولياً\n")
            }
        }
        حالة 2 => {
            اطبع("أدخل العدد: ")
            متغير ن = __ادخل_عدد__()

            إذا (ن < 0) {
                اطبع("خطأ: العاملي غير معرف للأعداد السالبة\n")
            } وإلا إذا (ن > 20) {
                اطبع("تحذير: الأعداد الكبيرة قد تسبب فيضان\n")
                اطبع_نتيجة_صحيحة(عاملي(ن))
            } وإلا {
                اطبع_نتيجة_صحيحة(عاملي(ن))
            }
        }
        حالة 3 => {
            اطبع("أدخل العدد الأول: ")
            متغير أ = __ادخل_عدد__()
            اطبع("أدخل العدد الثاني: ")
            متغير ب = __ادخل_عدد__()

            اطبع_نتيجة_صحيحة(قاسم_مشترك(أ، ب))
        }
        حالة 4 => {
            اطبع("أدخل العدد الأول: ")
            متغير أ = __ادخل_عدد__()
            اطبع("أدخل العدد الثاني: ")
            متغير ب = __ادخل_عدد__()

            اطبع_نتيجة_صحيحة(مضاعف_مشترك(أ، ب))
        }
        حالة 5 => {
            اطبع("أدخل العدد: ")
            متغير ن = __ادخل_عدد__()

            إذا (زوجي(ن)) {
                اطبع("\nالعدد ")
                اطبع(__الى_نص__(ن))
                اطبع(" عدد زوجي\n")
            } وإلا {
                اطبع("\nالعدد ")
                اطبع(__الى_نص__(ن))
                اطبع(" عدد فردي\n")
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n")
        }
    }
}

// ═══════════════════════════════════════════
// معلومات البرنامج
// ═══════════════════════════════════════════

/// عرض معلومات البرنامج
دالة اعرض_معلومات() {
    اطبع_ترويسة()
    اطبع("═══════ معلومات البرنامج ═══════\n")
    اطبع("\n")
    اطبع("  الاسم: الحاسبة العلمية\n")
    اطبع("  النسخة: 1.0.0\n")
    اطبع("  اللغة: ترقيم\n")
    اطبع("\n")
    اطبع("  هذا البرنامج مثال على استخدام:\n")
    اطبع("    - دوال الإدخال والإخراج\n")
    اطبع("    - الدوال الرياضية\n")
    اطبع("    - الهياكل التحكمية\n")
    اطبع("\n")
    اطبع("  إحصائيات الجلسة:\n")
    اطبع("    - عدد العمليات: ")
    اطبع(__الى_نص__(عدد_العمليات))
    اطبع("\n")
    اطبع("    - آخر نتيجة: ")
    اطبع(__الى_نص_عشري__(اخر_نتيجة))
    اطبع("\n")
}

// ═══════════════════════════════════════════
// الدالة الرئيسية
// ═══════════════════════════════════════════

/// نقطة بداية البرنامج
دالة رئيسي() {
    متغير مستمر = صحيح

    طالما (مستمر) {
        اطبع_ترويسة()
        اطبع_القائمة()

        اطبع("اختر من القائمة: ")
        متغير اختيار = __ادخل_عدد__()

        تطابق (اختيار) {
            حالة 0 => {
                اطبع("\n")
                اطبع("شكراً لاستخدام الحاسبة العلمية!\n")
                اطبع("إجمالي العمليات: ")
                اطبع(__الى_نص__(عدد_العمليات))
                اطبع("\n")
                مستمر = خطأ
            }
            حالة 1 => { عمليات_اساسية() }
            حالة 2 => { دوال_متقدمة() }
            حالة 3 => { حساب_مثلثات() }
            حالة 4 => { نظرية_اعداد() }
            حالة 5 => { اعرض_معلومات() }
            غير_ذلك => {
                اطبع("اختيار غير صالح، يرجى المحاولة مرة أخرى\n")
            }
        }
    }
}

الحمد_لله
