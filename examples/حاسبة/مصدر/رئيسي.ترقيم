// ═══════════════════════════════════════════
// العمليات الحسابية الأساسية
// ═══════════════════════════════════════════

دالة عمليات_اساسية() {
    اطبع_ترويسة();
    اطبع("═══════ العمليات الحسابية الأساسية ═══════\n\n");
    اطبع("  1. الجمع (+)\n");
    اطبع("  2. الطرح (-)\n");
    اطبع("  3. الضرب (×)\n");
    اطبع("  4. القسمة (÷)\n");
    اطبع("  5. باقي القسمة (٪)\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    إذا (اختيار == 0) {
        أرجع;
    }

    اطبع("أدخل العدد الأول: ");
    متغير أ = ادخل_عشري();

    اطبع("أدخل العدد الثاني: ");
    متغير ب = ادخل_عشري();

    متغير نتيجة: عدد_عشري = 0.0;

    تطابق (اختيار) {
        حالة 1 => {
            نتيجة = أ + ب;
        }
        حالة 2 => {
            نتيجة = أ - ب;
        }
        حالة 3 => {
            نتيجة = أ * ب;
        }
        حالة 4 => {
            إذا (ب == 0.0) {
                اطبع("خطأ: لا يمكن القسمة على صفر!\n");
                أرجع;
            }
            نتيجة = أ / ب;
        }
        حالة 5 => {
            إذا (ب == 0.0) {
                اطبع("خطأ: لا يمكن القسمة على صفر!\n");
                أرجع;
            }
            // استخدام باقي القسمة للأعداد الصحيحة
            نتيجة = عدد_عشري(عدد(أ) % عدد(ب));
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
            أرجع;
        }
    }

    اطبع_نتيجة(نتيجة);
}

// ═══════════════════════════════════════════
// الدوال الرياضية المتقدمة
// (تستخدم الدوال المدمجة في وقت التشغيل)
// ═══════════════════════════════════════════

دالة دوال_متقدمة() {
    اطبع_ترويسة();
    اطبع("═══════ الدوال الرياضية المتقدمة ═══════\n\n");
    اطبع("  1. الجذر التربيعي (√)\n");
    اطبع("  2. الجذر التكعيبي (∛)\n");
    اطبع("  3. القوة (أس)\n");
    اطبع("  4. القيمة المطلقة (|س|)\n");
    اطبع("  5. اللوغاريتم الطبيعي (ln)\n");
    اطبع("  6. اللوغاريتم أساس 10 (log10)\n");
    اطبع("  7. الأسي (e^x)\n");
    اطبع("  8. السقف والأرضية\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            إذا (س < 0.0) {
                اطبع("خطأ: لا يمكن حساب الجذر التربيعي لعدد سالب!\n");
                أرجع;
            }

            // استخدام الدالة المدمجة جذر
            اطبع_نتيجة(جذر(س));
        }
        حالة 2 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            // استخدام الدالة المدمجة جذر_تكعيبي
            اطبع_نتيجة(جذر_تكعيبي(س));
        }
        حالة 3 => {
            اطبع("أدخل الأساس: ");
            متغير ق = ادخل_عشري();
            اطبع("أدخل الأس: ");
            متغير ن = ادخل_عشري();

            // استخدام الدالة المدمجة قوة
            اطبع_نتيجة(قوة(ق، ن));
        }
        حالة 4 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            // استخدام الدالة المدمجة مطلق
            اطبع_نتيجة(مطلق(س));
        }
        حالة 5 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            إذا (س <= 0.0) {
                اطبع("خطأ: اللوغاريتم غير معرف للأعداد السالبة أو الصفر!\n");
                أرجع;
            }

            // استخدام الدالة المدمجة لوغاريتم (ln)
            اطبع_نتيجة(لوغاريتم(س));
        }
        حالة 6 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            إذا (س <= 0.0) {
                اطبع("خطأ: اللوغاريتم غير معرف للأعداد السالبة أو الصفر!\n");
                أرجع;
            }

            // استخدام الدالة المدمجة لوغاريتم10
            اطبع_نتيجة(لوغاريتم10(س));
        }
        حالة 7 => {
            اطبع("أدخل الأس: ");
            متغير س = ادخل_عشري();

            // استخدام الدالة المدمجة أسي (e^x)
            اطبع_نتيجة(أسي(س));
        }
        حالة 8 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            اطبع("\nالسقف (ceil): ");
            اطبع(سقف(س));
            اطبع("\nالأرضية (floor): ");
            اطبع(أرضية(س));
            اطبع("\nالتقريب (round): ");
            اطبع(تقريب(س));
            اطبع("\n");
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

