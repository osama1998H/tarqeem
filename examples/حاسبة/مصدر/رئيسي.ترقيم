دالة حساب_مثلثات() {
    اطبع_ترويسة();
    اطبع("═══════ حساب المثلثات ═══════\n\n");
    اطبع("  1. جيب الزاوية (جا)\n");
    اطبع("  2. جيب تمام الزاوية (جتا)\n");
    اطبع("  3. ظل الزاوية (ظا)\n");
    اطبع("  4. تحويل درجات ↔ راديان\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = درجات_راديان(زاوية);
            اطبع_نتيجة(جيب(راديان));
        }
        حالة 2 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = درجات_راديان(زاوية);
            اطبع_نتيجة(جيب_تمام(راديان));
        }
        حالة 3 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = درجات_راديان(زاوية);
            اطبع_نتيجة(ظل(راديان));
        }
        حالة 4 => {
            اطبع("  1. درجات → راديان\n");
            اطبع("  2. راديان → درجات\n");
            اطبع("اختر: ");
            متغير فرعي = ادخل_عدد();

            إذا (فرعي == 1) {
                اطبع("أدخل الدرجات: ");
                متغير درجات = ادخل_عشري();
                اطبع_نتيجة(درجات_راديان(درجات));
            } وإلا {
                اطبع("أدخل الراديان: ");
                متغير راد = ادخل_عشري();
                اطبع_نتيجة(راديان_درجات(راد));
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

// ═══════════════════════════════════════════
// نظرية الأعداد
// ═══════════════════════════════════════════

دالة نظرية_اعداد() {
    اطبع_ترويسة();
    اطبع("═══════ نظرية الأعداد ═══════\n\n");
    اطبع("  1. التحقق من عدد أولي\n");
    اطبع("  2. العاملي (ن!)\n");
    اطبع("  3. القاسم المشترك الأكبر\n");
    اطبع("  4. المضاعف المشترك الأصغر\n");
    اطبع("  5. زوجي أم فردي\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            إذا (اولي(ن)) {
                اطبع("\n✓ العدد ");
                اطبع(ن);
                اطبع(" عدد أولي\n");
            } وإلا {
                اطبع("\n✗ العدد ");
                اطبع(ن);
                اطبع(" ليس عدداً أولياً\n");
            }
        }
        حالة 2 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            إذا (ن < 0) {
                اطبع("خطأ: العاملي غير معرف للأعداد السالبة\n");
            } وإلا إذا (ن > 20) {
                اطبع("تحذير: الأعداد الكبيرة قد تسبب فيضان\n");
                اطبع_نتيجة_صحيحة(عاملي_حساب(ن));
            } وإلا {
                اطبع_نتيجة_صحيحة(عاملي_حساب(ن));
            }
        }
        حالة 3 => {
            اطبع("أدخل العدد الأول: ");
            متغير أ = ادخل_عدد();
            اطبع("أدخل العدد الثاني: ");
            متغير ب = ادخل_عدد();

            اطبع_نتيجة_صحيحة(قاسم_اكبر(أ، ب));
        }
        حالة 4 => {
            اطبع("أدخل العدد الأول: ");
            متغير أ = ادخل_عدد();
            اطبع("أدخل العدد الثاني: ");
            متغير ب = ادخل_عدد();

            اطبع_نتيجة_صحيحة(مضاعف_اصغر(أ، ب));
        }
        حالة 5 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            إذا (زوجي(ن)) {
                اطبع("\nالعدد ");
                اطبع(ن);
                اطبع(" عدد زوجي\n");
            } وإلا {
                اطبع("\nالعدد ");
                اطبع(ن);
                اطبع(" عدد فردي\n");
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

