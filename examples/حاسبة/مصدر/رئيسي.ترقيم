دالة رئيسي() {
    متغير مستمر = صحيح;

    طالما (مستمر) {
        اطبع_ترويسة();
        اطبع_القائمة();

        اطبع("اختر من القائمة: ");
        متغير اختيار = ادخل_عدد();

        تطابق (اختيار) {
            حالة 0 => {
                اطبع("\nشكراً لاستخدام الحاسبة العلمية!\n");
                مستمر = خطأ;
            }
            حالة 1 => { عمليات_اساسية(); }
            حالة 2 => { دوال_متقدمة(); }
            حالة 3 => { حساب_مثلثات(); }
            حالة 4 => { نظرية_اعداد(); }
            حالة 5 => { ارقام_عشوائية(); }
            حالة 6 => { اعرض_معلومات(); }
            غير_ذلك => {
                اطبع("اختيار غير صالح، يرجى المحاولة مرة أخرى\n");
            }
        }
    }
