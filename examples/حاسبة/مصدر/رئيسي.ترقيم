دالة عمليات_اساسية() {
    اطبع_ترويسة();
    اطبع("═══════ العمليات الحسابية الأساسية ═══════\n\n");
    اطبع("  1. الجمع (+)\n");
    اطبع("  2. الطرح (-)\n");
    اطبع("  3. الضرب (×)\n");
    اطبع("  4. القسمة (÷)\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    إذا (اختيار == 0) {
        أرجع;
    }

    اطبع("أدخل العدد الأول: ");
    متغير أ = ادخل_عشري();

    اطبع("أدخل العدد الثاني: ");
    متغير ب = ادخل_عشري();

    متغير نتيجة: عدد_عشري = 0.0;

    تطابق (اختيار) {
        حالة 1 => {
            نتيجة = أ + ب;
        }
        حالة 2 => {
            نتيجة = أ - ب;
        }
        حالة 3 => {
            نتيجة = أ * ب;
        }
        حالة 4 => {
            إذا (ب == 0.0) {
                اطبع("خطأ: لا يمكن القسمة على صفر!\n");
                أرجع;
            }
            نتيجة = أ / ب;
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
            أرجع;
        }
    }

    اطبع_نتيجة(نتيجة);
}

