    اطبع("═══════ الأرقام العشوائية ═══════\n\n");
    اطبع("  1. رقم عشوائي (0-1)\n");
    اطبع("  2. رقم عشوائي في نطاق\n");
    اطبع("  3. توليد عدة أرقام\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            // استخدام الدالة المدمجة عشوائي
            اطبع("\nرقم عشوائي: ");
            اطبع(عشوائي());
            اطبع("\n");
        }
        حالة 2 => {
            اطبع("أدخل الحد الأدنى: ");
            متغير ادنى = ادخل_عدد();
            اطبع("أدخل الحد الأقصى: ");
            متغير اقصى = ادخل_عدد();

            إذا (ادنى >= اقصى) {
                اطبع("خطأ: الحد الأدنى يجب أن يكون أصغر من الحد الأقصى\n");
                أرجع;
            }

            // استخدام الدالة المدمجة عشوائي_بين
            اطبع("\nرقم عشوائي بين ");
            اطبع(ادنى);
            اطبع(" و ");
            اطبع(اقصى);
            اطبع(": ");
            اطبع(عشوائي_بين(ادنى، اقصى));
            اطبع("\n");
        }
        حالة 3 => {
            اطبع("كم رقماً تريد توليده؟ ");
            متغير كم = ادخل_عدد();

            إذا (كم <= 0 || كم > 20) {
                اطبع("يرجى إدخال عدد بين 1 و 20\n");
                أرجع;
            }

            اطبع("\nالأرقام العشوائية:\n");
            متغير ع = 0;
            طالما (ع < كم) {
                اطبع("  ");
                اطبع(ع + 1);
                اطبع(". ");
                اطبع(عشوائي());
                اطبع("\n");
                ع = ع + 1;
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

