                اطبع("\nالعدد ");
                اطبع(ن);
                اطبع(" عدد فردي\n");
            }
        }
        حالة 6 => {
            اطبع("أدخل العدد الأول: ");
            متغير أ = ادخل_عشري();
            اطبع("أدخل العدد الثاني: ");
