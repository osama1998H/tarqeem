ثابت باي = 3.141592653589793;

// ═══════════════════════════════════════════
// الدوال الرياضية الأساسية
// ═══════════════════════════════════════════

// القيمة المطلقة للأعداد العشرية
دالة مطلق_عشري(س: عدد_عشري) -> عدد_عشري {
    إذا (س < 0.0) {
        أرجع 0.0 - س;
    }
    أرجع س;
}

// القيمة المطلقة للأعداد الصحيحة
دالة مطلق_صحيح(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع 0 - س;
    }
    أرجع س;
}

// الجذر التربيعي باستخدام طريقة نيوتن
دالة جذر_تربيعي(س: عدد_عشري) -> عدد_عشري {
    إذا (س <= 0.0) {
        أرجع 0.0;
    }

    متغير تخمين = س / 2.0;
    متغير عداد = 0;

    طالما (عداد < 20) {
        متغير تخمين_جديد = (تخمين + س / تخمين) / 2.0;
        متغير فرق = تخمين_جديد - تخمين;
        إذا (فرق < 0.0) {
            فرق = 0.0 - فرق;
        }
        إذا (فرق < 0.0000001) {
            أرجع تخمين_جديد;
        }
        تخمين = تخمين_جديد;
        عداد = عداد + 1;
    }

    أرجع تخمين;
}

// حساب القوة للأسس الصحيحة الموجبة
دالة اس(قاعدة: عدد_عشري، ن: عدد) -> عدد_عشري {
    إذا (ن == 0) {
        أرجع 1.0;
    }

    متغير نتيجة = 1.0;
    متغير ع = 0;
    متغير اس_موجب = ن;
    إذا (اس_موجب < 0) {
        اس_موجب = 0 - اس_موجب;
    }

    طالما (ع < اس_موجب) {
        نتيجة = نتيجة * قاعدة;
        ع = ع + 1;
    }

    إذا (ن < 0) {
        أرجع 1.0 / نتيجة;
    }

    أرجع نتيجة;
}

// العاملي
دالة عاملي_حساب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1;
    }

    متغير نتيجة = 1;
    متغير ع = 2;

    طالما (ع <= ن) {
        نتيجة = نتيجة * ع;
        ع = ع + 1;
    }

    أرجع نتيجة;
}

// القاسم المشترك الأكبر
دالة قاسم_اكبر(أ: عدد، ب: عدد) -> عدد {
    متغير س = مطلق_صحيح(أ);
    متغير ص = مطلق_صحيح(ب);

    طالما (ص != 0) {
        متغير مؤقت = ص;
        ص = س % ص;
        س = مؤقت;
    }

    أرجع س;
}

// المضاعف المشترك الأصغر
دالة مضاعف_اصغر(أ: عدد، ب: عدد) -> عدد {
    إذا (أ == 0 || ب == 0) {
        أرجع 0;
    }
    أرجع مطلق_صحيح(أ * ب) / قاسم_اكبر(أ، ب);
}

// تحويل درجات إلى راديان
دالة درجات_راديان(درجات: عدد_عشري) -> عدد_عشري {
    أرجع درجات * باي / 180.0;
}

// تحويل راديان إلى درجات
دالة راديان_درجات(راديان: عدد_عشري) -> عدد_عشري {
    أرجع راديان * 180.0 / باي;
}

// دالة الجيب (sin) باستخدام متسلسلة تايلور
دالة جيب(س: عدد_عشري) -> عدد_عشري {
    // تقليل الزاوية للنطاق [0، 2π]
    متغير زاوية = س;
    طالما (زاوية > باي * 2.0) {
        زاوية = زاوية - باي * 2.0;
    }
    طالما (زاوية < 0.0) {
        زاوية = زاوية + باي * 2.0;
    }

    // متسلسلة تايلور: sin(x) = x - x³/3! + x⁵/5! - ...
    متغير نتيجة = زاوية;
    متغير حد = زاوية;
    متغير ن = 1;

    طالما (ن < 10) {
        حد = 0.0 - حد * زاوية * زاوية / عدد_عشري((2 * ن) * (2 * ن + 1));
        نتيجة = نتيجة + حد;
        ن = ن + 1;
    }

    أرجع نتيجة;
}

// دالة جيب التمام (cos)
دالة جيب_تمام(س: عدد_عشري) -> عدد_عشري {
    أرجع جيب(س + باي / 2.0);
}

// دالة الظل (tan)
دالة ظل(س: عدد_عشري) -> عدد_عشري {
    متغير جتا = جيب_تمام(س);
    إذا (مطلق_عشري(جتا) < 0.0000001) {
        أرجع 999999.0;
    }
    أرجع جيب(س) / جتا;
}

// التحقق من عدد أولي
دالة اولي(ن: عدد) -> منطقي {
    إذا (ن <= 1) {
        أرجع خطأ;
    }
    إذا (ن <= 3) {
        أرجع صحيح;
    }
    إذا (ن % 2 == 0) {
        أرجع خطأ;
    }

    متغير ع = 3;
    طالما (ع * ع <= ن) {
        إذا (ن % ع == 0) {
            أرجع خطأ;
        }
        ع = ع + 2;
    }

    أرجع صحيح;
}

// التحقق من زوجي
دالة زوجي(ن: عدد) -> منطقي {
    أرجع ن % 2 == 0;
}

