دالة حساب_مثلثات() {
    اطبع_ترويسة();
    اطبع("═══════ حساب المثلثات ═══════\n\n");
    اطبع("  1. جيب الزاوية (جا)\n");
    اطبع("  2. جيب تمام الزاوية (جتا)\n");
    اطبع("  3. ظل الزاوية (ظا)\n");
    اطبع("  4. ظل التمام (ظتا)\n");
    اطبع("  5. القاطع (قا)\n");
    اطبع("  6. قاطع التمام (قتا)\n");
    اطبع("  7. الدوال العكسية\n");
    اطبع("  8. تحويل درجات ↔ راديان\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            // تحويل إلى راديان ثم حساب الجيب
            متغير راديان = زاوية * باي / 180.0;
            اطبع_نتيجة(جا(راديان));
        }
        حالة 2 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = زاوية * باي / 180.0;
            اطبع_نتيجة(جتا(راديان));
        }
        حالة 3 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = زاوية * باي / 180.0;
            اطبع_نتيجة(ظا(راديان));
        }
        حالة 4 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = زاوية * باي / 180.0;
            // ظل التمام = 1 / ظل
            اطبع_نتيجة(ظتا(راديان));
        }
        حالة 5 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = زاوية * باي / 180.0;
            // القاطع = 1 / جيب التمام
            اطبع_نتيجة(قا(راديان));
        }
        حالة 6 => {
            اطبع("أدخل الزاوية (بالدرجات): ");
            متغير زاوية = ادخل_عشري();
            متغير راديان = زاوية * باي / 180.0;
            // قاطع التمام = 1 / جيب
            اطبع_نتيجة(قتا(راديان));
        }
        حالة 7 => {
            اطبع("  1. معكوس الجيب (asin)\n");
            اطبع("  2. معكوس جيب التمام (acos)\n");
            اطبع("  3. معكوس الظل (atan)\n");
            اطبع("اختر: ");
            متغير فرعي = ادخل_عدد();

            تطابق (فرعي) {
                حالة 1 => {
                    اطبع("أدخل القيمة (بين -1 و 1): ");
                    متغير س = ادخل_عشري();
                    إذا (س < -1.0 || س > 1.0) {
                        اطبع("خطأ: القيمة يجب أن تكون بين -1 و 1\n");
                        أرجع;
                    }
                    متغير نتيجة_راد = جا_عكسي(س);
                    متغير نتيجة_درج = نتيجة_راد * 180.0 / باي;
                    اطبع("\nالنتيجة (بالراديان): ");
                    اطبع(نتيجة_راد);
                    اطبع("\nالنتيجة (بالدرجات): ");
                    اطبع(نتيجة_درج);
                    اطبع("\n");
                }
                حالة 2 => {
                    اطبع("أدخل القيمة (بين -1 و 1): ");
                    متغير س = ادخل_عشري();
                    إذا (س < -1.0 || س > 1.0) {
                        اطبع("خطأ: القيمة يجب أن تكون بين -1 و 1\n");
                        أرجع;
                    }
                    متغير نتيجة_راد = جتا_عكسي(س);
                    متغير نتيجة_درج = نتيجة_راد * 180.0 / باي;
                    اطبع("\nالنتيجة (بالراديان): ");
                    اطبع(نتيجة_راد);
                    اطبع("\nالنتيجة (بالدرجات): ");
                    اطبع(نتيجة_درج);
                    اطبع("\n");
                }
                حالة 3 => {
                    اطبع("أدخل القيمة: ");
                    متغير س = ادخل_عشري();
                    متغير نتيجة_راد = ظا_عكسي(س);
                    متغير نتيجة_درج = نتيجة_راد * 180.0 / باي;
                    اطبع("\nالنتيجة (بالراديان): ");
                    اطبع(نتيجة_راد);
                    اطبع("\nالنتيجة (بالدرجات): ");
                    اطبع(نتيجة_درج);
                    اطبع("\n");
                }
                غير_ذلك => {
                    اطبع("اختيار غير صالح\n");
                }
            }
        }
        حالة 8 => {
            اطبع("  1. درجات → راديان\n");
            اطبع("  2. راديان → درجات\n");
            اطبع("اختر: ");
            متغير فرعي = ادخل_عدد();

            إذا (فرعي == 1) {
                اطبع("أدخل الدرجات: ");
                متغير درجات_قيمة = ادخل_عشري();
                // استخدام الدالة المدمجة راديان
                اطبع_نتيجة(راديان(درجات_قيمة));
            } وإلا {
                اطبع("أدخل الراديان: ");
                متغير راد = ادخل_عشري();
                // استخدام الدالة المدمجة درجات
                اطبع_نتيجة(درجات(راد));
            }
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

// ═══════════════════════════════════════════
// نظرية الأعداد
// (تستخدم الدوال المدمجة في وقت التشغيل)
// ═══════════════════════════════════════════

دالة نظرية_اعداد() {
    اطبع_ترويسة();
    اطبع("═══════ نظرية الأعداد ═══════\n\n");
    اطبع("  1. التحقق من عدد أولي\n");
    اطبع("  2. العاملي (ن!)\n");
    اطبع("  3. القاسم المشترك الأكبر\n");
    اطبع("  4. المضاعف المشترك الأصغر\n");
    اطبع("  5. زوجي أم فردي\n");
    اطبع("  6. الأدنى والأقصى\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            // التحقق يدوياً - يمكن إضافة دالة أولي للمكتبة لاحقاً
            إذا (ن <= 1) {
                اطبع("\n✗ العدد ");
                اطبع(ن);
                اطبع(" ليس عدداً أولياً\n");
                أرجع;
            }
            إذا (ن <= 3) {
                اطبع("\n✓ العدد ");
                اطبع(ن);
                اطبع(" عدد أولي\n");
                أرجع;
            }
            إذا (ن % 2 == 0) {
                اطبع("\n✗ العدد ");
                اطبع(ن);
                اطبع(" ليس عدداً أولياً\n");
                أرجع;
            }

            متغير اولي = صحيح;
            متغير ع = 3;
            طالما (ع * ع <= ن) {
                إذا (ن % ع == 0) {
                    اولي = خطأ;
                }
                ع = ع + 2;
            }

            إذا (اولي) {
                اطبع("\n✓ العدد ");
                اطبع(ن);
                اطبع(" عدد أولي\n");
            } وإلا {
                اطبع("\n✗ العدد ");
                اطبع(ن);
                اطبع(" ليس عدداً أولياً\n");
            }
        }
        حالة 2 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            إذا (ن < 0) {
                اطبع("خطأ: العاملي غير معرف للأعداد السالبة\n");
            } وإلا إذا (ن > 20) {
                اطبع("تحذير: الأعداد الكبيرة قد تسبب فيضان\n");
                // استخدام الدالة المدمجة عاملي
                اطبع_نتيجة_صحيحة(عاملي(ن));
            } وإلا {
                اطبع_نتيجة_صحيحة(عاملي(ن));
            }
        }
        حالة 3 => {
            اطبع("أدخل العدد الأول: ");
            متغير أ = ادخل_عدد();
            اطبع("أدخل العدد الثاني: ");
            متغير ب = ادخل_عدد();

            // استخدام الدالة المدمجة قاسم_مشترك
            اطبع_نتيجة_صحيحة(قاسم_مشترك(أ، ب));
        }
        حالة 4 => {
            اطبع("أدخل العدد الأول: ");
            متغير أ = ادخل_عدد();
            اطبع("أدخل العدد الثاني: ");
            متغير ب = ادخل_عدد();

            // استخدام الدالة المدمجة مضاعف_مشترك
            اطبع_نتيجة_صحيحة(مضاعف_مشترك(أ، ب));
        }
        حالة 5 => {
            اطبع("أدخل العدد: ");
            متغير ن = ادخل_عدد();

            إذا (ن % 2 == 0) {
                اطبع("\nالعدد ");
                اطبع(ن);
                اطبع(" عدد زوجي\n");
