// الدوال الرياضية المتقدمة
// ═══════════════════════════════════════════

دالة دوال_متقدمة() {
    اطبع_ترويسة();
    اطبع("═══════ الدوال الرياضية المتقدمة ═══════\n\n");
    اطبع("  1. الجذر التربيعي (√)\n");
    اطبع("  2. القوة (أس)\n");
    اطبع("  3. القيمة المطلقة (|س|)\n");
    اطبع("  0. رجوع\n\n");

    اطبع("اختر العملية: ");
    متغير اختيار = ادخل_عدد();

    تطابق (اختيار) {
        حالة 0 => { أرجع; }
        حالة 1 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            إذا (س < 0.0) {
                اطبع("خطأ: لا يمكن حساب الجذر التربيعي لعدد سالب!\n");
                أرجع;
            }

            اطبع_نتيجة(جذر_تربيعي(س));
        }
        حالة 2 => {
            اطبع("أدخل الأساس: ");
            متغير ق = ادخل_عشري();
            اطبع("أدخل الأس (عدد صحيح): ");
            متغير قوة = ادخل_عدد();

            اطبع_نتيجة(اس(ق، قوة));
        }
        حالة 3 => {
            اطبع("أدخل العدد: ");
            متغير س = ادخل_عشري();

            اطبع_نتيجة(مطلق_عشري(س));
        }
        غير_ذلك => {
            اطبع("اختيار غير صالح\n");
        }
    }
}

