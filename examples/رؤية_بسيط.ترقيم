// مثال بسيط على نظام الرؤية

صنف حساب {
    عام اسم_المالك: نص;
    خاص الرصيد: عدد;
    محمي الحد_الائتماني: عدد;

    منشئ(اسم: نص، رصيد: عدد) {
        هذا.اسم_المالك = اسم;
        هذا.الرصيد = رصيد;
        هذا.الحد_الائتماني = 1000;
    }

    عام دالة احصل_الرصيد() -> عدد {
        أرجع هذا.الرصيد;
    }

    عام دالة اطبع_معلومات() {
        اطبع("اسم المالك: " + هذا.اسم_المالك);
        اطبع("الرصيد: " + هذا.الرصيد);
    }
}

// إنشاء حساب
متغير حسابي = جديد حساب("أحمد"، 5000);

// الوصول العام - مسموح
اطبع("=== اختبار الوصول العام ===");
اطبع("اسم المالك: " + حسابي.اسم_المالك);

// استخدام دالة عامة للحصول على الرصيد الخاص
اطبع("الرصيد (عبر دالة): " + حسابي.احصل_الرصيد());

اطبع("");
حسابي.اطبع_معلومات();

اطبع("");
اطبع("=== تم الاختبار بنجاح ===");

