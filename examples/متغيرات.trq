// أمثلة على المتغيرات والأنواع
// Examples of variables and types

// المتغيرات القابلة للتغيير
متغير اسم = "أحمد";
متغير عمر = 25;
متغير راتب = 5000.50;
متغير متزوج = صحيح;

// الثوابت
ثابت PI = 3.14159;
ثابت اسم_البرنامج = "ترقيم";

// المتغيرات مع تحديد النوع
متغير عداد: عدد = 0;
متغير رسالة: نص = "مرحباً";
متغير نشط: منطقي = خطأ;

// المصفوفات
ثابت أرقام = [1، 2، 3، 4، 5];
ثابت أسماء = ["أحمد"، "محمد"، "علي"];

// طباعة المتغيرات
اطبع(اسم);
اطبع(عمر);
اطبع(أرقام);
