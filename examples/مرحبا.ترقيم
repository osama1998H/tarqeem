بسم_الله

/// مرحبا بالعالم — أول برنامج بلغة ترقيم
///
/// يعرض هذا الملف أصغر ما يلزم لبرنامج ترقيم: علامتا بداية الملف ونهايته،
/// طباعة نص، متغير بنوع مستنتج وآخر بنوع محدد، ودالة تُرجع قيمة.
///
/// @منذ ١.٠.٠

/// حيِّ شخصاً باسمه
///
/// @معامل اسم_شخص - اسم المُحيَّا
/// @أرجع جملة الترحيب
دالة تحية(اسم_شخص: نص) -> نص {
    أرجع "أهلاً يا " + اسم_شخص + "!"
}

اطبع("مرحباً بالعالم!")

// الحروف اللاتينية ممنوعة في المعرِّفات، لكنها مسموحة داخل النصوص
اطبع("Hello, World!")

// نوع «رسالة» يُستنتج من القيمة، ونوع «اسم» محدد صراحةً بعد النقطتين
متغير رسالة = "أهلاً وسهلاً!"
متغير اسم: نص = "ترقيم"

اطبع(رسالة)
اطبع("مرحباً بك في لغة " + اسم)

اطبع(تحية("صديقي"))

الحمد_لله
