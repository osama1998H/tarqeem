// أمثلة على الأصناف
// Examples of classes

// تعريف ميثاق
ميثاق قابل_للطباعة {
    دالة اطبع_معلومات()
}

// تعريف صنف بسيط
صنف شخص يلتزم قابل_للطباعة {
    خاص اسم: نص;
    خاص عمر: عدد;

    منشئ(اسم: نص، عمر: عدد) {
        هذا.اسم = اسم;
        هذا.عمر = عمر;
    }

    عام دالة اطبع_معلومات() {
        اطبع("الاسم: " + هذا.اسم);
        اطبع("العمر: " + هذا.عمر);
    }

    عام دالة احصل_اسم() -> نص {
        أرجع هذا.اسم;
    }

    عام دالة احصل_عمر() -> عدد {
        أرجع هذا.عمر;
    }
}

// الوراثة
صنف موظف يرث شخص {
    خاص راتب: عدد_عشري;
    خاص منصب: نص;

    منشئ(اسم: نص، عمر: عدد، راتب: عدد_عشري، منصب: نص) {
        الأصل(اسم، عمر);
        هذا.راتب = راتب;
        هذا.منصب = منصب;
    }

    عام دالة اطبع_معلومات() {
        الأصل.اطبع_معلومات();
        اطبع("المنصب: " + هذا.منصب);
        اطبع("الراتب: " + هذا.راتب);
    }
}

// إنشاء كائنات
متغير شخص١ = جديد شخص("أحمد"، 30);
شخص١.اطبع_معلومات();

متغير موظف١ = جديد موظف("محمد"، 35، 10000.0، "مهندس");
موظف١.اطبع_معلومات();

