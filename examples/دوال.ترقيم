// ═══════════════════════════════════════════════════════════
// الدوال: المُعلَنة بالاسم، والسهمية (lambda)، والدوال كقيم
//
// مرجع لمطوّري اللغة: كل صيغة هنا تعمل في الأوضاع الثلاثة
// (المفسّر، الترجمة الفورية، الترجمة الأصلية). راجع القيود
// الحالية في نهاية الملف.
// ═══════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════
// أولاً: الدوال المُعلَنة بالاسم
// ═══════════════════════════════════════════════════════════


// ١) دالة بلا معاملات وبلا قيمة إرجاع
//    لا تُكتب «-> نمط»: غياب النمط هو ما يدل على أنها لا تُرجع شيئاً
دالة اعرض_العنوان() {
    اطبع("=== الدوال ===");
}
اعرض_العنوان();


// ٢) معاملات محددة النمط، ونمط إرجاع بعد «->»
دالة اجمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب;
}
اطبع(اجمع(5، 3));                        // 8


// ٣) الحساب العشري: «عدد_عشري» نمط مستقل عن «عدد»
دالة مساحة_الدائرة(نصف_القطر: عدد_عشري) -> عدد_عشري {
    ثابت باي = 3.14159;
    أرجع باي * نصف_القطر * نصف_القطر;
}
اطبع(مساحة_الدائرة(2.0));                // 12.56636


// ٤) التعاود: الدالة تستدعي نفسها
دالة فيبوناتشي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}
اطبع(فيبوناتشي(10));                     // 55


// ═══════════════════════════════════════════════════════════
// ثانياً: الدوال السهمية والدوال كقيم
// ═══════════════════════════════════════════════════════════


// ٥) لامدا تعبيرية: جسمها تعبير واحد، ونوع الإرجاع يُستنتج منه
ثابت مربع = (س: عدد) => س * س;
اطبع(مربع(5));                          // 25


// ٦) لامدا كتلية: جسمها كتلة، ونوع الإرجاع يُستنتج من 'أرجع'
ثابت مضروب = (ن: عدد) => {
    متغير نتيجة = 1;
    متغير عداد = 1;
    طالما (عداد <= ن) {
        نتيجة = نتيجة * عداد;
        عداد = عداد + 1;
    }
    أرجع نتيجة;
};
اطبع(مضروب(5));                         // 120


// ٧) تعليق نوع الدالة (مواصفات اللغة ٥.٣): (نمط، نمط) -> نمط
//    المعاملات غير المحددة تستنتج أنواعها من التعليق
ثابت جمع: (عدد، عدد) -> عدد = (أ، ب) => أ + ب;
اطبع(جمع(3، 4));                        // 7


// ٨) الدوال العليا: تمرير لامدا كوسيط
//    نوع معامل 'س' يُستنتج من توقيع 'طبّق' — لا حاجة لتحديده
دالة طبّق(دالة_التحويل: (عدد) -> عدد، قيمة: عدد) -> عدد {
    أرجع دالة_التحويل(قيمة);
}
اطبع(طبّق((س) => س * 10، 5));            // 50


// ٩) دالة مُعلَنة بالاسم تُستخدم كقيمة
دالة ضاعف(س: عدد) -> عدد {
    أرجع س * 2;
}
ثابت مرجع_الدالة: (عدد) -> عدد = ضاعف;
اطبع(مرجع_الدالة(21));                   // 42


// ١٠) لامدا بلا قيمة إرجاع (نمط رد النداء)
//     النوع المختصر () يعني: بلا معاملات وبلا إرجاع
ثابت رحّب = (اسم: نص) => اطبع("مرحباً يا " + اسم);
رحّب("ترقيم");                           // مرحباً يا ترقيم

متغير نفّذ: () = () => اطبع("تم التنفيذ");
نفّذ();                                  // تم التنفيذ


// ١١) دالة تُرجع دالة: العامل -> يرتبط من اليمين، أي أن
//     (عدد) -> (عدد) -> عدد تعني (عدد) -> ((عدد) -> عدد)
//
//     تنبيه: الدالة الداخلية لا تستطيع استخدام معامل الدالة
//     الخارجية ('أ' هنا) لأن ذلك التقاط (د٠٣٠٦)، لذا التسلسل
//     الحقيقي (currying) ينتظر دعم الالتقاط — المسألة ٢١٧.
ثابت مُنتِج: (عدد) -> (عدد) -> عدد = (أ) => (ب) => ب * 2;
اطبع(مُنتِج(1)(21));                      // 42


// ١٢) إعادة الإسناد: اللامدا الجديدة ترث توقيع المتغير المُعلَن
متغير عملية: (عدد) -> عدد = (س) => س + 1;
اطبع(عملية(41));                         // 42
عملية = (س) => س * 100;
اطبع(عملية(2));                          // 200


// ═══════════════════════════════════════════════════════════
// القيود الحالية (مقصودة، وموثّقة برموز أخطاء)
//
// • لا التقاط للمتغيرات المحلية المحيطة (closures) بعد — الدالة
//   السهمية تُرفع إلى دالة مستقلة، فالإشارة إلى متغير محلي في
//   دالة محيطة تُنتج الخطأ د٠٣٠٦، وكذلك 'هذا' و'الأصل'.
//   المتغيرات العامة (كالمعرّفة في هذا الملف) ليست التقاطاً.
//   المتابعة في المسألة ٢١٧.
//
//   دالة مثال() {
//       متغير ع = 10;
//       ثابت زد = (س: عدد) => س + ع;   // ❌ د٠٣٠٦
//   }
//
// • الترجمة الأصلية تحتاج أنواعاً محددة لكل معامل: المعاملات
//   بدون نوع (أو من النوع 'أي') تُنتج الخطأ ت٠٣٠١، لأن الكود
//   الأصلي يحتاج واجهة تطبيق ثنائية محددة. المفسّر لا يتأثر،
//   لذا تعمل صيغة المواصفات ٨.٣ التالية مع 'tarqeem run' فقط:
//
//   ثابت جمع_حر = (أ، ب) => أ + ب;      // ✅ المفسّر / ❌ ت٠٣٠١ أصلياً
//
//   الحل: حدّد نوع الدالة كما في المثال ٧ أعلاه.
// ═══════════════════════════════════════════════════════════

الحمد_لله
