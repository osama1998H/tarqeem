// أمثلة على الدوال
// Examples of functions

// دالة بسيطة
دالة مرحبا() {
    اطبع("مرحباً!");
}

// دالة مع معاملات
دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب;
}

// دالة مع قيمة افتراضية
دالة تحية(اسم: نص) {
    اطبع("مرحباً يا " + اسم);
}

// دالة حساب المساحة
دالة مساحة_الدائرة(نصف_القطر: عدد_عشري) -> عدد_عشري {
    ثابت باي = 3.14159;
    أرجع باي * نصف_القطر * نصف_القطر;
}

// دالة تعاودية (فيبوناتشي)
دالة فيبوناتشي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

// استدعاء الدوال
مرحبا();
متغير نتيجة = جمع(5، 3);
اطبع(نتيجة);
