// مثال على إطار عمل الاختبارات في ترقيم
// ═══════════════════════════════════════════
//
// يوضح هذا المثال كيفية كتابة اختبارات وحدة
// باستخدام أنماط الاختبارات المدمجة في ترقيم
//
// الأنماط المستخدمة:
// ١. دوال تبدأ بـ "اختبار_" للاختبارات
// ٢. دالة تأكد() للتوكيدات الأساسية
// ٣. دالة تأكد_رسالة() للتوكيدات مع رسائل مخصصة

// ═══════════════════════════════════════════
// الكود المراد اختباره
// ═══════════════════════════════════════════

/// جمع عددين
دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب
}

/// طرح عدد من عدد
دالة طرح(أ: عدد، ب: عدد) -> عدد {
    أرجع أ - ب
}

/// ضرب عددين
دالة ضرب(أ: عدد، ب: عدد) -> عدد {
    أرجع أ * ب
}

/// قسمة عدد على عدد (قسمة صحيحة)
دالة قسمة(أ: عدد، ب: عدد) -> عدد {
    إذا (ب == 0) {
        أرجع 0
    }
    أرجع أ / ب
}

/// حساب العاملي (المضروب)
دالة احسب_عاملي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }
    أرجع ن * احسب_عاملي(ن - 1)
}

/// تحقق إذا العدد زوجي
دالة زوجي(ن: عدد) -> منطقي {
    أرجع ن % 2 == 0
}

/// تحقق إذا العدد فردي
دالة فردي(ن: عدد) -> منطقي {
    أرجع ن % 2 != 0
}

/// حساب القيمة المطلقة
دالة قيمة_مطلقة(ن: عدد) -> عدد {
    إذا (ن < 0) {
        أرجع 0 - ن
    }
    أرجع ن
}

/// حساب مجموع مصفوفة
دالة مجموع(أرقام: مصفوفة<عدد>) -> عدد {
    متغير نتيجة = 0
    لكل رقم في أرقام {
        نتيجة = نتيجة + رقم
    }
    أرجع نتيجة
}

