/// اختبار دالة الجمع
دالة اختبار_الجمع() {
    // اختبار الحالات العادية
    تأكد_يساوي(جمع(2، 3)، 5)
    تأكد_يساوي(جمع(10، 20)، 30)
    تأكد_يساوي(جمع(100، 200)، 300)

    // اختبار مع الصفر
    تأكد_يساوي(جمع(5، 0)، 5)
    تأكد_يساوي(جمع(0، 5)، 5)
    تأكد_يساوي(جمع(0، 0)، 0)

    // اختبار الأعداد السالبة
    تأكد_يساوي(جمع(0 - 5، 3)، 0 - 2)
    تأكد_يساوي(جمع(5، 0 - 3)، 2)
    تأكد_يساوي(جمع(0 - 5، 0 - 3)، 0 - 8)
}

/// اختبار دالة الطرح
دالة اختبار_الطرح() {
    تأكد_يساوي(طرح(10، 3)، 7)
    تأكد_يساوي(طرح(5، 5)، 0)
    تأكد_يساوي(طرح(3، 10)، 0 - 7)
}

/// اختبار دالة الضرب
دالة اختبار_الضرب() {
    تأكد_يساوي(ضرب(3، 4)، 12)
    تأكد_يساوي(ضرب(0، 100)، 0)
    تأكد_يساوي(ضرب(100، 0)، 0)
    تأكد_يساوي(ضرب(0 - 2، 3)، 0 - 6)
    تأكد_يساوي(ضرب(0 - 2، 0 - 3)، 6)
}

/// اختبار دالة القسمة
دالة اختبار_القسمة() {
    تأكد_يساوي(قسمة(10، 2)، 5)
    تأكد_يساوي(قسمة(9، 3)، 3)
    تأكد_يساوي(قسمة(7، 2)، 3)  // قسمة صحيحة

    // اختبار القسمة على صفر
    تأكد_يساوي(قسمة(10، 0)، 0)
}

/// اختبار دالة العاملي
دالة اختبار_العاملي() {
    تأكد_يساوي(احسب_عاملي(0)، 1)
    تأكد_يساوي(احسب_عاملي(1)، 1)
    تأكد_يساوي(احسب_عاملي(5)، 120)
    تأكد_يساوي(احسب_عاملي(6)، 720)
}

/// اختبار دالة الزوجي/الفردي
دالة اختبار_الزوجي_والفردي() {
    تأكد_صحيح(زوجي(0))
    تأكد_صحيح(زوجي(2))
    تأكد_صحيح(زوجي(100))
    تأكد_خاطئ(زوجي(1))
    تأكد_خاطئ(زوجي(99))

    تأكد_صحيح(فردي(1))
    تأكد_صحيح(فردي(99))
    تأكد_خاطئ(فردي(0))
    تأكد_خاطئ(فردي(100))
}

/// اختبار دالة القيمة المطلقة
دالة اختبار_القيمة_المطلقة() {
    تأكد_يساوي(قيمة_مطلقة(5)، 5)
    تأكد_يساوي(قيمة_مطلقة(0 - 5)، 5)
    تأكد_يساوي(قيمة_مطلقة(0)، 0)
}

/// اختبار دالة المجموع
دالة اختبار_المجموع() {
    تأكد_يساوي(مجموع([1، 2، 3])، 6)
    تأكد_يساوي(مجموع([10، 20، 30])، 60)
    تأكد_يساوي(مجموع([])، 0)
    تأكد_يساوي(مجموع([100])، 100)
}

/// اختبار المصفوفات
دالة اختبار_المصفوفات() {
    متغير أرقام: مصفوفة<عدد> = [1، 2، 3، 4، 5]

    // اختبار الطول
    تأكد_يساوي(طول(أرقام)، 5)

    // اختبار الوصول
    تأكد_يساوي(أرقام[0]، 1)
    تأكد_يساوي(أرقام[4]، 5)

    // اختبار التعديل
    أرقام[0] = 10
    تأكد_يساوي(أرقام[0]، 10)

    // اختبار الإضافة
    أرقام.ألحق(6)
    تأكد_يساوي(طول(أرقام)، 6)
    تأكد_يساوي(أرقام[5]، 6)
}

