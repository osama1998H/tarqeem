// دوال مساعدة للاختبارات
// ═══════════════════════════════════════════

// عداد النجاح والفشل
متغير _اختبارات_ناجحة = 0
متغير _اختبارات_فاشلة = 0
متغير _الاختبار_الحالي = ""

/// تأكد من تساوي قيمتين عدديتين
دالة تأكد_يساوي(فعلي: عدد، متوقع: عدد) {
    إذا (فعلي != متوقع) {
        اطبع("    ✗ فشل: توقعت " + متوقع + " لكن حصلت على " + فعلي)
        توقف("فشل التأكيد")
    }
}

/// تأكد من تساوي نصين
دالة تأكد_يساوي_نص(فعلي: نص، متوقع: نص) {
    إذا (فعلي != متوقع) {
        اطبع("    ✗ فشل: توقعت \"" + متوقع + "\" لكن حصلت على \"" + فعلي + "\"")
        توقف("فشل التأكيد")
    }
}

/// تأكد من أن القيمة صحيحة
دالة تأكد_صحيح(قيمة: منطقي) {
    إذا (!قيمة) {
        اطبع("    ✗ فشل: توقعت صحيح لكن حصلت على خطأ")
        توقف("فشل التأكيد")
    }
}

/// تأكد من أن القيمة خاطئة
دالة تأكد_خاطئ(قيمة: منطقي) {
    إذا (قيمة) {
        اطبع("    ✗ فشل: توقعت خطأ لكن حصلت على صحيح")
        توقف("فشل التأكيد")
    }
}

/// تأكد من أن القيمة أكبر من حد
دالة تأكد_أكبر_من(فعلي: عدد، حد: عدد) {
    إذا (فعلي <= حد) {
        اطبع("    ✗ فشل: توقعت قيمة أكبر من " + حد + " لكن حصلت على " + فعلي)
        توقف("فشل التأكيد")
    }
}

/// تأكد من أن القيمة أصغر من حد
دالة تأكد_أصغر_من(فعلي: عدد، حد: عدد) {
    إذا (فعلي >= حد) {
        اطبع("    ✗ فشل: توقعت قيمة أصغر من " + حد + " لكن حصلت على " + فعلي)
        توقف("فشل التأكيد")
    }
}

