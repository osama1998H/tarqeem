بسم_الله

// لعبة الحياة - نسخة مبسطة لاختبار المترجم

// ثوابت
ثابت عرض = 5;
ثابت ارتفاع = 5;

// دالة بسيطة لعد الجيران
دالة عد_جيران_خلية(س: عدد، ص: عدد) -> عدد {
    متغير مجموع = 0;

    // محاكاة بسيطة - فقط لاختبار الحسابات
    إذا (س > 0) {
        مجموع++;
    }
    إذا (س < عرض - 1) {
        مجموع++;
    }
    إذا (ص > 0) {
        مجموع++;
    }
    إذا (ص < ارتفاع - 1) {
        مجموع++;
    }

    أرجع مجموع;
}

// دالة لتحديد حالة الخلية التالية
دالة الحالة_التالية(حية: منطقي، جيران: عدد) -> منطقي {
    // قواعد كونواي
    إذا (حية) {
        إذا (جيران == 2 || جيران == 3) {
            أرجع صحيح;
        } وإلا {
            أرجع خطأ;
        }
    } وإلا {
        إذا (جيران == 3) {
            أرجع صحيح;
        } وإلا {
            أرجع خطأ;
        }
    }
}

// دالة الطباعة
دالة اطبع_خلية(حية: منطقي) {
    إذا (حية) {
        اطبع("█");
    } وإلا {
        اطبع("░");
    }
}

// دالة حساب فيبوناتشي (لاختبار التعاودية)
دالة فيب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن;
    }
    أرجع فيب(ن - 1) + فيب(ن - 2);
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== لعبة الحياة - اختبار ===");

    // اختبار الدوال
    متغير جيران = عد_جيران_خلية(2، 2);
    اطبع("عدد الجيران للخلية (2,2): ");
    اطبع(جيران);

    // اختبار قواعد كونواي
    متغير حالة1 = الحالة_التالية(صحيح، 2);
    متغير حالة2 = الحالة_التالية(صحيح، 4);
    متغير حالة3 = الحالة_التالية(خطأ، 3);

    اطبع("خلية حية مع 2 جيران -> ");
    اطبع_خلية(حالة1);

    اطبع("خلية حية مع 4 جيران -> ");
    اطبع_خلية(حالة2);

    اطبع("خلية ميتة مع 3 جيران -> ");
    اطبع_خلية(حالة3);

    // اختبار فيبوناتشي
    اطبع("فيبوناتشي(10) = ");
    اطبع(فيب(10));

    // اختبار الحلقات
    اطبع("العد من 0 إلى 4:");
    لكل (متغير ع = 0؛ ع < 5؛ ع++) {
        اطبع(ع);
    }

    // اختبار العمليات الحسابية
    متغير حساب = (5 + 3) * 2 - 4 / 2;
    اطبع("(5 + 3) * 2 - 4 / 2 = ");
    اطبع(حساب);

    اطبع("=== انتهى الاختبار ===");
}

// تشغيل البرنامج
رئيسية();

الحمد_لله
