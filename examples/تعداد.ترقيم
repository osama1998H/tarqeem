// مثال على استخدام التعداد (Enums) في ترقيم
// Example: Enums in Tarqeem

// ═══════════════════════════════════════════════════════════════
// تعداد بسيط - Simple Enum
// ═══════════════════════════════════════════════════════════════

// تعداد الألوان الأساسية
تعداد لون {
    أحمر،
    أخضر،
    أزرق
}

// تعداد أيام الأسبوع
تعداد يوم {
    السبت،
    الأحد،
    الاثنين،
    الثلاثاء،
    الأربعاء،
    الخميس،
    الجمعة
}

// ═══════════════════════════════════════════════════════════════
// تعداد مع قيم تمييزية - Enum with Discriminants
// ═══════════════════════════════════════════════════════════════

// تعداد حالة الطلب مع قيم رقمية
تعداد حالة_طلب {
    منتظر = 0،
    قيد_المعالجة = 1،
    مُرسَل = 2،
    مُستلَم = 3،
    ملغي = -1
}

// تعداد مستوى الأولوية
تعداد أولوية {
    منخفضة = 1،
    متوسطة = 5،
    عالية = 10،
    حرجة = 100
}

// ═══════════════════════════════════════════════════════════════
// تعداد مع بيانات مرتبطة - Tagged Union / Sum Type
// ═══════════════════════════════════════════════════════════════

// تعداد نتيجة العملية (مشابه لـ Result في Rust)
تعداد نتيجة {
    نجاح(قيمة: عدد)،
    فشل(رسالة: نص)
}

// تعداد الأشكال الهندسية
تعداد شكل {
    دائرة(نصف_قطر: عدد_عشري)،
    مستطيل(عرض: عدد_عشري، ارتفاع: عدد_عشري)،
    مثلث(ضلع١: عدد_عشري، ضلع٢: عدد_عشري، ضلع٣: عدد_عشري)
}

// تعداد رسالة الشبكة
تعداد رسالة_شبكة {
    اتصال(معرف_مستخدم: نص)،
    قطع_اتصال(معرف_مستخدم: نص، سبب: نص)،
    بيانات(محتوى: نص)،
    مشكلة(رمز: عدد، وصف: نص)
}

// ═══════════════════════════════════════════════════════════════
// تعداد معمم - Generic Enum
// ═══════════════════════════════════════════════════════════════

// تعداد اختياري (مشابه لـ Option في Rust)
تعداد اختياري<ن> {
    بعض(قيمة: ن)،
    فارغ
}

// تعداد نتيجة معمم (مشابه لـ Result في Rust)
تعداد محاولة<ن، خ> {
    موفق(قيمة: ن)،
    خاطئ(خطأ_: خ)
}

