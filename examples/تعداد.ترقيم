بسم_الله

// مثال على استخدام التعداد في ترقيم
// ═══════════════════════════════════════════════════════════════
// تعداد بسيط 
// ═══════════════════════════════════════════════════════════════

// تعداد الألوان الأساسية
تعداد لون {
    أحمر،
    أخضر،
    أزرق
}

// تعداد أيام الأسبوع
تعداد يوم {
    السبت،
    الأحد،
    الاثنين،
    الثلاثاء،
    الأربعاء،
    الخميس،
    الجمعة
}

// ═══════════════════════════════════════════════════════════════
// تعداد مع قيم تمييزية  
// ═══════════════════════════════════════════════════════════════

// تعداد حالة الطلب مع قيم رقمية
تعداد حالة_طلب {
    منتظر = 0،
    قيد_المعالجة = 1،
    مُرسَل = 2،
    مُستلَم = 3،
    ملغي = -1
}

// تعداد مستوى الأولوية
تعداد أولوية {
    منخفضة = 1،
    متوسطة = 5،
    عالية = 10،
    حرجة = 100
}

// ═══════════════════════════════════════════════════════════════
// تعداد مع بيانات مرتبطة 
// ═══════════════════════════════════════════════════════════════

// تعداد نتيجة العملية
تعداد نتيجة {
    نجاح(قيمة: عدد)،
    فشل(رسالة: نص)
}

// تعداد الأشكال الهندسية
تعداد شكل {
    دائرة(نصف_قطر: عدد_عشري)،
    مستطيل(عرض: عدد_عشري، ارتفاع: عدد_عشري)،
    مثلث(ضلع١: عدد_عشري، ضلع٢: عدد_عشري، ضلع٣: عدد_عشري)
}

// تعداد رسالة الشبكة
تعداد رسالة_شبكة {
    اتصال(معرف_مستخدم: نص)،
    قطع_اتصال(معرف_مستخدم: نص، سبب: نص)،
    بيانات(محتوى: نص)،
    مشكلة(رمز: عدد، وصف: نص)
}

// ═══════════════════════════════════════════════════════════════
// تعداد معمم  
// ═══════════════════════════════════════════════════════════════

// تعداد اختياري
تعداد اختياري<ن> {
    بعض(قيمة: ن)،
    فارغ
}

// تعداد نتيجة معمم
تعداد محاولة<ن، خ> {
    موفق(قيمة: ن)،
    خاطئ(خطأ_: خ)
}

// ═══════════════════════════════════════════════════════════════
