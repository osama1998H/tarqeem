/// التعدادات: الحالات البسيطة، والقيم التمييزية، والبيانات المرتبطة
///
/// يعرض هذا الملف كيف يُعلَن التعداد وكيف تُقرأ حالاته بـ«::»، وكيف تُفكَّك
/// بياناته المرتبطة داخل «تطابق».
///
/// @منذ ١.٠.٠

// ═══════════════════════════════════════════
// تعداد بسيط
// ═══════════════════════════════════════════

/// تعداد الألوان الأساسية
تعداد لون {
    أحمر،
    أخضر،
    أزرق
}

/// تعداد أيام الأسبوع
تعداد يوم {
    السبت،
    الأحد،
    الاثنين،
    الثلاثاء،
    الأربعاء،
    الخميس،
    الجمعة
}

// ═══════════════════════════════════════════
// تعداد مع قيم تمييزية
// ═══════════════════════════════════════════

/// تعداد حالة الطلب مع قيم رقمية
تعداد حالة_طلب {
    منتظر = 0،
    قيد_المعالجة = 1،
    مُرسَل = 2،
    مُستلَم = 3،
    ملغي = -1
}

/// تعداد مستوى الأولوية
تعداد أولوية {
    منخفضة = 1،
    متوسطة = 5،
    عالية = 10،
    حرجة = 100
}

// ═══════════════════════════════════════════
// تعداد مع بيانات مرتبطة
// ═══════════════════════════════════════════

/// تعداد نتيجة العملية
تعداد نتيجة {
    نجاح(قيمة: عدد)،
    فشل(رسالة: نص)
}

/// تعداد الأشكال الهندسية
تعداد شكل {
    دائرة(نصف_قطر: عدد_عشري)،
    مستطيل(عرض: عدد_عشري، ارتفاع: عدد_عشري)،
    مثلث(ضلع١: عدد_عشري، ضلع٢: عدد_عشري، ضلع٣: عدد_عشري)
}

/// تعداد رسالة الشبكة
تعداد رسالة_شبكة {
    اتصال(معرف_مستخدم: نص)،
    قطع_اتصال(معرف_مستخدم: نص، سبب: نص)،
    بيانات(محتوى: نص)،
    مشكلة(رمز: عدد، وصف: نص)
}

// ═══════════════════════════════════════════
// تعداد معمم (للتوثيق - الدعم الكامل قادم)
// ═══════════════════════════════════════════

/// تعداد اختياري
تعداد اختياري<ن> {
    بعض(قيمة: ن)،
    فارغ
}

/// تعداد نتيجة معمم
تعداد محاولة<ن، خ> {
    موفق(قيمة: ن)،
    خاطئ(خطأ_: خ)
}

// ═══════════════════════════════════════════
// إنشاء قيم التعداد
// ═══════════════════════════════════════════

اطبع("=== إنشاء قيم التعداد ===")

// إنشاء قيم تعداد بسيط (بدون أقواس)
متغير اللون = لون::أحمر
متغير اليوم = يوم::الجمعة
متغير الحالة = حالة_طلب::قيد_المعالجة
متغير الأولوية = أولوية::عالية

اطبع("تم إنشاء قيم التعداد البسيطة")

// إنشاء قيم تعداد مع بيانات
متغير النتيجة = نتيجة::نجاح(42)
متغير الخطأ = نتيجة::فشل("حدث خطأ غير متوقع")

اطبع("تم إنشاء قيم التعداد مع البيانات")

// إنشاء أشكال هندسية
متغير الدائرة = شكل::دائرة(5.0)
متغير المستطيل = شكل::مستطيل(10.0، 5.0)
متغير المثلث = شكل::مثلث(3.0، 4.0، 5.0)

اطبع("تم إنشاء الأشكال الهندسية")

// إنشاء رسائل الشبكة
متغير رسالة_اتصال = رسالة_شبكة::اتصال("مستخدم_123")
متغير رسالة_قطع = رسالة_شبكة::قطع_اتصال("مستخدم_123"، "انتهت الجلسة")
متغير رسالة_بيانات = رسالة_شبكة::بيانات("مرحبا بالعالم")
متغير رسالة_خطأ = رسالة_شبكة::مشكلة(404، "الصفحة غير موجودة")

اطبع("تم إنشاء رسائل الشبكة")

// ═══════════════════════════════════════════
// استخدام التعداد في الدوال
// ═══════════════════════════════════════════

/// أرجع اللون الافتراضي
دالة احصل_اللون_الافتراضي() -> لون {
    أرجع لون::أزرق
}

/// أنشئ دائرة بنصف قطر ثابت
دالة انشئ_دائرة() -> شكل {
    أرجع شكل::دائرة(10.0)
}

// استخدام الدوال
متغير اللون_الافتراضي = احصل_اللون_الافتراضي()
متغير شكل_جديد = انشئ_دائرة()

اطبع("تم استخدام التعداد في الدوال")

// ═══════════════════════════════════════════
// مطابقة الأنماط على التعداد
// ═══════════════════════════════════════════

اطبع("")
اطبع("=== مطابقة الأنماط على التعداد ===")

/// اقرأ اسم اللون بمطابقة حالاته
دالة اسم_اللون(ل: لون) -> نص {
    تطابق (ل) {
        حالة لون::أحمر => { أرجع "أحمر" }
        حالة لون::أخضر => { أرجع "أخضر" }
        حالة لون::أزرق => { أرجع "أزرق" }
        غير_ذلك => { أرجع "لون غير معروف" }
    }
}

/// اطبع النتيجة بتفكيك بياناتها المرتبطة
دالة طباعة_النتيجة(ن: نتيجة) {
    تطابق (ن) {
        حالة نتيجة::نجاح(ق) => {
            اطبع("نجح بقيمة: " + ق)
        }
        حالة نتيجة::فشل(ر) => {
            اطبع("فشل: " + ر)
        }
    }
}

/// احسب مساحة شكل حسب حالته
دالة حساب_المساحة(ش: شكل) -> عدد_عشري {
    تطابق (ش) {
        حالة شكل::دائرة(نق) => {
            أرجع 3.14159 * نق * نق
        }
        حالة شكل::مستطيل(ع، ا) => {
            أرجع ع * ا
        }
        حالة شكل::مثلث(أ، ب، ج) => {
            // صيغة هيرون - تبسيط
            متغير س = (أ + ب + ج) / 2.0
            أرجع 0.0
        }
    }
}

// اختبار دالة اسم_اللون
اطبع("اختبار اسم_اللون:")
اطبع("  لون::أحمر = " + اسم_اللون(لون::أحمر))
اطبع("  لون::أخضر = " + اسم_اللون(لون::أخضر))
اطبع("  لون::أزرق = " + اسم_اللون(لون::أزرق))

// اختبار دالة طباعة_النتيجة
اطبع("")
اطبع("اختبار طباعة_النتيجة:")
اطبع("  نتيجة::نجاح(42):")
طباعة_النتيجة(نتيجة::نجاح(42))
اطبع("  نتيجة::فشل(\"خطأ في الاتصال\"):")
طباعة_النتيجة(نتيجة::فشل("خطأ في الاتصال"))

// اختبار دالة حساب_المساحة
اطبع("")
اطبع("اختبار حساب_المساحة:")
متغير مساحة_دائرة = حساب_المساحة(شكل::دائرة(5.0))
اطبع("  مساحة دائرة نصف قطرها 5 = " + مساحة_دائرة)
متغير مساحة_مستطيل = حساب_المساحة(شكل::مستطيل(10.0، 5.0))
اطبع("  مساحة مستطيل 10×5 = " + مساحة_مستطيل)

// ═══════════════════════════════════════════
// ملخص
// ═══════════════════════════════════════════

اطبع("")
اطبع("=== انتهى الاختبار بنجاح ===")

الحمد_لله
