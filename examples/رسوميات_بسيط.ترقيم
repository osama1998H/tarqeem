بسم_الله

/// مثال بسيط على استخدام الرسوميات
استورد { هيئ، أنهِ، أنشئ_نافذة، أغلق_نافذة، امسح، اعرض، عيّن_لون، ارسم_مستطيل، ارسم_مستطيل_ممتلئ، ارسم_دائرة_ممتلئة، استطلع_حدث، نوع_الحدث، تأخير } من "رسوميات"

إذا (هيئ() == ٠) {
    اطبع("فشل في تهيئة الرسوميات!")
} وإلا {
    متغير نافذة = أنشئ_نافذة("مثال ترقيم", ٨٠٠, ٦٠٠)

    إذا (نافذة > ٠) {
        متغير يعمل = صحيح
        متغير إطار = ٠

        طالما (يعمل و إطار < ٦٠) {
            طالما (استطلع_حدث() == ١) {
                إذا (نوع_الحدث() == ١) {
                    يعمل = خطأ
                }
            }

            عيّن_لون(نافذة, ٠, ٠, ٠, ٢٥٥)
            امسح(نافذة)

            عيّن_لون(نافذة, ٢٥٥, ٠, ٠, ٢٥٥)
            ارسم_مستطيل_ممتلئ(نافذة, ١٠٠, ١٥٠, ١٥٠, ١٠٠)

            عيّن_لون(نافذة, ٠, ٢٥٥, ٠, ٢٥٥)
            ارسم_مستطيل_ممتلئ(نافذة, ٣٢٥, ١٥٠, ١٥٠, ١٠٠)

            عيّن_لون(نافذة, ٠, ٠, ٢٥٥, ٢٥٥)
            ارسم_مستطيل_ممتلئ(نافذة, ٥٥٠, ١٥٠, ١٥٠, ١٠٠)

            عيّن_لون(نافذة, ٢٥٥, ٢٥٥, ٠, ٢٥٥)
            ارسم_دائرة_ممتلئة(نافذة, ٤٠٠, ٤٠٠, ٨٠)

            عيّن_لون(نافذة, ٢٥٥, ٢٥٥, ٢٥٥, ٢٥٥)
            ارسم_مستطيل(نافذة, ١٠, ١٠, ٧٨٠, ٥٨٠)

            اعرض(نافذة)

            تأخير(١٦)
            إطار = إطار + ١
        }

        أغلق_نافذة(نافذة)
    }

    أنهِ()
    اطبع("تم!")
}

الحمد_لله
