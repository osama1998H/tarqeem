// اختبار المجموعات - Collections Test
// Test the stdlib collection implementations

// Test List - اختبار القائمة
دالة اختبار_قائمة() {
    اطبع("=== اختبار القائمة ===")

    // Create a list
    متغير قائمتي = جديد قائمة<عدد>()

    // Add elements
    قائمتي.أضف(10)
    قائمتي.أضف(20)
    قائمتي.أضف(30)

    اطبع("الطول: ")
    اطبع(قائمتي.طول())

    // Access elements
    اطبع("العنصر الأول: ")
    اطبع(قائمتي.احصل(0))

    اطبع("العنصر الأخير: ")
    اطبع(قائمتي.اخير())

    // Check contains
    إذا (قائمتي.يحتوي(20)) {
        اطبع("القائمة تحتوي على 20")
    }
}

// Test Stack - اختبار المكدس
دالة اختبار_مكدس() {
    اطبع("=== اختبار المكدس ===")

    متغير مكدسي = جديد مكدس<عدد>()

    // Push elements
    مكدسي.ادفع(1)
    مكدسي.ادفع(2)
    مكدسي.ادفع(3)

    اطبع("الطول: ")
    اطبع(مكدسي.طول())

    // Peek at top
    اطبع("القمة: ")
    اطبع(مكدسي.قمة())

    // Pop element
    متغير عنصر = مكدسي.انزع()
    اطبع("تم انتزاع: ")
    اطبع(عنصر)
}

// Test Queue - اختبار الطابور
دالة اختبار_طابور() {
    اطبع("=== اختبار الطابور ===")

    متغير طابوري = جديد طابور<نص>()

    // Enqueue elements
    طابوري.ادخل("أول")
    طابوري.ادخل("ثاني")
    طابوري.ادخل("ثالث")

    اطبع("الطول: ")
    اطبع(طابوري.طول())

    // Dequeue
    متغير عنصر = طابوري.اخرج()
    اطبع("تم إخراج: ")
    اطبع(عنصر)
}

// Main function - الدالة الرئيسية
دالة رئيسية() {
    اطبار_قائمة()
    اختبار_مكدس()
    اختبار_طابور()
    اطبع("=== انتهى الاختبار ===")
}
