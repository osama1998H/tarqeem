/// حاسبة بسيطة — برنامج كامل يجمع العمليات الحسابية في مكان واحد
///
/// @منذ ١.٠.٠

/// اجمع عددين
دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب
}

/// اطرح عدداً من عدد
دالة طرح(أ: عدد، ب: عدد) -> عدد {
    أرجع أ - ب
}

/// اضرب عددين
دالة ضرب(أ: عدد، ب: عدد) -> عدد {
    أرجع أ * ب
}

/// اقسم عدداً على عدد، مع حراسة القسمة على صفر
دالة قسمة(أ: عدد، ب: عدد) -> عدد {
    إذا (ب == 0) {
        أرجع 0
    }
    أرجع أ / ب
}

/// ارفع أساساً إلى أس بحلقة تكرارية
دالة حساب_القوة(أساس: عدد، أس: عدد) -> عدد {
    متغير نتيجة = 1
    لكل (متغير ع = 0؛ ع < أس؛ ع++) {
        نتيجة = نتيجة * أساس
    }
    أرجع نتيجة
}

/// احسب باقي القسمة
دالة حساب_الباقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب
}

/// احسب القيمة المطلقة
دالة القيمة_المطلقة(س: عدد) -> عدد {
    إذا (س < 0) {
        أرجع 0 - س
    }
    أرجع س
}

/// ضاعف عدداً — تُظهر متغيراً محلياً داخل دالة
دالة مضاعفة(س: عدد) -> عدد {
    متغير نتيجة = س * 2
    أرجع نتيجة
}

/// احسب المضروب تعاودياً
دالة مضروب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1
    }
    أرجع ن * مضروب(ن - 1)
}

/// احسب حد فيبوناتشي تعاودياً
دالة فيبوناتشي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
}

// اختبار الحاسبة
اطبع("=== الحاسبة البسيطة ===")

اطبع("10 + 5 = " + جمع(10، 5))
اطبع("10 - 5 = " + طرح(10، 5))
اطبع("10 * 5 = " + ضرب(10، 5))
اطبع("10 / 5 = " + قسمة(10، 5))
اطبع("10 / 0 = " + قسمة(10، 0))
اطبع("2 ^ 10 = " + حساب_القوة(2، 10))
اطبع("17 % 5 = " + حساب_الباقي(17، 5))
اطبع("|-7| = " + القيمة_المطلقة(0 - 7))
اطبع("5 * 2 = " + مضاعفة(5))
اطبع("5! = " + مضروب(5))
اطبع("فيبوناتشي(10) = " + فيبوناتشي(10))

