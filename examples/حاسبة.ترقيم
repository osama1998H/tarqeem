// حاسبة بسيطة
// Simple Calculator
//
// هذا المثال يوضح كيفية إنشاء حاسبة بسيطة بلغة ترقيم
// This example demonstrates how to create a simple calculator in Tarqeem

// دالة الجمع
// Addition function
دالة جمع(أ: عدد، ب: عدد) -> عدد {
    أرجع أ + ب;
}

// دالة الطرح
// Subtraction function
دالة طرح(أ: عدد، ب: عدد) -> عدد {
    أرجع أ - ب;
}

// دالة الضرب
// Multiplication function
دالة ضرب(أ: عدد، ب: عدد) -> عدد {
    أرجع أ * ب;
}

// دالة القسمة
// Division function
دالة قسمة(أ: عدد، ب: عدد) -> عدد {
    إذا (ب == 0) {
        أرجع 0;  // تجنب القسمة على صفر
    }
    أرجع أ / ب;
}

// دالة القوة
// Power function
دالة حساب_القوة(أساس: عدد، أس: عدد) -> عدد {
    متغير نتيجة = 1;
    لكل (متغير ع = 0؛ ع < أس؛ ع++) {
        نتيجة = نتيجة * أساس;
    }
    أرجع نتيجة;
}

// دالة باقي القسمة
// Modulo function
دالة حساب_الباقي(أ: عدد، ب: عدد) -> عدد {
    أرجع أ % ب;
}

// دالة حساب المضروب
// Factorial function
دالة مضروب(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع 1;
    }
    أرجع ن * مضروب(ن - 1);
}

// دالة حساب متتالية فيبوناتشي
// Fibonacci function
دالة فيبوناتشي(ن: عدد) -> عدد {
    إذا (ن <= 1) {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

// اختبار الحاسبة
// Test the calculator
اطبع("اختبار الحاسبة البسيطة");
اطبع("========================");

// اختبار الجمع
متغير ر١ = جمع(10، 5);
اطبع("10 + 5 = ");
اطبع(ر١);

// اختبار الطرح
متغير ر٢ = طرح(10، 5);
اطبع("10 - 5 = ");
اطبع(ر٢);

// اختبار الضرب
متغير ر٣ = ضرب(10، 5);
اطبع("10 * 5 = ");
اطبع(ر٣);

// اختبار القسمة
متغير ر٤ = قسمة(10، 5);
اطبع("10 / 5 = ");
اطبع(ر٤);

// اختبار القوة
متغير ر٥ = حساب_القوة(2، 10);
اطبع("2 ^ 10 = ");
اطبع(ر٥);

// اختبار الباقي
متغير ر٦ = حساب_الباقي(17، 5);
اطبع("17 % 5 = ");
اطبع(ر٦);

// اختبار المضروب
متغير ر٧ = مضروب(5);
اطبع("5! = ");
اطبع(ر٧);

// اختبار فيبوناتشي
متغير ر٨ = فيبوناتشي(10);
اطبع("فيبوناتشي(10) = ");
اطبع(ر٨);

اطبع("========================");
اطبع("اكتمل الاختبار بنجاح!");

